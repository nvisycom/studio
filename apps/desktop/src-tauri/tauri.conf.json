{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Nvisy Desktop",
	"version": "0.1.0",
	"identifier": "com.nvisy.desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "npm run generate",
		"frontendDist": "../.output/public"
	},
	"app": {
		"windows": [
			{
				"title": "Nvisy Desktop",
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.png"]
	}
}

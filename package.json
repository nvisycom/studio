{
	"name": "@nvisy/portal",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.18"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "npm run dev -w @nvisy/webapp",
		"build": "npm run build -w @nvisy/webapp",
		"generate": "npm run generate -w @nvisy/webapp",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"ci": "biome ci ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.1.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.8"
	},
	"overrides": {
		"vite": "^7.3.2"
	}
}

{
	"name": "@nvisy/studio",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.18"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "npm run dev -w @nvisy/webapp",
		"dev:cloud": "npm run dev:cloud -w @nvisy/webapp",
		"build": "npm run build -w @nvisy/webapp",
		"build:cloud": "npm run build:cloud -w @nvisy/webapp",
		"generate": "npm run generate -w @nvisy/webapp",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"ci": "biome ci .",
		"i18n:unused": "node scripts/i18n-unused.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^26.1.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.9"
	},
	"overrides": {
		"vite": "^8.2.0",
		"nanoid": "^3.3.17"
	}
}

{
	"name": "@nvisy/studio",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.18"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev:web": "npm run dev -w @nvisy/webapp",
		"dev:web:cloud": "npm run dev:cloud -w @nvisy/webapp",
		"dev:desktop": "npm run dev -w @nvisy/desktop",
		"build:web": "npm run build -w @nvisy/webapp",
		"build:web:cloud": "npm run build:cloud -w @nvisy/webapp",
		"build:desktop": "npm run generate -w @nvisy/desktop",
		"tauri": "npm run tauri -w @nvisy/desktop",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"fmt": "npm run fmt:biome && npm run fmt:cargo",
		"fmt:biome": "biome format --write .",
		"fmt:cargo": "npm run fmt:cargo -w @nvisy/desktop",
		"lint": "npm run lint:biome && npm run lint:cargo",
		"lint:biome": "biome lint .",
		"lint:cargo": "npm run lint:cargo -w @nvisy/desktop",
		"check": "npm run check:biome && npm run check:cargo",
		"check:biome": "biome check .",
		"check:cargo": "npm run check:cargo -w @nvisy/desktop",
		"ci": "npm run ci:biome && npm run ci:cargo",
		"ci:biome": "biome ci .",
		"ci:cargo": "npm run ci:cargo -w @nvisy/desktop",
		"i18n:unused": "node scripts/i18n-unused.mjs",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:headed": "SLOWMO=800 playwright test --headed"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@playwright/test": "^1.50.0",
		"@types/node": "^26.1.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.11"
	},
	"overrides": {
		"vite": "^8.2.0",
		"nanoid": "^3.3.17"
	}
}

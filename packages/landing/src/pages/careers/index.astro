---
import { Layout } from "@/layouts";
import { getCollection, type CollectionEntry } from "astro:content";
import { ChevronRight, Mail } from "lucide-vue-next";
import { CTA, Hero } from "@/sections";



// Get all published job postings
let jobEntries: CollectionEntry<"jobs">[] = [];
try {
	jobEntries = await getCollection("jobs");
} catch (error: unknown) {
	console.error("Error fetching jobs collection:", error);
}

// Filter and transform the data
const openPositions = jobEntries
	.filter((job) => job.data.published !== false)
	.map((job) => ({
		id: job.slug,
		title: job.data.title,
		department: job.data.department,
		location: job.data.location,
		region: job.data.region,
		type: job.data.type,
		description: job.data.description,
		requirements: job.data.requirements,
		niceToHave: job.data.niceToHave,
	}));
---

<Layout
  title="Careers"
  description="Join Nvisy and help us build the future of developer productivity. Explore remote opportunities and learn about our culture."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Build the Future with Us"
      description="Join a passionate team of builders reimagining developer productivity. We're looking for talented people who want to make a real impact."
      background="gradient"
      fontSize="xl"
      padding="lg"
      buttons={[]}
    />

    <!-- Open Positions -->
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-4xl mx-auto">
        {openPositions.length > 0 ? (
          <>
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                Open Positions
              </h2>
              <span class="text-sm text-gray-500 dark:text-neutral-400">
                {openPositions.length} position{openPositions.length !== 1 ? 's' : ''}
              </span>
            </div>
            <div class="space-y-6">
              {openPositions.map(position => (
                <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 hover:border-gray-300 dark:hover:border-neutral-600 transition-all duration-300 hover:shadow-lg">
                  <a href={`/careers/${position.id}`} class="block p-8">
                    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between">
                      <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-4 mb-6">
                          <span class="text-sm font-medium text-white bg-black dark:bg-white dark:text-black px-3 py-1 rounded-full">
                            {position.department}
                          </span>
                          <div class="flex items-center gap-3">
                            <span class="text-sm font-medium text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-800 px-3 py-1 rounded-full">
                              {position.location}
                            </span>
                            <span class="text-sm font-medium text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-800 px-3 py-1 rounded-full">
                              {position.region}
                            </span>
                            <span class="text-sm font-medium text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-800 px-3 py-1 rounded-full">
                              {position.type}
                            </span>
                          </div>
                        </div>

                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
                          {position.title}
                        </h3>

                        <p class="text-gray-700 dark:text-neutral-300 mb-6 leading-relaxed">
                          {position.description}
                        </p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                          <div>
                            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">Requirements</h4>
                            <ul class="space-y-2">
                              {position.requirements.slice(0, 3).map((req: string) => (
                                <li class="text-sm text-gray-600 dark:text-neutral-400 flex items-start">
                                  <span class="text-gray-900 dark:text-white mr-2 mt-0.5">✓</span>
                                  {req}
                                </li>
                              ))}
                            </ul>
                          </div>

                          <div>
                            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">Nice to Have</h4>
                            <ul class="space-y-2">
                              {position.niceToHave.slice(0, 3).map((nice: string) => (
                                <li class="text-sm text-gray-600 dark:text-neutral-400 flex items-start">
                                  <span class="text-gray-900 dark:text-white mr-2 mt-0.5">+</span>
                                  {nice}
                                </li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      </div>

                      <div class="mt-6 lg:mt-0 lg:ml-8 flex-shrink-0">
                        <div class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-black dark:bg-white dark:text-black hover:bg-gray-800 dark:hover:bg-neutral-200 transition-all duration-200 shadow-sm hover:shadow-md">
                          Learn More
                          <ChevronRight class="w-4 h-4 ml-2" client:load />
                        </div>
                      </div>
                    </div>
                  </a>
                  <div class="px-8 pb-6 border-t border-gray-100 dark:border-neutral-800">
                    <a
                      href={`mailto:careers@nvisy.com?subject=Application for ${position.title}&body=Hi there,%0D%0A%0D%0AI'm interested in the ${position.title} position.%0D%0A%0D%0AThanks!`}
                      class="inline-flex items-center text-sm font-medium text-gray-900 dark:text-white hover:text-gray-700 dark:hover:text-gray-300 transition-colors mt-4"
                    >
                      Quick Apply via Email
                      <Mail class="w-4 h-4 ml-2" client:load />
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 bg-gray-100 dark:bg-neutral-800 rounded-full flex items-center justify-center mx-auto mb-6 text-gray-900 dark:text-white">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">No open positions</h3>
            <p class="text-gray-500 dark:text-neutral-400">Check back soon for new opportunities.</p>
          </div>
        )}
      </div>

      <!-- Contact Section -->
      <CTA
        background="solid"
        padding="md"
        title="Don't See the Right Role?"
        description="We're always looking for exceptional talent. If you think you'd be a great fit for our team, we'd love to hear from you."
        buttons={[
          {
            text: "Send Us Your Resume",
            href: "mailto:careers@nvisy.com?subject=General Application",
            variant: "primary"
          },
          {
            text: "Get In Touch",
            href: "/contact",
            variant: "secondary"
          }
        ]}
      />
    </div>
  </div>
</Layout>

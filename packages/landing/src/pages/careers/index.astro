---
import { Layout } from "@/layouts";
import { getCollection, type CollectionEntry } from "astro:content";
import { ChevronRight, Mail, Briefcase } from "lucide-vue-next";
import { CTA, Hero } from "@/components";

// Get all published job postings
let jobEntries: CollectionEntry<"jobs">[] = [];
try {
	jobEntries = await getCollection("jobs");
} catch (error: unknown) {
	console.error("Error fetching jobs collection:", error);
}

// Filter and transform the data
const openPositions = jobEntries
	.filter((job) => job.data.published !== false)
	.map((job) => ({
		id: job.slug,
		title: job.data.title,
		department: job.data.department,
		location: job.data.location,
		region: job.data.region,
		type: job.data.type,
		description: job.data.description,
		requirements: job.data.requirements,
		responsibilities: job.data.responsibilities,
		techStack: job.data.techStack,
	}));
---

<Layout
  title="Careers"
  description="Join Nvisy and help us build the future of developer productivity. Explore remote opportunities and learn about our culture."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Join Our Team"
      description="We're building document redaction tools to make sensitive data protection simpler and more reliable. Looking for people who want to help solve real problems."
      background="gradient"
      buttons={[]}
    />

    <!-- Open Positions -->
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-4xl mx-auto">
        {openPositions.length > 0 ? (
          <>
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-2xl font-light text-neutral-900 dark:text-white">
                Open Positions
              </h2>
              <span class="text-sm text-neutral-500 dark:text-neutral-400">
                {openPositions.length} position{openPositions.length !== 1 ? 's' : ''}
              </span>
            </div>
            <div class="space-y-4">
              {openPositions.map(position => (
                <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 hover:border-neutral-300 dark:hover:border-neutral-600 transition-all duration-300 hover:shadow-lg p-6">
                  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                    <div class="flex-1">
                      <div class="flex flex-wrap items-center gap-2 mb-3">
                        <span class="text-xs font-medium text-white bg-black dark:bg-white dark:text-black px-3 py-1 rounded-full">
                          {position.department}
                        </span>
                        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800 px-3 py-1 rounded-full">
                          {position.location}
                        </span>
                        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800 px-3 py-1 rounded-full">
                          {position.type}
                        </span>
                      </div>

                      <h3 class="text-lg font-light text-neutral-900 dark:text-white mb-2">
                        {position.title}
                      </h3>

                      <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3 leading-relaxed">
                        {position.description}
                      </p>

                      {position.responsibilities && position.responsibilities.length > 0 && (
                        <div class="mb-3">
                          <h4 class="text-xs font-medium text-neutral-900 dark:text-white mb-1.5">Responsibilities</h4>
                          <ul class="space-y-1">
                            {position.responsibilities.slice(0, 3).map((resp: string) => (
                              <li class="text-xs text-neutral-600 dark:text-neutral-400 flex items-start">
                                <span class="text-neutral-400 dark:text-neutral-500 mr-2 mt-0.5">•</span>
                                {resp}
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}

                      {position.techStack && position.techStack.length > 0 && (
                        <div class="flex flex-wrap gap-1.5">
                          {position.techStack.map((tech: string) => (
                            <span class="text-xs font-medium text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 px-2 py-1 rounded">
                              {tech}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>

                    <div class="flex lg:flex-shrink-0">
                      <a
                        href={`/careers/${position.id}`}
                        class="inline-flex items-center justify-center px-5 py-2 text-sm font-medium rounded-lg text-white bg-black dark:bg-white dark:text-black hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all duration-200 whitespace-nowrap"
                      >
                        View Details
                        <ChevronRight class="w-4 h-4 ml-1" client:load />
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 bg-neutral-100 dark:bg-neutral-800 rounded-full flex items-center justify-center mx-auto mb-6 text-neutral-900 dark:text-white">
              <Briefcase class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-light text-neutral-900 dark:text-white mb-2">No open positions</h3>
            <p class="text-neutral-500 dark:text-neutral-400">Check back soon for new opportunities.</p>
          </div>
        )}
      </div>
    </div>

    <!-- Contact Section -->
    <CTA
        background="solid"
        title="Don't See the Right Role?"
        description="We're always looking for exceptional talent. If you think you'd be a great fit for our team, we'd love to hear from you."
        buttons={[
          {
            text: "Send Us Your Resume",
            href: "mailto:careers@nvisy.com?subject=General Application",
            variant: "primary"
          },
          {
            text: "Get In Touch",
            href: "/contact",
            variant: "secondary"
          }
        ]}
    />
  </div>
</Layout>

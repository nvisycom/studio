---
import Layout from "@/layouts/Layout.astro";
import {
	Hero,
	Review,
	Features,
	Testimonials,
	CTA,
	SocialProof,
	FAQ,
} from "@/components";
import Connect from "@/components/sections/Connect.astro";
import Industries from "@/components/sections/Industries.astro";
import Blogposts from "@/components/sections/Blogposts.astro";

// SEO and metadata
const pageTitle = "Home";
const pageDescription =
	"Automatically redact sensitive information from documents with AI. Trusted by enterprises worldwide.";
const pageKeywords =
	"document redaction, AI redaction, PII removal, data privacy, compliance";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
>
	<main class="overflow-hidden">
		<!-- Hero Section - Immediate Impact -->
		<Hero
			title="Redact Sensitive Information in Seconds"
			description="Automatically identify and remove PII, PHI, and confidential data from any document. AI-powered precision that saves hours of manual work while ensuring compliance."
			buttons={[
				{
					text: "Try for Free",
					href: "/pricing",
					variant: "primary"
				},
				{
					text: "Request a Demo",
					href: "/contact",
					variant: "secondary"
				}
			]}
		/>

		<!-- Social Proof - Clients -->
		<SocialProof
			title="Trusted by Industry Leaders"
			subtitle="Join hundreds of companies protecting their sensitive data"
		/>

		<!-- Review Section - How It Works with Screenshots -->
		<Review
			description="Four simple steps from upload to secure, compliant documents. See our intuitive dashboard in action."
		/>

		<!-- Features Section - Core Value Props -->
		<Features
			category="general"
			featured={true}
			title="Enterprise-Grade Document Security"
			description="Everything you need to protect sensitive information at scale. Advanced AI meets strict compliance requirements."
		/>

		<!-- Industries Section - Real-World Applications -->
		<Industries
			title="Built for Every Industry"
			description="From legal firms to healthcare providers, organizations worldwide rely on Nvisy to protect their most sensitive documents."
		/>

		<!-- Testimonials Section -->
		<Testimonials
			title="Loved by Teams Worldwide"
			description="Join hundreds of companies that trust Nvisy to protect their sensitive information."
		/>

		<!-- Connect Section - Integrations & Webhooks -->
		<Connect
			title="Connect Your Workflow"
			description="Seamlessly integrate Nvisy into your existing infrastructure with powerful APIs and webhooks."
		/>

		<!-- Latest Blog Posts Section -->
		<Blogposts
			title="Latest from Our Blog"
			description="Stay updated with insights, tutorials, and product announcements from our team"
		/>

		<!-- FAQ Section - Answer Objections -->
		<FAQ
			title="Common Questions"
			description="Everything you need to know about protecting your documents with Nvisy"
			category="general"
			featured={true}
		/>

		<!-- Final CTA - Strong Close -->
		<CTA
			title="Ready to Protect Your Documents?"
			description="Join 500+ companies already using Nvisy. Start with 100 free pages, no credit card required."
			background="gradient"
			buttons={[
				{
					text: "Start Free Trial",
					href: "/pricing",
					variant: "primary"
				},
				{
					text: "Talk to Sales",
					href: "/contact",
					variant: "secondary"
				}
			]}
		/>
	</main>
</Layout>

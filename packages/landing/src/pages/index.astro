---
import Layout from "@/layouts/Layout.astro";
import {
	Hero,
	Workflow,
	Features,
	Integrations,
	UseCases,
	Testimonials,
	TrustIndicators,
	CTA,
	Stats,
} from "@/sections";
---

<Layout>
  <!-- Hero Section - Clear Value Proposition -->
  <Hero />

  <!-- Trust Indicators - Build Credibility Early -->
  <TrustIndicators />

  <!-- Stats Section - Quantifiable Value & Social Proof -->
  <div class="bg-white dark:bg-black">
    <Stats />
  </div>

  <!-- Features Section - Core Capabilities -->
  <div class="bg-gray-50 dark:bg-neutral-950">
    <Features />
  </div>

  <!-- Workflow - Remove Friction & Objections -->
  <div class="bg-white dark:bg-black">
    <Workflow backgroundColor="white" />
  </div>

  <!-- Use Cases Section - Industry Applications -->
  <div class="bg-white dark:bg-black border-t border-gray-200 dark:border-neutral-800">
    <UseCases />
  </div>

  <!-- Testimonials Section - Customer Validation -->
  <div class="bg-gray-50 dark:bg-neutral-950">
    <Testimonials backgroundColor="gray" />
  </div>

  <!-- Integrations Section - Ecosystem Fit -->
  <div class="bg-white dark:bg-black">
    <Integrations backgroundColor="white" />
  </div>

  <!-- Call-to-Action Section - Clear Next Steps -->
  <CTA
    title="Ready to Secure Your Documents?"
    description="Join hundreds of enterprises already protecting sensitive information with our AI-powered redaction platform."
    background="gradient"
    buttons={[
      {
        text: "Start Free Trial",
        href: "/dashboard",
        variant: "primary"
      },
      {
        text: "Contact Sales",
        href: "/contact",
        variant: "secondary"
      }
    ]}
  />
</Layout>

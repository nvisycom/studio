---
import Layout from "@/layouts/Layout.astro";
import {
	Hero,
	Workflow,
	Features,
	Integrations,
	UseCases,
	Testimonials,
	CTA,
	Stats,
	Security,
	PressCarousel,
	FAQ,
} from "@/sections";

// SEO and metadata
const pageTitle =
	"AI-Powered Document Redaction | Enterprise Security Platform";
const pageDescription =
	"Secure your sensitive documents with AI-powered redaction. Enterprise-grade security, 99.9% accuracy, SOC 2 compliant. Start your free trial today.";
const pageKeywords =
	"document redaction, AI security, enterprise compliance, data protection, GDPR, HIPAA, document processing";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
>
	<main class="overflow-hidden">
		<!-- Hero Section - Immediate Impact -->
		<Hero />

		<!-- Social Proof - Press & Recognition -->
		<section class="py-12 md:py-16">
			<PressCarousel
				title="Trusted by Industry Leaders"
				subtitle="Featured in leading technology publications"
			/>
		</section>

		<!-- Impact Metrics - Quick Wins -->
		<section class="bg-white dark:bg-black py-16 md:py-24">
			<Stats
				title="Proven Results at Scale"
				backgroundColor="white"
				stats={[
					{
						value: "99.9%",
						label: "Redaction Accuracy",
						description: "AI-powered precision"
					},
					{
						value: "10M+",
						label: "Documents Secured",
						description: "Every month"
					},
					{
						value: "500+",
						label: "Enterprise Clients",
						description: "Across 50+ countries"
					},
					{
						value: "<1min",
						label: "Average Processing",
						description: "Lightning fast"
					}
				]}
			/>
		</section>

		<!-- Features Section - Core Value Props -->
		<section class="bg-gradient-to-b from-white to-neutral-50 dark:from-black dark:to-neutral-950 py-16 md:py-24">
			<Features category="general" featured={true} />
		</section>

		<!-- Workflow Section - How It Works -->
		<section class="bg-white dark:bg-black py-16 md:py-24">
			<Workflow backgroundColor="white" />
		</section>

		<!-- Security & Compliance - Build Trust Early -->
		<section class="bg-neutral-50 dark:bg-neutral-950 py-16 md:py-24">
			<Security backgroundColor="gray" />
		</section>

		<!-- Use Cases Section - Real-World Applications -->
		<section class="bg-white dark:bg-black py-16 md:py-24">
			<UseCases />
		</section>

		<!-- Testimonials Section - Customer Stories -->
		<section class="bg-neutral-50 dark:bg-neutral-950 py-16 md:py-24">
			<Testimonials backgroundColor="white" />
		</section>

		<!-- Integrations Section - Easy Integration -->
		<section class="bg-white dark:bg-black py-16 md:py-24">
			<Integrations backgroundColor="white" />
		</section>

		<!-- FAQ Section - Answer Objections -->
		<section class="bg-neutral-50 dark:bg-neutral-950 py-16 md:py-24">
			<FAQ
				title="Common Questions"
				description="Everything you need to know to get started with confidence"
				backgroundColor="gray"
				category="general"
				featured={true}
			/>
		</section>

		<!-- Final CTA - Strong Close -->
		<section class="py-16 md:py-24">
			<CTA
				title="Start Securing Your Documents Today"
				description="Join 500+ enterprises protecting sensitive information with AI-powered redaction. No credit card required."
				background="gradient"
				buttons={[
					{
						text: "Start Free Trial",
						href: "/dashboard",
						variant: "primary"
					},
					{
						text: "Schedule Demo",
						href: "/contact",
						variant: "secondary"
					}
				]}
			/>
		</section>
	</main>
</Layout>

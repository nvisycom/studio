---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
} from "@/components";
import { Shield, Check, FileText } from "lucide-vue-next";
---

<Layout
  title="Government Solutions"
  description="Document redaction for government agencies and public sector organizations. GDPR & CCPA compliant with SOC II certification in progress. Protect sensitive citizen data and classified information."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Government Document Security"
      description="Protect sensitive citizen data and classified information with compliant document redaction. Built for federal agencies, state governments, and public sector organizations that need reliable data protection while meeting transparency and security requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Government Agencies"
      subtitle="Federal, state, and local government agencies trust Nvisy to protect sensitive citizen data"
    />

    <!-- Case Studies -->
    <CaseStudies />

    <Security
      title="Enterprise-Grade Document Security"
      description="Built with compliance and security at the core. Our platform meets the rigorous standards required by government agencies."
    />

    <UseCases
      title="Government Use Cases"
      description="Government agencies across federal, state, and local levels use our platform to protect sensitive information while maintaining transparency and operational efficiency."
      category="government"
    />

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Government Agencies"
      description="See how government organizations are protecting sensitive citizen data with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Government FAQs"
      description="Common questions about document redaction for government agencies"
      category="general"
      featured={true}
    />

    <!-- CTA -->
    <CTA
      title="Ready to Secure Your Government Documents?"
      description="Whether you're a local agency or federal department, we have solutions tailored for your security and transparency needs. Special government pricing and on-premise deployment available."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

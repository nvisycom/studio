---
import { Layout } from "@/layouts";
import { Hero, Features, CTA, CompanyStats } from "@/sections";
import {
	ShieldCheck,
	Users,
	Eye,
	Check,
	Building,
	FileText,
	BarChart3,
	Lock,
	Scale,
	Clipboard,
} from "lucide-vue-next";
---

<Layout title="Government Solutions" description="Document redaction solutions for government agencies. Security-focused features to help protect classified and sensitive government data with comprehensive audit capabilities.">
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Government Document Protection"
      description="Protect classified and sensitive government data with AI-powered redaction designed for public sector workflows. Security-focused features to help maintain data protection standards and audit requirements."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Request Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
      stats={[
        {
          value: "Security",
          label: "Focused"
        },
        {
          value: "Audit",
          label: "Ready"
        },
        {
          value: "Classified",
          label: "Data Support"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- Government-Specific Features -->
    <Features
      title="Built for Government Workflows"
      description="Document redaction features designed specifically to help government agencies protect sensitive information while maintaining transparency and supporting audit requirements."
      features={[
        {
          title: "Classified Data Handling",
          description: "Automatically identify and redact classified information, personal identifiers, and sensitive government data across multiple security levels.",
          icon: "shield-check"
        },
        {
          title: "Security-First Design",
          description: "Built with government security requirements in mind, including comprehensive access controls and secure data handling practices.",
          icon: "lock"
        },
        {
          title: "FOIA Request Support",
          description: "Streamline Freedom of Information Act requests by quickly redacting sensitive information while preserving transparency.",
          icon: "eye"
        },
        {
          title: "Comprehensive Audit Trails",
          description: "Detailed logging of all redaction activities to support compliance audits and regulatory oversight requirements.",
          icon: "clipboard-check"
        },
        {
          title: "Multi-Level Security",
          description: "Handle documents across different classification levels with appropriate security controls and access restrictions.",
          icon: "layers"
        },
        {
          title: "Government Integration",
          description: "Integrate securely with existing government systems through encrypted APIs and secure data transmission protocols.",
          icon: "link"
        }
      ]}
    />

    <!-- Government Use Cases -->
    <div class="bg-gray-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Common Government Use Cases
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
              See how government agencies use Nvisy to protect sensitive information
              across various administrative and operational workflows.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- FOIA Requests -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Eye class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">FOIA Requests</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Process Freedom of Information Act requests efficiently by redacting sensitive information while maintaining transparency.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Personal identifiers</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Law enforcement exemptions</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Security-sensitive information</span>
                </li>
              </ul>
            </div>

            <!-- Classified Documents -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Lock class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Classified Documents</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Handle classified and sensitive documents across different security levels with appropriate redaction controls.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Multi-level classification</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Security clearance controls</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Compartmented information</span>
                </li>
              </ul>
            </div>

            <!-- Legal Proceedings -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Scale class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Legal Proceedings</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Prepare government documents for legal proceedings and court cases while protecting sensitive information.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Court filings</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Discovery documents</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Evidence preparation</span>
                </li>
              </ul>
            </div>

            <!-- Public Records -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <FileText class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Public Records</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Manage public records releases by redacting personal information while maintaining public access to information.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Meeting minutes</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Budget documents</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Administrative records</span>
                </li>
              </ul>
            </div>

            <!-- Compliance Reporting -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <BarChart3 class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Compliance & Oversight</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Support regulatory compliance and oversight activities by preparing redacted documents for review and audit.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Audit preparations</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Regulatory reports</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Oversight documentation</span>
                </li>
              </ul>
            </div>

            <!-- Inter-Agency Sharing -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Building class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Inter-Agency Sharing</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Facilitate secure information sharing between government agencies while protecting sensitive data and maintaining security protocols.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Cross-agency reports</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Intelligence sharing</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Collaborative investigations</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Benefits -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Government Implementation Benefits
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Real benefits that government agencies experience when implementing
            our document redaction platform for sensitive data protection.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <ShieldCheck class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Enhanced Security</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Consistent, automated protection of classified and sensitive government information across all document types.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <Users class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Improved Transparency</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Faster processing of FOIA requests and public records while maintaining appropriate security protections.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <Clipboard class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Audit Readiness</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Comprehensive audit trails and logging capabilities support regulatory oversight and compliance requirements.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Security Features -->
    <div class="bg-gray-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Government-Grade Security
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Built with government security requirements in mind, including data protection
              and audit capabilities for sensitive government information.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Security Controls</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Multi-level security handling</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Access control enforcement</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Secure data transmission</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Encryption at rest and transit</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Audit Capabilities</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Comprehensive audit logs</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Activity tracking</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Data lineage documentation</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Compliance reporting</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Government Features</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Classification handling</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">FOIA request support</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Inter-agency integration</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Flexible deployment options</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <CTA
      title="Ready to Protect Government Data?"
      description="Join government agencies using Nvisy to safely redact and anonymize sensitive documents while maintaining transparency and audit requirements."
      buttons={[
        {
          text: "Schedule Government Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Government Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
} from "@/components";
---

<Layout
  title="Financial Services"
  description="Document redaction for financial institutions. GDPR & CCPA compliant with PCI-DSS considerations. Protect customer PII, transaction data, and sensitive financial information."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Financial Document Security"
      description="Protect customer PII and sensitive financial data with compliant document redaction. Built for banks, credit unions, fintech companies, and financial institutions that need reliable data protection while meeting regulatory requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Financial Institutions"
      subtitle="Banks, credit unions, and fintech companies trust Nvisy to protect sensitive financial data"
    />

    <!-- Case Studies -->
    <CaseStudies />

    <Security
      title="Enterprise-Grade Document Security"
      description="Built with compliance and security at the core. Our platform meets the rigorous standards required by financial institutions."
    />

    <UseCases
      title="Financial Services Use Cases"
      description="Financial institutions across different segments use our platform to protect sensitive data while maintaining operational efficiency."
      category="financial"
    />

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Financial Institutions"
      description="See how banks, credit unions, and fintech companies are protecting sensitive financial data with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Financial Services FAQs"
      description="Common questions about document redaction for financial institutions"
      category="general"
      featured={true}
    />

    <!-- CTA -->
    <CTA
      title="Ready to Secure Your Financial Documents?"
      description="Whether you're a fintech startup or a large financial institution, we have solutions tailored for your compliance and security needs. Special pricing available for qualifying organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
} from "@/components";
---

<Layout
  title="Financial Services"
  description="Document intelligence for financial institutions. Extract data, automate workflows, and ensure GDPR, CCPA & PCI-DSS compliance for customer documents and financial records."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Financial Document Intelligence"
      description="Transform financial documents into structured, actionable data. Built for banks, credit unions, fintech companies, and financial institutions that need to extract insights while meeting regulatory requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Financial Institutions"
      subtitle="Banks, credit unions, and fintech companies trust Nvisy to transform their document workflows"
    />

    <!-- Case Studies -->
    <CaseStudies />

    <Security
      title="Enterprise-Grade Document Security"
      description="Built with compliance and security at the core. Our platform meets the rigorous standards required by financial institutions."
    />

    <UseCases
      title="Financial Services Use Cases"
      description="Financial institutions across different segments use our platform to protect sensitive data while maintaining operational efficiency."
      category="financial"
    />

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Financial Institutions"
      description="See how banks, credit unions, and fintech companies are transforming their document workflows with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Financial Services FAQs"
      description="Common questions about document redaction for financial institutions"
      category="general"
      featured={true}
    />

    <!-- CTA -->
    <CTA
      title="Ready to Transform Your Financial Documents?"
      description="Whether you're a fintech startup or a large financial institution, we have solutions tailored for your data and compliance needs. Special pricing available for qualifying organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

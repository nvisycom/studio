---
import { Layout } from "@/layouts";
import { Hero, CTA, CompanyStats } from "@/components";
import {
	DollarSign,
	Shield,
	Check,
	Building,
	Lock,
	FileText,
	Users,
	Zap,
	Globe,
	Code,
	AlertCircle,
	BarChart3,
} from "lucide-vue-next";
---

<Layout
  title="Financial Services Solutions"
  description="Document redaction for financial institutions. GDPR & CCPA compliant with PCI-DSS considerations. Protect customer PII, transaction data, and sensitive financial information."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Financial Document Security"
      description="Protect customer PII and sensitive financial data with compliant document redaction. Built for banks, credit unions, fintech companies, and financial institutions that need reliable data protection while meeting regulatory requirements."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      stats={[
        {
          value: "GDPR/CCPA",
          label: "Compliant"
        },
        {
          value: "PCI-DSS",
          label: "Considerations"
        },
        {
          value: "SOC II",
          label: "In Progress"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- Key Challenges -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Financial Services Challenges
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Financial institutions handle some of the most sensitive personal and financial data,
            requiring robust protection while maintaining operational efficiency and regulatory compliance.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <Shield class="w-12 h-12 text-red-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Customer PII Protection</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Protect Social Security numbers, account details, addresses, and personal financial information
              across all document types and communications.
            </p>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <AlertCircle class="w-12 h-12 text-orange-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Regulatory Compliance</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Meet GDPR, CCPA, PCI-DSS, and SOX requirements while maintaining comprehensive
              audit trails for regulatory examinations.
            </p>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <BarChart3 class="w-12 h-12 text-blue-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Operational Efficiency</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Automate manual redaction processes for loan applications, account statements,
              and regulatory filings while maintaining accuracy.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Solutions -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Comprehensive Financial Data Protection
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Our document redaction platform addresses the specific needs of financial institutions
              with compliance-ready features and enterprise-grade security.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-6">
                <FileText class="w-6 h-6 text-blue-700 dark:text-blue-300" />
              </div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Document Processing</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Automated redaction for loan applications, account statements, credit reports,
                and regulatory filings with high accuracy detection.
              </p>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Account numbers and routing numbers</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Social Security numbers</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Credit card information</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Personal identifiable information</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-6">
                <Shield class="w-6 h-6 text-green-700 dark:text-green-300" />
              </div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Compliance & Security</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Built with financial services compliance requirements in mind,
                including comprehensive audit trails and data protection controls.
              </p>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">GDPR & CCPA compliant</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">PCI-DSS considerations</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">SOX audit trail support</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">End-to-end encryption</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Use Cases -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Common Use Cases
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Financial institutions across different segments use our platform
            to protect sensitive data while maintaining operational efficiency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Loan Processing</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Automatically redact sensitive information in loan applications, income statements,
              and supporting documentation for regulatory compliance.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Banks, Credit Unions, Mortgage Lenders
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">KYC & AML</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Protect customer identity documents and transaction records while maintaining
              necessary information for Know Your Customer and Anti-Money Laundering processes.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Investment Firms, Payment Processors
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Regulatory Reporting</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Prepare customer data and transaction reports for regulatory bodies
              while protecting individual privacy and sensitive information.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              All Financial Institutions
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Customer Communications</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Redact account statements, transaction histories, and correspondence
              for customer service, dispute resolution, or third-party sharing.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Retail Banks, Credit Card Companies
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Fintech Integration</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              API-first approach allows fintech applications to integrate document redaction
              directly into their platforms for user data protection.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Fintech Startups, Neobanks
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Internal Audits</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Prepare documentation for internal compliance reviews and external audits
              while protecting sensitive customer and transaction data.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Large Banks, Insurance Companies
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Options -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Flexible Implementation Options
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Choose the deployment model that best fits your institution's security requirements,
              regulatory needs, and operational constraints.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Globe class="w-8 h-8 text-blue-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Cloud API</h3>
                  <p class="text-sm text-neutral-500">For fintech and smaller institutions</p>
                </div>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Quick integration with REST API</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">TypeScript and Python SDKs</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">GDPR & CCPA compliant infrastructure</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Pay-as-you-scale pricing</span>
                </li>
              </ul>
              <a
                href="https://docs.nvisy.com"
                class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium transition-colors"
              >
                View API Documentation →
              </a>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Building class="w-8 h-8 text-purple-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">On-Premise Deployment</h3>
                  <p class="text-sm text-neutral-500">For large banks and enterprises</p>
                </div>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Complete data control and residency</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Source code access for security reviews</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Custom integration support</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Special enterprise pricing</span>
                </li>
              </ul>
              <a
                href="/contact"
                class="inline-flex items-center text-purple-600 hover:text-purple-700 font-medium transition-colors"
              >
                Contact Enterprise Sales →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Compliance Status -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Compliance & Certification Status
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            We're committed to meeting the highest security and compliance standards
            required by financial institutions.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
                <Check class="w-5 h-5 text-green-600" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Current Compliance</h3>
                <p class="text-sm text-neutral-500">Operational and certified</p>
              </div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">GDPR Compliant</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">CCPA Compliant</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">End-to-end encryption</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">Comprehensive audit trails</span>
              </li>
            </ul>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center">
                <Zap class="w-5 h-5 text-orange-600" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white">In Progress</h3>
                <p class="text-sm text-neutral-500">Active certification processes</p>
              </div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                  <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                </div>
                <span class="text-neutral-700 dark:text-neutral-300">SOC II Type 2 Certification</span>
              </li>
              <li class="flex items-center gap-3">
                <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                  <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                </div>
                <span class="text-neutral-700 dark:text-neutral-300">HIPAA Certification</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">PCI-DSS considerations built-in</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">SOX audit trail support</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- About -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-8">
            Built by a Focused Team
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-8">
            Nvisy is a dedicated 2-4 person startup focused exclusively on document redaction and data anonymization.
            We understand the unique challenges financial institutions face because we're building solutions
            specifically designed for regulated industries.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">100%</div>
              <div class="text-neutral-600 dark:text-neutral-400">Focus on Data Security</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">Direct</div>
              <div class="text-neutral-600 dark:text-neutral-400">Founder Communication</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">Rapid</div>
              <div class="text-neutral-600 dark:text-neutral-400">Feature Development</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <CTA
      title="Ready to Secure Your Financial Documents?"
      description="Whether you're a fintech startup or a large financial institution, we have solutions tailored for your compliance and security needs. Special pricing available for qualifying organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

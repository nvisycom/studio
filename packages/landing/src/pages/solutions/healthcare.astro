---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
} from "@/components";
---

<Layout
  title="Healthcare Solutions"
  description="Document redaction for healthcare organizations. GDPR & CCPA compliant with HIPAA certification in progress. Protect PHI, patient records, and sensitive medical information."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Healthcare Document Security"
      description="Protect PHI and sensitive medical information with compliant document redaction. Built for hospitals, clinics, health systems, and healthcare organizations that need reliable patient data protection while meeting regulatory requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Healthcare Organizations"
      subtitle="Hospitals, clinics, and health systems trust Nvisy to protect patient health information"
    />

    <!-- Case Studies -->
    <CaseStudies />

    <Security
      title="Enterprise-Grade Document Security"
      description="Built with compliance and security at the core. Our platform meets the rigorous standards required by healthcare organizations."
    />

    <!-- Use Cases -->
    <UseCases
      title="Healthcare Use Cases"
      description="Healthcare organizations across different settings use our platform to protect patient information while maintaining care quality and research capabilities."
      category="healthcare"
    />

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Healthcare Organizations"
      description="See how hospitals, clinics, and health systems are protecting patient health information with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Healthcare FAQs"
      description="Common questions about HIPAA-compliant document redaction for healthcare"
      category="general"
      featured={true}
    />

    <!-- CTA -->
    <CTA
      title="Ready to Secure Your Patient Data?"
      description="Whether you're a small practice or a large health system, we have solutions tailored for your HIPAA compliance and patient privacy needs. Special pricing available for qualifying healthcare organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

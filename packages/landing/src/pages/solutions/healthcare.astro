---
import { Layout } from "@/layouts";
import { Hero, CTA, CompanyStats } from "@/components";
import {
	Shield,
	Check,
	Building,
	FileText,
	Zap,
	Globe,
	AlertCircle,
	Stethoscope,
	User,
} from "lucide-vue-next";
---

<Layout
  title="Healthcare Solutions"
  description="Document redaction for healthcare organizations. GDPR & CCPA compliant with HIPAA certification in progress. Protect PHI, patient records, and sensitive medical information."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Healthcare Document Security"
      description="Protect PHI and sensitive medical information with compliant document redaction. Built for hospitals, clinics, health systems, and healthcare organizations that need reliable patient data protection while meeting regulatory requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- Key Challenges -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Healthcare Data Protection Challenges
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Healthcare organizations handle the most sensitive personal health information,
            requiring stringent protection while maintaining care quality and operational efficiency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <User class="w-12 h-12 text-red-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">PHI Protection</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Protect patient names, addresses, Social Security numbers, medical record numbers,
              and other protected health information across all clinical documentation.
            </p>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <AlertCircle class="w-12 h-12 text-orange-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">HIPAA Compliance</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Meet HIPAA Privacy Rule requirements while maintaining comprehensive
              audit trails for compliance officers and regulatory examinations.
            </p>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <Stethoscope class="w-12 h-12 text-blue-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Clinical Workflow</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Automate redaction in clinical notes, discharge summaries, and research documentation
              while preserving medical context and care continuity.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Solutions -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Comprehensive Healthcare Data Protection
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Our document redaction platform addresses the specific needs of healthcare organizations
              with HIPAA-focused features and enterprise-grade security for patient data protection.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-6">
                <FileText class="w-6 h-6 text-blue-700 dark:text-blue-300" />
              </div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Medical Document Processing</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Automated redaction for patient records, clinical notes, lab results,
                and research documentation with high accuracy PHI detection.
              </p>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Patient names and identifiers</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Medical record numbers</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Social Security numbers</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Dates of birth and addresses</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-6">
                <Shield class="w-6 h-6 text-green-700 dark:text-green-300" />
              </div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Compliance & Security</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Built with healthcare compliance requirements in mind,
                including comprehensive audit trails and patient data protection controls.
              </p>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">GDPR & CCPA compliant</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                    <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                  </div>
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">HIPAA certification in progress</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Business Associate Agreement ready</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">End-to-end encryption</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Use Cases -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Healthcare Use Cases
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Healthcare organizations across different settings use our platform
            to protect patient information while maintaining care quality and research capabilities.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Clinical Documentation</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Redact PHI from clinical notes, discharge summaries, and care plans
              for quality improvement, training, or case studies while preserving medical context.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Hospitals, Clinics, Health Systems
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Medical Research</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Prepare patient data for research studies, clinical trials, and publications
              while maintaining HIPAA compliance and patient anonymity.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Research Institutions, Academic Medical Centers
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Insurance & Billing</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Protect patient information in insurance claims, prior authorization requests,
              and billing documentation while maintaining necessary medical details.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Healthcare Billing Companies, Payers
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Patient Portals</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Automatically redact sensitive information when sharing medical records
              with patients, family members, or authorized representatives through patient portals.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Healthcare IT Vendors, EMR Systems
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Legal & Compliance</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Prepare medical records for legal proceedings, malpractice cases,
              or regulatory investigations while protecting uninvolved patient information.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Legal Departments, Risk Management
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Quality Improvement</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Create de-identified datasets for quality improvement initiatives,
              outcome analysis, and population health studies.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Quality Departments, Public Health Organizations
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Options -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Flexible Implementation Options
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Choose the deployment model that best fits your organization's HIPAA compliance requirements,
              security policies, and technical infrastructure.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Globe class="w-8 h-8 text-blue-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Cloud API</h3>
                  <p class="text-sm text-neutral-500">For smaller practices and health tech companies</p>
                </div>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Quick integration with REST API</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">TypeScript and Python SDKs</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">GDPR & CCPA compliant infrastructure</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                    <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                  </div>
                  <span class="text-neutral-700 dark:text-neutral-300">HIPAA certification in progress</span>
                </li>
              </ul>
              <a
                href="https://docs.nvisy.com"
                class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium transition-colors"
              >
                View API Documentation →
              </a>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Building class="w-8 h-8 text-purple-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">On-Premise Deployment</h3>
                  <p class="text-sm text-neutral-500">For health systems and large healthcare organizations</p>
                </div>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Complete PHI data control and residency</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Source code access for security reviews</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Custom EMR/EHR integration support</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Special enterprise pricing</span>
                </li>
              </ul>
              <a
                href="/contact"
                class="inline-flex items-center text-purple-600 hover:text-purple-700 font-medium transition-colors"
              >
                Contact Enterprise Sales →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Compliance Status -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Healthcare Compliance & Security
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            We're committed to meeting the highest security and compliance standards
            required by healthcare organizations and HIPAA regulations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
                <Check class="w-5 h-5 text-green-600" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Current Compliance</h3>
                <p class="text-sm text-neutral-500">Operational and certified</p>
              </div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">GDPR Compliant</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">CCPA Compliant</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">End-to-end encryption</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">Comprehensive audit trails</span>
              </li>
            </ul>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center">
                <Zap class="w-5 h-5 text-orange-600" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white">In Progress</h3>
                <p class="text-sm text-neutral-500">Active certification processes</p>
              </div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                  <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                </div>
                <span class="text-neutral-700 dark:text-neutral-300">HIPAA Certification</span>
              </li>
              <li class="flex items-center gap-3">
                <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                  <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                </div>
                <span class="text-neutral-700 dark:text-neutral-300">SOC II Type 2 Certification</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">Business Associate Agreement ready</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">Role-based access control</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- About -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-8">
            Built by a Focused Team
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-8">
            Nvisy is a dedicated 2-4 person startup focused exclusively on document redaction and data anonymization.
            We understand the critical importance of patient privacy and are building solutions
            specifically designed for healthcare compliance requirements.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">100%</div>
              <div class="text-neutral-600 dark:text-neutral-400">Focus on Data Security</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">Direct</div>
              <div class="text-neutral-600 dark:text-neutral-400">Founder Communication</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">Rapid</div>
              <div class="text-neutral-600 dark:text-neutral-400">Feature Development</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <CTA
      title="Ready to Secure Your Patient Data?"
      description="Whether you're a small practice or a large health system, we have solutions tailored for your HIPAA compliance and patient privacy needs. Special pricing available for qualifying healthcare organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import { Hero, Features, CTA, CompanyStats } from "@/sections";
import {
	ShieldCheck,
	FileText,
	BarChart3,
	FlaskConical,
	Building2,
	Microscope,
	Shield,
	Check,
	Heart,
} from "lucide-vue-next";
---

<Layout title="Healthcare Solutions" description="Document redaction solutions for healthcare organizations. HIPAA-focused features to help protect PHI while maintaining clinical workflow efficiency.">
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Healthcare Document Protection"
      description="Safeguard patient health information with AI-powered redaction designed for healthcare workflows. HIPAA-focused features to help maintain compliance while improving clinical documentation efficiency."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Request Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
      stats={[
        {
          value: "HIPAA",
          label: "Focused"
        },
        {
          value: "PHI",
          label: "Detection"
        },
        {
          value: "Secure",
          label: "Processing"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- Healthcare-Specific Features -->
    <Features
      title="Built for Healthcare Workflows"
      description="Document redaction features designed specifically to help healthcare organizations protect patient information while maintaining operational efficiency."
      category="healthcare"
    />

    <!-- Healthcare Use Cases -->
    <div class="bg-gray-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Common Healthcare Use Cases
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
              See how healthcare organizations use Nvisy to protect patient information
              across various clinical and administrative workflows.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Medical Records -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <FileText class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Medical Records</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Redact patient identifiers from electronic health records for research, quality improvement, or data sharing initiatives.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Patient names and addresses</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Medical record numbers</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Social security numbers</span>
                </li>
              </ul>
            </div>

            <!-- Research Documents -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Microscope class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Research Documents</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Prepare clinical data for research studies by removing identifying information while preserving research value.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Clinical trial data</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Patient case studies</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Research publications</span>
                </li>
              </ul>
            </div>

            <!-- Insurance Claims -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Shield class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Insurance & Claims</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Process insurance documentation and claims while protecting patient privacy and sensitive health information.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Claims processing</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Prior authorizations</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Appeals documentation</span>
                </li>
              </ul>
            </div>

            <!-- Quality Improvement -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <BarChart3 class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Quality Improvement</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Support quality improvement initiatives by preparing de-identified data for analysis and reporting.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Outcome analysis</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Performance metrics</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Compliance reporting</span>
                </li>
              </ul>
            </div>

            <!-- Lab Reports -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <FlaskConical class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Laboratory Reports</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Process laboratory results and pathology reports while maintaining clinical relevance and removing patient identifiers.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Lab test results</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Pathology reports</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Imaging reports</span>
                </li>
              </ul>
            </div>

            <!-- Legal & Compliance -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Building2 class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Legal & Compliance</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Prepare medical documents for legal proceedings, compliance audits, and regulatory submissions.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Legal discovery</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Regulatory submissions</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Compliance audits</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Benefits -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Healthcare Implementation Benefits
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Real benefits that healthcare organizations experience when implementing
            our document redaction platform.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <Heart class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Improved Patient Privacy</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Enhanced protection of patient health information through consistent, automated redaction processes.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <BarChart3 class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Operational Efficiency</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Significantly reduce manual document review time while maintaining high accuracy in PHI removal.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <ShieldCheck class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Compliance Support</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Built-in features that help support HIPAA compliance requirements and regulatory audit preparation.
            </p>
          </div>
        </div>
      </div>
    </div>

    <CTA
      title="Ready to Protect Patient Information?"
      description="Join healthcare organizations using Nvisy to safely redact and anonymize medical documents while maintaining clinical workflow efficiency."
      buttons={[
        {
          text: "Schedule Healthcare Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Healthcare Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

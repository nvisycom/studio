---
import { Layout } from "@/layouts";
import { Hero, CTA, SocialProof, Testimonials, FAQ, OpenSource } from "@/components";
import Connect from "@/components/sections/Connect.astro";
import SDKExamples from "@/components/sections/SDKExamples.astro";
import {
	Code,
	Zap,
	DollarSign,
	Shield,
	Book,
	Check,
	Globe,
	Rocket,
	Heart,
	Lock,
} from "lucide-vue-next";
import GithubIcon from "@/assets/icons/github.svg?raw";
---

<Layout
  title="Startup"
  description="Document redaction API built for startups. Easy integration, open source core services, TypeScript and Python SDKs. Free to start with special startup pricing."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Document Redaction API for Startups"
      description="Focus on building your product while we handle document security. Easy-to-use APIs, comprehensive SDKs, and open source core services. Built by founders, for founders."
      background="gradient"
      buttons={[
        {
          text: "Start Free",
          href: "/pricing",
          variant: "primary"
        },
        {
          text: "View API Docs",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Startups Worldwide"
      subtitle="Fast-growing startups trust Nvisy to protect their users' sensitive data"
      backgroundColor="white"
    />

    <!-- Documentation & Resources -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-light text-neutral-900 dark:text-white mb-6">
              Comprehensive Documentation
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Everything you need to integrate document redaction into your application,
              from quick start guides to advanced customization options.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Book class="w-8 h-8 text-blue-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Full Documentation</h3>
                  <p class="text-sm text-neutral-500">Complete guides and examples</p>
                </div>
              </div>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Comprehensive documentation with tutorials, best practices, and real-world examples
                to get you up and running quickly.
              </p>
              <a
                href="https://docs.nvisy.com"
                class="inline-flex items-center gap-2 text-black dark:text-white font-medium hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors"
              >
                Browse Documentation →
              </a>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Globe class="w-8 h-8 text-green-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">API Reference</h3>
                  <p class="text-sm text-neutral-500">Interactive API documentation</p>
                </div>
              </div>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Interactive API reference with live examples, request/response schemas,
                and detailed endpoint documentation.
              </p>
              <a
                href="https://docs.nvisy.com/api-reference"
                class="inline-flex items-center gap-2 text-black dark:text-white font-medium hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors"
              >
                View API Reference →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Open Source -->
    <OpenSource
      title="Built on Open Source"
      description="Our core services and SDKs are open source. Contribute, validate our security approach, and build with confidence."
      backgroundColor="white"
    />

    <!-- Connect/Integration -->
    <Connect
      title="Integrate in Minutes"
      description="Simple APIs and comprehensive SDKs make it easy to add document redaction to your product. Ship faster with ready-to-use tools."
      backgroundColor="white"
    />

    <!-- SDK Examples -->
    <SDKExamples
      title="Simple, Powerful SDKs"
      description="Get started in minutes with our easy-to-use SDKs. Built for developers, by developers."
      backgroundColor="gray"
    />

    <!-- Testimonials -->
    <Testimonials
      backgroundColor="white"
      title="Trusted by Startups"
      description="See how startups are building secure products faster with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Startup FAQs"
      description="Common questions about document redaction for startups"
      backgroundColor="white"
      category="general"
      featured={true}
    />

    <CTA
      title="Ready to Ship Faster with Secure Document Redaction?"
      description="Join the growing number of startups using Nvisy to protect sensitive documents while focusing on what matters most - building great products. Special pricing available for new startups."
      buttons={[
        {
          text: "Start Free Trial",
          href: "/pricing",
          variant: "primary"
        },
        {
          text: "Talk to Founders",
          href: "/contact",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

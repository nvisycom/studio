---
import Layout from "@/layouts/Layout.astro";
import { CTA, Features } from "@/sections";
---

<Layout title="Enterprise Solutions" description="Enterprise-grade document redaction solutions with advanced security, compliance, and dedicated support for large organizations.">
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-gray-50 via-white to-gray-100 dark:from-gray-900 dark:via-black dark:to-gray-800">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            Enterprise Document Security
          </h1>

          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 leading-relaxed mb-12 max-w-3xl mx-auto">
            Protect sensitive information across your organization with enterprise-grade document redaction.
            Advanced security, compliance, and dedicated support built for scale.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
            <a href="/contact" class="inline-flex items-center justify-center bg-gray-900 dark:bg-white text-white dark:text-black font-medium py-4 px-8 rounded-lg hover:bg-gray-700 dark:hover:bg-gray-100 transition-colors text-lg">
              Request Demo
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/pricing" class="inline-flex items-center justify-center border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium py-4 px-8 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors text-lg">
              View Pricing
            </a>
          </div>

          <!-- Enterprise Stats -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-2xl mx-auto">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">99.99%</div>
              <div class="text-gray-600 dark:text-gray-400">Uptime SLA</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">SOC 2</div>
              <div class="text-gray-600 dark:text-gray-400">Type II Certified</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">24/7</div>
              <div class="text-gray-600 dark:text-gray-400">Dedicated Support</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Features -->
    <Features
      title="Built for Enterprise Requirements"
      description="Everything your organization needs to implement document redaction at scale, with the security and compliance standards that enterprise demands."
      features={[
        {
          title: "Advanced Security",
          description: "Zero-trust architecture with end-to-end encryption, role-based access controls, and comprehensive audit logging for maximum data protection.",
          icon: "lock"
        },
        {
          title: "Compliance & Governance",
          description: "Meet regulatory requirements with built-in compliance frameworks and automated governance controls for GDPR, HIPAA, and more.",
          icon: "shield"
        },
        {
          title: "Enterprise Integration",
          description: "Seamlessly integrate with existing enterprise systems and workflows through robust APIs, SSO, and directory integration.",
          icon: "link"
        },
        {
          title: "Scalable Performance",
          description: "Handle enterprise-scale document processing with automatic scaling, load balancing, and high-availability architecture.",
          icon: "zap"
        },
        {
          title: "Dedicated Support",
          description: "Get the support your enterprise needs with dedicated account management, priority assistance, and professional services.",
          icon: "users"
        },
        {
          title: "Custom Deployment",
          description: "Deploy on your terms with flexible options including cloud, hybrid, or on-premises installations to meet specific requirements.",
          icon: "server"
        }
      ]}
    />

    <!-- Implementation Process -->
    <div class="bg-gray-50 dark:bg-gray-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Enterprise Implementation Process
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
              Our proven implementation methodology ensures successful deployment
              with minimal disruption to your existing workflows.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="text-center">
              <div class="w-16 h-16 bg-gray-900 dark:bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-white dark:text-black font-bold text-xl">1</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Assessment</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Comprehensive security and requirements assessment with your team.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-gray-900 dark:bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-white dark:text-black font-bold text-xl">2</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Planning</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Custom deployment plan and architecture design for your environment.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-gray-900 dark:bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-white dark:text-black font-bold text-xl">3</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Deployment</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Staged rollout with testing, validation, and team training.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-gray-900 dark:bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-white dark:text-black font-bold text-xl">4</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Support</h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Ongoing optimization, monitoring, and dedicated support.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enterprise Benefits -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Why Enterprise Leaders Choose Nvisy
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Proven results that drive business value and operational efficiency
            at enterprise scale.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
            <div class="text-4xl font-bold text-gray-900 dark:text-white mb-2">95%</div>
            <div class="text-gray-600 dark:text-gray-400 mb-4 font-medium">Faster Processing</div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              Automate manual redaction processes and reduce document review time by up to 95%.
            </p>
          </div>

          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
            <div class="text-4xl font-bold text-gray-900 dark:text-white mb-2">99.9%</div>
            <div class="text-gray-600 dark:text-gray-400 mb-4 font-medium">Accuracy Rate</div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              Industry-leading AI ensures consistent, reliable redaction across all document types.
            </p>
          </div>

          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
            <div class="text-4xl font-bold text-gray-900 dark:text-white mb-2">80%</div>
            <div class="text-gray-600 dark:text-gray-400 mb-4 font-medium">Cost Reduction</div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              Reduce operational costs through automation and improved efficiency.
            </p>
          </div>

          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-8 text-center">
            <div class="text-4xl font-bold text-gray-900 dark:text-white mb-2">24/7</div>
            <div class="text-gray-600 dark:text-gray-400 mb-4 font-medium">Enterprise Support</div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              Dedicated support team ensures maximum uptime and quick issue resolution.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Security & Compliance -->
    <div class="bg-gray-50 dark:bg-gray-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Enterprise-Grade Security
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
              Built to meet the most stringent security and compliance requirements
              of large organizations.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-gray-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Security Controls</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">AES-256 encryption</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Multi-factor authentication</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Zero-trust architecture</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Comprehensive audit trails</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-gray-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Compliance Standards</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">SOC 2 Type II certified</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">ISO 27001 compliant</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">GDPR & CCPA ready</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Data residency controls</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-gray-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Enterprise Features</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">SSO & LDAP integration</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Role-based access control</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Custom deployment options</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">Dedicated account management</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <CTA />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Premium,
	ROICalculator,
} from "@/components";
import Connect from "@/components/sections/Connect.astro";
import SDKExamples from "@/components/sections/SDKExamples.astro";
---

<Layout
  title="Enterprise"
  description="Enterprise-grade document redaction and anonymization platform. GDPR & CCPA compliant with SOC II and HIPAA certification in progress. Special pricing and on-premise deployment available."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Enterprise Document Redaction"
      description="Secure, compliant document redaction at enterprise scale. GDPR & CCPA compliant platform with SOC II and HIPAA certifications in progress. Built for organizations that need reliable data protection with enterprise-grade security."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Enterprise Organizations"
      subtitle="Leading enterprises trust Nvisy for secure, compliant document redaction at scale"
    />

    <Premium/>

    <!-- Connect/Integration -->
    <Connect
      title="Enterprise Integration"
      description="Powerful APIs, comprehensive SDKs, and dedicated support for seamless integration into your enterprise infrastructure."
    />

    <!-- SDK Examples -->
    <SDKExamples
      title="Developer-Friendly SDKs"
      description="Enterprise-ready SDKs with comprehensive documentation, type safety, and dedicated support."
    />

    <!-- ROI Calculator -->
    <ROICalculator/>

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Enterprises"
      description="See how leading enterprises are securing their documents with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Enterprise FAQs"
      description="Common questions about enterprise document redaction and deployment"
      category="general"
      featured={true}
    />

    <CTA
      title="Ready for Enterprise-Grade Document Security?"
      description="Let's discuss your specific requirements, compliance needs, and how our platform can be tailored for your organization. Special enterprise pricing and on-premise deployment available."
      buttons={[
        {
          text: "Schedule Enterprise Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

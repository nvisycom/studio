---
import { Layout } from "@/layouts";
import { Hero, CompanyStats, Features, CTA } from "@/sections";
import {
	Heart,
	DollarSign,
	Scale,
	Building,
	ShieldCheck,
	ChevronRight,
	Check,
	Zap,
	Building2,
} from "lucide-vue-next";
---

<Layout
  title="Solutions"
  description="Document redaction and anonymization solutions tailored for your industry. Protect sensitive data with our growing platform."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Document Redaction Solutions"
      description="Protect sensitive information across industries with AI-powered document redaction and anonymization. Built for teams who need reliable data protection."
      background="gradient"
      fontSize="xl"
      padding="lg"
      buttons={[
        {
          text: "Get Started",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- By Industry Section -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Solutions by Industry
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Industry-focused redaction solutions designed to help protect sensitive data
            while meeting common regulatory requirements.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Healthcare -->
          <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <Heart class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Healthcare</h3>
            <p class="text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              HIPAA-focused redaction for medical records, patient data, and clinical documentation.
              Protect PHI while maintaining document utility.
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">HIPAA considerations</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">PHI detection</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Medical record processing</span>
              </li>
            </ul>
            <a href="/solutions/healthcare" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium transition-colors">
              Learn more
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>

          <!-- Financial Services -->
          <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <DollarSign class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Financial Services</h3>
            <p class="text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              Secure financial data processing with considerations for PCI-DSS and GDPR requirements.
              Protect customer PII and sensitive financial information.
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">PCI-DSS considerations</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">PII protection</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Transaction data security</span>
              </li>
            </ul>
            <a href="/solutions/financial" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium transition-colors">
              Learn more
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>

          <!-- Legal -->
          <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <Scale class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Legal</h3>
            <p class="text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              Protect attorney-client privilege and sensitive legal information.
              Help streamline discovery processes and maintain confidentiality.
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Privilege protection</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Discovery assistance</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Case file security</span>
              </li>
            </ul>
            <a href="/solutions/legal" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium transition-colors">
              Learn more
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>

          <!-- Government -->
          <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <Building class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Government</h3>
            <p class="text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              Document redaction solutions for government agencies. Protect classified and sensitive
              government data with security-focused features.
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Security-first design</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Audit trails</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Classified data handling</span>
              </li>
            </ul>
            <a href="/solutions/government" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium transition-colors">
              Learn more
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>

          <!-- Insurance -->
          <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <ShieldCheck class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Insurance</h3>
            <p class="text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              Protect policyholder information and claims data. Help streamline underwriting
              and claims processing while maintaining privacy standards.
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Claims processing</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Underwriting support</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-0.5 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300 text-sm">Policyholder data protection</span>
              </li>
            </ul>
            <a href="/solutions/insurance" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium transition-colors">
              Learn more
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- By Company Size Section -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Solutions by Company Size
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Whether you're a growing startup or an established enterprise, we have solutions
              that fit your organization's needs and scale.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
            <!-- Enterprise -->
            <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-10 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
              <div class="w-20 h-20 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                <Building2 class="w-10 h-10 text-white dark:text-black" />
              </div>
              <h3 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">Enterprise</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed text-lg">
                Comprehensive document redaction solutions built for large organizations.
                Advanced security features and dedicated support for enterprise-scale deployments.
              </p>
              <ul class="space-y-4 mb-8">
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Security-focused architecture</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">SSO and directory integration</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Dedicated support</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Custom deployment options</span>
                </li>
              </ul>
              <a href="/solutions/enterprise" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium text-lg transition-colors">
                Learn more about Enterprise
                <ChevronRight class="w-5 h-5 ml-2" />
              </a>
            </div>

            <!-- Startup -->
            <div class="group bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-10 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
              <div class="w-20 h-20 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                <Zap class="w-10 h-10 text-white dark:text-black" />
              </div>
              <h3 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">Startup</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed text-lg">
                Get started quickly with document redaction that grows with you.
                Affordable and secure, built for fast-moving teams who need to protect sensitive data from day one.
              </p>
              <ul class="space-y-4 mb-8">
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Quick setup and onboarding</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Pay-as-you-scale pricing</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">API-first integration</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-neutral-600 dark:text-neutral-400 mt-1 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Community support</span>
                </li>
              </ul>
              <a href="/solutions/startup" class="inline-flex items-center text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium text-lg transition-colors">
                Learn more about Startup
                <ChevronRight class="w-5 h-5 ml-2" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Core Features -->
    <Features
      title="Why Choose Nvisy"
      description="Built by a small team focused on solving real document redaction problems with practical, reliable solutions."
      category="general"
    />

    <CTA
      title="Ready to Protect Your Documents?"
      description="Join the growing number of organizations using Nvisy to safely redact and anonymize their sensitive documents."
      buttons={[
        {
          text: "Start Free Trial",
          href: "/pricing",
          variant: "primary"
        },
        {
          text: "Talk to Our Team",
          href: "/contact",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

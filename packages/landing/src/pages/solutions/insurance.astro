---
import { Layout } from "@/layouts";
import { Testimonials, CTA } from "@/sections";
import { Lightbulb, FileText, Shield, Check } from "lucide-vue-next";
---

<Layout title="Insurance - Use Cases" description="Discover how insurance companies use our platform for digital transformation, claims automation, and customer experience excellence.">
  <div class="bg-white">
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-emerald-900 via-teal-800 to-cyan-900">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="text-center max-w-4xl mx-auto">
          <div class="inline-flex items-center bg-emerald-800/30 text-emerald-200 px-4 py-2 rounded-full text-sm font-medium mb-6 backdrop-blur-sm">
            <span class="w-2 h-2 bg-emerald-300 rounded-full mr-2 animate-pulse"></span>
            Insurance & Risk Management
          </div>
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
            Insurance Digital Transformation
          </h1>
          <p class="text-xl md:text-2xl text-emerald-100 leading-relaxed mb-12 max-w-3xl mx-auto">
            Modernize your insurance operations with AI-powered underwriting, automated claims processing,
            and seamless customer experiences that drive growth and efficiency.
          </p>

          <!-- Key Stats -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-2xl mx-auto">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-white mb-2">90%</div>
              <div class="text-emerald-200">Claims Automation</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-white mb-2">60%</div>
              <div class="text-emerald-200">Faster Processing</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-white mb-2">ISO 27001</div>
              <div class="text-emerald-200">Certified</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Features -->
    <div class="container mx-auto px-4 py-20">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
          Insurance-Optimized Platform
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Built specifically for insurance operations with advanced automation, risk assessment,
          and regulatory compliance capabilities.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        <!-- Automated Underwriting -->
        <div class="group bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <Lightbulb class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Automated Underwriting</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            AI-powered risk assessment and automated decision-making for faster, more accurate underwriting processes.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">AI risk scoring</span>
            </li>
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Real-time decisioning</span>
            </li>
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Regulatory compliance</span>
            </li>
          </ul>
        </div>

        <!-- Claims Processing -->
        <div class="group bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <FileText class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Smart Claims Processing</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Streamline claims management with automated workflows, fraud detection, and instant settlements.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Automated adjudication</span>
            </li>
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Fraud detection</span>
            </li>
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Instant payments</span>
            </li>
          </ul>
        </div>

        <!-- Customer Experience -->
        <div class="group bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <Shield class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Customer Experience</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Deliver exceptional customer journeys with self-service portals, mobile apps, and omnichannel support.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Self-service portals</span>
            </li>
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">Mobile applications</span>
            </li>
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 text-sm">24/7 digital support</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Insurance Use Cases -->
    <div class="bg-gray-50 py-20">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
            Insurance Solutions
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            From life insurance to property & casualty, see how insurers transform their operations with our platform.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
          <!-- Life Insurance -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-4xl mb-4">🛡️</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Life Insurance</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Digital life insurance platforms with instant quotes, simplified underwriting, and policy management.
            </p>
            <ul class="text-xs text-gray-500 space-y-1">
              <li>• Instant quote engines</li>
              <li>• Medical underwriting</li>
              <li>• Policy administration</li>
            </ul>
          </div>

          <!-- Property & Casualty -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-4xl mb-4">🏠</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Property & Casualty</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              P&C insurance solutions with risk assessment, claims automation, and real-time pricing.
            </p>
            <ul class="text-xs text-gray-500 space-y-1">
              <li>• Risk modeling</li>
              <li>• Claims processing</li>
              <li>• Dynamic pricing</li>
            </ul>
          </div>

          <!-- Health Insurance -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-4xl mb-4">🏥</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Health Insurance</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Health insurance platforms with member portals, provider networks, and claims management.
            </p>
            <ul class="text-xs text-gray-500 space-y-1">
              <li>• Member portals</li>
              <li>• Provider networks</li>
              <li>• Benefits management</li>
            </ul>
          </div>

          <!-- Commercial Insurance -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-4xl mb-4">🏢</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Commercial Insurance</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Enterprise insurance solutions for commercial risks, cyber liability, and business protection.
            </p>
            <ul class="text-xs text-gray-500 space-y-1">
              <li>• Commercial underwriting</li>
              <li>• Cyber insurance</li>
              <li>• Risk management</li>
            </ul>
          </div>

          <!-- Auto Insurance -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-4xl mb-4">🚗</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Auto Insurance</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Usage-based insurance with telematics, instant quotes, and mobile-first experiences.
            </p>
            <ul class="text-xs text-gray-500 space-y-1">
              <li>• Telematics integration</li>
              <li>• Usage-based pricing</li>
              <li>• Mobile claims</li>
            </ul>
          </div>

          <!-- InsurTech -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-shadow">
            <div class="text-4xl mb-4">⚡</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">InsurTech Innovation</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Next-generation insurance products with AI, IoT integration, and parametric coverage.
            </p>
            <ul class="text-xs text-gray-500 space-y-1">
              <li>• AI-powered products</li>
              <li>• IoT integration</li>
              <li>• Parametric insurance</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <Testimonials
      title="Trusted by Insurance Leaders"
      description="See how leading insurance companies are driving growth and efficiency with our comprehensive digital platform."
      backgroundColor="gray"
      category="insurance"
      featured={true}
    />

    <CTA
      title="Revolutionize insurance operations"
      description="Join leading insurance companies that are driving growth and efficiency with our comprehensive digital platform."
      background="gradient"
      buttons={[
        {
          text: "Book Demo",
          variant: "primary"
        },
        {
          text: "Explore Solutions",
          variant: "secondary",
          icon: "external"
        }
      ]}
    />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import { Hero, Features, CTA, CompanyStats } from "@/sections";
import {
	Shield,
	ShieldCheck,
	FileText,
	BarChart3,
	Users,
	Clipboard,
	Check,
	Building2,
	AlertTriangle,
	DollarSign,
} from "lucide-vue-next";
---

<Layout title="Insurance Solutions" description="Document redaction solutions for insurance companies. Help protect policyholder information and claims data while supporting underwriting and regulatory workflows.">
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Insurance Document Protection"
      description="Protect policyholder information and sensitive claims data with AI-powered redaction designed for insurance workflows. Help maintain privacy standards while supporting operational efficiency."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Request Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
      stats={[
        {
          value: "Privacy",
          label: "Focused"
        },
        {
          value: "Claims",
          label: "Support"
        },
        {
          value: "Secure",
          label: "Processing"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- Insurance-Specific Features -->
    <Features
      title="Built for Insurance Workflows"
      description="Document redaction features designed specifically to help insurance companies protect sensitive information while maintaining operational efficiency and supporting regulatory requirements."
      category="insurance"
    />

    <!-- Insurance Use Cases -->
    <div class="bg-gray-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Common Insurance Use Cases
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
              See how insurance companies use Nvisy to protect sensitive information
              across various operational and regulatory workflows.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Claims Documentation -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <FileText class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Claims Documentation</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Process claims files and documentation while protecting policyholder personal information and sensitive claim details.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Claim forms and applications</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Medical records and reports</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Adjuster notes and assessments</span>
                </li>
              </ul>
            </div>

            <!-- Policy Underwriting -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <BarChart3 class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Policy Underwriting</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Support underwriting processes by preparing anonymized applications and supporting documents for risk assessment.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Insurance applications</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Risk assessment documents</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Actuarial analysis reports</span>
                </li>
              </ul>
            </div>

            <!-- Fraud Investigation -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <AlertTriangle class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Fraud Investigation</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Support fraud investigation activities by preparing redacted case files and documentation while protecting privacy.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Investigation reports</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Evidence documentation</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Case file summaries</span>
                </li>
              </ul>
            </div>

            <!-- Regulatory Reporting -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Clipboard class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Regulatory Reporting</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Prepare regulatory reports and compliance documentation by redacting sensitive information while preserving analytical value.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Regulatory filings</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Compliance audits</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Market conduct examinations</span>
                </li>
              </ul>
            </div>

            <!-- Customer Communications -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Users class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Customer Communications</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Prepare customer communications and service documentation while protecting personal information and policy details.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Policy documents</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Correspondence records</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Service interaction logs</span>
                </li>
              </ul>
            </div>

            <!-- Third-Party Sharing -->
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mb-6">
                <Building2 class="w-8 h-8 text-white dark:text-black" />
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Third-Party Data Sharing</h3>
              <p class="text-gray-600 dark:text-neutral-300 mb-4">
                Safely share insurance data with reinsurers, vendors, and partners by redacting sensitive policyholder information.
              </p>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Reinsurer reports</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Vendor data sharing</span>
                </li>
                <li class="flex items-center gap-2">
                  <Check class="w-4 h-4 text-gray-600 dark:text-neutral-400" />
                  <span class="text-gray-700 dark:text-neutral-300">Partner analytics</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Benefits -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Insurance Implementation Benefits
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Real benefits that insurance companies experience when implementing
            our document redaction platform for sensitive data protection.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <Shield class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Enhanced Privacy Protection</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Consistent, automated protection of policyholder personal information across all insurance documents and workflows.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <DollarSign class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Operational Efficiency</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Significantly reduce manual document review time while maintaining accuracy in sensitive data identification and protection.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-black dark:bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
              <ShieldCheck class="w-8 h-8 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Compliance Support</h3>
            <p class="text-gray-600 dark:text-neutral-300">
              Built-in features that help support insurance regulatory compliance requirements and data protection standards.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Security Features -->
    <div class="bg-gray-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Insurance-Grade Security
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Built with insurance industry security requirements in mind, including data protection
              and compliance readiness for sensitive policyholder information.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Data Protection</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">End-to-end encryption</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Secure data handling</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Data retention controls</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Secure transmission</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Access Controls</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Role-based permissions</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Authentication controls</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Session management</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">API security</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-8">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Compliance Features</h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Audit trail logging</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Activity monitoring</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Compliance reporting</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-gray-600 dark:text-neutral-400 flex-shrink-0" />
                  <span class="text-gray-700 dark:text-neutral-300 text-sm">Data lineage tracking</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <CTA
      title="Ready to Protect Policyholder Data?"
      description="Join insurance companies using Nvisy to safely redact and anonymize sensitive documents while maintaining operational efficiency and compliance standards."
      buttons={[
        {
          text: "Schedule Insurance Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Insurance Pricing",
          href: "/pricing",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

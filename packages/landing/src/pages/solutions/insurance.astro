---
import { Layout } from "@/layouts";
import { Hero, CTA, CompanyStats } from "@/components";
import {
	Shield,
	Check,
	Building,
	FileText,
	Users,
	Zap,
	Globe,
	AlertCircle,
	TrendingUp,
} from "lucide-vue-next";
---

<Layout
  title="Insurance Solutions"
  description="Document redaction for insurance companies and carriers. GDPR & CCPA compliant with SOC II and HIPAA certifications in progress. Protect policyholder PII, claims data, and sensitive insurance information."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Insurance Document Security"
      description="Protect policyholder PII and sensitive insurance data with compliant document redaction. Built for insurance carriers, brokers, and insurance technology companies that need reliable data protection while meeting regulatory requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- Key Challenges -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Insurance Data Protection Challenges
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Insurance companies handle extensive personal and financial data throughout the policy lifecycle,
            requiring robust protection while maintaining operational efficiency and regulatory compliance.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <Users class="w-12 h-12 text-red-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Policyholder Privacy</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Protect Social Security numbers, driver's licenses, medical information, and financial data
              across all policy documentation, claims, and customer communications.
            </p>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <AlertCircle class="w-12 h-12 text-orange-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Regulatory Compliance</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Meet state insurance regulations, GDPR, CCPA, and HIPAA requirements while maintaining
              comprehensive audit trails for regulatory examinations.
            </p>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8 text-center">
            <TrendingUp class="w-12 h-12 text-blue-600 mx-auto mb-6" />
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Claims Processing</h3>
            <p class="text-neutral-600 dark:text-neutral-300">
              Automate redaction in claims documentation, fraud investigations, and underwriting files
              while maintaining processing speed and accuracy requirements.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Solutions -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Comprehensive Insurance Data Protection
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Our document redaction platform addresses the specific needs of insurance organizations
              with compliance-ready features and enterprise-grade security for policyholder data protection.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-6">
                <FileText class="w-6 h-6 text-blue-700 dark:text-blue-300" />
              </div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Insurance Document Processing</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Automated redaction for policy applications, claims forms, underwriting documents,
                and correspondence with high accuracy PII and sensitive data detection.
              </p>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Social Security and tax ID numbers</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Driver's license and vehicle information</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Medical and health information</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">Financial account information</span>
                </li>
              </ul>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-6">
                <Shield class="w-6 h-6 text-green-700 dark:text-green-300" />
              </div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Compliance & Security</h3>
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                Built with insurance industry compliance requirements in mind,
                including comprehensive audit trails and data protection controls for sensitive information.
              </p>
              <ul class="space-y-3">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">GDPR & CCPA compliant</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                    <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                  </div>
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">SOC II certification in progress</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                    <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                  </div>
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">HIPAA certification in progress</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300 text-sm">End-to-end encryption</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Use Cases -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Insurance Use Cases
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Insurance organizations across different lines of business use our platform
            to protect policyholder information while maintaining operational efficiency and regulatory compliance.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Claims Processing</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Automatically redact personal information in claims forms, medical records, police reports,
              and supporting documentation while preserving claim details for processing.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Auto, Health, Property & Casualty
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Underwriting Support</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Protect sensitive applicant information in underwriting files, risk assessments,
              and medical examinations while maintaining necessary data for risk evaluation.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Life, Health, Disability Insurance
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Fraud Investigation</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Redact uninvolved party information in fraud investigation files, surveillance reports,
              and case documentation while preserving investigative integrity.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Special Investigation Units, Claims Fraud
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Regulatory Reporting</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Prepare regulatory filings and compliance reports by redacting personal information
              while maintaining aggregate data and compliance metrics for state regulators.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              State Insurance Departments, NAIC Reporting
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Legal & Litigation</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Protect sensitive information in legal proceedings, subpoena responses,
              and litigation discovery while maintaining relevant case information.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Legal Departments, Coverage Disputes
            </div>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">Third-Party Sharing</h3>
            <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4">
              Safely share policy and claims information with reinsurers, vendors, and service providers
              by automatically redacting unnecessary personal details.
            </p>
            <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3">
              Reinsurance, Claims Administration, TPAs
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Options -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
              Flexible Implementation Options
            </h2>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
              Choose the deployment model that best fits your organization's compliance requirements,
              security policies, and integration needs with existing insurance systems.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Globe class="w-8 h-8 text-blue-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Cloud API</h3>
                  <p class="text-sm text-neutral-500">For insurtech and smaller insurance companies</p>
                </div>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Quick integration with REST API</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">TypeScript and Python SDKs</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">GDPR & CCPA compliant infrastructure</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Scalable pricing model</span>
                </li>
              </ul>
              <a
                href="https://docs.nvisy.com"
                class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium transition-colors"
              >
                View API Documentation →
              </a>
            </div>

            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
              <div class="flex items-center gap-3 mb-6">
                <Building class="w-8 h-8 text-purple-600" />
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-white">On-Premise Deployment</h3>
                  <p class="text-sm text-neutral-500">For large carriers and mutual companies</p>
                </div>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Complete data control and residency</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Source code access for security reviews</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Custom system integrations</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                  <span class="text-neutral-700 dark:text-neutral-300">Special enterprise pricing</span>
                </li>
              </ul>
              <a
                href="/contact"
                class="inline-flex items-center text-purple-600 hover:text-purple-700 font-medium transition-colors"
              >
                Contact Enterprise Sales →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Compliance Status -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
            Insurance Compliance & Security
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
            We're committed to meeting the highest security and compliance standards
            required by insurance organizations and regulatory authorities.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
                <Check class="w-5 h-5 text-green-600" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Current Compliance</h3>
                <p class="text-sm text-neutral-500">Operational and certified</p>
              </div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">GDPR Compliant</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">CCPA Compliant</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">End-to-end encryption</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">Comprehensive audit trails</span>
              </li>
            </ul>
          </div>

          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center">
                <Zap class="w-5 h-5 text-orange-600" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white">In Progress</h3>
                <p class="text-sm text-neutral-500">Active certification processes</p>
              </div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                  <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                </div>
                <span class="text-neutral-700 dark:text-neutral-300">SOC II Type 2 Certification</span>
              </li>
              <li class="flex items-center gap-3">
                <div class="w-5 h-5 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center flex-shrink-0">
                  <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                </div>
                <span class="text-neutral-700 dark:text-neutral-300">HIPAA Certification</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">State insurance regulation compliance</span>
              </li>
              <li class="flex items-center gap-3">
                <Check class="w-5 h-5 text-green-600 flex-shrink-0" />
                <span class="text-neutral-700 dark:text-neutral-300">Role-based access control</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- About -->
    <div class="bg-neutral-50 dark:bg-neutral-950 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-8">
            Built by a Focused Team
          </h2>
          <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-8">
            Nvisy is a dedicated 2-4 person startup focused exclusively on document redaction and data anonymization.
            We understand the complex regulatory environment insurance companies operate in
            and are building solutions specifically designed for insurance industry requirements.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">100%</div>
              <div class="text-neutral-600 dark:text-neutral-400">Focus on Data Security</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">Direct</div>
              <div class="text-neutral-600 dark:text-neutral-400">Founder Communication</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">Rapid</div>
              <div class="text-neutral-600 dark:text-neutral-400">Feature Development</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <CTA
      title="Ready to Secure Your Insurance Documents?"
      description="Whether you're an insurtech startup or a large carrier, we have solutions tailored for your compliance and operational needs. Special pricing available for qualifying insurance organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

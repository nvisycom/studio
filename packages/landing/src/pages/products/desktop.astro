---
import { Layout } from "@/layouts";
import { Hero, CTA } from "@/components";
import { Download, Github, Check, Zap, Shield, Boxes, MonitorSmartphone, Apple, Binary } from "lucide-vue-next";
---

<Layout
  title="Desktop UI"
  description="Cross-platform desktop application for document redaction. Works with both Nvisy Cloud and Server. Open source and built with Tauri."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <div class="border-b border-neutral-200 dark:border-neutral-800">
      <Hero
        title="Desktop UI"
        description="Cross-platform desktop application with intuitive UI for document redaction. Open source, lightweight, and built with Tauri."
        background="gradient"
        padding="lg"
        buttons={[
          {
            text: "Download for Windows",
            href: "https://github.com/nvisycom/desktop/releases/latest/download/nvisy-desktop-windows.exe",
            variant: "primary"
          },
          {
            text: "View on GitHub",
            href: "https://github.com/nvisycom/desktop",
            variant: "secondary"
          }
        ]}
      />
    </div>

    <!-- Download Section -->
    <div class="container mx-auto px-4 py-12 md:py-20">
      <div class="max-w-4xl mx-auto">
        <!-- Download Buttons -->
        <div class="text-center mb-12 md:mb-16">
          <div class="inline-flex items-center gap-2 bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300 px-3 md:px-4 py-1.5 md:py-2 rounded-full mb-4 md:mb-6">
            <Github class="w-4 h-4" />
            <span class="text-xs md:text-sm font-medium">Open Source • MIT License</span>
          </div>

          <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white mb-6 md:mb-8">
            Download for Your Platform
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-6 md:mb-8">
            <!-- Windows -->
            <a
              href="https://github.com/nvisycom/desktop/releases/latest/download/nvisy-desktop-windows.exe"
              class="group bg-white dark:bg-black border-2 border-neutral-200 dark:border-neutral-700 rounded-xl p-6 md:p-8 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-lg transition-all duration-200"
            >
              <div class="mb-4 flex justify-center">
                <MonitorSmartphone class="w-12 h-12 md:w-16 md:h-16 text-blue-500" />
              </div>
              <h3 class="text-base md:text-lg font-bold text-neutral-900 dark:text-white mb-2">Windows</h3>
              <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mb-3 md:mb-4">Windows 10 or later</p>
              <div class="flex items-center justify-center gap-2 text-blue-600 dark:text-blue-400 font-medium">
                <Download class="w-4 h-4" />
                <span class="text-xs md:text-sm">Download .exe</span>
              </div>
            </a>

            <!-- macOS -->
            <a
              href="https://github.com/nvisycom/desktop/releases/latest/download/nvisy-desktop-macos.dmg"
              class="group bg-white dark:bg-black border-2 border-neutral-200 dark:border-neutral-700 rounded-xl p-6 md:p-8 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-lg transition-all duration-200"
            >
              <div class="mb-4 flex justify-center">
                <Apple class="w-12 h-12 md:w-16 md:h-16 text-neutral-800 dark:text-neutral-200" />
              </div>
              <h3 class="text-base md:text-lg font-bold text-neutral-900 dark:text-white mb-2">macOS</h3>
              <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mb-3 md:mb-4">macOS 11 or later</p>
              <div class="flex items-center justify-center gap-2 text-blue-600 dark:text-blue-400 font-medium">
                <Download class="w-4 h-4" />
                <span class="text-xs md:text-sm">Download .dmg</span>
              </div>
            </a>

            <!-- Linux -->
            <a
              href="https://github.com/nvisycom/desktop/releases/latest/download/nvisy-desktop-linux.AppImage"
              class="group bg-white dark:bg-black border-2 border-neutral-200 dark:border-neutral-700 rounded-xl p-6 md:p-8 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-lg transition-all duration-200"
            >
              <div class="mb-4 flex justify-center">
                <Binary class="w-12 h-12 md:w-16 md:h-16 text-neutral-900 dark:text-white" />
              </div>
              <h3 class="text-base md:text-lg font-bold text-neutral-900 dark:text-white mb-2">Linux</h3>
              <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mb-3 md:mb-4">Ubuntu, Debian, Fedora</p>
              <div class="flex items-center justify-center gap-2 text-blue-600 dark:text-blue-400 font-medium">
                <Download class="w-4 h-4" />
                <span class="text-xs md:text-sm">Download .AppImage</span>
              </div>
            </a>
          </div>

          <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400">
            Latest version: <span class="font-medium">v1.0.0</span> •
            <a href="https://github.com/nvisycom/desktop/releases" class="text-blue-600 dark:text-blue-400 hover:underline">View all releases</a>
          </p>
        </div>

        <!-- Why Desktop UI Section -->
        <div class="bg-gradient-to-br from-purple-50 to-blue-50 dark:from-purple-950/30 dark:to-blue-950/30 rounded-2xl p-6 md:p-10 mb-12 md:mb-20">
          <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4 text-center">
            Why Desktop UI?
          </h2>
          <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 text-center mb-8 md:mb-12 max-w-2xl mx-auto">
            A lightweight, secure desktop application that combines the best of native performance with modern web technologies.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <!-- Lightweight -->
            <div class="text-center">
              <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-3 md:mb-4">
                <Zap class="w-6 h-6 md:w-7 md:h-7 text-white" />
              </div>
              <h3 class="text-base md:text-lg font-bold text-neutral-900 dark:text-white mb-2">Lightning Fast</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                Built with Tauri and Rust for minimal resource usage and maximum performance. Start redacting in seconds.
              </p>
            </div>

            <!-- Secure -->
            <div class="text-center">
              <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-3 md:mb-4">
                <Shield class="w-6 h-6 md:w-7 md:h-7 text-white" />
              </div>
              <h3 class="text-base md:text-lg font-bold text-neutral-900 dark:text-white mb-2">Secure by Default</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                Open source and auditable. Your documents stay on your machine until you choose to redact them.
              </p>
            </div>

            <!-- Flexible -->
            <div class="text-center">
              <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-orange-500 to-red-600 rounded-2xl flex items-center justify-center mx-auto mb-3 md:mb-4">
                <Boxes class="w-6 h-6 md:w-7 md:h-7 text-white" />
              </div>
              <h3 class="text-base md:text-lg font-bold text-neutral-900 dark:text-white mb-2">Backend Agnostic</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                Works with Nvisy Cloud for scale or Nvisy Server for complete control. Switch backends anytime.
              </p>
            </div>
          </div>
        </div>

        <!-- Features Section -->
        <div class="mb-12 md:mb-20">
          <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white mb-6 md:mb-8 text-center">
            Features
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            <div class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Cross-platform Support</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  Works seamlessly on Windows, macOS, and Linux with native performance and consistent experience.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Cloud & Server Integration</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  Connect to Nvisy Cloud for instant scale or your own Nvisy Server deployment for data sovereignty.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Batch Processing</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  Redact multiple documents at once with intelligent batch processing and progress tracking.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Built with Tauri</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  Lightweight and secure, powered by Rust and modern web technologies for optimal performance.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Intuitive Interface</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  Clean, modern UI designed for productivity with drag-and-drop support and keyboard shortcuts.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Open Source</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  MIT licensed, fully transparent, and community-driven. Contribute or audit the code anytime.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Technical Specs -->
        <div class="bg-white dark:bg-black rounded-2xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-10">
          <h2 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-6 md:mb-8">
            Technical Specifications
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            <!-- System Requirements -->
            <div>
              <h3 class="text-base md:text-lg font-semibold text-neutral-900 dark:text-white mb-3 md:mb-4">System Requirements</h3>
              <div class="space-y-2">
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Windows:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">Windows 10 or later</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">macOS:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">macOS 11 (Big Sur) or later</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Linux:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">Ubuntu 20.04+, Debian 11+, Fedora 36+</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">RAM:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">4GB minimum, 8GB recommended</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Storage:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">200MB for app + space for documents</span>
                </div>
              </div>
            </div>

            <!-- Tech Stack -->
            <div>
              <h3 class="text-base md:text-lg font-semibold text-neutral-900 dark:text-white mb-3 md:mb-4">Tech Stack</h3>
              <div class="space-y-2">
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Framework:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">Tauri 2.0</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Backend:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">Rust</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Frontend:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">Vue 3 + TypeScript</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">License:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">MIT</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-neutral-500 dark:text-neutral-400 text-sm">Size:</span>
                  <span class="text-neutral-900 dark:text-white text-sm">~15MB installed</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <CTA
      title="Ready to Start Redacting?"
      description="Download Desktop UI and connect it to Nvisy Cloud or your own Server deployment. Get started in minutes."
      buttons={[
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com/desktop",
          variant: "primary"
        },
        {
          text: "View on GitHub",
          href: "https://github.com/nvisycom/desktop",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import { Hero, CTA } from "@/components";
import {
	Server,
	Check,
	Shield,
	WifiOff,
	Box,
	Settings,
	Zap,
	FileCheck,
	ArrowRight,
	Star,
} from "lucide-vue-next";
---

<Layout
  title="Nvisy Server - On-Premises Document Redaction"
  description="Deploy Nvisy's AI-powered document redaction on your own infrastructure. Complete control, maximum security, and compliance for air-gapped environments."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <div class="border-b border-neutral-200 dark:border-neutral-800">
      <Hero
        title="Nvisy Server"
        description="Enterprise-grade document redaction deployed entirely on your infrastructure. Maximum security, complete data sovereignty, full customization. Perfect for organizations with strict compliance requirements and air-gapped environments."
        background="gradient"
        fontSize="xl"
        padding="lg"
        buttons={[
          {
            text: "Request Deployment Demo",
            href: "/contact",
            variant: "primary"
          },
          {
            text: "Download Specifications",
            href: "/contact",
            variant: "secondary"
          }
        ]}
      />
    </div>

    <!-- Stats Section -->
    <div class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-black">
      <div class="container mx-auto px-4 py-8 md:py-12">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-3 gap-4 md:gap-8">
            <div class="text-center">
              <div class="text-2xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-1 md:mb-2">100%</div>
              <div class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400">On-Premises</div>
            </div>
            <div class="text-center">
              <div class="text-2xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-1 md:mb-2">Air-Gap</div>
              <div class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400">Ready</div>
            </div>
            <div class="text-center">
              <div class="text-2xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-1 md:mb-2">Zero</div>
              <div class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400">Data Leaves Network</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Why Choose Nvisy Server -->
    <div class="container mx-auto px-4 py-12 md:py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">
            Why Choose Nvisy Server
          </h2>
          <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto px-4">
            All the power of Nvisy's AI technology, deployed entirely within your secure infrastructure with complete data sovereignty and control.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          <!-- Complete Data Sovereignty -->
          <div class="group bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-gray-700 to-gray-900 rounded-2xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform">
              <Shield class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-white mb-2 md:mb-3">Complete Data Sovereignty</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              100% on-premises deployment ensures your sensitive documents never leave your network. Perfect for government, healthcare, and financial institutions with strict data residency requirements.
            </p>
          </div>

          <!-- Air-Gap Ready -->
          <div class="group bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform">
              <WifiOff class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-white mb-2 md:mb-3">Air-Gap Ready</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              Deploy in completely isolated environments with no internet connectivity required. Ideal for classified networks, secure facilities, and high-security operations.
            </p>
          </div>

          <!-- Bring Your Own Models -->
          <div class="group bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform">
              <Box class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-white mb-2 md:mb-3">Bring Your Own Models</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              Use your own custom-trained AI models or Nvisy's pre-trained models. Full flexibility to adapt the system to your specific document types and redaction requirements.
            </p>
          </div>

          <!-- Enterprise Customization -->
          <div class="group bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-cyan-500 to-cyan-600 rounded-2xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform">
              <Settings class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-white mb-2 md:mb-3">Enterprise Customization</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              Customize workflows, integrate with existing systems, and adapt the platform to your exact requirements. Complete API access for deep integration.
            </p>
          </div>

          <!-- GPU Acceleration -->
          <div class="group bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-yellow-500 to-orange-600 rounded-2xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform">
              <Zap class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-white mb-2 md:mb-3">GPU Acceleration</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              Leverage NVIDIA GPUs for 10x faster processing of large document batches. Process thousands of pages per hour with optimal hardware utilization.
            </p>
          </div>

          <!-- FedRAMP Ready -->
          <div class="group bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform">
              <FileCheck class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-white mb-2 md:mb-3">FedRAMP Ready</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              Designed to meet FedRAMP requirements with comprehensive security controls, audit trails, and compliance documentation for government deployments.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Deployment Process -->
    <div class="bg-gradient-to-br from-gray-50 to-neutral-50 dark:from-gray-950/30 dark:to-neutral-950/30">
      <div class="container mx-auto px-4 py-12 md:py-20">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-8 md:mb-12">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">
              Deployment Process
            </h2>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300">
              Our team guides you through every step of the deployment process.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            <!-- Step 1 -->
            <div class="bg-white dark:bg-black rounded-xl p-6 md:p-8 border border-neutral-200 dark:border-neutral-700">
              <div class="w-10 h-10 md:w-12 md:h-12 bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 rounded-full flex items-center justify-center font-bold text-lg md:text-xl mb-4">
                1
              </div>
              <h3 class="font-bold text-neutral-900 dark:text-white mb-2 text-base md:text-lg">Infrastructure Assessment</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                We analyze your infrastructure and plan the optimal deployment architecture.
              </p>
            </div>

            <!-- Step 2 -->
            <div class="bg-white dark:bg-black rounded-xl p-6 md:p-8 border border-neutral-200 dark:border-neutral-700">
              <div class="w-10 h-10 md:w-12 md:h-12 bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 rounded-full flex items-center justify-center font-bold text-lg md:text-xl mb-4">
                2
              </div>
              <h3 class="font-bold text-neutral-900 dark:text-white mb-2 text-base md:text-lg">Installation & Configuration</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                Our engineers install and configure Nvisy Server to your specifications.
              </p>
            </div>

            <!-- Step 3 -->
            <div class="bg-white dark:bg-black rounded-xl p-6 md:p-8 border border-neutral-200 dark:border-neutral-700">
              <div class="w-10 h-10 md:w-12 md:h-12 bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 rounded-full flex items-center justify-center font-bold text-lg md:text-xl mb-4">
                3
              </div>
              <h3 class="font-bold text-neutral-900 dark:text-white mb-2 text-base md:text-lg">Training & Knowledge Transfer</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                Comprehensive training for your team on operation and maintenance.
              </p>
            </div>

            <!-- Step 4 -->
            <div class="bg-white dark:bg-black rounded-xl p-6 md:p-8 border border-neutral-200 dark:border-neutral-700">
              <div class="w-10 h-10 md:w-12 md:h-12 bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 rounded-full flex items-center justify-center font-bold text-lg md:text-xl mb-4">
                4
              </div>
              <h3 class="font-bold text-neutral-900 dark:text-white mb-2 text-base md:text-lg">Go-Live with Support</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                Launch your deployment with ongoing 24/7 enterprise support.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Deployment Options -->
    <div class="container mx-auto px-4 py-12 md:py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">
            Deployment Options
          </h2>
          <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto px-4">
            Choose the deployment model that best fits your infrastructure and security requirements. All options support air-gap environments.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          <!-- Single Server -->
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">Single Server</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              Perfect for smaller organizations or proof-of-concept deployments. All components on one server with simple management.
            </p>
            <div class="space-y-2">
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Up to 10,000 documents/month</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Single point of management</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Minimal hardware requirements</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Quick setup (1-2 days)</span>
              </div>
            </div>
          </div>

          <!-- Clustered (Recommended) -->
          <div class="bg-gradient-to-br from-blue-50 to-purple-50 dark:from-blue-950/30 dark:to-purple-950/30 rounded-xl border-2 border-blue-500 dark:border-blue-400 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-500 text-white text-xs font-medium px-3 py-1 rounded-full">
              Recommended
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">Clustered</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              High availability deployment with load balancing and redundancy. Ideal for mission-critical operations.
            </p>
            <div class="space-y-2">
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Up to 1M documents/month</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">High availability (99.9%+)</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Automatic failover</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Load balancing included</span>
              </div>
            </div>
          </div>

          <!-- Distributed -->
          <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">Distributed</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
              Enterprise-scale deployment across multiple data centers. Ultimate performance and geographic distribution.
            </p>
            <div class="space-y-2">
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Unlimited document processing</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Multi-datacenter support</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Geographic distribution</span>
              </div>
              <div class="flex items-start gap-2">
                <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-neutral-700 dark:text-neutral-400">Advanced disaster recovery</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- System Requirements -->
    <div class="bg-neutral-50 dark:bg-neutral-950">
      <div class="container mx-auto px-4 py-12 md:py-20">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12 md:mb-16">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">
              System Requirements
            </h2>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto px-4">
              Minimum and recommended specifications for optimal performance. GPU acceleration optional but recommended for high-volume processing.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            <!-- Minimum Requirements -->
            <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8">
              <h3 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-6">Minimum Requirements</h3>
              <div class="space-y-4">
                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">CPU</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">8 cores, 2.4GHz</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Memory</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">32 GB RAM DDR4</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Storage</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">500 GB SSD</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Network</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">1 Gbps Ethernet</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">OS</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">Ubuntu 22.04 LTS, RHEL 8+, Windows Server 2019+</span>
                </div>
              </div>
            </div>

            <!-- Recommended -->
            <div class="bg-gradient-to-br from-blue-50 to-purple-50 dark:from-blue-950/30 dark:to-purple-950/30 rounded-xl border-2 border-blue-500 dark:border-blue-400 p-6 md:p-8 relative">
              <div class="absolute -top-3 right-6 bg-blue-500 text-white text-xs font-medium px-3 py-1 rounded-full">
                Recommended
              </div>
              <h3 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-6">Recommended</h3>
              <div class="space-y-4">
                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">CPU</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">16+ cores, 3.0GHz</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Memory</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">64+ GB RAM DDR4/DDR5</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Storage</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">2+ TB NVMe SSD</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Network</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">10+ Gbps Ethernet</span>
                </div>
                <div class="flex items-start justify-between gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-700">
                  <span class="text-sm font-medium text-neutral-600 dark:text-neutral-400">GPU</span>
                  <span class="text-sm text-neutral-900 dark:text-white text-right">NVIDIA RTX 4000/5000 or Tesla T4/V100</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Features -->
    <div class="container mx-auto px-4 py-12 md:py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-900 dark:text-white mb-3 md:mb-4">
            Enterprise-Grade Platform
          </h2>
          <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto px-4">
            All the power of Nvisy's AI-powered document redaction, deployed entirely within your secure infrastructure.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
            <div>
              <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">99.9% AI Accuracy</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                Same industry-leading accuracy as Nvisy Cloud, deployed entirely on your infrastructure.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
            <div>
              <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Air-Gap Deployment</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                Deploy in completely isolated networks with no internet connectivity required.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
            <div>
              <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">Custom Model Training</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                Train AI models on your own data for optimal accuracy on your specific document types.

---
import { CTA } from "@/sections";
import { Layout } from "@/layouts";
import { getCollection, type CollectionEntry } from "astro:content";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import { Clock, FileText } from "lucide-vue-next";

export async function getStaticPaths() {
	try {
		const legalEntries = await getCollection("legal");
		return legalEntries.map((entry) => ({
			params: { slug: entry.slug },
			props: { entry },
		}));
	} catch (error: unknown) {
		// Return empty array if no legal collection exists.
		console.error("Error fetching legal collection:", error);
		return [];
	}
}

interface Props {
	entry: CollectionEntry<"legal">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={(entry.data as any).description || entry.data.title}>
  <div class="container mx-auto max-w-4xl px-4 py-8">
      <!-- Breadcrumb -->
      <Breadcrumb>
          <BreadcrumbList>
              <BreadcrumbItem>
                  <BreadcrumbLink href="/legal">
                      Legal
                  </BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                  <BreadcrumbPage>
                      {entry.data.title}
                  </BreadcrumbPage>
              </BreadcrumbItem>
          </BreadcrumbList>
      </Breadcrumb>

    <article class="max-w-none mt-8">
      <header class="text-center mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-black dark:text-white mb-4">{entry.data.title}</h1>

        <!-- Metadata Section -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-4 text-sm text-gray-600 dark:text-gray-400">
          <div class="flex items-center gap-1">
            <FileText class="w-4 h-4"/>
            <span>Version {entry.data.version}</span>
          </div>

          <div class="flex items-center gap-1">
            <Clock class="w-4 h-4"/>
            <span>Updated {new Date(entry.data.updatedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}</span>
          </div>
        </div>

        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
            {entry.data.description}
        </p>
      </header>

      <div class="prose prose-xl max-w-none mx-auto leading-loose text-gray-800 dark:text-gray-200 prose-headings:text-gray-900 dark:prose-headings:text-gray-100 prose-strong:text-gray-900 dark:prose-strong:text-gray-100" style="font-size: 1.125rem; line-height: 1.8;">
        <Content />
      </div>
    </article>
  </div>

  <CTA
    title="Questions about our legal policies?"
    description="If you have questions about any of our legal documents or need clarification on our policies, please don't hesitate to reach out to our legal team."
    background="solid"
    padding="md"
    buttons={[
      {
        text: "Contact Support",
        href: "/support",
        variant: "primary"
      },
      {
        text: "Email Legal Team",
        href: "mailto:legal@nvisy.com",
        variant: "secondary"
      }
    ]}
  />
</Layout>

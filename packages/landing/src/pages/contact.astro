---
import { Layout } from "@/layouts";
import { Hero } from "@/sections";

const contactMethods = [
	{
		title: "Sales",
		description: "Interested in our platform?",
		value: "sales@nvisy.com",
		href: "mailto:sales@nvisy.com",
		icon: "💼",
	},
	{
		title: "Support",
		description: "Need help with your account?",
		value: "support@nvisy.com",
		href: "mailto:support@nvisy.com",
		icon: "🛟",
	},
	{
		title: "General",
		description: "General inquiries",
		value: "hello@nvisy.com",
		href: "mailto:hello@nvisy.com",
		icon: "✉️",
	},
	{
		title: "Careers",
		description: "Join our team",
		value: "careers@nvisy.com",
		href: "mailto:careers@nvisy.com",
		icon: "🚀",
	},
];
---

<Layout
  title="Contact"
  description="Get in touch with Nvisy. Contact our team for sales inquiries, support, or general questions about our document redaction platform."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Get in Touch"
      description="Ready to protect your sensitive documents? Have questions about our platform? Our team is here to help you secure your data and streamline your workflows."
      background="dark"
      fontSize="xl"
      padding="xl"
      buttons={[]}
    />
    <div class="border-b border-gray-200 dark:border-neutral-800"></div>

    <!-- Contact Methods -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            How Can We Help?
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300">
            Choose the best way to reach us based on your needs.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
          {contactMethods.map(method => (
            <a
              href={method.href}
              class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 text-center hover:border-gray-300 dark:hover:border-neutral-600 transition-colors group"
            >
              <div class="text-3xl mb-4">{method.icon}</div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                {method.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-neutral-400 mb-3">
                {method.description}
              </p>
              <p class="text-sm font-medium text-gray-700 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white">
                {method.value}
              </p>
            </a>
          ))}
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <!-- Contact Form -->
          <div>
            <div class="mb-8">
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
                Send us a Message
              </h2>
              <p class="text-lg text-gray-600 dark:text-neutral-400">
                Fill out the form below and we'll get back to you within 24 hours.
              </p>
            </div>

            <form class="space-y-6" action="#" method="POST">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="first-name" class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                    First Name *
                  </label>
                  <input
                    type="text"
                    name="first-name"
                    id="first-name"
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-black text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-neutral-400 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="last-name" class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                    Last Name *
                  </label>
                  <input
                    type="text"
                    name="last-name"
                    id="last-name"
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-black text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-neutral-400 focus:border-transparent"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                  Work Email *
                </label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-black text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-neutral-400 focus:border-transparent"
                />
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                  Company
                </label>
                <input
                  type="text"
                  name="company"
                  id="company"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-black text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-neutral-400 focus:border-transparent"
                />
              </div>

              <div>
                <label for="inquiry-type" class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                  Inquiry Type *
                </label>
                <select
                  name="inquiry-type"
                  id="inquiry-type"
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-black text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-neutral-400 focus:border-transparent"
                >
                  <option value="">Select an option</option>
                  <option value="sales">Sales Inquiry</option>
                  <option value="demo">Request Demo</option>
                  <option value="support">Technical Support</option>
                  <option value="partnership">Partnership</option>
                  <option value="general">General Question</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                  Message *
                </label>
                <textarea
                  name="message"
                  id="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-neutral-600 rounded-lg bg-white dark:bg-black text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-neutral-400 focus:border-transparent"
                  placeholder="Tell us more about your needs..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-black dark:bg-white text-white dark:text-black font-medium py-3 px-8 rounded-lg hover:bg-gray-800 dark:hover:bg-neutral-200 transition-colors"
              >
                Send Message
              </button>
            </form>
          </div>

          <!-- Contact Information -->
          <div>
            <div class="mb-8">
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
                Contact Information
              </h2>
              <p class="text-lg text-gray-600 dark:text-neutral-400">
                Prefer to reach out directly? Use the information below.
              </p>
            </div>

            <!-- Response Times -->
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-6 mb-8">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
                Response Times
              </h3>
              <div class="space-y-3">
                <div class="flex justify-between">
                  <span class="text-gray-600 dark:text-neutral-400">Sales Inquiries</span>
                  <span class="text-gray-900 dark:text-white font-medium">Within 2 hours</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600 dark:text-neutral-400">Support Requests</span>
                  <span class="text-gray-900 dark:text-white font-medium">Within 4 hours</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600 dark:text-neutral-400">General Inquiries</span>
                  <span class="text-gray-900 dark:text-white font-medium">Within 24 hours</span>
                </div>
              </div>
            </div>

            <!-- Office Locations -->
            <div class="space-y-6">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                Office Locations
              </h3>

              <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-6">
                <h4 class="font-semibold text-gray-900 dark:text-white mb-2">
                  San Francisco HQ
                </h4>
                <div class="text-gray-600 dark:text-neutral-400 space-y-1">
                  <p>123 Market Street, Suite 400</p>
                  <p>San Francisco, CA 94105</p>
                  <p>United States</p>
                </div>
              </div>

              <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-6">
                <h4 class="font-semibold text-gray-900 dark:text-white mb-2">
                  New York Office
                </h4>
                <div class="text-gray-600 dark:text-neutral-400 space-y-1">
                  <p>456 Broadway, Floor 12</p>
                  <p>New York, NY 10013</p>
                  <p>United States</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="bg-gray-50 dark:bg-neutral-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Frequently Asked Questions
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300">
              Quick answers to common questions about getting in touch.
            </p>
          </div>

          <div class="space-y-6">
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                How quickly do you respond to inquiries?
              </h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                We typically respond to all inquiries within 24 hours during business days. For sales inquiries and demo requests, we aim to respond within 2 hours.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                Do you offer custom enterprise solutions?
              </h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Yes! We work closely with enterprise customers to create tailored solutions that meet their specific document redaction and compliance requirements.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                Can I schedule a product demonstration?
              </h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Absolutely! We'd love to show you how our platform can transform your document workflows. Contact our sales team to schedule a personalized demo.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

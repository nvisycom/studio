---
import { Layout } from "@/layouts";
import { Hero, FAQ, CTA } from "@/sections";
---

<Layout title="Support" description="Get help and support for our platform with comprehensive resources, documentation, and contact options.">
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="How can we help you?"
      description="Find answers, get support, and access resources to make the most of our platform. Our team is here to help you succeed."
      background="dark"
      fontSize="xl"
      padding="xl"
      buttons={[]}
    />

    <!-- Quick Help Options -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Popular Help Topics
          </h2>
          <p class="text-xl text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Quick access to the most commonly requested information and solutions.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Getting Started -->
          <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
            <div class="mb-6">
              <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Getting Started</h3>
            <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
              New to our platform? Learn the basics and get up and running quickly with our step-by-step guides.
            </p>
            <a href="#" class="inline-flex items-center text-gray-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium transition-colors">
              View guides
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- Documentation -->
          <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
            <div class="mb-6">
              <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Documentation</h3>
            <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
              Comprehensive technical documentation, API references, and detailed feature explanations.
            </p>
            <a href="#" class="inline-flex items-center text-gray-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium transition-colors">
              Browse docs
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- API Reference -->
          <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
            <div class="mb-6">
              <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">API Reference</h3>
            <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
              Complete API documentation with code examples, authentication guides, and endpoint references.
            </p>
            <a href="#" class="inline-flex items-center text-gray-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium transition-colors">
              View API docs
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- Troubleshooting -->
          <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
            <div class="mb-6">
              <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Troubleshooting</h3>
            <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
              Common issues and their solutions. Find quick fixes for the most frequent problems.
            </p>
            <a href="#" class="inline-flex items-center text-gray-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium transition-colors">
              Get help
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- Video Tutorials -->
          <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
            <div class="mb-6">
              <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Video Tutorials</h3>
            <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
              Learn through visual guides and step-by-step video tutorials covering all features.
            </p>
            <a href="#" class="inline-flex items-center text-gray-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium transition-colors">
              Watch videos
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- Community -->
          <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
            <div class="mb-6">
              <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Community</h3>
            <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
              Connect with other users, share best practices, and get help from the community.
            </p>
            <a href="#" class="inline-flex items-center text-gray-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium transition-colors">
              Join community
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Support -->
    <CTA
      title="Still Need Help?"
      description="Can't find what you're looking for? Our support team is here to help you get the most out of our platform."
      background="solid"
      padding="lg"
      buttons={[
        {
          text: "Contact Support",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "Schedule Call",
          href: "/contact",
          variant: "secondary"
        }
      ]}
    />

    <!-- FAQ Section -->
    <FAQ />
  </div>
</Layout>

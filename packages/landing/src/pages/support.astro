---
import { Layout } from "@/layouts";
import { Hero, FAQ, CTA } from "@/sections";
import { BookOpen, Code, MessageCircle, FileText } from "lucide-vue-next";
---

<Layout title="Support" description="Get help and support for our platform with comprehensive resources, documentation, and contact options.">
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="How can we help you?"
      description="Find answers, get support, and access resources to make the most of our platform. Our team is here to help you succeed."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Contact Support",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "Browse Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Quick Help Options -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Popular Help Topics
          </h2>
          <p class="text-xl text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
            Quick access to the most commonly requested information and solutions.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <!-- Documentation -->
          <a href="https://docs.nvisy.com" class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors group">
            <div class="mb-6">
              <BookOpen class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Documentation</h3>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
              Comprehensive technical documentation and detailed feature explanations.
            </p>
          </a>

          <!-- API Reference -->
          <a href="https://docs.nvisy.com/api-reference" class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors group">
            <div class="mb-6">
              <Code class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">API Reference</h3>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
              Complete API documentation with code examples and authentication guides.
            </p>
          </a>

          <!-- Contact Support -->
          <a href="/contact" class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors group">
            <div class="mb-6">
              <MessageCircle class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Contact Support</h3>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
              Get in touch with our support team for personalized assistance.
            </p>
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div id="faq">
      <FAQ
        title="Frequently Asked Questions"
        description="Find answers to common questions about our platform and services."
        featured={true}
      />
    </div>

    <!-- Contact Support -->
    <CTA
      title="Still Need Help?"
      description="Can't find what you're looking for? Our support team is here to help you get the most out of our platform."
      background="none"
      padding="lg"
      buttons={[
        {
          text: "Contact Support",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "Browse Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />
  </div>
</Layout>

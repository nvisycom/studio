---
import { Layout } from "@/layouts";
import { Hero } from "@/sections";
import { CTA } from "@/sections";
import {
	ShieldCheck,
	Lock,
	Box,
	Cloud,
	Cpu,
	Clock,
	Database,
	FileCheck,
	Award,
	Shield,
} from "lucide-vue-next";
---

<Layout
  title="Security"
  description="Enterprise-grade security and compliance for document redaction. SOC 2 compliant, end-to-end encryption, and zero-trust architecture to protect your sensitive data."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Enterprise-Grade Security"
      description="Trust Nvisy with your most sensitive documents. Our security-first approach ensures your data is protected with industry-leading encryption, compliance frameworks, and zero-trust architecture."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Security Assessment",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Security Details",
          href: "#security-features",
          variant: "secondary"
        }
      ]}
    />

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16" id="security-features">
      <div class="max-w-6xl mx-auto">

        <!-- Security Overview -->
        <div class="mb-20">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              Built Security-First
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Every aspect of Nvisy is designed with security as the foundation. From data processing to storage and transmission, your documents are protected at every step.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <ShieldCheck class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">End-to-End Encryption</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                AES-256 encryption for data at rest and TLS 1.3 for data in transit. Your documents are encrypted before they leave your environment.
              </p>
              <span class="text-gray-700 dark:text-neutral-300 text-sm font-medium">✓ Implemented</span>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <Lock class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Zero-Trust Architecture</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                Never trust, always verify. Every request is authenticated and authorized using multi-factor authentication and role-based access controls.
              </p>
              <span class="text-gray-700 dark:text-neutral-300 text-sm font-medium">✓ Implemented</span>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <Box class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Private Processing</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                Documents are processed in isolated, ephemeral environments. No data is retained after processing is complete.
              </p>
              <span class="text-gray-700 dark:text-neutral-300 text-sm font-medium">✓ Implemented</span>
            </div>
          </div>
        </div>

        <!-- Compliance & Certifications -->
        <div class="mb-20">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              Compliance & Certifications
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Meet the most stringent regulatory requirements with our comprehensive compliance framework and third-party audited security controls.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 text-center hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6 flex justify-center">
                <Award class="w-12 h-12 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">SOC 2 Type II</h3>
              <p class="text-gray-600 dark:text-neutral-400 text-sm mb-3">
                Independently audited security controls
              </p>
              <span class="inline-block px-3 py-1 text-xs font-medium text-gray-600 dark:text-neutral-400 bg-gray-100 dark:bg-neutral-800 rounded-full">
                Q2 2026
              </span>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 text-center hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6 flex justify-center">
                <Shield class="w-12 h-12 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">GDPR Compliant</h3>
              <p class="text-gray-600 dark:text-neutral-400 text-sm mb-3">
                European data protection standards
              </p>
              <span class="inline-block px-3 py-1 text-xs font-medium text-gray-700 dark:text-neutral-300 bg-gray-200 dark:bg-neutral-700 rounded-full">
                ✓ Implemented
              </span>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 text-center hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6 flex justify-center">
                <ShieldCheck class="w-12 h-12 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">HIPAA Ready</h3>
              <p class="text-gray-600 dark:text-neutral-400 text-sm mb-3">
                Healthcare data protection
              </p>
              <span class="inline-block px-3 py-1 text-xs font-medium text-gray-600 dark:text-neutral-400 bg-gray-100 dark:bg-neutral-800 rounded-full">
                Coming Q4 2026
              </span>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 text-center hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6 flex justify-center">
                <FileCheck class="w-12 h-12 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">ISO 27001</h3>
              <p class="text-gray-600 dark:text-neutral-400 text-sm mb-3">
                Information security management
              </p>
              <span class="inline-block px-3 py-1 text-xs font-medium text-gray-600 dark:text-neutral-400 bg-gray-100 dark:bg-neutral-800 rounded-full">
                Q2 2026
              </span>
            </div>
          </div>
        </div>

        <!-- Data Privacy -->
        <div class="mb-20">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              Data Privacy & Protection
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Your data privacy is paramount. We employ strict data handling practices to ensure your sensitive information remains confidential and secure.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <Database class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Data Minimization</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                We only process data necessary for redaction. No additional personal information is collected or stored.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <Clock class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Automatic Deletion</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Documents are automatically deleted from our systems after processing, with configurable retention periods.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <FileCheck class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">No Training Data</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Your documents are never used to train our AI models. All processing is done with pre-trained, static models.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <Cloud class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Cloud Security</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                Hosted on AWS with enterprise-grade security controls, including VPC isolation, WAF protection, and DDoS mitigation.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-2">
                <li>• Multi-region redundancy</li>
                <li>• Automated security patching</li>
                <li>• 24/7 monitoring and alerting</li>
                <li>• Infrastructure as code</li>
              </ul>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <Cpu class="w-8 h-8 text-gray-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Access Controls</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                Comprehensive identity and access management with multi-factor authentication, role-based permissions, and audit logging.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-2">
                <li>• Single sign-on (SSO) integration</li>
                <li>• Multi-factor authentication</li>
                <li>• Role-based access control</li>
                <li>• Complete audit trails</li>
              </ul>
            </div>
          </div>
        </div>

        <CTA
          title="Security Questions?"
          description="Our security team is available to discuss our security practices, compliance certifications, and answer any questions about protecting your data."
          background="none"
          padding="lg"
          buttons={[
            {
              text: "Contact Security Team",
              href: "/contact",
              variant: "primary"
            },
            {
              text: "Request Security Assessment",
              href: "/contact",
              variant: "secondary"
            }
          ]}
        />

      </div>
    </div>
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import { CTA } from "@/sections";

// Company updates and announcements
const updates = [
	{
		id: "enterprise-launch",
		title: "Nvisy Enterprise Platform Now Available",
		excerpt:
			"Our comprehensive document security solution is now ready for enterprise deployment, featuring advanced AI-powered redaction and enterprise-grade compliance tools.",
		date: "2024-01-15",
		category: "Product Launch",
	},
	{
		id: "compliance-certification",
		title: "SOC 2 Type II Certification Achieved",
		excerpt:
			"We've successfully completed our SOC 2 Type II audit, demonstrating our commitment to the highest standards of security, availability, and confidentiality for enterprise customers.",
		date: "2024-01-08",
		category: "Security",
	},
	{
		id: "partnership",
		title: "Strategic Partnership with Leading Cloud Providers",
		excerpt:
			"Announcing new integrations with major cloud infrastructure providers to deliver seamless document security solutions at enterprise scale.",
		date: "2024-01-02",
		category: "Partnership",
	},
];
---

<Layout
  title="Newsroom"
  description="Latest news, updates, and announcements from Nvisy. Stay informed about our enterprise document security solutions and company developments."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-neutral-900 dark:via-neutral-900 dark:to-neutral-800">
      <div class="container mx-auto px-4 py-20 md:py-24">
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
            Enterprise Newsroom
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-neutral-300 leading-relaxed mb-8">
            Stay informed about Nvisy's latest developments, product updates, and insights
            in enterprise document security and compliance.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/demo" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-200">
              Schedule Demo
            </a>
            <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-neutral-600 text-base font-medium rounded-lg text-gray-700 dark:text-neutral-300 bg-white dark:bg-neutral-800 hover:bg-gray-50 dark:hover:bg-neutral-700 transition-colors duration-200">
              Contact Sales
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16">
      <!-- Company Updates Section -->
      <section class="mb-20">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              Latest Updates
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-400 max-w-2xl mx-auto">
              Stay current with our product launches, partnerships, and enterprise program announcements.
            </p>
          </div>

          <div class="space-y-8">
            {updates.map(update => (
              <article class="bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800 p-8 hover:border-gray-300 dark:hover:border-neutral-700 transition-all duration-300 hover:shadow-lg">
                <div class="flex flex-wrap items-center gap-4 mb-6">
                  <span class="text-sm font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-3 py-1 rounded-full">
                    {update.category}
                  </span>
                  <span class="text-sm text-gray-500 dark:text-neutral-500">
                    {new Date(update.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </span>
                </div>

                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
                  {update.title}
                </h3>

                <p class="text-lg text-gray-600 dark:text-neutral-300 leading-relaxed">
                  {update.excerpt}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section class="mb-20">
        <div class="max-w-4xl mx-auto">
          <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-neutral-900 dark:to-neutral-800 rounded-2xl p-8 md:p-12 border border-gray-200 dark:border-neutral-800">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              About Nvisy
            </h2>
            <div class="space-y-4">
              <p class="text-lg text-gray-600 dark:text-neutral-300 leading-relaxed">
                Nvisy is an enterprise-focused technology company dedicated to delivering advanced document security solutions.
                Our platform combines cutting-edge AI with rigorous security standards to protect sensitive information at scale.
              </p>
              <p class="text-lg text-gray-600 dark:text-neutral-300 leading-relaxed">
                We serve organizations that demand the highest levels of security, compliance, and operational efficiency
                in their document processing workflows.
              </p>
            </div>
            <div class="mt-8">
              <a href="/about" class="inline-flex items-center text-blue-600 dark:text-blue-400 font-medium hover:underline">
                Learn more about our mission →
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Media Contact -->
      <section class="mb-16">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800 p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              Media Contact
            </h2>
            <p class="text-gray-600 dark:text-neutral-300 leading-relaxed mb-4">
              For press inquiries, interviews, or additional information about Nvisy.
            </p>
            <div class="space-y-2">
              <p class="text-gray-600 dark:text-neutral-400">
                Press: <a href="mailto:press@nvisy.com" class="text-gray-900 dark:text-white hover:underline font-medium">press@nvisy.com</a>
              </p>
              <p class="text-gray-600 dark:text-neutral-400">
                General: <a href="mailto:hello@nvisy.com" class="text-gray-900 dark:text-white hover:underline font-medium">hello@nvisy.com</a>
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- CTA Section -->
    <CTA
      title="Ready to Secure Your Documents?"
      description="Discover how Nvisy can help your organization implement automated document redaction and maintain compliance standards."
      background="gradient"
      padding="lg"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/demo",
          variant: "primary"
        },
        {
          text: "Contact Sales",
          href: "/contact",
          variant: "secondary"
        }
      ]}
    />
  </div>
</Layout>

---
import { Layout } from "@/layouts";
import { Hero } from "@/sections";
import { getCollection } from "astro:content";
import { Newspaper } from "lucide-vue-next";

// Get blog posts with "update" category
const allBlogPosts = await getCollection("blog");
const updates = allBlogPosts
	.filter((post) => post.data.category?.toLowerCase() === "update")
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.map((post) => ({
		id: post.slug,
		title: post.data.title,
		excerpt: post.data.excerpt || post.data.description,
		date: post.data.publishedAt,
		category: post.data.category || "Update",
		href: `/blog/${post.slug}`,
	}));
---
<Layout
  title="Newsroom"
  description="Latest news, updates, and announcements from Nvisy. Stay informed about our enterprise document security solutions and company developments."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Newsroom"
      description="Stay informed about Nvisy's latest developments, product updates, and insights in document security and compliance."
      background="gradient"
      fontSize="xl"
      padding="xl"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/demo",
          variant: "primary"
        },
        {
          text: "Contact Sales",
          href: "/contact",
          variant: "secondary"
        }
      ]}
    />

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16">
      <!-- Company Updates Section -->
      <section class="mb-20">
        <div class="max-w-4xl mx-auto">

          <!-- Updates -->
          {updates.length > 0 ? (
            <div class="space-y-8">
              {updates.map(update => (
                <a
                  href={update.href}
                  class="block bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800 p-8 hover:border-gray-300 dark:hover:border-neutral-700 transition-all duration-300 hover:shadow-lg group"
                >
                  <div class="flex flex-wrap items-center gap-4 mb-6">
                    <span class="text-sm font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-3 py-1 rounded-full">
                      {update.category}
                    </span>
                    <span class="text-sm text-gray-500 dark:text-neutral-500">
                      {new Date(update.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </span>
                  </div>

                  <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {update.title}
                  </h3>

                  <p class="text-lg text-gray-600 dark:text-neutral-300 leading-relaxed">
                    {update.excerpt}
                  </p>
                </a>
              ))}
            </div>
          ) : (
            // Empty updates
            <div class="text-center py-32">
              <div class="flex justify-center mb-6">
                <div class="p-4 rounded-full bg-gray-100 dark:bg-neutral-800">
                  <Newspaper class="w-12 h-12 text-gray-400 dark:text-neutral-500" />
                </div>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                No Updates Yet
              </h3>
              <p class="text-gray-600 dark:text-neutral-400">
                Check back soon for the latest news and announcements.
              </p>
            </div>
          )}
        </div>
      </section>
    </div>
  </div>
</Layout>

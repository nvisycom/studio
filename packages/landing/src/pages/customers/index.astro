---
import { Layout } from "@/layouts";
import { CTA, Testimonials, Hero } from "@/sections";

const companyStats = [
	{ label: "Enterprise Customers", value: "500+" },
	{ label: "Documents Protected", value: "50M+" },
	{ label: "Industries Served", value: "25+" },
	{ label: "Customer Satisfaction", value: "99.8%" },
];

const industries = [
	{
		name: "Healthcare",
		count: "250+ organizations",
		icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
	},
	{
		name: "Financial Services",
		count: "180+ institutions",
		icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1",
	},
	{
		name: "Legal",
		count: "320+ law firms",
		icon: "M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3",
	},
	{
		name: "Government",
		count: "150+ agencies",
		icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
	},
	{
		name: "Insurance",
		count: "95+ companies",
		icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
	},
	{
		name: "Technology",
		count: "200+ companies",
		icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
	},
];

const caseStudies = [
	{
		company: "Metro General Hospital",
		industry: "Healthcare",
		metric: "75%",
		metricDescription: "Reduction in manual review time",
		description:
			"Transformed medical records management while ensuring complete HIPAA compliance. Our AI accuracy has dramatically improved patient data sharing for research.",
		compliance: "HIPAA Compliant",
	},
	{
		company: "National Credit Union",
		industry: "Financial Services",
		metric: "90%",
		metricDescription: "Faster loan processing",
		description:
			"Loan application processing went from weeks to days. Automated redaction of sensitive financial information enables secure document sharing with underwriters.",
		compliance: "PCI-DSS Compliant",
	},
	{
		company: "City Legal Department",
		industry: "Government",
		metric: "60%",
		metricDescription: "Cost savings on document review",
		description:
			"FOIA requests that used to take weeks now get processed in hours. Government-ready security features provide confidence handling sensitive public documents.",
		compliance: "FedRAMP Ready",
	},
];
---

<Layout
  title="Customers"
  description="See how leading organizations across industries use Nvisy to protect sensitive data and streamline document workflows with enterprise-grade security."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Trusted by Industry Leaders"
      description="From Fortune 500 enterprises to innovative startups, organizations worldwide rely on Nvisy to protect sensitive data and accelerate their document workflows."
      background="dark"
      fontSize="xl"
      padding="xl"
      buttons={[]}
    />
    <div class="border-b border-gray-200 dark:border-neutral-800"></div>

    <!-- Stats Section -->
    <div class="bg-gray-50 dark:bg-neutral-900 py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {companyStats.map(stat => (
              <div class="text-center">
                <div class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">
                  {stat.value}
                </div>
                <div class="text-gray-600 dark:text-neutral-400 font-medium">
                  {stat.label}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Success Stories -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Customer Success Stories
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
            Real results from real customers. See how organizations are transforming their document workflows with enterprise-grade security.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {caseStudies.map(study => (
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  {study.company}
                </h3>
                <p class="text-sm text-gray-500 dark:text-neutral-500">
                  {study.industry}
                </p>
              </div>

              <div class="mb-6">
                <div class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
                  {study.metric}
                </div>
                <p class="text-gray-600 dark:text-neutral-400 text-sm">
                  {study.metricDescription}
                </p>
              </div>

              <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
                "{study.description}"
              </p>

              <div class="text-sm text-gray-500 dark:text-neutral-500">
                ✓ {study.compliance}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Industries Section -->
    <div class="bg-gray-50 dark:bg-neutral-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Industries We Serve
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Organizations across all industries trust Nvisy to handle their most sensitive documents with the highest levels of security and compliance.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {industries.map(industry => (
              <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 bg-white dark:bg-black hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
                <div class="mb-4">
                  <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={industry.icon} />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
                  {industry.name}
                </h3>
                <p class="text-gray-600 dark:text-neutral-400">
                  {industry.count}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Trusted Brands -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Trusted by Leading Organizations
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300">
            Join the growing number of enterprises that trust Nvisy with their most sensitive documents
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
          {["HealthCorp", "TechStart Inc", "Global Bank", "Legal Partners", "InsureTech", "GovAgency", "MedCenter", "FinanceFirst", "LawGroup", "StateOffice", "DataCorp", "SecureBank"].map(company => (
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg h-20 flex items-center justify-center hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <span class="text-gray-500 dark:text-neutral-500 font-medium text-sm">
                {company}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Why Choose Nvisy -->
    <div class="bg-gray-50 dark:bg-neutral-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Why Customers Choose Nvisy
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300 mb-12 max-w-2xl mx-auto">
            Enterprise-grade features and world-class support that organizations rely on to protect their most sensitive data.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="mb-4">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Enterprise Security</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                SOC 2 compliant with end-to-end encryption, zero-trust architecture, and comprehensive audit trails.
              </p>
            </div>

            <div class="text-center">
              <div class="mb-4">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">AI-Powered Accuracy</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Advanced machine learning delivers 99.8% accuracy in detecting and redacting sensitive information.
              </p>
            </div>

            <div class="text-center">
              <div class="mb-4">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Expert Support</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Dedicated customer success team and technical experts available to ensure your success.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Testimonials -->
    <Testimonials
      title="What Our Customers Say"
      description="Hear directly from organizations that have transformed their document workflows with Nvisy."
      backgroundColor="white"
    />

    <!-- Call to Action -->
    <CTA
      title="Join Leading Organizations"
      description="Ready to protect your sensitive documents and accelerate your workflows? See how Nvisy can transform your organization."
      background="gradient"
      padding="lg"
      buttons={[
        {
          text: "Request Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "Contact Sales",
          href: "/contact",
          variant: "secondary",
          icon: "mail"
        }
      ]}
    />
  </div>
</Layout>

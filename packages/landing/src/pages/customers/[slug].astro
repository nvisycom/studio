---
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
	// In a real implementation, this would fetch from a CMS or markdown files
	// For now, we'll define some sample customer stories
	const customerStories = [
		{
			slug: "techcorp-data-protection",
			title: "TechCorp Streamlines Data Protection Compliance",
			company: "TechCorp Solutions",
			industry: "Financial Services",
			employees: "10,000+",
			location: "New York, NY",
			challenge:
				"Manual document redaction was taking weeks and risked compliance violations",
			solution: "Nvisy Cloud automated redaction with 99.9% accuracy",
			results: [
				"95% reduction in processing time",
				"Zero compliance violations in 18 months",
				"$2.4M annual savings in manual labor",
				"Improved customer satisfaction scores",
			],
			quote:
				"Nvisy transformed our document processing workflow. What used to take weeks now takes hours, and we have complete confidence in our compliance.",
			author: "Sarah Johnson",
			authorTitle: "Chief Compliance Officer",
			authorImage: "/images/customers/sarah-johnson.jpg",
			companyLogo: "/images/customers/techcorp-logo.svg",
			heroImage: "/images/customers/techcorp-hero.jpg",
			tags: ["Financial Services", "Compliance", "Enterprise"],
			publishDate: "2024-01-15",
		},
		{
			slug: "healthplus-hipaa-compliance",
			title: "HealthPlus Achieves HIPAA Compliance at Scale",
			company: "HealthPlus Medical",
			industry: "Healthcare",
			employees: "5,000+",
			location: "Chicago, IL",
			challenge:
				"Processing thousands of patient records while maintaining HIPAA compliance",
			solution:
				"Nvisy Local for on-premise security with automated PHI detection",
			results: [
				"100% HIPAA compliance maintained",
				"80% faster patient record processing",
				"Enhanced patient privacy protection",
				"Streamlined audit processes",
			],
			quote:
				"Patient privacy is paramount. Nvisy gives us the confidence that every document is properly secured while maintaining our operational efficiency.",
			author: "Dr. Michael Chen",
			authorTitle: "Chief Medical Information Officer",
			authorImage: "/images/customers/michael-chen.jpg",
			companyLogo: "/images/customers/healthplus-logo.svg",
			heroImage: "/images/customers/healthplus-hero.jpg",
			tags: ["Healthcare", "HIPAA", "Privacy"],
			publishDate: "2024-02-01",
		},
		{
			slug: "govtech-digital-transformation",
			title: "GovTech Modernizes Public Records Management",
			company: "GovTech Solutions",
			industry: "Government",
			employees: "2,500+",
			location: "Washington, DC",
			challenge:
				"Legacy document systems couldn't handle privacy requirements for digital services",
			solution: "Nvisy Enterprise with custom government compliance modules",
			results: [
				"500% increase in public record requests processed",
				"Full FOIA compliance automation",
				"24/7 citizen service availability",
				"Reduced processing costs by 60%",
			],
			quote:
				"Nvisy helped us bring government services into the 21st century while maintaining the highest standards of citizen privacy.",
			author: "Jennifer Martinez",
			authorTitle: "Director of Digital Services",
			authorImage: "/images/customers/jennifer-martinez.jpg",
			companyLogo: "/images/customers/govtech-logo.svg",
			heroImage: "/images/customers/govtech-hero.jpg",
			tags: ["Government", "Digital Transformation", "Public Records"],
			publishDate: "2024-01-28",
		},
	];

	return customerStories.map((story) => ({
		params: { slug: story.slug },
		props: { story },
	}));
}

const { story } = Astro.props;
---

<Layout
  title={`${story.title} | Customer Success Stories`}
  description={`Learn how ${story.company} in ${story.industry} transformed their document workflows with Nvisy. ${story.challenge}`}
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Breadcrumb Navigation -->
    <div class="border-b border-gray-200 dark:border-neutral-700 bg-gray-50 dark:bg-neutral-900">
      <div class="container mx-auto px-4 py-4">
        <nav class="flex items-center space-x-2 text-sm">
          <a
            href="/"
            class="text-gray-500 dark:text-neutral-400 hover:text-gray-700 dark:hover:text-neutral-300 transition-colors"
          >
            Home
          </a>
          <span class="text-gray-400 dark:text-neutral-500">/</span>
          <a
            href="/customers"
            class="text-gray-500 dark:text-neutral-400 hover:text-gray-700 dark:hover:text-neutral-300 transition-colors"
          >
            Customers
          </a>
          <span class="text-gray-400 dark:text-neutral-500">/</span>
          <span class="text-gray-900 dark:text-white font-medium">{story.company}</span>
        </nav>
      </div>
    </div>

    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-gray-50 via-white to-gray-50 dark:from-black dark:via-black dark:to-black py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <!-- Company Info -->
          <div class="flex items-center gap-4 mb-8">
            <img
              src={story.companyLogo}
              alt={`${story.company} logo`}
              class="w-16 h-16 object-contain"
            />
            <div>
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white">{story.company}</h2>
              <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-neutral-400">
                <span>{story.industry}</span>
                <span>•</span>
                <span>{story.employees} employees</span>
                <span>•</span>
                <span>{story.location}</span>
              </div>
            </div>
          </div>

          <!-- Main Title -->
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
            {story.title}
          </h1>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-8">
            {story.tags.map((tag) => (
              <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs font-medium rounded-full">
                {tag}
              </span>
            ))}
          </div>

          <!-- Key Metrics -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {story.results.slice(0, 4).map((result) => (
              <div class="text-center">
                <div class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400 mb-1">
                  {result.split(' ')[0]}
                </div>
                <div class="text-sm text-gray-600 dark:text-neutral-400">
                  {result.split(' ').slice(1).join(' ')}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <!-- Quote Section -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-950/30 dark:to-indigo-950/30 rounded-2xl p-8 mb-16 border border-blue-100 dark:border-blue-800/30">
          <div class="flex items-start gap-6">
            <img
              src={story.authorImage}
              alt={story.author}
              class="w-20 h-20 rounded-full object-cover"
            />
            <div class="flex-1">
              <blockquote class="text-xl md:text-2xl text-gray-900 dark:text-white mb-4 font-medium leading-relaxed">
                "{story.quote}"
              </blockquote>
              <div class="text-gray-700 dark:text-neutral-300">
                <div class="font-semibold">{story.author}</div>
                <div class="text-sm text-gray-600 dark:text-neutral-400">{story.authorTitle}</div>
                <div class="text-sm text-gray-600 dark:text-neutral-400">{story.company}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Challenge & Solution Grid -->
        <div class="grid md:grid-cols-2 gap-12 mb-16">
          <!-- Challenge -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              The Challenge
            </h3>
            <p class="text-gray-700 dark:text-neutral-300 leading-relaxed text-lg">
              {story.challenge}
            </p>
          </div>

          <!-- Solution -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              The Solution
            </h3>
            <p class="text-gray-700 dark:text-neutral-300 leading-relaxed text-lg">
              {story.solution}
            </p>
          </div>
        </div>

        <!-- Results Section -->
        <div class="mb-16">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">
            Results & Impact
          </h3>
          <div class="grid md:grid-cols-2 gap-6">
            {story.results.map((result, index) => (
              <div class="flex items-start gap-4 p-6 bg-gray-50 dark:bg-neutral-800 rounded-xl">
                <div class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center text-sm font-bold">
                  {index + 1}
                </div>
                <div class="text-gray-700 dark:text-neutral-300 font-medium">
                  {result}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA Section -->
        <div class="bg-gradient-to-r from-gray-900 to-black dark:from-neutral-800 dark:to-neutral-900 rounded-2xl p-8 text-center text-white">
          <h3 class="text-2xl font-bold mb-4">
            Ready to Transform Your Document Workflow?
          </h3>
          <p class="text-gray-300 mb-6 text-lg">
            Join {story.company} and hundreds of other organizations using Nvisy to protect sensitive data.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/signup"
              class="inline-flex items-center justify-center bg-white text-gray-900 font-medium px-6 py-3 rounded-lg hover:bg-gray-100 transition-colors"
            >
              Start Free Trial
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center border border-white text-white font-medium px-6 py-3 rounded-lg hover:bg-white/10 transition-colors"
            >
              Contact Sales
            </a>
          </div>
        </div>

        <!-- Navigation -->
        <div class="mt-16 pt-8 border-t border-gray-200 dark:border-neutral-700">
          <a
            href="/customers"
            class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium group"
          >
            <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Back to All Customer Stories
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

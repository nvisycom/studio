---
import { Layout } from "@/layouts";
import { Hero, CTA, Testimonials } from "@/sections";
import { CheckCircle, ArrowRight } from "lucide-vue-next";
import Logo from "@/components/Logo.astro";
import { getCollection } from "astro:content";

const comparisons = await getCollection("comparisons");
---

<Layout
  title="Comparisons | Nvisy vs Competition"
  description="Compare Nvisy with leading document redaction and privacy solutions. See how we stack up against Redactable.com, Adobe Redaction, and iDox.ai."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="How Nvisy Compares"
      description="See how Nvisy's privacy-first document redaction solution stacks up against the competition. We've done the research so you don't have to."
      background="solid"
      fontSize="lg"
      padding="md"
      buttons={[]}
    />

    <!-- Comparisons Grid -->
    <div class="bg-neutral-50 dark:bg-neutral-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-black dark:text-white mb-4">
              Detailed Comparisons
            </h2>
            <p class="text-lg text-black/70 dark:text-white/70 max-w-2xl mx-auto">
              In-depth analysis of how Nvisy compares with leading document redaction solutions
            </p>
          </div>

          <!-- Comparison Cards -->
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {comparisons.map((comparison) => {
              const data = comparison.data;
              const competitorInitial = data.competitor.name.charAt(0);
              const nvisyStrengths = data.overview.nvisy.strengths.slice(0, 3);

              return (
                <div class="bg-white dark:bg-neutral-800 rounded-2xl border border-black/5 dark:border-white/5 overflow-hidden group hover:border-black/20 dark:hover:border-white/20 transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
                  <div class="p-8">
                    <div class="flex items-center justify-between mb-6">
                      <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-lg">
                          <Logo size="sm" class="w-full h-full" />
                        </div>
                        <span class="text-black/30 dark:text-white/30 text-xl font-light">vs</span>
                        <div class="w-12 h-12 bg-red-600 rounded-xl flex items-center justify-center shadow-lg">
                          <span class="text-white font-bold text-lg">{competitorInitial}</span>
                        </div>
                      </div>
                    </div>

                    <h3 class="text-2xl font-bold text-black dark:text-white mb-4">
                      {data.title}
                    </h3>

                    <p class="text-black/70 dark:text-white/70 mb-8 leading-relaxed">
                      {data.competitor.description}
                    </p>

                    <div class="space-y-3 mb-8">
                      {nvisyStrengths.map((strength) => (
                        <div class="flex items-start gap-3">
                          <CheckCircle class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" />
                          <span class="text-sm text-black/80 dark:text-white/80">{strength}</span>
                        </div>
                      ))}
                    </div>

                    <a
                      href={`/comparisons/${data.slug}`}
                      class="inline-flex items-center justify-center w-full bg-black dark:bg-white text-white dark:text-black font-semibold py-3.5 px-6 rounded-xl hover:bg-black/90 dark:hover:bg-white/90 transition-all group-hover:shadow-lg"
                    >
                      View Full Comparison
                      <ArrowRight class="w-4 h-4 ml-2" />
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonials Section -->
    <Testimonials
      title="Trusted by Enterprise Leaders"
      description="See what our customers say about transforming their document security workflows."
      backgroundColor="white"
      featured={true}
      limit={6}
    />

    <!-- CTA Section -->
    <CTA />
  </div>
</Layout>

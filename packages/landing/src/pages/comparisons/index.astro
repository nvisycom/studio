---
import { Layout } from "@/layouts";
import { Hero, CTA } from "@/sections";
---

<Layout
  title="Comparisons | Nvisy vs Competition"
  description="Compare Nvisy with leading document redaction and privacy solutions. See how we stack up against Redactable.com, Adobe Redaction, and iDox.ai."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="How Nvisy Compares"
      description="See how Nvisy's privacy-first document redaction solution stacks up against the competition. We've done the research so you don't have to."
      background="solid"
      fontSize="lg"
      padding="lg"
      buttons={[]}
    />

        <!-- Key Advantages -->
        <div class="container mx-auto px-4 py-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-3xl mx-auto mb-12">
            <div class="text-center">
              <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-lg font-semibold text-black dark:text-white mb-2">Higher Accuracy</div>
              <div class="text-black/70 dark:text-white/70">99.9% redaction accuracy with advanced AI</div>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <div class="text-lg font-semibold text-black dark:text-white mb-2">Better Security</div>
              <div class="text-black/70 dark:text-white/70">On-premise options for maximum control</div>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="text-lg font-semibold text-black dark:text-white mb-2">Faster Processing</div>
              <div class="text-black/70 dark:text-white/70">10x faster than traditional methods</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparisons Grid -->
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-black dark:text-white mb-4">
            Detailed Comparisons
          </h2>
          <p class="text-lg text-black/70 dark:text-white/70 max-w-2xl mx-auto">
            In-depth analysis of how Nvisy compares with leading document redaction solutions
          </p>
        </div>

        <!-- Comparison Cards -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Nvisy vs Redactable.com -->
          <div class="bg-white dark:bg-neutral-800 rounded-2xl border border-black/10 dark:border-white/10 p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-lg">N</span>
                </div>
                <span class="text-black/40 dark:text-white/40 text-xl">vs</span>
                <div class="w-10 h-10 bg-red-500 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-lg">R</span>
                </div>
              </div>
            </div>

            <h3 class="text-xl font-bold text-black dark:text-white mb-3">
              Nvisy vs Redactable.com
            </h3>

            <p class="text-black/70 dark:text-white/70 mb-6 leading-relaxed">
              Compare our privacy-first approach with Redactable's cloud-only solution.
              See the differences in security, accuracy, and pricing.
            </p>

            <div class="space-y-3 mb-6">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">On-premise deployment option</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">Higher redaction accuracy</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">Better enterprise support</span>
              </div>
            </div>

            <a
              href="/comparisons/redactable"
              class="inline-flex items-center justify-center w-full bg-black dark:bg-white text-white dark:text-black font-medium py-3 px-6 rounded-lg hover:bg-black/90 dark:hover:bg-white/90 transition-colors"
            >
              View Full Comparison
            </a>
          </div>

          <!-- Nvisy vs Adobe Redaction -->
          <div class="bg-white dark:bg-neutral-800 rounded-2xl border border-black/10 dark:border-white/10 p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-lg">N</span>
                </div>
                <span class="text-black/40 dark:text-white/40 text-xl">vs</span>
                <div class="w-10 h-10 bg-red-600 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-lg">A</span>
                </div>
              </div>
            </div>

            <h3 class="text-xl font-bold text-black dark:text-white mb-3">
              Nvisy vs Adobe Redaction
            </h3>

            <p class="text-black/70 dark:text-white/70 mb-6 leading-relaxed">
              Compare our modern AI-powered solution with Adobe's traditional document
              redaction tools. See the advantages in speed and automation.
            </p>

            <div class="space-y-3 mb-6">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">Automated batch processing</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">API-first architecture</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">Lower total cost of ownership</span>
              </div>
            </div>

            <a
              href="/comparisons/adobe"
              class="inline-flex items-center justify-center w-full bg-black dark:bg-white text-white dark:text-black font-medium py-3 px-6 rounded-lg hover:bg-black/90 dark:hover:bg-white/90 transition-colors"
            >
              View Full Comparison
            </a>
          </div>

          <!-- Nvisy vs iDox.ai -->
          <div class="bg-white dark:bg-neutral-800 rounded-2xl border border-black/10 dark:border-white/10 p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-lg">N</span>
                </div>
                <span class="text-black/40 dark:text-white/40 text-xl">vs</span>
                <div class="w-10 h-10 bg-purple-600 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-lg">i</span>
                </div>
              </div>
            </div>

            <h3 class="text-xl font-bold text-black dark:text-white mb-3">
              Nvisy vs iDox.ai
            </h3>

            <p class="text-black/70 dark:text-white/70 mb-6 leading-relaxed">
              Compare our specialized redaction focus with iDox's broader AI document
              processing platform. See why specialization matters.
            </p>

            <div class="space-y-3 mb-6">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">Purpose-built for redaction</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">Superior privacy compliance</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-black/80 dark:text-white/80">More transparent pricing</span>
              </div>
            </div>

            <a
              href="/comparisons/idox"
              class="inline-flex items-center justify-center w-full bg-black dark:bg-white text-white dark:text-black font-medium py-3 px-6 rounded-lg hover:bg-black/90 dark:hover:bg-white/90 transition-colors"
            >
              View Full Comparison
            </a>
          </div>
        </div>

        <!-- Feature Comparison Table -->
        <div class="mt-16">
          <h3 class="text-2xl font-bold text-black dark:text-white mb-8 text-center">
            Quick Feature Comparison
          </h3>

          <div class="overflow-x-auto">
            <table class="w-full bg-white dark:bg-neutral-800 rounded-xl border border-black/10 dark:border-white/10">
              <thead>
                <tr class="bg-white dark:bg-neutral-700 border-b border-black/10 dark:border-white/10">
                  <th class="text-left py-4 px-6 font-semibold text-black dark:text-white">Feature</th>
                  <th class="text-center py-4 px-6 font-semibold text-blue-600 dark:text-blue-400">Nvisy</th>
                  <th class="text-center py-4 px-6 font-semibold text-black/60 dark:text-white/60">Redactable</th>
                  <th class="text-center py-4 px-6 font-semibold text-black/60 dark:text-white/60">Adobe</th>
                  <th class="text-center py-4 px-6 font-semibold text-black/60 dark:text-white/60">iDox</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-black/10 dark:divide-white/10">
                <tr>
                  <td class="py-4 px-6 text-black dark:text-white">On-Premise Deployment</td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-red-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-red-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
                <tr class="bg-black/5 dark:bg-white/5">
                  <td class="py-4 px-6 text-black dark:text-white">API Access</td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <span class="text-black/50 dark:text-white/50">Limited</span>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
                <tr>
                  <td class="py-4 px-6 text-black dark:text-white">Batch Processing</td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <span class="text-black/50 dark:text-white/50">Limited</span>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-red-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </td>
                  <td class="text-center py-4 px-6">
                    <svg class="w-6 h-6 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <CTA />
  </div>
</Layout>

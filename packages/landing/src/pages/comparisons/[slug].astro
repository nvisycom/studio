---
import { Layout } from "@/layouts";
import { CTA } from "@/sections";
import { getCollection } from "astro:content";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import { CheckCircle, X, Building2, Shield, Award } from "lucide-vue-next";
import Logo from "@/components/Logo.astro";

export async function getStaticPaths() {
	const comparisons = await getCollection("comparisons");

	return comparisons.map((comparison) => ({
		params: { slug: comparison.id },
		props: { comparison: comparison.data },
	}));
}

const { comparison } = Astro.props;
---

<Layout
  title={`${comparison.title} | Detailed Comparison`}
  description={`Comprehensive comparison between Nvisy and ${comparison.competitor.name}. Compare features, pricing, and use cases to make the right choice for your document redaction needs.`}
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Breadcrumb Navigation -->
    <div class="bg-white dark:bg-black">
      <div class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
          <Breadcrumb>
            <BreadcrumbList>
              <BreadcrumbItem>
                <BreadcrumbLink href="/comparisons">
                  Comparisons
                </BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                <BreadcrumbPage>
                  {comparison.competitor.name}
                </BreadcrumbPage>
              </BreadcrumbItem>
            </BreadcrumbList>
          </Breadcrumb>
        </div>
      </div>
    </div>

    <!-- Hero Section -->
    <div class="relative bg-white dark:bg-black pb-12">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <!-- Comparison Header -->
          <div class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-black dark:text-white mb-6">
              {comparison.title}
            </h1>
            <p class="text-xl text-black/70 dark:text-white/70 max-w-3xl mx-auto leading-relaxed">
              A comprehensive comparison to help you choose the right document redaction solution
              for your organization's needs.
            </p>
          </div>

          <!-- Company Comparison Cards -->
          <div class="grid md:grid-cols-2 gap-10 mb-16">
            <!-- Nvisy Card -->
            <div class="bg-gradient-to-br from-blue-50 to-white dark:from-blue-950/20 dark:to-neutral-800 rounded-3xl p-10 border-2 border-blue-200 dark:border-blue-700 shadow-lg">
              <div class="flex items-center gap-4 mb-8">
                <div class="w-20 h-20 rounded-2xl flex items-center justify-center shadow-xl">
                  <Logo size="md" class="w-full h-full" />
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-black dark:text-white">Nvisy</h3>
                  <p class="text-black/70 dark:text-white/70 text-lg">Privacy-first document redaction</p>
                </div>
              </div>

              <div class="space-y-5">
                <div>
                  <h4 class="font-semibold text-black dark:text-white mb-4 text-lg flex items-center gap-2">
                    <Award class="w-5 h-5 text-blue-600" />
                    Key Strengths
                  </h4>
                  <ul class="space-y-3">
                    {comparison.overview.nvisy.strengths.map((strength: string) => (
                      <li class="flex items-start gap-3 text-black/80 dark:text-white/80">
                        <CheckCircle class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" />
                        <span>{strength}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Competitor Card -->
            <div class="bg-white dark:bg-neutral-800 rounded-3xl p-10 border border-black/10 dark:border-white/10 shadow-lg">
              <div class="flex items-center gap-4 mb-8">
                <img
                  src={comparison.competitor.logo}
                  alt={`${comparison.competitor.name} logo`}
                  class="w-20 h-20 object-contain rounded-2xl"
                />
                <div>
                  <h3 class="text-2xl font-bold text-black dark:text-white">{comparison.competitor.name}</h3>
                  <p class="text-black/70 dark:text-white/70 text-lg">{comparison.competitor.description}</p>
                </div>
              </div>

              <div class="space-y-5">
                <div>
                  <h4 class="font-semibold text-black dark:text-white mb-4 text-lg flex items-center gap-2">
                    <Building2 class="w-5 h-5 text-black/60 dark:text-white/60" />
                    Key Strengths
                  </h4>
                  <ul class="space-y-3">
                    {comparison.overview.competitor.strengths.map((strength: string) => (
                      <li class="flex items-start gap-3 text-black/80 dark:text-white/80">
                        <CheckCircle class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" />
                        <span>{strength}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature Comparison Table -->
    <div class="bg-neutral-50 dark:bg-neutral-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-black dark:text-white mb-4">
              Feature Comparison
            </h2>
            <p class="text-lg text-black/70 dark:text-white/70">
              Side-by-side comparison of capabilities and features
            </p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full bg-white dark:bg-neutral-800 rounded-2xl border border-black/10 dark:border-white/10 shadow-lg overflow-hidden">
              <thead>
                <tr class="bg-neutral-50 dark:bg-neutral-700 border-b-2 border-black/10 dark:border-white/10">
                  <th class="text-left py-5 px-8 font-semibold text-black dark:text-white text-lg">Feature</th>
                  <th class="text-center py-5 px-8 font-semibold text-blue-600 dark:text-blue-400 text-lg">Nvisy</th>
                  <th class="text-center py-5 px-8 font-semibold text-black/60 dark:text-white/60 text-lg">{comparison.competitor.name}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-black/10 dark:divide-white/10">
                {comparison.features.map((feature: any, index: number) => (
                  <tr class={index % 2 === 0 ? "bg-white dark:bg-neutral-800" : "bg-neutral-50/50 dark:bg-white/5"}>
                    <td class="py-5 px-8 text-black dark:text-white font-medium">{feature.name}</td>
                    <td class="text-center py-5 px-8">
                      {typeof feature.nvisy === 'boolean' ? (
                        feature.nvisy ? (
                          <div class="inline-flex items-center justify-center w-10 h-10 bg-green-50 dark:bg-green-900/20 rounded-full">
                            <CheckCircle class="w-6 h-6 text-green-500" />
                          </div>
                        ) : (
                          <div class="inline-flex items-center justify-center w-10 h-10 bg-red-50 dark:bg-red-900/20 rounded-full">
                            <X class="w-6 h-6 text-red-500" />
                          </div>
                        )
                      ) : (
                        <span class="font-semibold text-green-600 dark:text-green-400">{feature.nvisy}</span>
                      )}
                    </td>
                    <td class="text-center py-5 px-8">
                      {typeof feature.competitor === 'boolean' ? (
                        feature.competitor ? (
                          <div class="inline-flex items-center justify-center w-10 h-10 bg-green-50 dark:bg-green-900/20 rounded-full">
                            <CheckCircle class="w-6 h-6 text-green-500" />
                          </div>
                        ) : (
                          <div class="inline-flex items-center justify-center w-10 h-10 bg-red-50 dark:bg-red-900/20 rounded-full">
                            <X class="w-6 h-6 text-red-500" />
                          </div>
                        )
                      ) : (
                        <span class="font-semibold text-black/60 dark:text-white/60">{feature.competitor}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Use Cases Comparison -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-black dark:text-white mb-4">
            Use Case Analysis
          </h2>
          <p class="text-lg text-black/70 dark:text-white/70">
            How each solution performs in real-world scenarios
          </p>
        </div>

        <div class="space-y-6">
          {comparison.useCases.map((useCase: any, index: number) => (
            <div class="bg-white dark:bg-neutral-800 rounded-2xl border border-black/10 dark:border-white/10 overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
              <div class="bg-neutral-50 dark:bg-neutral-700 px-8 py-5 border-b border-black/10 dark:border-white/10">
                <h3 class="text-xl font-bold text-black dark:text-white flex items-center gap-3">
                  <Shield class="w-6 h-6 text-blue-600 dark:text-blue-400" />
                  {useCase.title}
                </h3>
              </div>
              <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-black/10 dark:divide-white/10">
                <div class="p-8">
                  <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shadow-lg">
                      <Logo size="sm" class="w-full h-full" />
                    </div>
                    <h4 class="font-semibold text-black dark:text-white text-lg">Nvisy Advantage</h4>
                  </div>
                  <p class="text-black/80 dark:text-white/80 leading-relaxed">{useCase.nvisy}</p>
                </div>
                <div class="p-8">
                  <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 bg-neutral-400 dark:bg-neutral-600 rounded-xl flex items-center justify-center shadow-lg">
                      <span class="text-white dark:text-black font-bold">C</span>
                    </div>
                    <h4 class="font-semibold text-black dark:text-white text-lg">{comparison.competitor.name}</h4>
                  </div>
                  <p class="text-black/80 dark:text-white/80 leading-relaxed">{useCase.competitor}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Decision Helper -->
    <CTA
      title="Ready to Make Your Decision?"
      description="See how Nvisy can transform your document redaction workflow with a free trial."
      background="gradient"
      fontSize="lg"
      padding="lg"
      buttons={[
        {
          text: "Start Free Trial",
          href: "/signup",
          variant: "primary"
        },
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "secondary"
        }
      ]}
    />
  </div>
</Layout>

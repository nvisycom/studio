---
import { Layout } from "@/layouts";
import { CompanyStats } from "@/sections";
import { Button } from "@/components/ui/button";
import { ChevronRight } from "lucide-vue-next";

import { getCollection } from "astro:content";

const teamMembers = [
	{
		name: "Sarah Johnson",
		role: "CEO & Co-Founder",
		bio: "Former VP of Product at Fortune 500 company. Passionate about building enterprise tools that drive real business outcomes.",
		image: "SJ",
	},
	{
		name: "Michael Chen",
		role: "CTO & Co-Founder",
		bio: "15+ years building scalable systems for enterprise customers. Expert in AI/ML and document processing technologies.",
		image: "MC",
	},
	{
		name: "Emma Rodriguez",
		role: "Head of Engineering",
		bio: "Former principal engineer at major tech companies. Leads our technical vision and platform architecture.",
		image: "ER",
	},
	{
		name: "David Kim",
		role: "VP of Product",
		bio: "Product leader with deep expertise in enterprise software and regulatory compliance requirements.",
		image: "DK",
	},
];

const values = [
	{
		title: "Security First",
		description:
			"Every decision prioritizes the security and privacy of customer data above all else.",
	},
	{
		title: "Enterprise Focus",
		description:
			"Built for the scale, reliability, and compliance requirements of enterprise organizations.",
	},
	{
		title: "Continuous Innovation",
		description:
			"Constantly advancing our AI capabilities to stay ahead of emerging threats and use cases.",
	},
	{
		title: "Customer Success",
		description:
			"Our success is measured by the tangible business value we deliver to our customers.",
	},
];

// Get blog entries from content/blog
const blogEntries = (await getCollection("blog"))
	.sort(
		(rhs, lhs) =>
			new Date(lhs.data.publishedAt).getTime() -
			new Date(rhs.data.publishedAt).getTime(),
	)
	.slice(0, 3); // Only show first 3 posts
---

<Layout
  title="About Us"
  description="Learn about Nvisy's mission to revolutionize document redaction and data protection for enterprise organizations worldwide."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Mission & Story -->
    <div class="container mx-auto px-4 py-20 pb-12">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
            Our Mission
          </h1>
          <p class="text-xl text-gray-600 dark:text-neutral-300 leading-relaxed">
            To provide enterprise organizations with the most secure, accurate, and efficient document redaction platform,
            enabling them to protect sensitive data while maintaining business velocity.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">
              The Challenge
            </h2>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed mb-4">
              Enterprise organizations process millions of documents containing sensitive information. Traditional redaction methods are manual, error-prone, and don't scale with business needs.
            </p>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
              Compliance requirements are becoming more stringent, while the volume and complexity of documents continue to grow exponentially.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">
              Our Solution
            </h2>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed mb-4">
              We've built an AI-powered platform that automatically identifies and redacts sensitive information with enterprise-grade accuracy and security.
            </p>
            <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
              Our solution integrates seamlessly into existing workflows while providing the transparency, auditability, and control that enterprises require.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Values -->
    <div class="bg-gray-50 dark:bg-neutral-900 py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Our Values
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              These principles guide every decision we make, from product development to customer relationships.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {values.map(value => (
              <div class="bg-white dark:bg-black rounded-lg border border-gray-200 dark:border-neutral-700 p-8">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
                  {value.title}
                </h3>
                <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Leadership Team -->
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Leadership Team
          </h2>
          <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
            Our team combines deep expertise in AI, enterprise software, and regulatory compliance to deliver world-class solutions.
          </p>
        </div>

        <div class="flex justify-center mb-8">
          <div class="w-48 h-48 bg-gray-200 dark:bg-neutral-700 rounded-full flex items-center justify-center">
            <span class="text-4xl text-gray-500 dark:text-neutral-400">Team Photo</span>
          </div>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 dark:text-neutral-300">
            {teamMembers.map((member) => member.name).join(', ')}
          </p>
        </div>
      </div>
    </div>

    <!-- Company Stats -->
    <CompanyStats backgroundColor="white" />

    <!-- We Are Hiring Section -->
    <div class="bg-gray-50 dark:bg-black py-32">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              We Are Hiring
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto mb-8">
              Join our team and help build the future of enterprise document security.
              We're looking for talented professionals to drive innovation in compliance and automation.
            </p>
            <Button variant="default" size="lg">
                <a href="/careers" class="inline-flex items-center gap-2">
                    View Open Positions
                  <ChevronRight class="w-4 h-4" />
                </a>
            </Button>
          </div>
        </div>
      </div>
    </div>

    <!-- From Our Blog Section -->
    <div class="container mx-auto px-4 py-32">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
            From Our Blog
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {blogEntries.map(post => (
            <article class="group transition-all duration-300 hover:-translate-y-1">
              <a href={`/blog/${post.slug}`} class="block">
                <div class="overflow-hidden">
                  <!-- Image placeholder -->
                  <div class="aspect-[16/9] bg-gradient-to-br from-gray-100 to-gray-200 dark:from-neutral-800 dark:to-neutral-700 flex items-center justify-center rounded-lg">
                    <div class="text-gray-400 dark:text-neutral-500 text-2xl">
                      {post.data.category === 'Engineering' && '⚡'}
                      {post.data.category === 'Development' && '💻'}
                      {post.data.category === 'Design' && '🎨'}
                      {post.data.category === 'Architecture' && '🏗️'}
                      {post.data.category === 'Content' && '📝'}
                      {!post.data.category && '📄'}
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="pt-3">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 group-hover:text-gray-700 dark:group-hover:text-neutral-200 transition-colors">
                      {post.data.title}
                    </h3>

                    <div class="text-sm text-gray-500 dark:text-neutral-400">
                      {new Date(post.data.publishedAt).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>


  </div>
</Layout>

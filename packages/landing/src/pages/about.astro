---
import { Layout } from "@/layouts";
import { CompanyStats, CTA, Press, SocialProof } from "@/components";
import { Shield, Building2, Zap, Target } from "lucide-vue-next";
import TeamMember from "@/components/features/about/TeamMember.vue";
import Blogposts from "@/components/sections/Blogposts.astro";

const teamMembers = [
	{
		name: "Alex Rivera",
		role: "CEO & Co-Founder",
		linkedin: "#",
		github: "#",
	},
	{
		name: "Jordan Martinez",
		role: "CTO & Co-Founder",
		linkedin: "#",
		github: "#",
	},
	{
		name: "Sam Chen",
		role: "VP of Engineering",
		linkedin: "#",
	},
];

const values = [
	{
		title: "Security First",
		description:
			"Every decision prioritizes the security and privacy of customer data above all else.",
		icon: Shield,
	},
	{
		title: "Enterprise Focus",
		description:
			"Built for the scale, reliability, and compliance requirements of enterprise organizations.",
		icon: Building2,
	},
	{
		title: "Continuous Innovation",
		description:
			"Constantly advancing our AI capabilities to stay ahead of emerging threats and use cases.",
		icon: Zap,
	},
	{
		title: "Customer Success",
		description:
			"Our success is measured by the tangible business value we deliver to our customers.",
		icon: Target,
	},
];

// Custom stats without team members
const customStats = [
	{ label: "Founded", value: "2025" },
	{ label: "Enterprise Customers", value: "10+" },
	{ label: "Documents Processed", value: "1M+" },
];
---

<Layout
  title="About Us"
  description="Learn about Nvisy's mission to provide enterprise-grade AI-powered solutions for secure data processing and compliance."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Mission & Story -->
    <section aria-label="Mission and Story" class="container mx-auto px-4 py-12 md:py-20 pb-8 md:pb-12">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-neutral-900 dark:text-white mb-4 md:mb-6">
            Our Mission
          </h1>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed px-4">
            To help enterprise organizations transform documents into actionable data with AI-powered intelligence,
            enabling them to extract insights, ensure compliance, and accelerate business decisions.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="text-center md:text-left">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-neutral-900 dark:text-white mb-6">
              The Challenge
            </h2>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
              Enterprise organizations process millions of documents containing valuable information trapped in unstructured formats. Traditional methods are manual, error-prone, and don't scale with business needs.
            </p>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
              The volume and complexity of documents continues to grow exponentially, while the need for actionable insights and compliance grows ever more critical.
            </p>
          </div>

          <div class="text-center md:text-left">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-neutral-900 dark:text-white mb-6">
              Our Solution
            </h2>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
              We've built an AI-powered platform that transforms documents into structured, actionable data with enterprise-grade accuracy and security.
            </p>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
              From intelligent data extraction to compliance-ready redaction, our solution integrates seamlessly into existing workflows while providing the transparency, auditability, and control that enterprises require.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Stats -->
    <CompanyStats stats={customStats} />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Industry Leaders"
      description="Join organizations that rely on Nvisy for secure, compliant document processing."
    />

    <!-- Values -->
    <section aria-label="Company Values" class="container mx-auto px-4 py-12 md:py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-neutral-900 dark:text-white mb-4 md:mb-6">
            Our Values
          </h2>
          <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto px-4">
            These principles guide every decision we make, from product development to customer relationships.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
          {values.map(value => (
            <div class="group text-center p-6 md:p-8 rounded-xl hover:-translate-y-1 transition-all duration-300">
              <div class="inline-flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-gradient-to-br from-neutral-100 to-neutral-200 dark:from-neutral-800 dark:to-neutral-700 group-hover:scale-110 transition-transform duration-300">
                <value.icon class="w-8 h-8 text-neutral-700 dark:text-neutral-300" />
              </div>
              <h3 class="text-lg md:text-xl font-light text-neutral-900 dark:text-white mb-3">
                {value.title}
              </h3>
              <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {value.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Team -->
    <section aria-label="Team" class="bg-neutral-50 dark:bg-black py-12 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12 md:mb-16">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-neutral-900 dark:text-white mb-4 md:mb-6">
              Meet the Team
            </h2>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto px-4">
              Driven by expertise in AI, enterprise software, and regulatory compliance.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 max-w-4xl mx-auto">
            {teamMembers.map(member => (
              <TeamMember client:load {...member} />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Press -->
    <Press
      title="In the News"
      description="See what industry leaders and media are saying about Nvisy."
    />

    <!-- From Our Blog Section -->
    <Blogposts
      title="From Our Blog"
      description="Read about our journey, insights, and the latest updates from the team"
    />

    <!-- Careers CTA -->
    <CTA
      title="Join Our Team"
      description="Help us build the future of enterprise data security. We're looking for talented professionals to drive innovation in compliance and automation."
      background="gradient"
      buttons={[
        {
          text: "View Open Positions",
          href: "/careers",
          variant: "primary"
        }
      ]}
    />
  </div>
</Layout>

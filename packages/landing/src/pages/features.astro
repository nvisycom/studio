---
import { Layout } from "@/layouts";
import { Hero, CTA } from "@/sections";
---

<Layout
  title="Features"
  description="Discover Nvisy's powerful AI-driven document redaction features. Automatically identify and redact sensitive information with enterprise-grade accuracy and security."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Intelligent Document Redaction"
      description="Protect sensitive information with AI-powered precision. Nvisy automatically identifies and redacts PII, financial data, and confidential information across all document types."
      background="solid"
      fontSize="lg"
      padding="lg"
      buttons={[]}
    />
    <div class="border-b border-gray-200 dark:border-neutral-800"></div>

    <!-- Main Features -->
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-6xl mx-auto">

        <!-- AI-Powered Detection -->
        <div class="mb-20">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              AI-Powered Detection
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Advanced machine learning algorithms trained on millions of documents to accurately identify and classify sensitive information.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">PII Detection</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                Automatically identify names, addresses, phone numbers, email addresses, and other personally identifiable information with 99.8% accuracy.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-1">
                <li>• Social Security Numbers</li>
                <li>• Driver's License Numbers</li>
                <li>• Passport Numbers</li>
                <li>• Date of Birth</li>
              </ul>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Financial Data</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                Detect and protect credit card numbers, bank accounts, tax IDs, and other financial information across all document formats.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-1">
                <li>• Credit Card Numbers</li>
                <li>• Bank Account Numbers</li>
                <li>• Tax ID Numbers</li>
                <li>• Financial Account Data</li>
              </ul>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8 hover:border-gray-300 dark:hover:border-neutral-600 transition-colors">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Healthcare PHI</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-4 leading-relaxed">
                HIPAA-compliant detection of protected health information including medical record numbers, diagnosis codes, and patient identifiers.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-1">
                <li>• Medical Record Numbers</li>
                <li>• Insurance Policy Numbers</li>
                <li>• Health Plan Numbers</li>
                <li>• Patient Identifiers</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Document Processing -->
        <div class="mb-20">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              Universal Document Support
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Process any document format with intelligent OCR and layout preservation. From scanned PDFs to handwritten forms.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Advanced OCR</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
                State-of-the-art optical character recognition processes even the most challenging documents with handwriting, low quality scans, and complex layouts.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-2">
                <li>• Handwritten text recognition</li>
                <li>• Multi-language support</li>
                <li>• Complex table extraction</li>
                <li>• Layout preservation</li>
              </ul>
            </div>

            <div class="border border-gray-200 dark:border-neutral-700 rounded-lg p-8">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Format Support</h3>
              <p class="text-gray-600 dark:text-neutral-400 mb-6 leading-relaxed">
                Handle all document types seamlessly. From digital PDFs to scanned images, from Word documents to handwritten forms.
              </p>
              <ul class="text-sm text-gray-500 dark:text-neutral-500 space-y-2">
                <li>• PDF, Word, Excel, PowerPoint</li>
                <li>• Images: PNG, JPEG, TIFF</li>
                <li>• Scanned documents</li>
                <li>• Email attachments</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Enterprise Features -->
        <div class="mb-20">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              Enterprise-Grade Security
            </h2>
            <p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
              Built for enterprise environments with comprehensive security, compliance, and governance features.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div class="text-center">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Zero Trust Architecture</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                End-to-end encryption with zero-knowledge processing ensures your sensitive data never leaves your control.
              </p>
            </div>

            <div class="text-center">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Compliance Ready</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Meet GDPR, HIPAA, SOX, PCI-DSS, and other regulatory requirements with built-in compliance features and audit trails.
              </p>
            </div>

            <div class="text-center">
              <div class="mb-6">
                <svg class="w-8 h-8 text-gray-700 dark:text-neutral-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">High Performance</h3>
              <p class="text-gray-600 dark:text-neutral-400 leading-relaxed">
                Process thousands of documents per minute with distributed processing and intelligent batching.
              </p>
            </div>
          </div>
        </div>

        <!-- Call to Action -->
        <CTA
          title="Ready to Protect Your Documents?"
          description="Start securing your sensitive information today with our enterprise-grade document redaction platform."
          background="none"
          padding="lg"
          buttons={[
            {
              text: "Get Started Free",
              href: "/dashboard",
              variant: "primary"
            },
            {
              text: "Schedule Demo",
              href: "/contact",
              variant: "secondary"
            }
          ]}
        />

      </div>
    </div>
  </div>
</Layout>

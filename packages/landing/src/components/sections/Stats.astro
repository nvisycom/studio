---
interface StatItem {
	value: string;
	label: string;
	description?: string;
}

export interface Props {
	title?: string;
	backgroundColor?: "white" | "gray";
	stats?: StatItem[];
	inline?: boolean;
	padding?: "sm" | "md" | "lg" | "xl";
	maxWidth?: "sm" | "md" | "lg" | "xl" | "full";
}

const {
	title,
	backgroundColor = "white",
	stats,
	inline = false,
	padding = "xl",
	maxWidth = "xl",
} = Astro.props;

const defaultStats: StatItem[] = [
	{ label: "Founded", value: "2025" },
	{ label: "Enterprise Customers", value: "10+" },
	{ label: "Documents Processed", value: "1M+" },
	{ label: "Team Members", value: "3" },
];

const statsData = stats || defaultStats;

const _bgClass = inline
	? ""
	: backgroundColor === "gray"
		? "bg-gray-50 dark:bg-neutral-950"
		: "bg-white dark:bg-black";

const _paddingClass = inline
	? ""
	: padding === "sm"
		? "pt-4 pb-16"
		: padding === "md"
			? "pt-6 pb-24"
			: padding === "lg"
				? "pt-8 pb-28"
				: "pt-8 pb-32";

const _maxWidthClass =
	maxWidth === "sm"
		? "max-w-2xl"
		: maxWidth === "md"
			? "max-w-4xl"
			: maxWidth === "lg"
				? "max-w-5xl"
				: maxWidth === "xl"
					? "max-w-6xl"
					: "max-w-none";

const _gridCols =
	statsData.length <= 2
		? "grid-cols-1 sm:grid-cols-2"
		: statsData.length === 3
			? "grid-cols-1 sm:grid-cols-3"
			: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4";
---

{inline ? (
  <div class={`${maxWidthClass} mx-auto`}>
    {title && (
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
          {title}
        </h2>
      </div>
    )}
    <div class={`grid ${gridCols} gap-6 md:gap-8`}>
      {statsData.map((stat) => (
        <div class="text-center p-4 md:p-6 rounded-lg border border-gray-200 dark:border-gray-700">
          <div class="text-2xl md:text-3xl lg:text-4xl font-bold mb-2 text-gray-900 dark:text-white">
            {stat.value}
          </div>
          <div class="text-sm md:text-base text-gray-600 dark:text-gray-400">
            {stat.label}
          </div>
          {stat.description && (
            <div class="text-xs md:text-sm text-gray-500 dark:text-gray-500 mt-1">
              {stat.description}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
) : (
  <section class={`${paddingClass} ${bgClass}`}>
    <div class="container mx-auto px-4">
      <div class={`${maxWidthClass} mx-auto`}>
        {title && (
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
              {title}
            </h2>
          </div>
        )}
        <div class={`grid ${gridCols} gap-6 md:gap-8`}>
          {statsData.map((stat) => (
            <div class="text-center px-4">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">
                {stat.value}
              </div>
              <div class="text-sm sm:text-base text-gray-600 dark:text-neutral-400 font-medium">
                {stat.label}
              </div>
              {stat.description && (
                <div class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-1">
                  {stat.description}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

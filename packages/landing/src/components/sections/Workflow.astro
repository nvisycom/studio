---
import type { BackgroundVariant } from "@/components/types";

export interface Props {
	backgroundColor?: BackgroundVariant;
	title?: string;
	description?: string;
}

const {
	backgroundColor = "white",
	title = "How It Works",
	description = "Our AI-powered redaction process is designed for simplicity and accuracy. Get from sensitive documents to secure, compliant files in just a few clicks.",
} = Astro.props;

const _bgClass =
	backgroundColor === "gray"
		? "bg-gray-50 dark:bg-neutral-950"
		: "bg-white dark:bg-black";
---

<section class={`py-12 md:py-20 ${bgClass} px-4`}>
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-3 md:mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-gray-700 dark:text-neutral-300 max-w-2xl mx-auto leading-relaxed px-4">
        {description}
      </p>
    </div>

    <WorkflowStepper client:load />
  </div>
</section>

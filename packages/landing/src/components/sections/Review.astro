---
import ReviewTabs from "@/components/features/dashboard/ReviewTabs.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "See Nvisy in Action",
	description = "Experience our intuitive dashboard designed for effortless document redaction",
} = Astro.props;
---

<section class="py-12 md:py-20 bg-white dark:bg-black">
  <div class="container mx-auto max-w-7xl px-4">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-gray-900 dark:text-white mb-3 md:mb-4">
        {title}
      </h2>
      {description && (
        <p class="text-base md:text-lg text-gray-600 dark:text-neutral-400 max-w-2xl mx-auto">
          {description}
        </p>
      )}
    </div>

    <ReviewTabs client:load />
  </div>
</section>

---
import { Check, Lock } from "lucide-vue-next";

export interface Props {
  title?: string;
  description?: string;
  backgroundColor?: "white" | "gray";
}

const {
  title = "Enterprise-Grade Document Security",
  description = "Built with compliance and security at the core. Our platform meets rigorous industry standards.",
  backgroundColor = "white",
} = Astro.props;

const bgClass =
  backgroundColor === "gray"
    ? "bg-gray-50 dark:bg-neutral-950"
    : "bg-white dark:bg-black";
---

<section class={`py-12 md:py-20 ${bgClass}`}>
  <div class="container mx-auto max-w-4xl px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-light text-gray-900 dark:text-white mb-6">
        {title}
      </h2>
      <p class="text-lg text-gray-600 dark:text-neutral-400 max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center">
        <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mx-auto mb-4">
          <Check class="w-6 h-6 text-green-600" client:load />
        </div>
        <div class="text-sm font-medium text-gray-900 dark:text-white">GDPR Compliant</div>
      </div>

      <div class="text-center">
        <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mx-auto mb-4">
          <Check class="w-6 h-6 text-green-600" client:load />
        </div>
        <div class="text-sm font-medium text-gray-900 dark:text-white">CCPA Compliant</div>
      </div>

      <div class="text-center">
        <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center mx-auto mb-4">
          <div class="w-3 h-3 bg-orange-500 rounded-full"></div>
        </div>
        <div class="text-sm font-medium text-gray-900 dark:text-white">SOC II</div>
        <div class="text-xs text-gray-500 dark:text-neutral-500">In Progress</div>
      </div>

      <div class="text-center">
        <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center mx-auto mb-4">
          <div class="w-3 h-3 bg-orange-500 rounded-full"></div>
        </div>
        <div class="text-sm font-medium text-gray-900 dark:text-white">HIPAA</div>
        <div class="text-xs text-gray-500 dark:text-neutral-500">In Progress</div>
      </div>
    </div>
  </div>
</section>

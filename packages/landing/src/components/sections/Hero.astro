---
import type { ButtonProps } from "@/components/types";
import { getButtonClasses } from "@/utils/buttonStyles";
import { getBackgroundClass } from "@/utils/backgroundStyles";

export interface Props {
	title?: string;
	subtitle?: string;
	description?: string;
	buttons?: ButtonProps[];
	centered?: boolean;
	background?: "solid" | "gradient" | "none";
	maxWidth?: "sm" | "md" | "lg" | "xl" | "full";
	titleHighlight?: string;
	heroImage?: string;
	heroImageAlt?: string;
}

const {
	title = "Enterprise Document",
	subtitle = "",
	description = "Automatically identify and redact sensitive information from your documents with AI-powered precision. Maintain compliance while preserving document integrity.",
	centered = true,
	background = "solid",
	maxWidth = "xl",
	titleHighlight,
	heroImage,
	heroImageAlt = "Hero image",
	buttons = [
		{
			text: "Start Free Trial",
			href: "/dashboard",
			variant: "primary",
		},
		{
			text: "Watch Demo",
			href: "/demo",
			variant: "secondary",
		},
	],
} = Astro.props;

// Helper function to split title and highlight text
const getTitleParts = () => {
	if (!titleHighlight || !title.includes(titleHighlight)) {
		return { beforeHighlight: title, highlight: "", afterHighlight: "" };
	}
	const parts = title.split(titleHighlight);
	return {
		beforeHighlight: parts[0],
		highlight: titleHighlight,
		afterHighlight: parts[1] || "",
	};
};

const titleParts = getTitleParts();

const maxWidthClasses = {
	sm: "max-w-2xl",
	md: "max-w-4xl",
	lg: "max-w-5xl",
	xl: "max-w-6xl",
	full: "max-w-none",
};
---

<section class={`
	${getBackgroundClass(background)}
	py-24 px-12
	min-h-[20vh] flex items-center
	border-b border-gray-200 dark:border-neutral-800
`}>
	<div class="container mx-auto px-4 w-full">
		<div class={`grid ${heroImage ? 'lg:grid-cols-2 gap-12 items-center' : 'grid-cols-1'}`}>
			<div class={`
				${centered ? `mx-auto text-center` : ""}
				${maxWidthClasses[maxWidth]}
			`}>
				<slot name="pre-title" />

				{title && (
					<h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4 md:mb-6 text-gray-900 dark:text-white">
						{titleParts.beforeHighlight}
						{titleParts.highlight && (
							<span class="text-blue-600 dark:text-blue-400">
								{titleParts.highlight}
							</span>
						)}
						{titleParts.afterHighlight}
						{subtitle && (
							<span class="block mt-2 text-2xl md:text-3xl font-bold leading-tight text-gray-700 dark:text-gray-300">
								{subtitle}
							</span>
						)}
					</h1>
				)}

				<slot name="title" />

				{description && (
					<p class={`
						text-lg md:text-xl mb-6 md:mb-8 leading-relaxed text-gray-600 dark:text-gray-400
						${centered ? "max-w-3xl mx-auto" : "max-w-3xl"}
					`}>
						{description}
					</p>
				)}

				<slot name="description" />

				{(buttons.length > 0 || Astro.slots.has('buttons')) && (
					<div class={`
						flex flex-col sm:flex-row gap-4 mb-8 md:mb-12
						${centered ? "justify-center" : "justify-start"}
					`}>
						{buttons.map((button) => {
							return button.href ? (
								<a
									href={button.href}
									class={getButtonClasses(button.variant || "primary")}
									aria-label={button.text}
								>
									{button.icon && (
										<span class="flex-shrink-0">
											{button.icon === "play" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1M9 10v4a2 2 0 002 2h2a2 2 0 002-2v-4m-6 4a2 2 0 002 2h2a2 2 0 002-2M9 10V9a2 2 0 012-2h2a2 2 0 012 2v1m-6 0a2 2 0 002 2h2a2 2 0 002-2"/>
												</svg>
											)}
											{button.icon === "arrow" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
												</svg>
											)}
											{button.icon === "external" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
												</svg>
											)}
										</span>
									)}
									{button.text}
								</a>
							) : (
								<button
									class={getButtonClasses(button.variant || "primary")}
									onclick={button.onClick}
									aria-label={button.text}
								>
									{button.icon && (
										<span class="flex-shrink-0">
											{button.icon === "play" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1M9 10v4a2 2 0 002 2h2a2 2 0 002-2v-4m-6 4a2 2 0 002 2h2a2 2 0 002-2M9 10V9a2 2 0 012-2h2a2 2 0 012 2v1m-6 0a2 2 0 002 2h2a2 2 0 002-2"/>
												</svg>
											)}
											{button.icon === "arrow" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
												</svg>
											)}
											{button.icon === "external" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
												</svg>
											)}
										</span>
									)}
									{button.text}
								</button>
							);
						})}

						<slot name="buttons" />
					</div>
				)}

				<slot name="stats" />
				<slot name="content" />
			</div>

			{heroImage && (
				<div class={centered ? "flex justify-center" : ""}>
					<div class="relative">
						<img
							src={heroImage}
							alt={heroImageAlt}
							class="w-full h-auto rounded-lg shadow-2xl"
							loading="eager"
						/>
						<slot name="hero-image-overlay" />
					</div>
				</div>
			)}

			<slot name="media" />
			<slot name="stats" />
		</div>

		<slot name="footer" />
	</div>
</section>

---
import { Mail, ExternalLink } from "lucide-vue-next";
import GithubIcon from "@/assets/icons/github.svg?raw";
import { Button } from "@/components/ui/button";

export interface Props {
	text: string;
	href?: string;
	variant?: "default" | "secondary" | "outline";
	onClick?: string;
	icon?: string;
}

const { text, href = "#", variant = "default", onClick, icon } = Astro.props;
---

<Button variant={variant} size="lg" asChild>
	<a href={href} onclick={onClick}>
		{icon === "github" && <Fragment set:html={GithubIcon} />}
		{icon === "mail" && <Mail class="w-5 h-5" />}
		{icon === "external" && <ExternalLink class="w-5 h-5" />}
		{text}
	</a>
</Button>

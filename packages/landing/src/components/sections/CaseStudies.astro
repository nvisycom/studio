---
import { ChevronRight, Building2, Clock } from "lucide-vue-next";
import { getCollection } from "astro:content";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Customer Success Stories",
	description = "See how leading organizations are using Nvisy to protect sensitive information and streamline compliance workflows.",
} = Astro.props;

// Fetch blog posts with "Case Study" category
const caseStudies = (await getCollection("blog-posts"))
	.filter((post) => post.data.category === "Case Study")
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 3);
---

<section class="py-12 md:py-20 px-4 bg-white dark:bg-black">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-neutral-900 dark:text-white mb-3 md:mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto leading-relaxed px-4">
        {description}
      </p>
    </div>

    {caseStudies.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {caseStudies.map((study) => (
          <a
            href={`/blog/${study.slug}`}
            class="group bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 hover:border-gray-300 dark:hover:border-neutral-600 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 p-6 flex flex-col"
          >
            {/* Title and Category */}
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="text-lg font-light text-gray-900 dark:text-white group-hover:text-gray-700 dark:group-hover:text-neutral-300 transition-colors line-clamp-2">
                {study.data.title}
              </h3>
              {study.data.category && (
                <span class="text-xs font-medium text-white bg-black dark:bg-white dark:text-black px-2 py-1 rounded whitespace-nowrap flex-shrink-0">
                  {study.data.category}
                </span>
              )}
            </div>

            {/* Excerpt */}
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4 line-clamp-3 flex-grow">
              {study.data.excerpt || study.data.description}
            </p>

            {/* Footer */}
            <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-neutral-800 mt-auto">
              <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-neutral-500">
                <Clock class="w-3 h-3" />
                <span>
                  {new Date(study.data.publishedAt).toLocaleDateString('en-US', {
                    month: 'short',
                    year: 'numeric'
                  })}
                </span>
              </div>
              <div class="flex items-center gap-1 text-sm text-gray-600 dark:text-neutral-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">
                Read more
                <ChevronRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <div class="w-16 h-16 bg-gray-100 dark:bg-neutral-800 rounded-full flex items-center justify-center mx-auto mb-4">
          <Building2 class="w-8 h-8 text-gray-400 dark:text-neutral-500" />
        </div>
        <p class="text-gray-500 dark:text-neutral-400">
          Case studies coming soon. Check back for customer success stories.
        </p>
      </div>
    )}

    {/* View All Link */}
    {caseStudies.length > 0 && (
      <div class="text-center mt-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-gray-900 dark:text-white hover:text-gray-700 dark:hover:text-neutral-300 transition-colors font-medium"
        >
          View all stories
          <ChevronRight class="w-4 h-4" />
        </a>
      </div>
    )}
  </div>
</section>

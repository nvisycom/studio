---
import { getCollection, getEntry } from "astro:content";
import {
	Check,
	Lock,
	Zap,
	Shield,
	ShieldCheck,
	Link,
	Users,
	Server,
	Code,
	ClipboardCheck,
	TrendingUp,
	BarChart3,
	Eye,
	FileText,
	Layers,
	DollarSign,
	Cog,
	Globe,
	Award,
} from "lucide-vue-next";
import type { FunctionalComponent } from "vue";
import FeatureCard from "@/components/features/FeatureCard.astro";

export interface FeatureItem {
	title: string;
	description: string;
	icon: string;
}

export interface Props {
	title?: string;
	description?: string;
	features?: FeatureItem[];
	category?: string;
	featured?: boolean;
}

const {
	title = "Built for Enterprise Scale",
	description = "Advanced AI technology meets enterprise security requirements. Process thousands of documents with unprecedented accuracy.",
	category,
	featured,
	features: propFeatures,
} = Astro.props;

// Fetch features from content if no features prop is provided
let features: FeatureItem[] = propFeatures || [];

if (!propFeatures) {
	if (category) {
		// Fetch specific category JSON file
		const categoryFeatures = await getEntry("features", category);
		if (categoryFeatures) {
			let featureList = categoryFeatures.data;

			// Filter by featured if specified
			if (featured !== undefined) {
				featureList = featureList.filter(
					(feature) => feature.featured === featured,
				);
			}

			features = featureList
				.sort((a, b) => a.order - b.order)
				.map((feature) => ({
					title: feature.title,
					description: feature.description,
					icon: feature.icon,
				}));
		}
	} else {
		// Fetch all feature categories and combine them
		const allFeatureEntries = await getCollection("features");
		let allFeaturesList = allFeatureEntries.flatMap((entry) => entry.data);

		// Filter by featured if specified
		if (featured !== undefined) {
			allFeaturesList = allFeaturesList.filter(
				(feature) => feature.featured === featured,
			);
		}

		features = allFeaturesList
			.sort((a, b) => a.order - b.order)
			.map((feature) => ({
				title: feature.title,
				description: feature.description,
				icon: feature.icon,
			}));
	}
}

const iconComponents: Record<string, FunctionalComponent> = {
	check: Check,
	lock: Lock,
	zap: Zap,
	shield: Shield,
	"shield-check": ShieldCheck,
	link: Link,
	users: Users,
	server: Server,
	code: Code,
	"clipboard-check": ClipboardCheck,
	"trending-up": TrendingUp,
	"bar-chart-3": BarChart3,
	eye: Eye,
	"file-text": FileText,
	layers: Layers,
	"dollar-sign": DollarSign,
	cog: Cog,
	globe: Globe,
	award: Award,
};

const getIcon = (iconName: string) => {
	return iconComponents[iconName] || Check;
};
---

<section class="py-12 md:py-20 px-4 bg-white dark:bg-black">
  <div class="container mx-auto max-w-7xl">
    <div class="mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-neutral-900 dark:text-white mb-3 md:mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl">
        {description}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
      {features.map((feature) => {
        const IconComponent = getIcon(feature.icon);
        return (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            IconComponent={IconComponent}
          />
        );
      })}
    </div>
  </div>
</section>

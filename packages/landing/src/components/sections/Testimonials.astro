---
import { getCollection, getEntry } from "astro:content";
import type { TestimonialItem } from "@/content.config.ts";

export interface Props {
	title?: string;
	description?: string;
	backgroundColor?: "white" | "gray";
	category?: string;
	featured?: boolean;
	limit?: number;
	testimonials?: TestimonialItem[];
}

const {
	title = "Trusted by Enterprise Leaders",
	description = "See what our customers say about transforming their document security workflows.",
	backgroundColor = "white",
	category,
	featured = true,
	limit = 6,
	testimonials,
} = Astro.props;

async function getTestimonials(category?: string): Promise<TestimonialItem[]> {
	if (category) {
		const categoryTestimonials = await getEntry("testimonials", category);
		return categoryTestimonials?.data || [];
	} else {
		const allTestimonials = await getCollection("testimonials");
		return allTestimonials.flatMap((entry) => entry.data);
	}
}

const _allTestimonials: TestimonialItem[] =
	testimonials ||
	(await getTestimonials(category))
		.filter((testimonial) => testimonial.featured === featured)
		.sort((lhs, rhs) => lhs.order - rhs.order)
		.slice(0, limit);

const _bgClass =
	backgroundColor === "gray"
		? "bg-gray-50 dark:bg-neutral-950"
		: "bg-white dark:bg-black";
---

<section class={`py-12 md:py-20 ${bgClass} px-4`}>
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-3 md:mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-gray-600 dark:text-neutral-400 max-w-2xl mx-auto px-4">
        {description}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {allTestimonials.map((testimonial) => (
        <div class="bg-white dark:bg-black border border-gray-200 dark:border-neutral-800 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
          <!-- Quote Icon -->
          <div class="mb-4">
            <Quote class="w-8 h-8 text-gray-400 dark:text-neutral-500" />
          </div>

          <!-- Quote -->
          <blockquote class="text-sm md:text-base text-gray-700 dark:text-neutral-300 mb-4 md:mb-6 leading-relaxed">
            "{testimonial.quote}"
          </blockquote>

          <!-- Author Info -->
          <div class="border-t border-gray-100 dark:border-neutral-700 pt-4">
            <div class="flex items-start space-x-3">
              {testimonial.avatar ? (
                <img
                  src={testimonial.avatar}
                  alt={testimonial.author}
                  class="w-10 h-10 rounded-full object-cover"
                />
              ) : (
                <div class="w-10 h-10 bg-gray-200 dark:bg-neutral-600 rounded-full flex items-center justify-center">
                  <span class="text-gray-600 dark:text-neutral-300 font-semibold text-sm">
                    {testimonial.author.split(' ').map(name => name.charAt(0)).join('')}
                  </span>
                </div>
              )}
              <div class="flex-1 min-w-0">
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm">
                  {testimonial.author}
                </h4>
                <p class="text-gray-600 dark:text-neutral-400 text-sm">
                  {testimonial.title}
                </p>
                <p class="text-gray-500 dark:text-neutral-500 text-sm font-medium">
                  {testimonial.company}
                </p>
              </div>
              {testimonial.companyLogo && (
                <img
                  src={testimonial.companyLogo}
                  alt={testimonial.company}
                  class="w-8 h-8 object-contain opacity-60"
                />
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Indicators -->
    <div class="text-center mt-16">
      <div class="inline-flex items-center space-x-8 text-gray-500 dark:text-neutral-400 text-sm">
        <div class="flex items-center space-x-2">
          <CheckCircle2 class="w-4 h-4 text-green-500" />
          <span>SOC 2 Type II Certified</span>
        </div>
        <div class="flex items-center space-x-2">
          <Users class="w-4 h-4 text-blue-500" />
          <span>500+ Enterprise Clients</span>
        </div>
        <div class="flex items-center space-x-2">
          <CheckCircle2 class="w-4 h-4 text-purple-500" />
          <span>GDPR & HIPAA Compliant</span>
        </div>
      </div>
    </div>
  </div>
</section>

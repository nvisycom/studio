---
import { getCollection } from "astro:content";
import {
	File,
	Zap,
	Code,
	Palette,
	Building,
	FileText,
	Shield,
} from "lucide-vue-next";

interface Props {
	title?: string;
	description?: string;
	limit?: number;
}

const { title = "From Our Blog", description, limit = 3 } = Astro.props;

// Get all blog entries and sort by publishedAt (newest first)
const blogEntries = (await getCollection("blog-posts"))
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, limit);
---

<section aria-label="Latest Blog Posts" class="py-12 md:py-20 bg-white dark:bg-black">
	<div class="container mx-auto px-4">
		<div class="text-center mb-12 md:mb-16">
			<h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-gray-900 dark:text-white mb-4 md:mb-6">
				{title}
			</h2>
			{description && (
				<p class="text-base md:text-lg lg:text-xl text-gray-600 dark:text-neutral-400 max-w-2xl mx-auto px-4">
					{description}
				</p>
			)}
		</div>

		<div class="max-w-6xl mx-auto">
			{blogEntries.length > 0 ? (
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					{blogEntries.map(post => (
						<article class="group transition-all duration-300 hover:-translate-y-1">
							<a href={`/blog/${post.slug}`} class="block">
								<div class="overflow-hidden">
									<!-- Image placeholder -->
									<div class="aspect-[16/9] bg-gradient-to-br from-neutral-100 to-neutral-200 dark:from-neutral-800 dark:to-neutral-700 flex items-center justify-center rounded-lg group-hover:shadow-lg transition-shadow duration-300">
										<div class="text-neutral-400 dark:text-neutral-500">
											{post.data.category === 'Engineering' && <Zap class="w-12 h-12" client:load />}
											{post.data.category === 'Development' && <Code class="w-12 h-12" client:load />}
											{post.data.category === 'Design' && <Palette class="w-12 h-12" client:load />}
											{post.data.category === 'Architecture' && <Building class="w-12 h-12" client:load />}
											{post.data.category === 'Compliance' && <Shield class="w-12 h-12" client:load />}
											{post.data.category === 'Case Study' && <FileText class="w-12 h-12" client:load />}
											{!post.data.category && <File class="w-12 h-12" client:load />}
										</div>
									</div>

									<!-- Content -->
									<div class="pt-4">
										<h3 class="text-lg font-light text-neutral-900 dark:text-white mb-2 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors line-clamp-2">
											{post.data.title}
										</h3>

										<div class="text-sm text-neutral-500 dark:text-neutral-400">
											{new Date(post.data.publishedAt).toLocaleDateString('en-US', {
												year: 'numeric',
												month: 'short',
												day: 'numeric'
											})}
										</div>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>
			) : (
				<div class="text-center py-12">
					<div class="w-20 h-20 bg-neutral-100 dark:bg-neutral-800 rounded-full flex items-center justify-center mx-auto mb-6">
						<File class="w-8 h-8 text-neutral-400 dark:text-neutral-500" client:load />
					</div>
					<h3 class="text-xl font-light text-neutral-900 dark:text-white mb-2">No blog posts yet</h3>
					<p class="text-neutral-500 dark:text-neutral-400">Check back soon for our latest insights and updates.</p>
				</div>
			)}
		</div>
	</div>
</section>

---
import {
	Building2,
	Landmark,
	HeartPulse,
	ShieldCheck,
	Building,
	Rocket,
	ChevronRight,
} from "lucide-vue-next";

export interface UseCase {
	title: string;
	description: string;
	icon:
		| "financial"
		| "government"
		| "healthcare"
		| "insurance"
		| "enterprise"
		| "startup";
	href: string;
}

export interface Props {
	title?: string;
	description?: string;
	backgroundColor?: "white" | "gray" | "dark";
	useCases?: UseCase[];
}

const {
	title = "Built for Every Industry",
	description = "From legal firms to healthcare providers, organizations worldwide rely on Nvisy to protect their most sensitive documents.",
	backgroundColor = "white",
	useCases = [
		{
			title: "Financial",
			description:
				"Secure financial data, account numbers, and PII in customer communications.",
			icon: "financial",
			href: "/solutions/financial",
		},
		{
			title: "Government",
			description:
				"Redact classified information for FOIA requests and public disclosures.",
			icon: "government",
			href: "/solutions/government",
		},
		{
			title: "Healthcare",
			description:
				"HIPAA-compliant redaction for patient records, medical histories, and research data.",
			icon: "healthcare",
			href: "/solutions/healthcare",
		},
		{
			title: "Insurance",
			description:
				"Protect policyholder information and claims data while maintaining compliance.",
			icon: "insurance",
			href: "/solutions/insurance",
		},
		{
			title: "Enterprise",
			description:
				"Scale document security across your entire organization with enterprise tools.",
			icon: "enterprise",
			href: "/solutions/enterprise",
		},
		{
			title: "Startups",
			description:
				"Developer-friendly APIs and startup pricing to build privacy into your product.",
			icon: "startup",
			href: "/solutions/startup",
		},
	],
} = Astro.props;

const backgroundClasses = {
	white: "bg-white dark:bg-black",
	gray: "bg-gray-50 dark:bg-neutral-950",
	dark: "bg-gray-900 dark:bg-black",
};

const getIcon = (iconName: UseCase["icon"]) => {
	const icons = {
		financial: Building2,
		government: Landmark,
		healthcare: HeartPulse,
		insurance: ShieldCheck,
		enterprise: Building,
		startup: Rocket,
	};
	return icons[iconName];
};
---

<section class={`py-12 md:py-20 px-4 ${backgroundClasses[backgroundColor]}`} aria-labelledby="use-cases-title">
	<div class="container mx-auto max-w-4xl">
		<!-- Header -->
		<header class="text-center mb-12 md:mb-16">
			<h2 id="use-cases-title" class="text-3xl md:text-4xl lg:text-5xl font-light text-gray-900 dark:text-white mb-3 md:mb-4">
				{title}
			</h2>
			{description && (
				<p class="text-base md:text-lg text-gray-700 dark:text-neutral-300 max-w-3xl mx-auto leading-relaxed px-4">
					{description}
				</p>
			)}
		</header>

		<!-- Use Cases Grid -->
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
			{useCases.map((useCase) => {
				const IconComponent = getIcon(useCase.icon);
				return (
					<a
						href={useCase.href}
						class="group bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 hover:border-gray-300 dark:hover:border-neutral-600 transition-all duration-300 hover:shadow-lg p-6 no-underline relative block"
					>
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-3">
								<div class="w-10 h-10 bg-gray-100 dark:bg-neutral-800 rounded-full flex items-center justify-center flex-shrink-0 text-gray-900 dark:text-white">
									<IconComponent class="w-5 h-5" aria-hidden="true" />
								</div>
								<h3 class="text-base font-light text-gray-900 dark:text-white">
									{useCase.title}
								</h3>
							</div>
							<ChevronRight class="w-4 h-4 text-gray-400 dark:text-neutral-500 group-hover:text-gray-900 dark:group-hover:text-white group-hover:translate-x-1 transition-all" aria-hidden="true" />
						</div>
					</a>
				);
			})}
		</div>
	</div>
</section>

---
import { COMPANY_NAME } from "@nvisy/config";
import Logo from "@/components/Logo.astro";
import OpenStatus from "./OpenStatus.vue";
import GithubIcon from "@/assets/icons/github.svg";
import BlueskyIcon from "@/assets/icons/bluesky.svg";
import LinkedinIcon from "@/assets/icons/linkedin.svg";

export interface Props {
	companyName?: string;
}

const { companyName = COMPANY_NAME } = Astro.props;

const socialLinks = [
	{
		name: "GitHub",
		href: "https://github.com/nvisycom",
		Icon: GithubIcon,
	},
	{
		name: "Bluesky",
		href: "https://bsky.app/profile/nvisy.com",
		Icon: BlueskyIcon,
	},
	{
		name: "LinkedIn",
		href: "https://www.linkedin.com/company/nvisy/",
		Icon: LinkedinIcon,
	},
];
---
<div class="col-span-1 lg:col-span-2">
  <div class="mb-4">
    <Logo size="md" asLink={true} companyName={companyName} />
  </div>
  <p class="text-gray-600 dark:text-neutral-300 text-sm max-w-md leading-relaxed">
    Enterprise-grade document redaction powered by state of the art AI. Protect sensitive information while maintaining document integrity.
  </p>
  <div class="flex space-x-4 mt-6">
    {socialLinks.map((social) => (
      <a
        href={social.href}
        class="text-gray-400 dark:text-neutral-400 hover:text-gray-600 dark:hover:text-neutral-200 transition-colors p-2 hover:bg-gray-100 dark:hover:bg-neutral-800 rounded-md"
        aria-label={`Follow us on ${social.name}`}
      >
        <social.Icon class="h-5 w-5" />
      </a>
    ))}
  </div>

  <!-- OpenStatus state -->
  <div class="mt-6">
      <OpenStatus client:load slug="nvisy" />
  </div>

</div>

---
import { ExternalLink } from "lucide-vue-next";

export interface FooterLink {
	name: string;
	href: string;
	isExternal?: boolean;
}

export interface FooterSection {
	title: string;
	links: FooterLink[];
}

interface Props {
	footerSections: FooterSection[];
}

const { footerSections } = Astro.props;
---

<!-- Dynamic Footer Sections -->
{footerSections.map((section) => (
  <div>
    <h3
      class="font-light text-gray-900 dark:text-white text-sm mb-4 tracking-wider uppercase"
    >
      {section.title}
    </h3>
    <ul class="space-y-3">
      {section.links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noopener noreferrer" : undefined}
            class="text-gray-600 dark:text-neutral-400 hover:text-gray-900 dark:hover:text-white text-sm font-light transition-colors duration-200 inline-flex items-center gap-1.5"
          >
            {link.name}
            {link.isExternal && <ExternalLink class="w-3 h-3" />}
          </a>
        </li>
      ))}
    </ul>
  </div>
))}

---
import type { FunctionalComponent } from "vue";
import FeatureDesc from "./FeatureDesc.vue";

export interface Props {
	title: string;
	description: string;
	IconComponent: FunctionalComponent;
}

const { title, description, IconComponent } = Astro.props;
---

<div class="flex flex-col text-left p-4 md:p-6">
  <!-- Icon -->
  <div class="mb-4">
    <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg flex items-center justify-center">
      <IconComponent class="w-5 h-5 md:w-6 md:h-6 text-neutral-900 dark:text-white" />
    </div>
  </div>

  <!-- Title -->
  <h3 class="text-lg md:text-xl font-light text-neutral-900 dark:text-white mb-3">
    {title}
  </h3>

  <!-- Description with Tooltips -->
  <FeatureDesc client:visible description={description} />
</div>

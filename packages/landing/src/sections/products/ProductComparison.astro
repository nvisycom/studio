---
import {
	CheckIcon,
	XIcon,
	AlertTriangleIcon,
	ArrowRightIcon,
} from "lucide-vue-next";

export interface ComparisonItem {
	name: string;
	description: string;
	features: Array<{
		name: string;
		status: "check" | "x" | "warning";
	}>;
}

export interface Props {
	title: string;
	description: string;
	mainProduct: ComparisonItem;
	competitors: ComparisonItem[];
	ctaText?: string;
	ctaHref?: string;
}

const {
	title,
	description,
	mainProduct,
	competitors,
	ctaText = "View Detailed Comparisons",
	ctaHref = "/comparisons",
} = Astro.props;

const getStatusIcon = (status: string) => {
	switch (status) {
		case "check":
			return CheckIcon;
		case "x":
			return XIcon;
		case "warning":
			return AlertTriangleIcon;
		default:
			return CheckIcon;
	}
};

const getStatusColor = (status: string) => {
	switch (status) {
		case "check":
			return "text-neutral-900 dark:text-white";
		case "x":
			return "text-red-500";
		case "warning":
			return "text-yellow-500";
		default:
			return "text-neutral-400";
	}
};
---

<div class="bg-neutral-50 dark:bg-neutral-950 py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
          {title}
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
          {description}
        </p>
      </div>

      <!-- Comparison Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <!-- Main Product -->
        <div class="bg-white dark:bg-black rounded-lg p-8 border-2 border-neutral-900 dark:border-white">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{mainProduct.name}</h3>
            <p class="text-neutral-600 dark:text-neutral-300">{mainProduct.description}</p>
          </div>
          <ul class="space-y-3">
            {mainProduct.features.map((feature) => {
              const IconComponent = getStatusIcon(feature.status);
              const colorClass = getStatusColor(feature.status);
              return (
                <li class="flex items-center gap-3">
                  <IconComponent class={`w-5 h-5 ${colorClass}`} />
                  <span class="text-neutral-700 dark:text-neutral-300">{feature.name}</span>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Competitors -->
        {competitors.map((competitor) => (
          <div class="bg-white dark:bg-black rounded-lg p-8 border border-neutral-200 dark:border-neutral-700">
            <div class="text-center mb-6">
              <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{competitor.name}</h3>
              <p class="text-neutral-600 dark:text-neutral-300">{competitor.description}</p>
            </div>
            <ul class="space-y-3">
              {competitor.features.map((feature) => {
                const IconComponent = getStatusIcon(feature.status);
                const colorClass = getStatusColor(feature.status);
                return (
                  <li class="flex items-center gap-3">
                      <IconComponent class="w-5 h-5" :class={colorClass} />
                    <span class="text-neutral-700 dark:text-neutral-300">{feature.name}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>

      <!-- CTA for Comparisons -->
      <div class="text-center">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center border-2 border-neutral-300 dark:border-neutral-600 text-neutral-700 dark:text-neutral-300 font-medium py-3 px-8 rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors"
        >
          {ctaText}
          <ArrowRightIcon class="w-5 h-5 ml-2" />
        </a>
      </div>
    </div>
  </div>
</div>

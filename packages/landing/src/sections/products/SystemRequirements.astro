---
export interface RequirementSpec {
	label: string;
	value: string;
}

export interface RequirementSet {
	title: string;
	description?: string;
	specs: RequirementSpec[];
	highlighted?: boolean;
}

export interface Props {
	title: string;
	description: string;
	requirementSets: RequirementSet[];
}

const { title, description, requirementSets } = Astro.props;
---

<div class="bg-white dark:bg-black py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6">
          {title}
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-300">
          {description}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {requirementSets.map((requirementSet) => (
          <div class={`rounded-2xl p-8 ${
            requirementSet.highlighted
              ? 'bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700'
              : 'bg-neutral-50 dark:bg-neutral-950'
          }`}>
            <h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-6">
              {requirementSet.title}
            </h3>
            {requirementSet.description && (
              <p class="text-neutral-600 dark:text-neutral-300 mb-6">
                {requirementSet.description}
              </p>
            )}
            <div class="space-y-4">
              {requirementSet.specs.map((spec) => (
                <div class={`flex justify-between items-center py-3 border-b ${
                  requirementSet.highlighted
                    ? 'border-neutral-200 dark:border-neutral-700'
                    : 'border-neutral-200 dark:border-neutral-800'
                }`}>
                  <span class="text-neutral-700 dark:text-neutral-300">{spec.label}:</span>
                  <span class="font-medium text-neutral-900 dark:text-white">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

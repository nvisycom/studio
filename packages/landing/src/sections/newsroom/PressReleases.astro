---
import { ChevronRight, Calendar } from "lucide-vue-next";

// Press releases data - this could be passed as props in a real implementation
const pressReleases = [
	{
		id: "series-a-funding",
		title: "Nvisy Raises $15M Series A to Revolutionize Document Redaction",
		excerpt:
			"Leading venture capital firms back Nvisy's AI-powered approach to enterprise document security and compliance automation.",
		date: "2024-01-15",
		category: "Funding",
		featured: true,
	},
	{
		id: "enterprise-launch",
		title: "Nvisy Launches Enterprise Platform for Fortune 500 Companies",
		excerpt:
			"New enterprise-grade features include advanced compliance tracking, custom integrations, and dedicated support infrastructure.",
		date: "2024-01-08",
		category: "Product",
	},
	{
		id: "partnership-announcement",
		title: "Strategic Partnership with Microsoft Announced",
		excerpt:
			"Integration with Microsoft 365 and Azure brings seamless document redaction to millions of enterprise users worldwide.",
		date: "2024-01-08",
		category: "Partnership",
	},
	{
		id: "security-certification",
		title: "Nvisy Achieves SOC 2 Type II Certification",
		excerpt:
			"Independent audit confirms highest standards of security, availability, and confidentiality for customer data protection.",
		date: "2023-12-01",
		category: "Security",
	},
	{
		id: "team-expansion",
		title: "Nvisy Doubles Engineering Team, Opens European Office",
		excerpt:
			"Rapid growth drives international expansion with new development center in Amsterdam to serve European market.",
		date: "2023-11-15",
		category: "Company",
	},
];
---

<div class="max-w-7xl mx-auto">




  <!-- Press Releases List -->
  <div>
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
        Press Releases
      </h2>
      <span class="text-sm text-gray-500 dark:text-neutral-400">
        {pressReleases.length} release{pressReleases.length !== 1 ? 's' : ''}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {pressReleases.map(release => (
        <article class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 hover:border-gray-300 dark:hover:border-neutral-600 transition-all duration-300 hover:shadow-lg">
          <a href={`/newsroom/${release.id}`} class="block p-6">
            <div class="mb-4">
              <span class="text-sm font-medium text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-800 px-3 py-1 rounded-full w-fit">
                {release.category}
              </span>
            </div>

            <div class="flex items-start justify-between mb-3">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex-1 pr-4">
                {release.title}
              </h3>
              <div class="flex items-center gap-2 text-gray-500 dark:text-neutral-400 text-sm flex-shrink-0">
                <Calendar class="w-4 h-4" client:load />
                <span>{new Date(release.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}</span>
              </div>
            </div>

            <p class="text-gray-600 dark:text-neutral-300 leading-relaxed mb-4">
              {release.excerpt}
            </p>

            <div class="flex items-center text-sm font-medium text-gray-900 dark:text-white">
              Read More
              <ChevronRight class="w-4 h-4 ml-2" client:load />
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes spin-slow {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }
</style>

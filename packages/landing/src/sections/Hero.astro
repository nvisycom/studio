---
export interface HeroButton {
	text: string;
	href?: string;
	variant?: "primary" | "secondary" | "outline";
	onClick?: string;
	icon?: string;
}

export interface Props {
	title?: string;
	subtitle?: string;
	description?: string;
	buttons?: HeroButton[];
	centered?: boolean;
	fontSize?: "sm" | "md" | "lg" | "xl" | "xxl";
	background?: "solid" | "gradient" | "none";
	padding?: "sm" | "md" | "lg" | "xl";
	maxWidth?: "sm" | "md" | "lg" | "xl" | "full";
	titleHighlight?: string;
	heroImage?: string;
	heroImageAlt?: string;
}

const {
	title = "Enterprise Document",
	subtitle = "",
	description = "Automatically identify and redact sensitive information from your documents with AI-powered precision. Maintain compliance while preserving document integrity.",
	centered = true,
	fontSize = "lg",
	background = "solid",
	padding = "xl",
	maxWidth = "xl",
	titleHighlight,
	heroImage,
	heroImageAlt = "Hero image",
	buttons = [
		{
			text: "Start Free Trial",
			href: "/dashboard",
			variant: "primary",
		},
		{
			text: "Watch Demo",
			href: "/demo",
			variant: "secondary",
		},
	],
} = Astro.props;

// Helper function to split title and highlight text
const getTitleParts = () => {
	if (!titleHighlight || !title.includes(titleHighlight)) {
		return { beforeHighlight: title, highlight: "", afterHighlight: "" };
	}
	const parts = title.split(titleHighlight);
	return {
		beforeHighlight: parts[0],
		highlight: titleHighlight,
		afterHighlight: parts[1] || "",
	};
};

const titleParts = getTitleParts();
---

<section class={`
	${background === "solid" ? "bg-white dark:bg-black" : ""}
	${background === "gradient" ? "bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-black dark:to-gray-900" : ""}
	${background === "none" ? "bg-transparent" : ""}
	${padding === "sm" ? "py-12 px-6" : ""}
	${padding === "md" ? "py-16 px-8" : ""}
	${padding === "lg" ? "py-20 px-10" : ""}
	${padding === "xl" ? "py-24 px-12" : ""}
	min-h-[20vh] flex items-center
	border-b border-gray-200 dark:border-neutral-800
`}>
	<div class="container mx-auto px-4 w-full">
		<div class={`grid ${heroImage ? 'lg:grid-cols-2 gap-12 items-center' : 'grid-cols-1'}`}>
			<div class={`
				${centered ? `mx-auto text-center` : ""}
				${maxWidth === "sm" ? "max-w-2xl" : ""}
				${maxWidth === "md" ? "max-w-4xl" : ""}
				${maxWidth === "lg" ? "max-w-5xl" : ""}
				${maxWidth === "xl" ? "max-w-6xl" : ""}
				${maxWidth === "full" ? "max-w-none" : ""}
			`}>
				<slot name="pre-title" />

				{title && (
					<h1 class={`
						font-bold leading-tight mb-4 md:mb-6
						${fontSize === "sm" ? "text-2xl md:text-3xl" : ""}
						${fontSize === "md" ? "text-3xl md:text-4xl" : ""}
						${fontSize === "lg" ? "text-4xl md:text-5xl" : ""}
						${fontSize === "xl" ? "text-5xl md:text-6xl" : ""}
						${fontSize === "xxl" ? "text-6xl md:text-7xl" : ""}
						text-gray-900 dark:text-white
					`}>
						{titleParts.beforeHighlight}
						{titleParts.highlight && (
							<span class="text-blue-600 dark:text-blue-400">
								{titleParts.highlight}
							</span>
						)}
						{titleParts.afterHighlight}
						{subtitle && (
							<span class={`
								block mt-2 font-bold leading-tight
								${fontSize === "sm" ? "text-lg md:text-xl" : ""}
								${fontSize === "md" ? "text-xl md:text-2xl" : ""}
								${fontSize === "lg" ? "text-2xl md:text-3xl" : ""}
								${fontSize === "xl" ? "text-3xl md:text-4xl" : ""}
								${fontSize === "xxl" ? "text-4xl md:text-5xl" : ""}
								text-gray-700 dark:text-gray-300
							`}>
								{subtitle}
							</span>
						)}
					</h1>
				)}

				<slot name="title" />

				{description && (
					<p class={`
						mb-6 md:mb-8 leading-relaxed
						${fontSize === "sm" ? "text-sm md:text-base" : ""}
						${fontSize === "md" ? "text-base md:text-lg" : ""}
						${fontSize === "lg" ? "text-lg md:text-xl" : ""}
						${fontSize === "xl" ? "text-xl md:text-2xl" : ""}
						${fontSize === "xxl" ? "text-2xl md:text-3xl" : ""}
						text-gray-600 dark:text-gray-400
						${centered ? "max-w-3xl mx-auto" : "max-w-3xl"}
					`}>
						{description}
					</p>
				)}

				<slot name="description" />

				{(buttons.length > 0 || Astro.slots.has('buttons')) && (
					<div class={`
						flex flex-col sm:flex-row gap-4 mb-8 md:mb-12
						${centered ? "justify-center" : "justify-start"}
					`}>
						{buttons.map((button) => {
							const baseClasses = "inline-flex items-center justify-center gap-2 font-medium py-3 px-6 md:py-4 md:px-8 rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 text-base md:text-lg";

							let variantClasses = "";
							if (button.variant === "primary") {
								variantClasses = "bg-black dark:bg-white text-white dark:text-black hover:bg-gray-800 dark:hover:bg-gray-100 focus:ring-black dark:focus:ring-white shadow-sm hover:shadow-md";
							} else if (button.variant === "secondary") {
								variantClasses = "bg-white dark:bg-black/50 text-black dark:text-white border-2 border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 focus:ring-black/10 dark:focus:ring-white/10";
							} else if (button.variant === "outline") {
								variantClasses = "bg-white dark:bg-black/50 text-black dark:text-white border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 focus:ring-black/10 dark:focus:ring-white/10";
							}

							return button.href ? (
								<a
									href={button.href}
									class={`${baseClasses} ${variantClasses}`}
									aria-label={button.text}
								>
									{button.icon && (
										<span class="flex-shrink-0">
											{button.icon === "play" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1M9 10v4a2 2 0 002 2h2a2 2 0 002-2v-4m-6 4a2 2 0 002 2h2a2 2 0 002-2M9 10V9a2 2 0 012-2h2a2 2 0 012 2v1m-6 0a2 2 0 002 2h2a2 2 0 002-2"/>
												</svg>
											)}
											{button.icon === "arrow" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
												</svg>
											)}
											{button.icon === "external" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
												</svg>
											)}
										</span>
									)}
									{button.text}
								</a>
							) : (
								<button
									class={`${baseClasses} ${variantClasses}`}
									onclick={button.onClick}
									aria-label={button.text}
								>
									{button.icon && (
										<span class="flex-shrink-0">
											{button.icon === "play" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1M9 10v4a2 2 0 002 2h2a2 2 0 002-2v-4m-6 4a2 2 0 002 2h2a2 2 0 002-2M9 10V9a2 2 0 012-2h2a2 2 0 012 2v1m-6 0a2 2 0 002 2h2a2 2 0 002-2"/>
												</svg>
											)}
											{button.icon === "arrow" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
												</svg>
											)}
											{button.icon === "external" && (
												<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
												</svg>
											)}
										</span>
									)}
									{button.text}
								</button>
							);
						})}

						<slot name="buttons" />
					</div>
				)}

				<slot name="stats" />
				<slot name="content" />
			</div>

			{heroImage && (
				<div class={centered ? "flex justify-center" : ""}>
					<div class="relative">
						<img
							src={heroImage}
							alt={heroImageAlt}
							class="w-full h-auto rounded-lg shadow-2xl"
							loading="eager"
						/>
						<slot name="hero-image-overlay" />
					</div>
				</div>
			)}

			<slot name="media" />
			<slot name="stats" />
		</div>

		<slot name="footer" />
	</div>
</section>

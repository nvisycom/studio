---
export interface CTAButton {
	text: string;
	href?: string;
	variant?: "primary" | "secondary" | "outline";
	onClick?: string;
	icon?: string;
}

export interface Props {
	title?: string;
	description?: string;
	buttons?: CTAButton[];
	centered?: boolean;
	fontSize?: "sm" | "md" | "lg" | "xl" | "xxl";
	background?: "solid" | "gradient" | "dark" | "none";
	padding?: "sm" | "md" | "lg" | "xl";
	maxWidth?: "sm" | "md" | "lg" | "xl" | "full";
}

const {
	title = "Ready to get started?",
	description = "Join thousands of companies already using our platform to build better products faster.",
	centered = true,
	fontSize = "lg",
	background = "gradient",
	padding = "lg",
	maxWidth = "xl",
	buttons = [
		{
			text: "Start Free Trial",
			variant: "primary",
		},
		{
			text: "Book a Demo",
			variant: "secondary",
		},
	],
} = Astro.props;

const titleSizeClasses = {
	sm: "text-2xl md:text-3xl",
	md: "text-3xl md:text-4xl",
	lg: "text-4xl md:text-5xl",
	xl: "text-5xl md:text-6xl",
	xxl: "text-6xl md:text-7xl",
};

const descriptionSizeClasses = {
	sm: "text-sm md:text-base",
	md: "text-base md:text-lg",
	lg: "text-lg md:text-xl",
	xl: "text-xl md:text-2xl",
	xxl: "text-2xl md:text-3xl",
};

const getButtonClasses = (variant: string) => {
	const baseClasses =
		"inline-flex items-center justify-center gap-2 font-medium py-3 px-6 md:py-4 md:px-8 rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 text-base md:text-lg";

	if (variant === "primary") {
		if (background === "dark") {
			return `${baseClasses} bg-white text-black hover:bg-neutral-100 focus:ring-white shadow-sm hover:shadow-md`;
		}
		return `${baseClasses} bg-black dark:bg-white text-white dark:text-black hover:bg-neutral-800 dark:hover:bg-neutral-100 focus:ring-black dark:focus:ring-white shadow-sm hover:shadow-md`;
	} else if (variant === "secondary") {
		if (background === "dark") {
			return `${baseClasses} bg-transparent text-white border-2 border-white/20 hover:bg-white/10 hover:border-white/30 focus:ring-white/20`;
		}
		return `${baseClasses} bg-white dark:bg-black/50 text-black dark:text-white border-2 border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 focus:ring-black/10 dark:focus:ring-white/10`;
	} else if (variant === "outline") {
		if (background === "dark") {
			return `${baseClasses} bg-transparent text-white border border-white/30 hover:bg-white/10 hover:border-white/40 focus:ring-white/20`;
		}
		return `${baseClasses} bg-white dark:bg-black/50 text-black dark:text-white border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 focus:ring-black/10 dark:focus:ring-white/10`;
	}
	return getButtonClasses("primary");
};
---

<section class={`
	${background === "solid" ? "bg-white dark:bg-black" : ""}
	${background === "gradient" ? "bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-black dark:to-gray-900" : ""}
	${background === "dark" ? "bg-gradient-to-br from-gray-900 via-black to-gray-900" : ""}
	${background === "none" ? "bg-transparent" : ""}
	${padding === "sm" ? "py-12 px-6" : ""}
	${padding === "md" ? "py-16 px-8" : ""}
	${padding === "lg" ? "py-20 px-10" : ""}
	${padding === "xl" ? "py-24 px-12" : ""}
`}>
	<div class="container mx-auto px-4">
		<div class={`
			${centered ? "mx-auto text-center" : ""}
			${maxWidth === "sm" ? "max-w-2xl" : ""}
			${maxWidth === "md" ? "max-w-4xl" : ""}
			${maxWidth === "lg" ? "max-w-5xl" : ""}
			${maxWidth === "xl" ? "max-w-6xl" : ""}
			${maxWidth === "full" ? "max-w-none" : ""}
		`}>
			{title && (
				<h2 class={`
					font-bold leading-tight mb-4 md:mb-6
					${titleSizeClasses[fontSize]}
					${background === "dark" ? "text-white" : "text-gray-900 dark:text-white"}
				`}>
					{title}
				</h2>
			)}

			<slot name="title" />

			{description && (
				<p class={`
					mb-6 md:mb-8 leading-relaxed
					${descriptionSizeClasses[fontSize]}
					${background === "dark" ? "text-gray-300" : "text-gray-600 dark:text-gray-400"}
					${centered ? "max-w-3xl mx-auto" : "max-w-3xl"}
				`}>
					{description}
				</p>
			)}

			<slot name="description" />
			<slot name="content" />

			{(buttons.length > 0 || Astro.slots.has('buttons')) && (
				<div class={`
					flex flex-col sm:flex-row gap-4
					${centered ? "justify-center" : "justify-start"}
				`}>
					{buttons.map((button) => (
						button.href ? (
							<a
								href={button.href}
								class={getButtonClasses(button.variant || "primary")}
								aria-label={button.text}
							>
								{button.icon && (
									<span class="flex-shrink-0">
										{button.icon === "github" && (
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
												<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
											</svg>
										)}
										{button.icon === "mail" && (
											<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
											</svg>
										)}
										{button.icon === "external" && (
											<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
											</svg>
										)}
									</span>
								)}
								{button.text}
							</a>
						) : (
							<button
								class={getButtonClasses(button.variant || "primary")}
								onclick={button.onClick}
								aria-label={button.text}
							>
								{button.icon && (
									<span class="flex-shrink-0">
										{button.icon === "github" && (
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
												<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
											</svg>
										)}
										{button.icon === "mail" && (
											<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
											</svg>
										)}
										{button.icon === "external" && (
											<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
											</svg>
										)}
									</span>
								)}
								{button.text}
							</button>
						)
					))}

					<slot name="buttons" />
				</div>
			)}

			<slot name="footer" />
		</div>
	</div>
</section>

---
import { Github, Mail, ExternalLink } from "lucide-vue-next";

export interface CTAButton {
	text: string;
	href?: string;
	variant?: "primary" | "secondary" | "outline";
	onClick?: string;
	icon?: string;
}

export interface Props {
	title?: string;
	description?: string;
	buttons?: CTAButton[];
	centered?: boolean;
	fontSize?: "sm" | "md" | "lg" | "xl" | "xxl";
	background?: "solid" | "gradient" | "none";
	padding?: "sm" | "md" | "lg" | "xl";
	maxWidth?: "sm" | "md" | "lg" | "xl" | "full";
}

const {
	title = "Ready to get started?",
	description = "Join thousands of companies already using our platform to build better products faster.",
	centered = true,
	fontSize = "lg",
	background = "gradient",
	padding = "lg",
	maxWidth = "xl",
	buttons = [
		{
			text: "Start Free Trial",
			variant: "primary",
		},
		{
			text: "Book a Demo",
			variant: "secondary",
		},
	],
} = Astro.props;

const titleSizeClasses = {
	sm: "text-2xl md:text-3xl",
	md: "text-3xl md:text-4xl",
	lg: "text-4xl md:text-5xl",
	xl: "text-5xl md:text-6xl",
	xxl: "text-6xl md:text-7xl",
};

const descriptionSizeClasses = {
	sm: "text-sm md:text-base",
	md: "text-base md:text-lg",
	lg: "text-lg md:text-xl",
	xl: "text-xl md:text-2xl",
	xxl: "text-2xl md:text-3xl",
};

const getButtonClasses = (variant: string) => {
	const baseClasses =
		"inline-flex items-center justify-center gap-2 font-medium py-3 px-6 md:py-4 md:px-8 rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 text-base md:text-lg";

	if (variant === "primary") {
		return `${baseClasses} bg-black dark:bg-white text-white dark:text-black hover:bg-neutral-800 dark:hover:bg-neutral-100 focus:ring-black dark:focus:ring-white shadow-sm hover:shadow-md`;
	} else if (variant === "secondary") {
		return `${baseClasses} bg-white dark:bg-black/50 text-black dark:text-white border-2 border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 focus:ring-black/10 dark:focus:ring-white/10`;
	} else if (variant === "outline") {
		return `${baseClasses} bg-white dark:bg-black/50 text-black dark:text-white border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 focus:ring-black/10 dark:focus:ring-white/10`;
	}
	return getButtonClasses("primary");
};
---

<section class={`
	${background === "solid" ? "bg-white dark:bg-black" : ""}
	${background === "gradient" ? "bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-black dark:to-gray-900" : ""}
	${background === "none" ? "bg-transparent" : ""}
	${padding === "sm" ? "py-12 px-6" : ""}
	${padding === "md" ? "py-16 px-8" : ""}
	${padding === "lg" ? "py-20 px-10" : ""}
	${padding === "xl" ? "py-24 px-12" : ""}
`}>
	<div class="container mx-auto px-4">
		<div class={`
			${centered ? "mx-auto text-center" : ""}
			${maxWidth === "sm" ? "max-w-2xl" : ""}
			${maxWidth === "md" ? "max-w-4xl" : ""}
			${maxWidth === "lg" ? "max-w-5xl" : ""}
			${maxWidth === "xl" ? "max-w-6xl" : ""}
			${maxWidth === "full" ? "max-w-none" : ""}
		`}>
			{title && (
				<h2 class={`
					font-bold leading-tight mb-4 md:mb-6
					${titleSizeClasses[fontSize]}
					text-gray-900 dark:text-white
				`}>
					{title}
				</h2>
			)}

			<slot name="title" />

			{description && (
				<p class={`
					mb-6 md:mb-8 leading-relaxed
					${descriptionSizeClasses[fontSize]}
					text-gray-600 dark:text-gray-400
					${centered ? "max-w-3xl mx-auto" : "max-w-3xl"}
				`}>
					{description}
				</p>
			)}

			<slot name="description" />
			<slot name="content" />

			{(buttons.length > 0 || Astro.slots.has('buttons')) && (
				<div class={`
					flex flex-col sm:flex-row gap-4
					${centered ? "justify-center" : "justify-start"}
				`}>
					{buttons.map((button) => (
						button.href ? (
							<a
								href={button.href}
								class={getButtonClasses(button.variant || "primary")}
								aria-label={button.text}
							>
								{button.icon && (
									<span class="flex-shrink-0">
										{button.icon === "github" && <Github class="w-5 h-5" />}
										{button.icon === "mail" && <Mail class="w-5 h-5" />}
										{button.icon === "external" && <ExternalLink class="w-5 h-5" />}
									</span>
								)}
								{button.text}
							</a>
						) : (
							<button
								class={getButtonClasses(button.variant || "primary")}
								onclick={button.onClick}
								aria-label={button.text}
							>
								{button.icon && (
									<span class="flex-shrink-0">
										{button.icon === "github" && <Github class="w-5 h-5" />}
										{button.icon === "mail" && <Mail class="w-5 h-5" />}
										{button.icon === "external" && <ExternalLink class="w-5 h-5" />}
									</span>
								)}
								{button.text}
							</button>
						)
					))}

					<slot name="buttons" />
				</div>
			)}

			<slot name="footer" />
		</div>
	</div>
</section>

---
export interface Props {
	backgroundColor?: "white" | "gray";
}

const { backgroundColor = "white" } = Astro.props;

const companyStats = [
	{ label: "Founded", value: "2025" },
	{ label: "Enterprise Customers", value: "10+" },
	{ label: "Documents Processed", value: "1M+" },
	{ label: "Team Members", value: "3" },
];

const bgClass =
	backgroundColor === "gray"
		? "bg-gray-50 dark:bg-neutral-950"
		: "bg-white dark:bg-black";
---

<section class={`pt-8 pb-32 ${bgClass}`}>
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {companyStats.map(stat => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">
              {stat.value}
            </div>
            <div class="text-gray-600 dark:text-neutral-400 font-medium">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

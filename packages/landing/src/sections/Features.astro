---
import { getCollection, getEntry } from "astro:content";
import {
	Check,
	Lock,
	Zap,
	Shield,
	ShieldCheck,
	Link,
	Users,
	Server,
	Code,
	ClipboardCheck,
	TrendingUp,
	BarChart3,
	Eye,
	FileText,
	Layers,
	DollarSign,
	Cog,
	Globe,
} from "lucide-vue-next";
import type { FunctionalComponent } from "vue";

export interface FeatureItem {
	title: string;
	description: string;
	icon: string;
}

export interface Props {
	title?: string;
	description?: string;
	features?: FeatureItem[];
	category?: string;
	featured?: boolean;
}

const {
	title = "Built for Enterprise Scale",
	description = "Advanced AI technology meets enterprise security requirements. Process thousands of documents with unprecedented accuracy.",
	category,
	featured,
	features: propFeatures,
} = Astro.props;

// Fetch features from content if no features prop is provided
let features: FeatureItem[] = propFeatures || [];

if (!propFeatures) {
	if (category) {
		// Fetch specific category JSON file
		const categoryFeatures = await getEntry("features", category);
		if (categoryFeatures) {
			let featureList = categoryFeatures.data;

			// Filter by featured if specified
			if (featured !== undefined) {
				featureList = featureList.filter(
					(feature) => feature.featured === featured,
				);
			}

			features = featureList
				.sort((a, b) => a.order - b.order)
				.map((feature) => ({
					title: feature.title,
					description: feature.description,
					icon: feature.icon,
				}));
		}
	} else {
		// Fetch all feature categories and combine them
		const allFeatureEntries = await getCollection("features");
		let allFeaturesList = allFeatureEntries.flatMap((entry) => entry.data);

		// Filter by featured if specified
		if (featured !== undefined) {
			allFeaturesList = allFeaturesList.filter(
				(feature) => feature.featured === featured,
			);
		}

		features = allFeaturesList
			.sort((a, b) => a.order - b.order)
			.map((feature) => ({
				title: feature.title,
				description: feature.description,
				icon: feature.icon,
			}));
	}
}

const iconComponents: Record<string, FunctionalComponent> = {
	check: Check,
	lock: Lock,
	zap: Zap,
	shield: Shield,
	"shield-check": ShieldCheck,
	link: Link,
	users: Users,
	server: Server,
	code: Code,
	"clipboard-check": ClipboardCheck,
	"trending-up": TrendingUp,
	"bar-chart-3": BarChart3,
	eye: Eye,
	"file-text": FileText,
	layers: Layers,
	"dollar-sign": DollarSign,
	cog: Cog,
	globe: Globe,
};
---

<section class="py-20 px-4 bg-white dark:bg-black">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-4">
        {title}
      </h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {features.map((feature) => {
        const IconComponent = iconComponents[feature.icon] || Check;
        return (
          <div class="text-center p-8 border border-neutral-100 dark:border-neutral-800 bg-white dark:bg-black rounded-lg hover:border-neutral-200 dark:hover:border-neutral-700 transition-all duration-200">
            <div class="w-12 h-12 bg-black dark:bg-white rounded-lg flex items-center justify-center mx-auto mb-6">
              <IconComponent class="w-6 h-6 text-white dark:text-black" />
            </div>
            <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mb-4">{feature.title}</h3>
            <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {feature.description}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>

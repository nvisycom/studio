---
import { FileText, DollarSign, Heart, Building } from "lucide-vue-next";

export interface UseCase {
	title: string;
	description: string;
	icon: "document" | "dollar" | "heart" | "building";
}

export interface Props {
	title?: string;
	description?: string;
	backgroundColor?: "white" | "gray" | "dark";
	useCases?: UseCase[];
}

const {
	title = "Trusted Across Industries",
	description = "From healthcare to finance, government to legal services, organizations trust our AI-powered redaction technology to protect their most sensitive information.",
	backgroundColor = "white",
	useCases = [
		{
			title: "Legal & Compliance",
			description:
				"Redact client information, case details, and privileged communications while maintaining legal document integrity for court proceedings.",
			icon: "document",
		},
		{
			title: "Financial Services",
			description:
				"Protect SSNs, account numbers, and financial data in loan documents, compliance reports, and customer communications.",
			icon: "dollar",
		},
		{
			title: "Healthcare",
			description:
				"HIPAA-compliant redaction of patient records, medical histories, and research data for secure information sharing.",
			icon: "heart",
		},
		{
			title: "Government",
			description:
				"Redact classified information, personal identifiers, and sensitive data for Freedom of Information Act requests and public disclosures.",
			icon: "building",
		},
	],
} = Astro.props;

const backgroundClasses = {
	white: "bg-white dark:bg-black",
	gray: "bg-gray-50 dark:bg-neutral-950",
	dark: "bg-gray-900 dark:bg-black",
};

const getIcon = (iconName: UseCase["icon"]) => {
	const icons = {
		document: FileText,
		dollar: DollarSign,
		heart: Heart,
		building: Building,
	};
	return icons[iconName];
};
---

<section class={`py-20 px-4 ${backgroundClasses[backgroundColor]}`} aria-labelledby="use-cases-title">
	<div class="container mx-auto max-w-6xl">
		<!-- Header -->
		<header class="text-center mb-16">
			<h2 id="use-cases-title" class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
				{title}
			</h2>
			{description && (
				<p class="text-lg text-gray-600 dark:text-neutral-300 max-w-3xl mx-auto">
					{description}
				</p>
			)}
		</header>

		<!-- Use Cases Grid -->
		<div class="grid md:grid-cols-2 gap-8" role="list">
			{useCases.map((useCase) => {
				const IconComponent = getIcon(useCase.icon);
				return (
					<article class="flex space-x-6 group" role="listitem">
						<div class="w-16 h-16 bg-blue-50 dark:bg-blue-950 rounded-xl flex items-center justify-center flex-shrink-0 mt-1 group-hover:bg-blue-100 dark:group-hover:bg-blue-900 transition-colors duration-300">
							<IconComponent class="w-8 h-8 text-blue-600 dark:text-blue-400" aria-hidden="true" />
						</div>
						<div class="flex-1">
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 group-hover:text-blue-900 dark:group-hover:text-blue-100 transition-colors duration-300">
								{useCase.title}
							</h3>
							<p class="text-gray-600 dark:text-neutral-300 leading-relaxed">
								{useCase.description}
							</p>
						</div>
					</article>
				);
			})}
		</div>

		<!-- Industry Stats -->
		<div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6">
			<div class="text-center p-6 bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800">
				<div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-2">500+</div>
				<div class="text-sm text-gray-600 dark:text-neutral-400">Legal Firms</div>
			</div>
			<div class="text-center p-6 bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800">
				<div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-2">200+</div>
				<div class="text-sm text-gray-600 dark:text-neutral-400">Banks & Credit Unions</div>
			</div>
			<div class="text-center p-6 bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800">
				<div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-2">150+</div>
				<div class="text-sm text-gray-600 dark:text-neutral-400">Healthcare Systems</div>
			</div>
			<div class="text-center p-6 bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800">
				<div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-2">75+</div>
				<div class="text-sm text-gray-600 dark:text-neutral-400">Government Agencies</div>
			</div>
		</div>
	</div>
</section>

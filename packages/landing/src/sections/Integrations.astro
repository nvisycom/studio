---
import {
	Cloud,
	Building,
	Briefcase,
	MessageSquare,
	Zap,
	Server,
	Shield,
	Rocket,
	Settings,
	Code,
	Code2,
	Link,
	FileText,
	ChevronRight,
} from "lucide-vue-next";
import { getCollection } from "astro:content";
import type { FunctionalComponent } from "vue";
import { Button } from "@/components/ui/button";

export interface Props {
	title?: string;
	description?: string;
	backgroundColor?: "white" | "gray";
}

const {
	title = "Seamless Integrations",
	description = "Connect with your existing tools and workflows. Our platform integrates with popular business software to streamline your document processing pipeline.",
	backgroundColor = "white",
} = Astro.props;

// Get all integrations and filter for completed or v1+
const allIntegrations = await getCollection("integrations");
const featuredIntegrations = allIntegrations
	.filter(
		(integration) =>
			integration.data.status === "Completed" ||
			integration.data.status === "In Progress" ||
			integration.data.version.includes("1"),
	)
	.slice(0, 6);

// Icon mapping from FontAwesome to Lucide
const getIcon = (iconName: string) => {
	const iconMap: Record<string, FunctionalComponent> = {
		"google-drive": Cloud,
		dropbox: Cloud,
		aws: Cloud,
		bolt: Zap,
		gears: Settings,
		rocket: Rocket,
		slack: MessageSquare,
		microsoft: Building,
		notion: FileText,
		building: Building,
		shield: Shield,
		server: Server,
		python: Code,
		js: Code2,
		link: Link,
	};

	return iconMap[iconName] || FileText;
};

const bgClass =
	backgroundColor === "gray"
		? "bg-gray-50 dark:bg-neutral-950"
		: "bg-white dark:bg-black";
---

<section class={`py-20 ${bgClass} px-4`}>
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
        {title}
      </h2>
      <p class="text-xl text-gray-600 dark:text-neutral-400 max-w-3xl mx-auto leading-relaxed">
        {description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredIntegrations.map((integration) => {
        const Icon = getIcon(integration.data.icon);
        return (
          <a
            href="/integrations"
            class="group bg-white dark:bg-black border border-gray-200 dark:border-neutral-800 rounded-xl p-6 hover:shadow-lg hover:border-gray-300 dark:hover:border-neutral-700 transition-all duration-300 block no-underline"
          >
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-gray-100 dark:bg-neutral-900 rounded-lg flex items-center justify-center group-hover:bg-gray-200 dark:group-hover:bg-neutral-800 transition-colors mr-4">
                <Icon class="w-6 h-6 text-gray-900 dark:text-white" />
              </div>
              <div class="flex-1 text-center">
                <div class="flex items-center justify-center gap-2 flex-wrap">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-black dark:group-hover:text-white">
                    {integration.data.title}
                  </h3>
                  <span class="text-xs font-medium text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-neutral-800 px-2 py-1 rounded-full">
                    {integration.data.category}
                  </span>
                </div>
              </div>
            </div>

            <p class="text-gray-600 dark:text-neutral-400 text-sm leading-relaxed text-center">
              {integration.data.description}
            </p>
          </a>
        );
      })}
    </div>

    <div class="text-center mt-12">
      <Button variant="default" size="default">
          <a href="/integrations" class="inline-flex items-center gap-2">
            View all integrations
            <ChevronRight class="w-4 h-4" />
          </a>
      </Button>
    </div>
  </div>
</section>

{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"root": false,
	"extends": "//",
	"vcs": {
		"useIgnoreFile": false
	},
	"files": {
		"includes": ["**", "!.output", "!.nuxt"]
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedImports": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	},
	"assist": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["app/components/ui/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noVueDuplicateKeys": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		}
	]
}

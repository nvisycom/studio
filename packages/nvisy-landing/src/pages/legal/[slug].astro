---
import { CTA } from "@/components";
import { Layout } from "@/layouts";
import { getCollection, type CollectionEntry } from "astro:content";
import { Clock, FileText } from "lucide-vue-next";

export async function getStaticPaths() {
	try {
		const legalEntries = await getCollection("legal-docs");
		return legalEntries.map((entry) => ({
			params: { slug: entry.slug },
			props: { entry },
		}));
	} catch (error: unknown) {
		// Return empty array if no legal collection exists.
		console.error("Error fetching legal collection:", error);
		return [];
	}
}

interface Props {
	entry: CollectionEntry<"legal-docs">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={(entry.data as any).description || entry.data.title}>
  <div class="container mx-auto max-w-4xl px-4 py-8">
    <article class="max-w-none mt-8">
      <div class="text-center mb-8">
        <h1 class="text-4xl md:text-5xl font-light text-black dark:text-white mb-4">{entry.data.title}</h1>

        <!-- Metadata Section -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-4 text-sm text-neutral-600 dark:text-neutral-400">
          <div class="flex items-center gap-1">
            <FileText class="w-4 h-4"/>
            <span>Version {entry.data.version}</span>
          </div>

          <div class="flex items-center gap-1">
            <Clock class="w-4 h-4"/>
            <span>Updated {new Date(entry.data.updatedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}</span>
          </div>
        </div>

        <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
            {entry.data.description}
        </p>
      </div>

      <div class="prose prose-xl max-w-none mx-auto leading-loose text-neutral-800 dark:text-neutral-200 prose-headings:text-neutral-900 dark:prose-headings:text-neutral-100 prose-strong:text-neutral-900 dark:prose-strong:text-neutral-100" style="font-size: 1.125rem; line-height: 1.8;">
        <Content />
      </div>
    </article>
  </div>

  <CTA
    title="Questions about our legal policies?"
    description="If you have questions about our legal documents or need clarification on our policies, please don't hesitate to reach out to our legal team."
    background="solid"
    buttons={[
      {
        text: "Email Us",
        href: "mailto:hello@nvisy.com",
        variant: "primary"
      }
    ]}
  />
</Layout>

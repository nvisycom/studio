---
import { Layout } from "@/layouts";
import { getCollection, type CollectionEntry } from "astro:content";
import { Hero, LegalCard, Security } from "@/components";
import { File } from "@lucide/vue";

let legalEntries: CollectionEntry<"legal-docs">[] = [];
try {
	legalEntries = await getCollection("legal-docs");
} catch (error: unknown) {
	console.error("Error fetching legal collection:", error);
}

legalEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Legal" description="Legal documents and policies for our platform and services." hideFooterBorder>
  <Hero
    title="Legal"
    description="The documents, policies, and terms that govern our services."
    primaryCta={null}
    compact
  />

  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        {legalEntries.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {legalEntries.map((entry) => (
              <LegalCard entry={entry} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 bg-muted rounded-2xl flex items-center justify-center mx-auto mb-4">
              <File class="w-8 h-8 text-muted-foreground" />
            </div>
            <h3 class="text-lg font-medium mb-2">No legal documents found</h3>
            <p class="text-muted-foreground">Legal documents will appear here once they are available.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <Security />
</Layout>

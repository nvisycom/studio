---
import { Layout } from "@/layouts";
import { Hero, CTA, OpenSource, Features, Security } from "@/components";
import SDKExamples from "@/components/sections/SDKExamples.astro";
import Connect from "@/components/sections/Connect.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import { Check, Shield, ArrowRight, BookOpen, Cloud } from "lucide-vue-next";
import GithubIcon from "@/assets/icons/github.svg?raw";
---

<Layout
  title="Nvisy Server"
  description="Deploy Nvisy's AI-powered document processing in the cloud or on your own infrastructure. Flexible deployment options for any security and compliance requirement."
  hideFooterBorder
>
  <Hero
    title="Nvisy"
    titleHighlight="Server"
    titleInline={true}
    description="Enterprise-grade document processing with flexible deployment options. Deploy in our managed cloud or on your own infrastructure."
    primaryCta={{ text: "Start Free Trial", href: "/pricing" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <section class="py-24 md:py-32 relative overflow-hidden">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/30 to-transparent" />

    <div class="container relative z-10 mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="scroll-reveal text-center mb-16" data-reveal>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
            Choose your deployment
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Deploy in our managed cloud for zero maintenance, or self-host for complete control.
          </p>
        </div>

        <!-- Deployment options -->
        <div class="scroll-reveal grid grid-cols-1 lg:grid-cols-3 gap-8" style="--reveal-delay: 100ms;" data-reveal>
          <!-- Cloud - Recommended -->
          <div class="relative group">
            <div class="absolute -inset-px bg-gradient-to-b from-foreground/20 to-foreground/5 rounded-3xl" />
            <div class="relative h-full p-8 rounded-3xl bg-card border border-foreground/10 flex flex-col">
              <!-- Badge -->
              <div class="absolute -top-3 left-6 px-3 py-1 bg-foreground text-background text-xs font-medium rounded-full">
                Recommended
              </div>

              <div class="flex items-center gap-4 mb-6 mt-2">
                <div class="w-12 h-12 rounded-xl bg-foreground flex items-center justify-center">
                  <Cloud className="w-6 h-6 text-background" />
                </div>
                <div>
                  <h3 class="text-lg font-semibold">Nvisy Cloud</h3>
                  <p class="text-sm text-muted-foreground">Managed service</p>
                </div>
              </div>

              <p class="text-muted-foreground mb-8">
                Fully managed cloud deployment. Deploy in minutes, scale instantly.
              </p>

              <ul class="space-y-3 mb-8 flex-grow">
                <li class="flex items-center gap-3">
                  <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                  <span class="text-muted-foreground">Zero infrastructure management</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                  <span class="text-muted-foreground">Auto-scaling & high availability</span>
                </li>
                <li class="flex items-center gap-3">
                  <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                  <span class="text-muted-foreground">100 free pages/month</span>
                </li>
              </ul>

              <a
                href="/pricing"
                class="inline-flex items-center justify-center gap-2 bg-foreground text-background font-medium py-3 px-6 rounded-xl hover:opacity-90 transition-opacity"
              >
                Start Free Trial
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>

          <!-- Open Source -->
          <div class="group h-full p-8 rounded-3xl bg-card border border-border hover:border-border/80 hover:bg-card/80 transition-all duration-300 flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-xl bg-accent flex items-center justify-center">
                <div class="w-6 h-6 text-foreground [&>svg]:w-full [&>svg]:h-full">
                  <Fragment set:html={GithubIcon} />
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold">Open Source</h3>
                <p class="text-sm text-muted-foreground">MIT Licensed</p>
              </div>
            </div>

            <p class="text-muted-foreground mb-8">
              Run Nvisy Server for free. Perfect for testing and development.
            </p>

            <ul class="space-y-3 mb-8 flex-grow">
              <li class="flex items-center gap-3">
                <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                <span class="text-muted-foreground">Free to use and modify</span>
              </li>
              <li class="flex items-center gap-3">
                <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                <span class="text-muted-foreground">Docker container support</span>
              </li>
              <li class="flex items-center gap-3">
                <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                <span class="text-muted-foreground">Community support</span>
              </li>
            </ul>

            <div class="flex flex-col gap-3">
              <a
                href="https://github.com/nvisycom/server"
                class="inline-flex items-center justify-center gap-2 bg-foreground text-background font-medium py-3 px-6 rounded-xl hover:opacity-90 transition-opacity"
              >
                <div class="w-4 h-4 [&>svg]:w-full [&>svg]:h-full">
                  <Fragment set:html={GithubIcon} />
                </div>
                View on GitHub
              </a>
              <a
                href="https://docs.nvisy.com/server/quickstart"
                class="inline-flex items-center justify-center gap-2 border border-border text-foreground font-medium py-3 px-6 rounded-xl hover:bg-accent transition-colors"
              >
                <BookOpen className="w-4 h-4" />
                Quick Start
              </a>
            </div>
          </div>

          <!-- Enterprise -->
          <div class="group h-full p-8 rounded-3xl bg-card border border-border hover:border-border/80 hover:bg-card/80 transition-all duration-300 flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-xl bg-accent flex items-center justify-center">
                <Shield className="w-6 h-6 text-muted-foreground" />
              </div>
              <div>
                <h3 class="text-lg font-semibold">Enterprise</h3>
                <a href="/pricing" class="text-sm text-muted-foreground hover:text-foreground transition-colors underline underline-offset-2">View Pricing</a>
              </div>
            </div>

            <p class="text-muted-foreground mb-8">
              Enterprise-grade support and custom deployment assistance.
            </p>

            <ul class="space-y-3 mb-8 flex-grow">
              <li class="flex items-center gap-3">
                <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                <span class="text-muted-foreground">24/7 enterprise support</span>
              </li>
              <li class="flex items-center gap-3">
                <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                <span class="text-muted-foreground">Deployment assistance</span>
              </li>
              <li class="flex items-center gap-3">
                <Check className="w-5 h-5 text-emerald-500 flex-shrink-0" />
                <span class="text-muted-foreground">Air-gapped environments</span>
              </li>
            </ul>

            <a
              href="mailto:hello@nvisy.com"
              class="inline-flex items-center justify-center gap-2 bg-foreground text-background font-medium py-3 px-6 rounded-xl hover:opacity-90 transition-opacity"
            >
              Contact Sales
              <ArrowRight className="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Features
    title="Built for enterprise scale"
    description="Advanced AI technology meets enterprise security requirements."
    category="general"
    featured={true}
  />

  <HowItWorks />

  <OpenSource
    title="Built on open source"
    description="Server is fully open source. Contribute, validate our security approach, and build with confidence."
  />

  <Connect
    title="Flexible integration"
    description="Powerful APIs and comprehensive SDKs make it easy to integrate document processing."
  />

  <SDKExamples
    title="Developer-friendly SDKs"
    description="Get started in minutes with our TypeScript and Python SDKs."
  />

  <CTA
    title="Ready to get started?"
    description="Deploy AI-powered document processing in minutes. Start with 100 free pages per month."
    primaryCta={{ text: "Start Free Trial", href: "/pricing" }}
    secondaryCta={{ text: "View on GitHub", href: "https://github.com/nvisycom/server" }}
  />
  <Security />
</Layout>

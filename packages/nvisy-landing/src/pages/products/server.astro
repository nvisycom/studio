---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	OpenSource,
	Premium,
	Features,
	Security,
} from "@/components";
import SDKExamples from "@/components/sections/SDKExamples.astro";
import Connect from "@/components/sections/Connect.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import { Check, Shield, ArrowRight, BookOpen, Cloud } from "lucide-vue-next";
import GithubIcon from "@/assets/icons/github.svg?raw";
---

<Layout
  title="Nvisy Server"
  description="Deploy Nvisy's AI-powered document processing in the cloud or on your own infrastructure. Flexible deployment options for any security and compliance requirement."
>
  <Hero
    title="Nvisy Server"
    description="Enterprise-grade document processing with flexible deployment options. Deploy in our managed cloud for instant scalability, or on your own infrastructure for maximum control. Perfect for organizations of any size with any compliance requirement."
    background="gradient"
    buttons={[
      {
        text: "Start Free Trial",
        href: "/pricing",
        variant: "primary"
      },
      {
        text: "View Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
  />

  <div class="container mx-auto px-4 py-12 md:py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-neutral-900 dark:text-white mb-3 md:mb-4">
          Choose Your Deployment
        </h2>
        <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto px-4">
          Deploy in our managed cloud for zero maintenance, or self-host for complete control. Both options offer the same powerful AI capabilities.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Cloud -->
        <div class="bg-white dark:bg-black rounded-xl border-2 border-neutral-900 dark:border-white p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 relative flex flex-col">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-black dark:bg-white text-white dark:text-black text-xs font-medium px-3 py-1 rounded-full">
            Recommended
          </div>

          <div class="flex items-center gap-3 mb-6 mt-2">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-neutral-700 to-neutral-900 rounded-2xl flex items-center justify-center">
              <Cloud class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            <div>
              <h3 class="text-xl md:text-2xl font-light text-neutral-900 dark:text-white">Nvisy Cloud</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">Managed service</p>
            </div>
          </div>

          <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
            Fully managed cloud deployment. Deploy in minutes, scale instantly, maintain nothing. Perfect for teams that want to focus on their product.
          </p>

          <div class="space-y-2 mb-8 flex-grow">
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Zero infrastructure management</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Auto-scaling & high availability</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Automatic updates & patches</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">100 free pages/month</span>
            </div>
          </div>

          <a
            href="/pricing"
            class="inline-flex items-center justify-center gap-2 bg-neutral-900 dark:bg-white text-white dark:text-black font-medium py-3 px-6 rounded-xl hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all duration-200 text-sm mt-auto"
          >
            Start Free Trial
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <!-- Open Source -->
        <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-neutral-100 dark:bg-neutral-800 rounded-2xl flex items-center justify-center">
              <div class="w-6 h-6 md:w-7 md:h-7 text-neutral-900 dark:text-white [&>svg]:w-full [&>svg]:h-full">
                <Fragment set:html={GithubIcon} />
              </div>
            </div>
            <div>
              <h3 class="text-xl md:text-2xl font-light text-neutral-900 dark:text-white">Open Source</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">MIT Licensed</p>
            </div>
          </div>

          <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
            Run Nvisy Server for free using our open-source release. Perfect for testing, development, or small-scale deployments.
          </p>

          <div class="space-y-2 mb-8 flex-grow">
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Free to use and modify</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Docker container support</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Community support</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Self-managed updates</span>
            </div>
          </div>

          <div class="flex flex-col gap-3 mt-auto">
            <a
              href="https://github.com/nvisycom/server"
              class="inline-flex items-center justify-center gap-2 bg-neutral-900 dark:bg-white text-white dark:text-black font-medium py-3 px-6 rounded-xl hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all duration-200 text-sm"
            >
              <div class="w-4 h-4 [&>svg]:w-full [&>svg]:h-full">
                <Fragment set:html={GithubIcon} />
              </div>
              View on GitHub
            </a>
            <a
              href="https://docs.nvisy.com/server/quickstart"
              class="inline-flex items-center justify-center gap-2 border border-neutral-300 dark:border-neutral-600 text-neutral-900 dark:text-white font-medium py-3 px-6 rounded-xl hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-all duration-200 text-sm"
            >
              <BookOpen class="w-4 h-4" />
              Quick Start
            </a>
          </div>
        </div>

        <!-- Enterprise -->
        <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 md:p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-neutral-100 dark:bg-neutral-800 rounded-2xl flex items-center justify-center">
              <Shield class="w-6 h-6 md:w-7 md:h-7 text-neutral-900 dark:text-white" />
            </div>
            <div>
              <h3 class="text-xl md:text-2xl font-light text-neutral-900 dark:text-white">Enterprise</h3>
              <a href="/pricing" class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white underline">View Pricing</a>
            </div>
          </div>

          <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed">
            Enterprise-grade support, custom deployment assistance, and priority access to new features. Perfect for production deployments.
          </p>

          <div class="space-y-2 mb-8 flex-grow">
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">24/7 enterprise support</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Deployment assistance</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Priority feature access</span>
            </div>
            <div class="flex items-start gap-2">
              <Check class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-neutral-700 dark:text-neutral-400">Air-gapped environments</span>
            </div>
          </div>

          <a
            href="mailto:hello@nvisy.com"
            class="inline-flex items-center justify-center gap-2 bg-neutral-900 dark:bg-white text-white dark:text-black font-medium py-3 px-6 rounded-xl hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all duration-200 text-sm mt-auto"
          >
            Contact Sales
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <Features
    title="Built for Enterprise Scale"
    description="Advanced AI technology meets enterprise security requirements. Process thousands of documents with unprecedented accuracy."
    category="general"
    featured={true}
  />

  <HowItWorks />

  <OpenSource
    title="Built on Open Source"
    description="Server is fully open source. Contribute, validate our security approach, and build with confidence."
  />

  <Connect
    title="Flexible Integration"
    description="Powerful APIs and comprehensive SDKs make it easy to integrate document processing into your applications."
  />

  <SDKExamples
    title="Developer-Friendly SDKs"
    description="Get started in minutes with our TypeScript and Python SDKs. Built for developers, with full type safety and comprehensive documentation."
  />

  <CTA
    title="Ready to Get Started?"
    description="Deploy AI-powered document processing in minutes. Start with 100 free pages per month."
    buttons={[
      {
        text: "Start Free Trial",
        href: "/pricing",
        variant: "primary"
      },
      {
        text: "View on GitHub",
        href: "https://github.com/nvisycom/server",
        variant: "secondary"
      }
    ]}
    background="gradient"
  />
  <Security />
</Layout>

---
import { Layout } from "@/layouts";
import { Hero, CTA, Security, Premium, Features } from "@/components";
import SDKExamples from "@/components/sections/SDKExamples.astro";
import Connect from "@/components/sections/Connect.astro";
import Review from "@/components/sections/Review.astro";
---

<Layout
  title="Nvisy Cloud"
  description="Deploy Nvisy's AI-powered document processing in the cloud. Global scale, managed infrastructure, and enterprise security with zero maintenance."
>
  <Hero
    title="Nvisy Cloud"
    description="Enterprise-grade document processing delivered as a fully managed cloud service. Deploy in minutes, scale instantly, maintain nothing. Get the power of AI-driven data extraction without the infrastructure complexity."
    background="gradient"
    buttons={[
      {
        text: "Start Free Trial",
        href: "/pricing",
        variant: "primary"
      },
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "secondary"
      }
    ]}
  />

  <Features
    title="Built for Enterprise Scale"
    description="Advanced AI technology meets enterprise security requirements. Process thousands of documents with unprecedented accuracy."
    category="general"
    featured={true}
  />

  <Review
    title="How It Works"
    description="Simple, secure workflow from upload to download. AI-powered extraction in four easy steps."
  />

  <Connect
    title="Seamless Integration"
    description="Powerful APIs and comprehensive SDKs make it easy to integrate document processing into your applications."
  />

  <SDKExamples
    title="Developer-Friendly SDKs"
    description="Get started in minutes with our TypeScript and Python SDKs. Built for developers, with full type safety and comprehensive documentation."
  />

  <Premium
    title="Enterprise Solutions"
    description="Need more control? We offer on-premise deployment, source code access, and custom enterprise pricing for organizations with specific requirements."
  />

  <CTA
    title="Ready to Get Started?"
    description="Deploy AI-powered document processing in minutes. Start with 100 free pages per month."
    buttons={[
      {
        text: "Start Free Trial",
        href: "/pricing",
        variant: "primary"
      },
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "secondary"
      }
    ]}
    background="solid"
  />
  <Security />
</Layout>

---
import { Layout } from "@/layouts";
import { Hero, CTA } from "@/components";
import SDKExamples from "@/components/sections/SDKExamples.astro";
import {
	Cloud,
	Server,
	Check,
	ArrowRight,
	Zap,
	Shield,
	Github,
} from "lucide-vue-next";
---

<Layout
  title="Products"
  description="Choose the right deployment model for your document processing needs. Cloud-based for instant scale or on-premises for maximum control."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <div class="border-b border-neutral-200 dark:border-neutral-800">
      <Hero
        title="AI-Powered Document Processing"
        description="Deploy anywhere, scale everywhere. Choose cloud for instant deployment and zero maintenance, or on-premises for complete control and data sovereignty."
        background="gradient"
        buttons={[
          {
            text: "Start Free Trial",
            href: "/pricing",
            variant: "primary"
          },
          {
            text: "Compare Products",
            href: "#products",
            variant: "secondary"
          }
        ]}
      />
    </div>

    <!-- Quick Stats -->
    <div class="bg-neutral-50 dark:bg-neutral-950/50 py-8 md:py-12">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto text-center">
          <div>
            <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white">99.99%</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">Uptime SLA</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white">5 min</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">Setup Time</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white">100M+</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">Documents Processed</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white">SOC 2</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">Certified</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Products -->
    <div class="container mx-auto px-4 py-16 md:py-24" id="products">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-neutral-900 dark:text-white mb-6">
            Choose Your Deployment
          </h2>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto leading-relaxed">
            Same powerful AI technology, different deployment options. Pick what works best for your security,
            compliance, and operational requirements.
          </p>
        </div>

        <!-- Product Comparison -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-20">
          <!-- Nvisy Cloud -->
          <div class="group relative bg-white dark:bg-black rounded-3xl border-2 border-neutral-200 dark:border-neutral-700 overflow-hidden hover:border-blue-300 dark:hover:border-blue-600 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
            <!-- Recommended Badge -->
            <div class="absolute -top-px left-1/2 transform -translate-x-1/2">
              <div class="bg-gradient-to-r from-blue-500 to-purple-600 text-white text-xs font-semibold px-4 py-1 rounded-b-lg">
                Most Popular
              </div>
            </div>

            <div class="p-8 md:p-10 pt-12 md:pt-14">
              <!-- Icon and Badge -->
              <div class="flex items-start justify-between mb-8">
                <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl flex items-center justify-center group-hover:scale-110 transition-transform">
                  <Cloud class="w-8 h-8 text-white" />
                </div>
                <div class="flex items-center gap-2">
                  <Zap class="w-4 h-4 text-blue-600" />
                  <span class="text-blue-700 dark:text-blue-300 text-sm font-medium">Instant Setup</span>
                </div>
              </div>

              <h3 class="text-2xl md:text-3xl font-light text-neutral-900 dark:text-white mb-4">Nvisy Cloud</h3>
              <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
                Fully managed cloud service with global scale, zero maintenance, and enterprise-grade security.
                Perfect for teams that prioritize speed and scalability.
              </p>

              <!-- Key Benefits -->
              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">Deploy in 5 minutes</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">No infrastructure setup required</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">99.99% uptime SLA</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Multi-region global deployment</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">Auto-scaling</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Handle any volume automatically</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">Pay-as-you-go pricing</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">No upfront costs or commitments</p>
                  </div>
                </div>
              </div>

              <!-- Best For -->
              <div class="bg-blue-50 dark:bg-blue-950 rounded-xl p-4 mb-8">
                <h4 class="font-semibold text-neutral-900 dark:text-white mb-2">Perfect for:</h4>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  SaaS companies, startups, and organizations prioritizing rapid deployment and scalability
                </p>
              </div>

              <a
                href="/pricing"
                class="inline-flex items-center justify-center w-full bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold py-4 px-6 rounded-xl hover:from-blue-600 hover:to-purple-700 transition-all duration-200 group"
              >
                Start Free Trial
                <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>

          <!-- Nvisy Server -->
          <div class="group relative bg-white dark:bg-black rounded-3xl border-2 border-neutral-200 dark:border-neutral-700 overflow-hidden hover:border-neutral-400 dark:hover:border-neutral-500 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
            <!-- Enterprise Badge -->
            <div class="absolute -top-px left-1/2 transform -translate-x-1/2">
              <div class="bg-gradient-to-r from-neutral-800 to-black text-white text-xs font-semibold px-4 py-1 rounded-b-lg">
                Enterprise
              </div>
            </div>

            <div class="p-8 md:p-10 pt-12 md:pt-14">
              <!-- Icon and Badge -->
              <div class="flex items-start justify-between mb-8">
                <div class="w-16 h-16 bg-gradient-to-br from-neutral-800 to-black rounded-3xl flex items-center justify-center group-hover:scale-110 transition-transform">
                  <Server class="w-8 h-8 text-white" />
                </div>
                <div class="flex items-center gap-2">
                  <Shield class="w-4 h-4 text-green-600" />
                  <span class="text-green-700 dark:text-green-300 text-sm font-medium">Max Security</span>
                </div>
              </div>

              <h3 class="text-2xl md:text-3xl font-light text-neutral-900 dark:text-white mb-4">Nvisy Server</h3>
              <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
                On-premises deployment with complete control, data sovereignty, and air-gap capability.
                Built for enterprises with strict compliance requirements.
              </p>

              <!-- Key Benefits -->
              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">100% on-premises</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Zero data leaves your network</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">Air-gap ready</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Deploy in isolated environments</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">Custom AI models</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Bring your own models and configurations</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Check class="w-5 h-5 text-green-600 flex-shrink-0 mt-1" />
                  <div>
                    <span class="text-neutral-900 dark:text-white font-semibold">Annual licensing</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Flexible subscription model</p>
                  </div>
                </div>
              </div>

              <!-- Best For -->
              <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-4 mb-8">
                <h4 class="font-semibold text-neutral-900 dark:text-white mb-2">Perfect for:</h4>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  Government, healthcare, finance, and enterprises requiring data sovereignty
                </p>
              </div>

              <div class="flex gap-3">
                <a
                  href="https://github.com/nvisycom/server"
                  class="flex-1 inline-flex items-center justify-center gap-2 bg-neutral-900 dark:bg-white text-white dark:text-black font-semibold py-4 px-6 rounded-xl hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all duration-200"
                >
                  <Github class="w-4 h-4" />
                  GitHub
                </a>
                <a
                  href="/products/server"
                  class="flex-1 inline-flex items-center justify-center gap-2 border-2 border-neutral-300 dark:border-neutral-600 text-neutral-900 dark:text-white font-semibold py-4 px-6 rounded-xl hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-all duration-200 group"
                >
                  Learn More
                  <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>
          </div>
        </div>

    <!-- SDKs and Developer Tools -->
    <SDKExamples
      title="Developer Tools & SDKs"
      description="Integrate document processing into your applications with our comprehensive developer tools. All open source and community-driven."
    />

    <!-- CTA Section -->
    <CTA
      title="Ready to Get Started?"
      description="Choose the deployment model that fits your needs and start protecting sensitive information in minutes, not months."
      buttons={[
        {
          text: "Start Free Trial",
          href: "/pricing",
          variant: "primary"
        },
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "secondary"
        }
      ]}
    />
  </div>
</Layout>

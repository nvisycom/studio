---
import { Layout } from "@/layouts";
import { Hero, CTA, OpenSource, Security } from "@/components";
import { Zap, Shield, Lock, Cpu, Layers, ShieldCheck } from "lucide-vue-next";
import GithubIcon from "@/assets/icons/github.svg?raw";
---

<Layout
  title="Nvisy Runtime"
  description="Self-hosted data redaction engine for automated PII and PHI removal. Deploy on your infrastructure for complete data sovereignty."
  hideFooterBorder
>
  <Hero
    title="Nvisy"
    titleHighlight="Runtime"
    titleInline={true}
    description="Self-hosted redaction engine that detects and removes sensitive information from documents, images, and audio. Deploy on your infrastructure for complete data sovereignty."
    primaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com/runtime" }}
    secondaryCta={null}
    compact
  >
    <a slot="buttons" href="https://github.com/nvisycom/runtime" class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-background px-6 py-3 text-sm font-medium hover:bg-accent transition-colors">
      <span class="w-4 h-4 flex-shrink-0 [&>svg]:w-full [&>svg]:h-full">
        <Fragment set:html={GithubIcon} />
      </span>
      View on GitHub
    </a>
    <p slot="content" class="text-sm text-muted-foreground mt-6">
      Latest version: v1.0.0 · Apache 2.0 License · <a href="https://github.com/nvisycom/runtime/releases" class="hover:text-foreground transition-colors underline">View all releases</a>
    </p>
  </Hero>

  <!-- Capabilities -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/30 to-transparent" />
    <div class="container relative z-10 mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
          Built for production redaction
        </h2>
        <p class="text-lg text-muted-foreground">
          Detect and redact sensitive data at scale with deterministic, repeatable results.
        </p>
      </div>

      {(() => {
        const cards = [
          {
            icon: ShieldCheck,
            title: "Multimodal Redaction",
            description: "Process documents, images, and audio. Get redacted files with full audit trails for compliance verification.",
            wide: true,
          },
          {
            icon: Zap,
            title: "High Throughput",
            description: "Process thousands of pages per minute with parallel execution and efficient resource management.",
          },
          {
            icon: Shield,
            title: "Deterministic Output",
            description: "Same input, same redaction. Repeatable results for compliance and auditing.",
          },
          {
            icon: Lock,
            title: "Data Sovereignty",
            description: "All processing happens on your infrastructure. No data leaves your environment. Air-gapped deployments supported.",
            wide: true,
          },
          {
            icon: Layers,
            title: "Deploy Anywhere",
            description: "Self-host on your infrastructure or embed directly into your application via our SDKs.",
          },
          {
            icon: Cpu,
            title: "Built with Rust",
            description: "Memory-safe, minimal footprint. No garbage collection pauses, predictable latency under load.",
          },
        ];

        return (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
            {cards.map((card, i) => (
              <div
                class:list={[
                  "scroll-reveal group relative p-6 md:p-8 rounded-2xl border border-border bg-card/50 hover:border-border/60 transition-all duration-300",
                  card.wide && "md:col-span-2",
                ]}
                style={`--reveal-delay: ${i * 100}ms;`}
                data-reveal
              >
                <div class="w-10 h-10 rounded-xl bg-foreground/5 flex items-center justify-center mb-4 group-hover:bg-foreground/10 transition-colors duration-300">
                  <card.icon class="w-5 h-5 text-foreground" />
                </div>
                <h3 class="text-lg font-semibold mb-2 tracking-tight">{card.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{card.description}</p>
              </div>
            ))}
          </div>
        );
      })()}
    </div>
  </section>

  <OpenSource
    title="Open source, Apache 2.0"
    description="Nvisy Runtime is open source under the Apache 2.0 license. Inspect the code, contribute, and deploy with confidence."
  />

  <CTA
    title="Ready for self-hosted redaction?"
    description="Deploy Nvisy Runtime in your infrastructure with full data sovereignty and air-gapped support."
    primaryCta={{ text: "Get Started", href: "https://docs.nvisy.com/runtime/quickstart" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com/runtime" }}
  />
  <Security />
</Layout>

---
import {
	Hero,
	CTA,
	FAQ,
	SocialProof,
	PricingCards,
	PricingComparison,
	Security,
} from "@/components";
import { Layout } from "@/layouts";
---

<Layout title="Pricing" description="Choose the perfect plan for your needs. Simple, transparent pricing with no hidden fees." hideFooterBorder>
  <Hero
    title="Pricing"
    description="Start free and scale as you grow. No hidden fees or surprise charges."
    compact
  />

  <PricingCards client:load />

  <SocialProof
    showTitle={false}
    subtitle="Trusted by industry leaders worldwide"
  />

  <PricingComparison />

  <FAQ
    title="Frequently asked questions"
    description="Everything you need to know about our pricing and plans."
    category="pricing"
  />

  <CTA
    title="Ready to get started?"
    description="Join thousands of companies already using our platform."
    primaryCta={{ text: "Start Free Trial", href: "https://app.nvisy.com/auth/signup" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <Security />
</Layout>

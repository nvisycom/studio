---
import {
	Hero,
	CTA,
	FAQ,
	SocialProof,
	PricingCards,
	PricingComparison,
	Security,
} from "@/components";
import { Layout } from "@/layouts";
---

<Layout title="Pricing" description="Usage-based pricing for data redaction. Start free with 500 credits per month." hideFooterBorder>
  <Hero
    title="Pricing"
    description="Usage-based pricing for automated data redaction. Start free and scale as you grow."
    compact
  />

  <PricingCards client:load />

  <SocialProof
    showTitle={false}
    subtitle="Trusted by industry leaders worldwide"
  />

  <PricingComparison />

  <FAQ
    title="Frequently asked questions"
    description="Everything you need to know about our pricing and plans."
    category="pricing"
  />

  <CTA
    title="Ready to protect your data?"
    description="Start with 500 free credits per month. No credit card required."
    primaryCta={{ text: "Start Free", href: "https://app.nvisy.com/auth/signup" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <Security />
</Layout>

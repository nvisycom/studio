---
import { Layout } from "@/layouts";
import { Hero, CTA, Connect } from "@/components";
import IntegrationsGrid from "@/components/sections/IntegrationsGrid.vue";

import AnthropicIcon from "@/assets/integration/anthropic.svg?raw";
import DiscordIcon from "@/assets/integration/discord.svg?raw";
import DropboxIcon from "@/assets/integration/dropbox.svg?raw";
import GoogleDriveIcon from "@/assets/integration/google-drive.svg?raw";
import MakeIcon from "@/assets/integration/make.svg?raw";
import OneDriveIcon from "@/assets/integration/microsoft-onedrive.svg?raw";
import TeamsIcon from "@/assets/integration/microsoft-teams.svg?raw";
import MinioIcon from "@/assets/integration/minio.svg?raw";
import N8nIcon from "@/assets/integration/n8n.svg?raw";
import NotionIcon from "@/assets/integration/notion.svg?raw";
import OpenAIIcon from "@/assets/integration/openai.svg?raw";
import SlackIcon from "@/assets/integration/slack.svg?raw";
import ZapierIcon from "@/assets/integration/zapier.svg?raw";

const integrations = [
	{
		name: "Anthropic",
		icon: AnthropicIcon,
		description: "Claude-powered entity detection for redaction.",
		status: "available" as const,
		category: "ai",
	},
	{
		name: "Discord",
		icon: DiscordIcon,
		description: "Receive redaction notifications in your Discord channels.",
		status: "coming_soon" as const,
		category: "communication",
	},
	{
		name: "Dropbox",
		icon: DropboxIcon,
		description: "Connect Dropbox folders for automated redaction workflows.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Google Drive",
		icon: GoogleDriveIcon,
		description: "Redact documents directly from your Google Drive folders.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Make",
		icon: MakeIcon,
		description:
			"Build complex automation scenarios with Make (formerly Integromat).",
		status: "available" as const,
		category: "automation",
	},
	{
		name: "Microsoft OneDrive",
		icon: OneDriveIcon,
		description: "Sync with OneDrive for seamless redaction workflows.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Microsoft Teams",
		icon: TeamsIcon,
		description: "Integrate redaction workflows into Microsoft Teams.",
		status: "available" as const,
		category: "communication",
	},
	{
		name: "n8n",
		icon: N8nIcon,
		description: "Open-source workflow automation with full control.",
		status: "available" as const,
		category: "automation",
	},
	{
		name: "Notion",
		icon: NotionIcon,
		description: "Automatically export redaction reports to Notion databases.",
		status: "available" as const,
		category: "productivity",
	},
	{
		name: "OpenAI",
		icon: OpenAIIcon,
		description: "Enhanced entity detection with GPT models for redaction.",
		status: "available" as const,
		category: "ai",
	},
	{
		name: "S3-Compatible Storage",
		icon: MinioIcon,
		description:
			"Connect any S3-compatible storage including AWS S3, MinIO, and others.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Slack",
		icon: SlackIcon,
		description:
			"Get notified when redaction is complete and share results with your team.",
		status: "available" as const,
		category: "communication",
	},
	{
		name: "Zapier",
		icon: ZapierIcon,
		description: "Connect Nvisy to 5,000+ apps with Zapier workflows.",
		status: "available" as const,
		category: "automation",
	},
];
---

<Layout
  title="Integrations"
  description="Connect Nvisy with your favorite tools. Automate redaction workflows with 50+ integrations."
  hideFooterBorder
>
  <Hero
    title="Integrations"
    titleHighlight="for your stack"
    description="Connect Nvisy with the tools you already use. Automate redaction workflows and sync data across your entire stack."
    primaryCta={{ text: "Get Started", href: "https://app.nvisy.com/auth/signup" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com/integrations" }}
    compact
  />

  <!-- Integrations Grid -->
  <section class="py-24 md:py-32">
    <div class="container mx-auto max-w-6xl px-4">
      <IntegrationsGrid integrations={integrations} client:load />
    </div>
  </section>

  <!-- Connect -->
  <Connect
    title="Connect your workflow"
    description="Seamlessly integrate Nvisy into your existing infrastructure with powerful APIs and webhooks."
  />

  <CTA
    title="Need a different integration?"
    description="We're constantly adding new integrations. Let us know what you need or get started with what's available."
    primaryCta={{ text: "Get Started", href: "https://app.nvisy.com/auth/signup" }}
    secondaryCta={{ text: "Request Integration", href: "mailto:support@nvisy.com?subject=Integration Request" }}
  />
</Layout>

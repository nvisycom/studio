---
import { Layout } from "@/layouts";
import { CTA, Security } from "@/components";
import IntegrationsGrid from "@/components/sections/IntegrationsGrid.vue";

import AnthropicIcon from "@/assets/integration/anthropic.svg?raw";
import DiscordIcon from "@/assets/integration/discord.svg?raw";
import DropboxIcon from "@/assets/integration/dropbox.svg?raw";
import GoogleDriveIcon from "@/assets/integration/google-drive.svg?raw";
import MakeIcon from "@/assets/integration/make.svg?raw";
import OneDriveIcon from "@/assets/integration/microsoft-onedrive.svg?raw";
import TeamsIcon from "@/assets/integration/microsoft-teams.svg?raw";
import MinioIcon from "@/assets/integration/minio.svg?raw";
import N8nIcon from "@/assets/integration/n8n.svg?raw";
import NotionIcon from "@/assets/integration/notion.svg?raw";
import OpenAIIcon from "@/assets/integration/openai.svg?raw";
import SlackIcon from "@/assets/integration/slack.svg?raw";
import ZapierIcon from "@/assets/integration/zapier.svg?raw";

const integrations = [
	{
		name: "Anthropic",
		icon: AnthropicIcon,
		description: "Use Claude models for entity detection and classification.",
		status: "available" as const,
		category: "ai",
	},
	{
		name: "OpenAI",
		icon: OpenAIIcon,
		description: "Use GPT models for entity detection and classification.",
		status: "available" as const,
		category: "ai",
	},
	{
		name: "Google Drive",
		icon: GoogleDriveIcon,
		description: "Watch folders and redact new files automatically.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Dropbox",
		icon: DropboxIcon,
		description: "Trigger redaction when files are added or updated.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Microsoft OneDrive",
		icon: OneDriveIcon,
		description: "Redact files stored in OneDrive and SharePoint.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "S3-Compatible Storage",
		icon: MinioIcon,
		description: "Connect AWS S3, MinIO, or any S3-compatible object store.",
		status: "available" as const,
		category: "storage",
	},
	{
		name: "Slack",
		icon: SlackIcon,
		description: "Send redaction results and alerts to Slack channels.",
		status: "available" as const,
		category: "communication",
	},
	{
		name: "Microsoft Teams",
		icon: TeamsIcon,
		description: "Post redaction notifications to Teams channels.",
		status: "available" as const,
		category: "communication",
	},
	{
		name: "Discord",
		icon: DiscordIcon,
		description: "Receive redaction notifications in Discord channels.",
		status: "coming_soon" as const,
		category: "communication",
	},
	{
		name: "Zapier",
		icon: ZapierIcon,
		description: "Connect to 5,000+ apps with no-code workflows.",
		status: "available" as const,
		category: "automation",
	},
	{
		name: "Make",
		icon: MakeIcon,
		description: "Build multi-step automation scenarios visually.",
		status: "available" as const,
		category: "automation",
	},
	{
		name: "n8n",
		icon: N8nIcon,
		description: "Self-hostable workflow automation with full control.",
		status: "available" as const,
		category: "automation",
	},
	{
		name: "Notion",
		icon: NotionIcon,
		description: "Export redaction reports to Notion databases.",
		status: "available" as const,
		category: "productivity",
	},
];
---

<Layout
  title="Integrations"
  description="Connect Nvisy with your favorite tools. Automate redaction workflows with built-in integrations."
  hideFooterBorder
>
  <section class="border-b border-border bg-background">
    <div class="container mx-auto px-5 pt-16 pb-20 md:pt-24 md:pb-28">
      <!-- Minimal page header -->
      <div class="max-w-2xl">
        <h1 class="font-display text-4xl md:text-5xl font-medium tracking-[-0.03em]">
          Integrations
        </h1>
      </div>

      <!-- Grid with category tabs -->
      <div class="mt-12">
        <IntegrationsGrid integrations={integrations} client:load />
      </div>
    </div>
  </section>

  <CTA
    title="Need a different integration?"
    description="We're constantly adding new integrations. Let us know what you need or get started with what's available."
    primaryCta={{ text: "Get Started", href: "https://app.nvisy.com/auth/signup" }}
    secondaryCta={{ text: "Request Integration", href: "mailto:support@nvisy.com?subject=Integration Request" }}
  />
  <Security />
</Layout>

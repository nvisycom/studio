---
import { Layout } from "@/layouts";
import { Hero, CTA } from "@/components";
import {
	Shield,
	Lock,
	Eye,
	Server,
	FileCheck,
	Key,
	Globe,
	Building2,
	CheckCircle,
	Clock,
} from "lucide-vue-next";

const securityFeatures = [
	{
		title: "End-to-End Encryption",
		description:
			"All data is encrypted in transit using TLS 1.3 and at rest using AES-256 encryption.",
		icon: Lock,
	},
	{
		title: "Zero Data Retention",
		description:
			"Documents are processed in memory and never stored. Your data is deleted immediately after processing.",
		icon: Eye,
	},
	{
		title: "Infrastructure Security",
		description:
			"Hosted on enterprise-grade infrastructure with network isolation, firewalls, and intrusion detection.",
		icon: Server,
	},
	{
		title: "Access Controls",
		description:
			"Role-based access control, SSO integration, and audit logging for complete visibility.",
		icon: Key,
	},
	{
		title: "Data Residency",
		description:
			"Choose where your data is processed with regional deployment options in US, EU, and APAC.",
		icon: Globe,
	},
	{
		title: "Self-Hosted Option",
		description:
			"Deploy on your own infrastructure for complete control over your data and security policies.",
		icon: Building2,
	},
];

const compliances = [
	{
		name: "GDPR",
		description: "EU General Data Protection Regulation",
		status: "completed",
	},
	{
		name: "SOC 2 Type II",
		description: "Service Organization Control",
		status: "in-progress",
	},
	{
		name: "HIPAA",
		description: "Health Insurance Portability and Accountability Act",
		status: "in-progress",
	},
	{
		name: "ISO 27001",
		description: "Information Security Management",
		status: "planned",
	},
];

const securityPractices = [
	"Regular penetration testing by third-party security firms",
	"Continuous vulnerability scanning and remediation",
	"Security awareness training for all employees",
	"Incident response plan with 24/7 monitoring",
	"Background checks for all team members",
	"Secure software development lifecycle (SSDLC)",
];
---

<Layout
  title="Security"
  description="Learn about Nvisy's enterprise-grade security measures, compliance certifications, and data protection practices."
  hideFooterBorder
>
  <Hero
    title="Security &"
    titleHighlight="Compliance"
    titleInline={true}
    description="Enterprise-grade security built into every layer. Your data protection is our top priority."
    primaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com/security" }}
    secondaryCta={{ text: "Contact Sales", href: "/contact" }}
  />

  <!-- Security Features -->
  <section class="py-24 md:py-32">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
            Security at every layer
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Multiple layers of protection ensure your sensitive documents remain secure throughout processing.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {securityFeatures.map((feature) => (
            <div class="group relative p-6 rounded-2xl border border-border bg-card/50 backdrop-blur-sm hover:bg-card/80 transition-all duration-300">
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-emerald-500/5 to-teal-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              <div class="relative">
                <div class="inline-flex items-center justify-center w-12 h-12 mb-4 rounded-xl bg-muted">
                  <feature.icon class="w-6 h-6 text-muted-foreground" />
                </div>
                <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
                <p class="text-muted-foreground leading-relaxed">
                  {feature.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance -->
  <section class="py-24 md:py-32 border-t border-border">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
            Compliance & Certifications
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Meeting the highest standards for data protection and regulatory compliance.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {compliances.map((compliance) => (
            <div class="flex items-start gap-4 p-6 rounded-2xl border border-border bg-card/50">
              <div class="flex-shrink-0">
                {compliance.status === "completed" ? (
                  <div class="w-10 h-10 rounded-full bg-emerald-500/10 flex items-center justify-center">
                    <CheckCircle class="w-5 h-5 text-emerald-500" />
                  </div>
                ) : compliance.status === "in-progress" ? (
                  <div class="w-10 h-10 rounded-full bg-amber-500/10 flex items-center justify-center">
                    <Clock class="w-5 h-5 text-amber-500" />
                  </div>
                ) : (
                  <div class="w-10 h-10 rounded-full bg-muted flex items-center justify-center">
                    <FileCheck class="w-5 h-5 text-muted-foreground" />
                  </div>
                )}
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-lg font-semibold">{compliance.name}</h3>
                  {compliance.status === "completed" ? (
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600">
                      Certified
                    </span>
                  ) : compliance.status === "in-progress" ? (
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600">
                      In Progress
                    </span>
                  ) : (
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-muted text-muted-foreground">
                      Planned
                    </span>
                  )}
                </div>
                <p class="text-muted-foreground">{compliance.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Security Practices -->
  <section class="py-24 md:py-32 border-t border-border">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
            Security Practices
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Our commitment to security extends beyond technology to our people and processes.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {securityPractices.map((practice) => (
            <div class="flex items-center gap-3 p-4 rounded-xl border border-border bg-card/50">
              <Shield class="w-5 h-5 text-emerald-500 flex-shrink-0" />
              <span class="text-muted-foreground">{practice}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Questions about security?"
    description="Our security team is available to discuss your specific requirements and answer any questions."
    primaryCta={{ text: "Contact Security Team", href: "mailto:security@nvisy.com" }}
    secondaryCta={{ text: "Security Documentation", href: "https://docs.nvisy.com/security" }}
  />
</Layout>

---
import { Layout } from "@/layouts";
import { CTA } from "@/components";
import {
	Lock,
	Eye,
	Server,
	Key,
	Globe,
	Building2,
	Check,
} from "@lucide/vue";

const securityFeatures = [
	{
		title: "End-to-end encryption",
		description:
			"All data is encrypted in transit using TLS 1.3 and at rest using AES-256.",
		icon: Lock,
	},
	{
		title: "Zero data retention",
		description:
			"Documents are redacted in memory and never stored, then deleted immediately after processing.",
		icon: Eye,
	},
	{
		title: "Infrastructure security",
		description:
			"Enterprise-grade infrastructure with network isolation, firewalls, and intrusion detection.",
		icon: Server,
	},
	{
		title: "Access controls",
		description:
			"Role-based access control, SSO integration, and audit logging for complete visibility.",
		icon: Key,
	},
	{
		title: "Data residency",
		description:
			"Choose where your data is processed with regional options in the US, EU, and APAC.",
		icon: Globe,
	},
	{
		title: "Self-hosted option",
		description:
			"Deploy on your own infrastructure for complete control over your data and policies.",
		icon: Building2,
	},
];

const compliances = [
	{
		name: "GDPR",
		description: "EU General Data Protection Regulation",
		status: "certified",
	},
	{
		name: "SOC 2 Type II",
		description: "Service Organization Control",
		status: "in-progress",
	},
	{
		name: "HIPAA",
		description: "Health Insurance Portability and Accountability Act",
		status: "in-progress",
	},
	{
		name: "CCPA",
		description: "California Consumer Privacy Act",
		status: "certified",
	},
	{
		name: "ISO 27001",
		description: "Information Security Management",
		status: "planned",
	},
];

const statusLabel: Record<string, string> = {
	certified: "Certified",
	"in-progress": "In progress",
	planned: "Planned",
};
---

<Layout
  title="Security"
  description="Learn about Nvisy's enterprise-grade security measures for data redaction, compliance certifications, and data protection practices."
  hideFooterBorder
>
  <!-- Page header -->
  <section class="border-b border-border bg-background">
    <div class="container mx-auto px-5 pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="max-w-2xl">
        <h1 class="font-display text-4xl md:text-5xl font-medium tracking-[-0.03em]">
          Security
        </h1>
        <p class="mt-4 text-base text-foreground/60 leading-relaxed">
          Enterprise-grade security built into every layer, because your data
          protection is our top priority.
        </p>
      </div>

      <!-- Security features (hairline grid) -->
      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-3">
        {
          securityFeatures.map((feature) => (
            <div class="bg-background p-6 transition-colors hover:bg-muted/40 md:p-8">
              <div class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-foreground/80">
                <feature.icon class="h-[18px] w-[18px]" />
              </div>
              <h3 class="mt-5 text-base font-medium tracking-tight">
                {feature.title}
              </h3>
              <p class="mt-2 text-sm text-foreground/55 leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Compliance -->
  <section class="border-b border-border bg-background">
    <div class="container mx-auto px-5 py-20 md:py-28">
      <h2 class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]">
        Compliance &amp; certifications
      </h2>
      <p class="mt-4 max-w-lg text-base text-foreground/60 leading-relaxed">
        Meeting the highest standards for data protection and regulatory
        compliance.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          compliances.map((compliance) => (
            <div class="flex flex-col rounded-xl border border-border bg-card p-6">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-base font-medium tracking-tight">
                  {compliance.name}
                </h3>
                {compliance.status === "certified" ? (
                  <span class="flex items-center gap-1 font-mono text-[11px] uppercase tracking-wider text-foreground/60">
                    <Check class="h-3.5 w-3.5 text-[#2ecc71]" />
                    {statusLabel[compliance.status]}
                  </span>
                ) : (
                  <span class="font-mono text-[11px] uppercase tracking-wider text-foreground/40">
                    {statusLabel[compliance.status]}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm text-foreground/55 leading-relaxed">
                {compliance.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Questions about security?"
    description="Our security team is available to discuss your specific requirements."
    primaryCta={{ text: "Contact security team", href: "mailto:security@nvisy.com" }}
    secondaryCta={{ text: "Security docs", href: "https://docs.nvisy.com/security" }}
  />
</Layout>

---
import { Layout } from "@/layouts";
import { Hero, CTA, Features, Stats, Security } from "@/components";
import Industries from "@/components/sections/Industries.astro";
import CaseStudies from "@/components/sections/CaseStudies.astro";
---

<Layout
  title="Solutions"
  description="Industry-specific document intelligence solutions. From healthcare to financial services, transform your documents into actionable data while ensuring compliance."
>
  <Hero
    title="Solutions by Industry"
    description="Tailored document intelligence solutions that meet your industry's unique data needs, compliance requirements, and operational goals. Transform unstructured documents into actionable insights."
    background="gradient"
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View All Industries",
        href: "#industries",
        variant: "secondary"
      }
    ]}
  />

  <Stats
    stats={[
      { label: "Industries Served", value: "6+" },
      { label: "Compliance Standards", value: "15+" },
      { label: "Enterprise Customers", value: "100+" },
      { label: "Accuracy Rate", value: "99.9%" },
    ]}
    inline={false}
    padding="lg"
  />

  <div id="industries">
    <Industries
      title="Industry-Specific Solutions"
      description="Every industry has unique data challenges and compliance requirements. Our solutions are built to help you extract value from documents while meeting regulatory standards."
    />
  </div>

  <CaseStudies />

  <Features
    title="Built for Regulatory Compliance"
    description="Our industry solutions include everything you need to extract document value while meeting regulatory requirements across different sectors."
    features={[
      {
        title: "HIPAA Compliance",
        description: "Healthcare-specific processing with PHI protection and patient privacy built in.",
        icon: "shield"
      },
      {
        title: "Financial Regulations",
        description: "SOX, PCI DSS, and banking compliance with automated audit trails.",
        icon: "dollar"
      },
      {
        title: "Government Standards",
        description: "FedRAMP, FISMA compliance with air-gap deployment capabilities.",
        icon: "government"
      },
      {
        title: "Data Sovereignty",
        description: "Keep sensitive data within your jurisdiction with on-premises options.",
        icon: "globe"
      },
      {
        title: "Audit & Reporting",
        description: "Comprehensive audit logs and compliance reporting for all industries.",
        icon: "clipboard"
      },
      {
        title: "Custom Integration",
        description: "Seamlessly integrate with your existing industry-specific workflows.",
        icon: "link"
      }
    ]}
  />

  <Security />
  <CTA
    title="Ready to Transform Your Industry's Documents?"
    description="Choose the solution that matches your data needs and compliance requirements. Get started with a personalized demo tailored to your industry."
    buttons={[
      {
        text: "Schedule Industry Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View Pricing",
        href: "/pricing",
        variant: "secondary"
      }
    ]}
    background="gradient"
  />
</Layout>

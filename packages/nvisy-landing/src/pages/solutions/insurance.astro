---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
	Features,
} from "@/components";
---

<Layout
  title="Insurance Solutions"
  description="Document intelligence for insurance companies and carriers. Automate claims processing, extract policy data, and ensure GDPR, CCPA & HIPAA compliance."
>
  <Hero
    title="Insurance Document Intelligence"
    description="Transform insurance documents into structured, actionable data. Built for insurance carriers, brokers, and insurtech companies that need to automate claims processing while meeting regulatory requirements."
    background="gradient"
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
  />

  <SocialProof />
  <Features
    title="Built for Insurance Companies"
    description="Advanced AI technology meets insurance industry standards. Process claims, underwriting documents, and policy applications with speed and accuracy."
    category="insurance"
    featured={true}
  />
  <CaseStudies />
  <UseCases category="insurance" />
  <Testimonials />
  <FAQ category="general" featured={true} />

  <CTA
    title="Ready to Transform Your Insurance Documents?"
    description="Whether you're an insurtech startup or a large carrier, we have solutions tailored for your data extraction and compliance needs."
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View API Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
    background="solid"
  />
  <Security />
</Layout>

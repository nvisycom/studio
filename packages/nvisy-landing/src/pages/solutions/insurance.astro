---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
} from "@/components";
import { Shield, Check, FileText } from "lucide-vue-next";
---

<Layout
  title="Insurance Solutions"
  description="Document intelligence for insurance companies and carriers. Automate claims processing, extract policy data, and ensure GDPR, CCPA & HIPAA compliance."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Insurance Document Intelligence"
      description="Transform insurance documents into structured, actionable data. Built for insurance carriers, brokers, and insurtech companies that need to automate claims processing while meeting regulatory requirements."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Insurance Companies"
      subtitle="Insurance carriers and brokers trust Nvisy to transform their document workflows"
    />

    <!-- Case Studies -->
    <CaseStudies />

    <Security
      title="Enterprise-Grade Document Security"
      description="Built with compliance and security at the core. Our platform meets the rigorous standards required by insurance companies."
    />

    <UseCases
      title="Insurance Use Cases"
      description="Insurance organizations across different lines of business use our platform to protect policyholder information while maintaining operational efficiency and regulatory compliance."
      category="insurance"
    />

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Insurance Companies"
      description="See how insurance carriers and brokers are transforming their document workflows with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Insurance FAQs"
      description="Common questions about document processing for insurance companies"
      category="general"
      featured={true}
    />

    <!-- CTA -->
    <CTA
      title="Ready to Transform Your Insurance Documents?"
      description="Whether you're an insurtech startup or a large carrier, we have solutions tailored for your data extraction and compliance needs. Special pricing available for qualifying insurance organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

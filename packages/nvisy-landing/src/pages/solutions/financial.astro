---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
	Features,
} from "@/components";
---

<Layout
  title="Financial Services"
  description="Document intelligence for financial institutions. Extract data, automate workflows, and ensure GDPR, CCPA & PCI-DSS compliance for customer documents and financial records."
>
  <Hero
    title="Financial Document Intelligence"
    description="Transform financial documents into structured, actionable data. Built for banks, credit unions, fintech companies, and financial institutions that need to extract insights while meeting regulatory requirements."
    background="gradient"
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
  />

  <SocialProof />
  <Features
    title="Built for Financial Services"
    description="Advanced AI technology meets banking-grade security. Process loan applications, KYC documents, and financial records with unprecedented accuracy."
    category="financial"
    featured={true}
  />
  <CaseStudies />
  <UseCases category="financial" />
  <Testimonials />
  <FAQ category="general" featured={true} />

  <Security />
  <CTA
    title="Ready to Transform Your Financial Documents?"
    description="Whether you're a fintech startup or a large financial institution, we have solutions tailored for your data and compliance needs."
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View API Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
    background="gradient"
  />
</Layout>

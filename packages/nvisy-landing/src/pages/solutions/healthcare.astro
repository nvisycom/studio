---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
} from "@/components";
---

<Layout
  title="Healthcare Solutions"
  description="Document intelligence for healthcare organizations. Extract insights from medical records, automate clinical workflows, and ensure HIPAA compliance for patient data."
>
  <div class="bg-white dark:bg-black min-h-screen">

    <!-- Hero Section -->
    <Hero
      title="Healthcare Document Intelligence"
      description="Transform medical documents into structured, actionable data. Built for hospitals, clinics, health systems, and healthcare organizations that need to extract insights while ensuring HIPAA compliance."
      background="gradient"
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
    />

    <!-- Social Proof -->
    <SocialProof
      title="Trusted by Healthcare Organizations"
      subtitle="Hospitals, clinics, and health systems trust Nvisy to transform their document workflows"
    />

    <!-- Case Studies -->
    <CaseStudies />

    <Security
      title="Enterprise-Grade Document Security"
      description="Built with compliance and security at the core. Our platform meets the rigorous standards required by healthcare organizations."
    />

    <!-- Use Cases -->
    <UseCases
      title="Healthcare Use Cases"
      description="Healthcare organizations across different settings use our platform to protect patient information while maintaining care quality and research capabilities."
      category="healthcare"
    />

    <!-- Testimonials -->
    <Testimonials
      title="Trusted by Healthcare Organizations"
      description="See how hospitals, clinics, and health systems are transforming their document workflows with Nvisy"
    />

    <!-- FAQ -->
    <FAQ
      title="Healthcare FAQs"
      description="Common questions about HIPAA-compliant document processing for healthcare"
      category="general"
      featured={true}
    />

    <!-- CTA -->
    <CTA
      title="Ready to Transform Your Healthcare Documents?"
      description="Whether you're a small practice or a large health system, we have solutions tailored for your data extraction and HIPAA compliance needs. Special pricing available for qualifying healthcare organizations."
      buttons={[
        {
          text: "Schedule Demo",
          href: "/contact",
          variant: "primary"
        },
        {
          text: "View API Documentation",
          href: "https://docs.nvisy.com",
          variant: "secondary"
        }
      ]}
      background="solid"
    />
  </div>
</Layout>

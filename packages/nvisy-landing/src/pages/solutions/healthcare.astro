---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	SocialProof,
	Testimonials,
	FAQ,
	Security,
	CaseStudies,
	UseCases,
	Features,
} from "@/components";
---

<Layout
  title="Healthcare Solutions"
  description="Document intelligence for healthcare organizations. Extract insights from medical records, automate clinical workflows, and ensure HIPAA compliance for patient data."
>
  <Hero
    title="Healthcare Document Intelligence"
    description="Transform medical documents into structured, actionable data. Built for hospitals, clinics, health systems, and healthcare organizations that need to extract insights while ensuring HIPAA compliance."
    background="gradient"
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
  />

  <SocialProof />
  <Features
    title="Built for Healthcare Organizations"
    description="Advanced AI technology meets HIPAA requirements. Process clinical documents, patient records, and medical forms with healthcare-grade security and accuracy."
    category="healthcare"
    featured={true}
  />
  <CaseStudies />
  <UseCases category="healthcare" />
  <Testimonials />
  <FAQ category="general" featured={true} />

  <CTA
    title="Ready to Transform Your Healthcare Documents?"
    description="Whether you're a small practice or a large health system, we have solutions tailored for your data extraction and HIPAA compliance needs."
    buttons={[
      {
        text: "Schedule Demo",
        href: "/contact",
        variant: "primary"
      },
      {
        text: "View API Documentation",
        href: "https://docs.nvisy.com",
        variant: "secondary"
      }
    ]}
    background="solid"
  />
  <Security />
</Layout>

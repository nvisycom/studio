---
import { Layout } from "@/layouts";
import { Hero } from "@/components";
import { calculateReadingTime } from "@nvisy/shared";
import { getCollection } from "astro:content";
import {
	File,
	Zap,
	Code,
	Palette,
	Building,
	FileText,
	Shield,
} from "lucide-vue-next";

// Get all blog entries and sort by publishedAt (newest first)
const blogEntries = (await getCollection("blog-posts"))
	.map((entry) => ({
		...entry,
		readingTime: calculateReadingTime(entry.body || ""),
	}))
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Get unique categories for filtering
const categories = [
	"All",
	...new Set(blogEntries.map((entry) => entry.data.category).filter(Boolean)),
] as string[];

// Helper function to slugify category names
const slugifyCategory = (category: string) =>
	category.toLowerCase().replace(/\s+/g, "-");

const categoryIcons: Record<string, typeof Zap> = {
	Engineering: Zap,
	Development: Code,
	Design: Palette,
	Architecture: Building,
	Compliance: Shield,
	"Case Study": FileText,
};
---

<Layout title="Blog" description="Insights, stories, and updates from our team" hideFooterBorder>
  <Hero
    title="Stories &"
    titleHighlight="Insights"
    titleInline={true}
    description="Discover the latest from our team. Engineering insights, product updates, and thought leadership."
    secondaryCta={{ text: "View Changelog", href: "/changelog" }}
    compact
  />

  <!-- Main Content -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Category Filter -->
        {categories.length > 1 && (
          <div class="flex justify-center mb-12" id="category-filter">
            <div class="inline-flex p-1 rounded-xl bg-muted/50 backdrop-blur-sm border border-border">
              {categories.map(category => (
                <button
                  type="button"
                  data-category={slugifyCategory(category)}
                  class="category-btn px-4 py-2 text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground"
                >
                  {category}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Posts Grid -->
        {blogEntries.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="posts-grid">
            {blogEntries.map((post, index) => {
              const IconComponent = categoryIcons[post.data.category || ''] || File;
              return (
                <article
                  class="blog-post group"
                  data-category={slugifyCategory(post.data.category || '')}
                >
                  <a href={`/blog/${post.id}`} class="block h-full">
                    <div class="relative h-full p-6 rounded-2xl border border-border bg-card/50 backdrop-blur-sm hover:bg-card/80 transition-all duration-300 flex flex-col min-h-[320px]">
                      <!-- Subtle gradient on hover -->
                      <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                      <div class="relative flex-1 flex flex-col">
                        <!-- Header with icon and badges -->
                        <div class="flex items-start justify-between mb-4">
                          <div class="w-10 h-10 rounded-xl bg-muted flex items-center justify-center">
                            <IconComponent class="w-5 h-5 text-muted-foreground" />
                          </div>
                          <div class="flex items-center gap-2">
                            {index === 0 && (
                              <span class="latest-badge text-xs font-medium text-background bg-foreground px-2 py-1 rounded-md">
                                Latest
                              </span>
                            )}
                            {post.data.category && (
                              <span class="text-xs font-medium text-muted-foreground bg-muted px-2 py-1 rounded-md">
                                {post.data.category}
                              </span>
                            )}
                          </div>
                        </div>

                        <!-- Title -->
                        <h3 class="text-base font-medium mb-2 line-clamp-2 group-hover:text-foreground/80 transition-colors">
                          {post.data.title}
                        </h3>

                        <!-- Excerpt -->
                        <p class="text-sm text-muted-foreground mb-4 leading-relaxed flex-grow line-clamp-3">
                          {post.data.excerpt || post.data.description}
                        </p>

                        <!-- Footer -->
                        <div class="flex items-center justify-between pt-4 border-t border-border mt-auto">
                          <div class="flex items-center gap-2">
                            <div class="w-6 h-6 bg-muted rounded-full flex items-center justify-center">
                              <span class="text-xs font-medium text-muted-foreground">
                                {post.data.author.split(' ').map((n: string) => n[0]).join('').toUpperCase()}
                              </span>
                            </div>
                            <span class="text-sm text-muted-foreground">{post.data.author}</span>
                          </div>
                          <div class="text-xs text-muted-foreground">
                            {post.readingTime} min read
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-20">
            <div class="w-16 h-16 bg-muted rounded-2xl flex items-center justify-center mx-auto mb-4">
              <File class="w-8 h-8 text-muted-foreground" />
            </div>
            <h3 class="text-lg font-medium mb-2">No blog posts found</h3>
            <p class="text-muted-foreground">Blog posts will appear here once they are published.</p>
          </div>
        )}

        <!-- No results message (hidden by default) -->
        <div id="no-results" class="text-center py-20 hidden">
          <div class="w-16 h-16 bg-muted rounded-2xl flex items-center justify-center mx-auto mb-4">
            <File class="w-8 h-8 text-muted-foreground" />
          </div>
          <h3 class="text-lg font-medium mb-2">No posts in this category</h3>
          <p class="text-muted-foreground">Try selecting a different category.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initCategoryFilter() {
    const buttons = document.querySelectorAll('.category-btn');
    const posts = document.querySelectorAll('.blog-post');
    const noResults = document.getElementById('no-results');
    const postsGrid = document.getElementById('posts-grid');

    function updateFilter(category: string) {
      // Update button styles
      buttons.forEach(btn => {
        const btnCategory = btn.getAttribute('data-category');
        if (btnCategory === category) {
          btn.classList.remove('text-muted-foreground');
          btn.classList.add('bg-background', 'text-foreground', 'shadow-sm');
        } else {
          btn.classList.add('text-muted-foreground');
          btn.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
        }
      });

      // Filter posts
      let visibleCount = 0;
      posts.forEach((post, index) => {
        const postCategory = post.getAttribute('data-category');
        const shouldShow = category === 'all' || postCategory === category;

        if (shouldShow) {
          (post as HTMLElement).style.display = '';
          visibleCount++;

          // Update latest badge visibility
          const latestBadge = post.querySelector('.latest-badge');
          if (latestBadge) {
            (latestBadge as HTMLElement).style.display = (category === 'all' && index === 0) ? '' : 'none';
          }
        } else {
          (post as HTMLElement).style.display = 'none';
        }
      });

      // Show/hide no results message
      if (noResults && postsGrid) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          postsGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          postsGrid.classList.remove('hidden');
        }
      }
    }

    // Add click handlers
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category') || 'all';
        updateFilter(category);
      });
    });

    // Initialize with 'all' selected
    updateFilter('all');
  }

  // Run on page load and after Astro navigation
  document.addEventListener('astro:page-load', initCategoryFilter);
  initCategoryFilter();
</script>

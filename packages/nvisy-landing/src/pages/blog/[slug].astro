---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import {
	ChevronLeft,
	ChevronRight,
	Zap,
	Code,
	Palette,
	Building,
	FileText,
	Shield,
	File,
} from "@lucide/vue";
import { calculateReadingTime } from "@nvisy/shared";

import BlueskyIcon from "@/assets/icons/bluesky.svg";
import LinkedinIcon from "@/assets/icons/linkedin.svg";

export async function getStaticPaths() {
	try {
		const blogEntries = await getCollection("blog-posts");
		return blogEntries.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
	} catch (error: unknown) {
		console.error("Error fetching blog collection:", error);
		return [];
	}
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const readingTime = calculateReadingTime(entry.body || "");

const allPosts = (await getCollection("blog-posts")).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const currentIndex = allPosts.findIndex((post) => post.id === entry.id);
const previousPost =
	currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const relatedPosts = allPosts
	.filter((post) => post.id !== entry.id)
	.slice(0, 3);

const categoryIcons: Record<string, typeof Zap> = {
	Engineering: Zap,
	Development: Code,
	Design: Palette,
	Architecture: Building,
	Compliance: Shield,
	"Case Study": FileText,
};
---

<Layout title={entry.data.title} description={entry.data.description}>
  <!-- Article Header -->
  <section class="relative pt-18 md:pt-24 pb-12 overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-gradient-radial" />
    <div class="absolute inset-0 bg-[linear-gradient(to_right,oklch(0.5_0_0/0.03)_1px,transparent_1px),linear-gradient(to_bottom,oklch(0.5_0_0/0.03)_1px,transparent_1px)] bg-[size:64px_64px]" />

    <div class="container relative z-10 mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <!-- Back link -->
        <a href="/blog" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
          <ChevronLeft class="w-4 h-4" />
          Back to blog
        </a>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          {entry.data.category && (
            <span class="text-xs font-medium bg-foreground text-background px-2.5 py-1 rounded-md">
              {entry.data.category}
            </span>
          )}
          <div class="flex items-center gap-3 text-sm text-muted-foreground">
            <time>
              {new Date(entry.data.publishedAt).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span>·</span>
            <span>{readingTime} min read</span>
          </div>
        </div>

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-6">
          {entry.data.title}
        </h1>

        <!-- Description -->
        {entry.data.excerpt && (
          <p class="text-lg md:text-xl text-muted-foreground leading-relaxed mb-8 max-w-3xl">
            {entry.data.excerpt}
          </p>
        )}

        <!-- Author & Share -->
        <div class="flex items-center justify-between border-t border-border pt-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-muted rounded-full flex items-center justify-center">
              <span class="text-sm font-medium text-muted-foreground">
                {entry.data.author.split(' ').map((n: string) => n[0]).join('').toUpperCase()}
              </span>
            </div>
            <div>
              <div class="text-sm font-medium">{entry.data.author}</div>
              <div class="text-xs text-muted-foreground">Author</div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-sm text-muted-foreground mr-1">Share</span>
            <a
              href={`https://bsky.app/intent/compose?text=${encodeURIComponent(entry.data.title + ' ' + Astro.url)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 bg-muted hover:bg-accent rounded-lg flex items-center justify-center transition-colors"
              aria-label="Share on Bluesky"
            >
              <BlueskyIcon class="w-4 h-4" />
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${Astro.url}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 bg-muted hover:bg-accent rounded-lg flex items-center justify-center transition-colors"
              aria-label="Share on LinkedIn"
            >
              <LinkedinIcon class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-2">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <article class="mb-16">
          <div class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-p:text-muted-foreground prose-p:leading-relaxed prose-a:text-foreground prose-a:underline prose-strong:text-foreground prose-code:text-foreground prose-code:bg-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-card prose-pre:border prose-pre:border-border">
            <Content />
          </div>
        </article>

        <!-- Tags -->
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="mb-12">
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag: string) => (
                <span class="text-sm text-muted-foreground bg-muted px-3 py-1.5 rounded-lg">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Article Navigation -->
        {(previousPost || nextPost) && (
          <nav class="border-t border-border pt-12 mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {previousPost && (
                <a href={`/blog/${previousPost.id}`} class="group p-4 rounded-xl border border-border hover:bg-card/50 transition-colors">
                  <div class="text-xs text-muted-foreground mb-2 flex items-center gap-1">
                    <ChevronLeft class="w-3 h-3" />
                    Previous
                  </div>
                  <span class="text-sm font-medium group-hover:text-foreground/80 transition-colors line-clamp-2">
                    {previousPost.data.title}
                  </span>
                </a>
              )}
              {nextPost && (
                <a href={`/blog/${nextPost.id}`} class="group p-4 rounded-xl border border-border hover:bg-card/50 transition-colors md:text-right md:col-start-2">
                  <div class="text-xs text-muted-foreground mb-2 flex items-center gap-1 md:justify-end">
                    Next
                    <ChevronRight class="w-3 h-3" />
                  </div>
                  <span class="text-sm font-medium group-hover:text-foreground/80 transition-colors line-clamp-2">
                    {nextPost.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )}

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <div class="border-t border-border pt-12">
            <h2 class="text-xl font-semibold tracking-tight mb-8">Related articles</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {relatedPosts.map(post => {
                const IconComponent = categoryIcons[post.data.category || ''] || File;
                return (
                  <article class="group">
                    <a href={`/blog/${post.id}`} class="block">
                      <div class="relative p-5 rounded-2xl border border-border bg-card/50 hover:bg-card/80 transition-all duration-300">
                        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                        <div class="relative">
                          <div class="w-8 h-8 rounded-lg bg-muted flex items-center justify-center mb-3">
                            <IconComponent class="w-4 h-4 text-muted-foreground" />
                          </div>
                          <div class="text-xs text-muted-foreground mb-2">
                            {new Date(post.data.publishedAt).toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric'
                            })}
                          </div>
                          <h3 class="text-sm font-medium mb-2 line-clamp-2 group-hover:text-foreground/80 transition-colors">
                            {post.data.title}
                          </h3>
                          <p class="text-xs text-muted-foreground line-clamp-2">
                            {post.data.excerpt || post.data.description}
                          </p>
                        </div>
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="pb-16"></div>
</Layout>

---
import { Layout } from "@/layouts";
import { CTA, Security } from "@/components";
import { Shield, Building2, Zap, Target } from "@lucide/vue";
import TeamMember from "@/components/features/about/TeamMember.vue";
import Blogposts from "@/components/sections/Blogposts.astro";

const teamMembers = [
	{ name: "Alex Rivera", title: "CEO & Co-Founder" },
	{ name: "Jordan Martinez", title: "CTO & Co-Founder" },
	{ name: "Sam Chen", title: "VP of Engineering" },
];

const values = [
	{
		title: "Security first",
		description:
			"Every decision prioritizes the security and privacy of customer data above all else.",
		icon: Shield,
	},
	{
		title: "Enterprise focus",
		description:
			"Built for the scale, reliability, and compliance requirements of enterprise organizations.",
		icon: Building2,
	},
	{
		title: "Continuous innovation",
		description:
			"Constantly advancing our AI to stay ahead of emerging threats and use cases.",
		icon: Zap,
	},
	{
		title: "Customer success",
		description:
			"Our success is measured by the tangible business value we deliver to customers.",
		icon: Target,
	},
];
---

<Layout
  title="About Us"
  description="Learn about Nvisy's mission to protect sensitive data with automated, AI-powered redaction for enterprise organizations."
  hideFooterBorder
>
  <!-- Mission -->
  <section class="border-b border-border bg-background">
    <div class="container mx-auto px-5 pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="max-w-3xl">
        <h1
          class="font-display text-4xl md:text-5xl font-medium tracking-[-0.03em] leading-[1.05] text-balance"
        >
          Protecting sensitive data, by default.
        </h1>
        <p class="mt-6 max-w-xl text-lg font-light text-foreground/55 leading-relaxed">
          We build automated, AI-powered redaction that helps enterprise teams
          meet privacy compliance and safeguard PII, PHI, and financial data at
          scale.
        </p>
      </div>

      <!-- Challenge / Solution -->
      <div class="mt-14 grid grid-cols-1 gap-3 md:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-7">
          <h2 class="text-base font-medium tracking-tight">The challenge</h2>
          <p class="mt-3 text-sm text-foreground/55 leading-relaxed">
            Enterprises handle massive volumes of sensitive data across
            documents, images, and audio. Manual redaction is slow, error-prone,
            and doesn't scale, while GDPR, HIPAA, and CCPA demand ever more
            rigorous protection.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-card p-7">
          <h2 class="text-base font-medium tracking-tight">Our solution</h2>
          <p class="mt-3 text-sm text-foreground/55 leading-relaxed">
            An AI-powered multimodal redaction platform that detects and removes
            sensitive data with enterprise-grade accuracy, integrating into
            existing workflows with the transparency, auditability, and control
            enterprises require.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="border-b border-border bg-background">
    <div class="container mx-auto px-5 py-20 md:py-28">
      <h2 class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]">
        Our values
      </h2>
      <p class="mt-4 max-w-lg text-base text-foreground/60 leading-relaxed">
        Principles that guide every decision we make, from product to customer
        relationships.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((value) => (
            <div class="rounded-xl border border-border bg-card p-6">
              <div class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-foreground/80">
                <value.icon class="h-[18px] w-[18px]" />
              </div>
              <h3 class="mt-5 text-base font-medium tracking-tight">
                {value.title}
              </h3>
              <p class="mt-2 text-sm text-foreground/55 leading-relaxed">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="border-b border-border bg-background">
    <div class="container mx-auto px-5 py-20 md:py-28">
      <h2 class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]">
        Meet the team
      </h2>
      <p class="mt-4 max-w-lg text-base text-foreground/60 leading-relaxed">
        Driven by expertise in AI, enterprise software, and regulatory
        compliance.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {teamMembers.map((member) => <TeamMember client:load {...member} />)}
      </div>
    </div>
  </section>

  <!-- From the blog -->
  <Blogposts title="From the blog" />

  <!-- Careers CTA -->
  <CTA
    title="Join our team"
    description="Help us build the future of enterprise data privacy."
    primaryCta={{ text: "View open positions", href: "https://www.linkedin.com/company/nvisy/jobs/" }}
  />

  <Security />
</Layout>

---
import { Layout } from "@/layouts";
import { Security } from "@/components";
import { Mail, MessageSquare, Building2, Clock } from "lucide-vue-next";

const contactOptions = [
	{
		title: "Sales",
		description:
			"Talk to our sales team about your redaction needs and custom deployments.",
		email: "sales@nvisy.com",
		icon: Building2,
	},
	{
		title: "Support",
		description:
			"Get help with technical issues or questions about your account.",
		email: "support@nvisy.com",
		icon: MessageSquare,
	},
	{
		title: "General Inquiries",
		description: "For partnerships, press, or other general questions.",
		email: "hello@nvisy.com",
		icon: Mail,
	},
];
---

<Layout
  title="Contact Us"
  description="Get in touch with the Nvisy team. We're here to help with sales, support, and general inquiries."
  hideFooterBorder
>
  <section class="relative py-24 md:py-32 overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-gradient-radial" />
    <div class="absolute inset-0 bg-[linear-gradient(to_right,oklch(0.5_0_0/0.03)_1px,transparent_1px),linear-gradient(to_bottom,oklch(0.5_0_0/0.03)_1px,transparent_1px)] bg-[size:64px_64px]" />

    <div class="container relative z-10 mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight mb-6">
            Get in Touch
          </h1>
          <p class="text-lg md:text-xl text-muted-foreground leading-relaxed max-w-2xl mx-auto">
            Have questions about Nvisy? We'd love to hear from you. Reach out and our team will get back to you promptly.
          </p>
        </div>

        <!-- Contact Options -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
          {contactOptions.map((option) => (
            <a
              href={`mailto:${option.email}`}
              class="group relative p-6 rounded-2xl border border-border bg-card/50 backdrop-blur-sm hover:bg-card/80 hover:border-foreground/20 transition-all duration-300 text-center"
            >
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              <div class="relative">
                <div class="inline-flex items-center justify-center w-12 h-12 mb-4 rounded-xl bg-muted group-hover:bg-foreground/10 transition-colors">
                  <option.icon class="w-6 h-6 text-muted-foreground" />
                </div>
                <h3 class="text-lg font-semibold mb-2">{option.title}</h3>
                <p class="text-sm text-muted-foreground mb-4">{option.description}</p>
                <span class="text-sm font-medium text-foreground group-hover:underline">
                  {option.email}
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- Response Time -->
        <div class="flex items-center justify-center gap-3 text-muted-foreground">
          <Clock class="w-5 h-5" />
          <span class="text-sm">We typically respond within 24 hours</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Office / Additional Info -->
  <section class="py-24 md:py-32 border-t border-border">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Enterprise -->
          <div class="p-8 rounded-2xl border border-border bg-card/50">
            <h2 class="text-xl font-semibold mb-4">Enterprise Solutions</h2>
            <p class="text-muted-foreground mb-6">
              Looking for custom deployment options, dedicated support, or volume pricing? Our enterprise team can help design a solution that fits your needs.
            </p>
            <a
              href="mailto:sales@nvisy.com"
              class="inline-flex items-center justify-center gap-2 bg-foreground text-background font-medium py-3 px-6 rounded-xl hover:opacity-90 transition-opacity"
            >
              Contact Enterprise Sales
            </a>
          </div>

          <!-- Security -->
          <div class="p-8 rounded-2xl border border-border bg-card/50">
            <h2 class="text-xl font-semibold mb-4">Security Concerns</h2>
            <p class="text-muted-foreground mb-6">
              To report a security vulnerability or discuss security requirements for your organization, please contact our security team directly.
            </p>
            <a
              href="mailto:security@nvisy.com"
              class="inline-flex items-center justify-center gap-2 border border-border text-foreground font-medium py-3 px-6 rounded-xl hover:bg-accent transition-colors"
            >
              Contact Security Team
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Security />
</Layout>

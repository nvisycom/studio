---
import { Layout } from "@/layouts";
import { Hero, Press, Inquery } from "@/components";
---
<Layout
  title="Contact"
  description="Get in touch with Nvisy. Contact our team for sales inquiries, support, or general questions about our document processing platform."
>
  <!-- Hero Section -->
    <Hero
      title="Get in Touch"
      description="Ready to protect your sensitive documents? Have questions about our platform? We'll respond within 24 hours."
      background="gradient"
      buttons={[]}
    />

    <!-- Contact Content -->
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <!-- Two Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Left Column - Contact Form -->
          <div>
            <Inquery client:load />
          </div>

          <!-- Right Column - Brand Carousel -->
          <div class="lg:pt-12">
            <div class="flex flex-col h-full min-h-[600px]">
              <!-- Text Content -->
              <div>
                <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-4">
                  Whether you're looking to secure sensitive documents, need technical support, or want to learn more about our enterprise solutions, our team is ready to assist you.
                </p>
              </div>

              <!-- Brand Carousel -->
              <div class="flex items-center my-8">
                <Press
                  title="Trusted by Industry Leaders"
                  subtitle="Companies worldwide rely on our platform"
                />
              </div>

              <!-- Additional Info at Bottom -->
              <div class="mt-8 text-center">
                <p class="text-neutral-600 dark:text-neutral-400">
                  Need immediate assistance?{" "}
                  <a href="/docs" class="text-neutral-900 dark:text-white font-medium hover:underline">
                    Check out our documentation
                  </a>{" "}
                  or{" "}
                  <a href="mailto:hello@nvisy.com" class="text-neutral-900 dark:text-white font-medium hover:underline">
                    reach out via email directly.
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
</Layout>

---
import { Layout } from "@/layouts";
import {
	CTA,
	Testimonials,
	CaseStudies,
	Industries,
	Security,
} from "@/components";
---

<Layout
  title="Customers"
  description="See how organizations across industries use Nvisy to protect sensitive data and meet privacy compliance requirements."
  hideFooterBorder
>
  <Industries
    title="Customers"
    description="From financial services to healthcare, Nvisy helps organizations redact PII and PHI across documents, images, and audio."
  />
  <CaseStudies />
  <Testimonials />

  <CTA
    title="Ready to protect your data?"
    description="Start redacting sensitive data in minutes. No credit card required."
    primaryCta={{ text: "Get started", href: "https://app.nvisy.com/auth/signup" }}
    secondaryCta={{ text: "View documentation", href: "https://docs.nvisy.com" }}
  />

  <Security />
</Layout>

---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	Testimonials,
	CaseStudies,
	Industries,
	Security,
} from "@/components";
---

<Layout
  title="Customers"
  description="See how organizations across industries use Nvisy to transform their document workflows."
  hideFooterBorder
>
  <Hero
    title="Trusted by"
    titleHighlight="industry leaders"
    description="Organizations worldwide rely on Nvisy to extract insights from documents, automate workflows, and meet compliance requirements."
    primaryCta={{ text: "Get Started", href: "/pricing" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <Industries />
  <CaseStudies />
  <Testimonials />

  <CTA
    title="Ready to transform your workflows?"
    description="Join leading organizations that trust Nvisy for their document processing needs."
    primaryCta={{ text: "Get Started", href: "/pricing" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <Security />
</Layout>

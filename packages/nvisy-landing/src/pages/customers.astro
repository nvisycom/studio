---
import { Layout } from "@/layouts";
import {
	Hero,
	CTA,
	Testimonials,
	CaseStudies,
	Industries,
	SocialProof,
	Security,
} from "@/components";
---

<Layout
  title="Customers"
  description="See how organizations across industries use Nvisy to protect sensitive data and meet privacy compliance requirements."
  hideFooterBorder
>
  <Hero
    title="Trusted by"
    titleHighlight="industry leaders"
    description="Organizations worldwide rely on Nvisy to redact sensitive data, protect PII and PHI, and meet privacy compliance requirements."
    primaryCta={{ text: "Get Started", href: "/pricing" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <SocialProof
    title="Trusted by industry leaders"
    subtitle="Join hundreds of companies protecting their sensitive data"
    variant="grid"
    disableLink
  />

  <Industries />
  <CaseStudies />
  <Testimonials />

  <CTA
    title="Ready to protect your data?"
    description="Join leading organizations that trust Nvisy for their data redaction and privacy compliance needs."
    primaryCta={{ text: "Get Started", href: "/pricing" }}
    secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
  />

  <Security />
</Layout>

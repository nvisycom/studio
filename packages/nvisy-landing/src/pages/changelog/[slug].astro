---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ChevronLeft, ChevronRight } from "lucide-vue-next";

export async function getStaticPaths() {
	try {
		const changelogEntries = await getCollection("changelog");
		return changelogEntries.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
	} catch (error: unknown) {
		console.error("Error fetching changelog collection:", error);
		return [];
	}
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEntries = (await getCollection("changelog")).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const previousEntry =
	currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
const nextEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;

const formatDate = (date: Date) => {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
};
---

<Layout title={entry.data.title} description={entry.data.description}>
	<!-- Header -->
	<section class="relative pt-24 md:pt-32 pb-6 overflow-hidden">
		<!-- Background effects -->
		<div class="absolute inset-0 bg-gradient-radial" />
		<div class="absolute inset-0 bg-[linear-gradient(to_right,oklch(0.5_0_0/0.03)_1px,transparent_1px),linear-gradient(to_bottom,oklch(0.5_0_0/0.03)_1px,transparent_1px)] bg-[size:64px_64px]" />

		<div class="container relative z-10 mx-auto px-4">
			<div class="max-w-3xl mx-auto">
				<!-- Back link -->
				<a href="/changelog" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
					<ChevronLeft class="w-4 h-4" />
					Back to changelog
				</a>

				<!-- Meta -->
				<div class="flex flex-wrap items-center gap-3 mb-4">
					<time class="text-sm text-muted-foreground">
						{formatDate(entry.data.publishedAt)}
					</time>
					{entry.data.version && (
						<span class="text-xs font-mono text-muted-foreground bg-muted px-2 py-0.5 rounded">
							v{entry.data.version}
						</span>
					)}
				</div>

				<!-- Title -->
				<h1 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">
					{entry.data.title}
				</h1>

				<!-- Description -->
				<p class="text-lg text-muted-foreground leading-relaxed">
					{entry.data.description}
				</p>
			</div>
		</div>
	</section>

	<!-- Divider -->
	<div class="container mx-auto px-4">
		<div class="max-w-3xl mx-auto border-t border-border" />
	</div>

	<!-- Content -->
	<section class="py-8">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto">
				<article class="mb-16">
					<div class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-p:text-muted-foreground prose-p:leading-relaxed prose-a:text-foreground prose-a:underline prose-strong:text-foreground prose-li:text-muted-foreground prose-code:text-foreground prose-code:bg-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-card prose-pre:border prose-pre:border-border">
						<Content />
					</div>
				</article>

				<!-- Navigation -->
				{(previousEntry || nextEntry) && (
					<nav class="border-t border-border pt-12">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{previousEntry && (
								<a href={`/changelog/${previousEntry.id}`} class="group p-4 rounded-xl border border-border hover:bg-card/50 transition-colors">
									<div class="text-xs text-muted-foreground mb-2 flex items-center gap-1">
										<ChevronLeft class="w-3 h-3" />
										Older
									</div>
									<span class="text-sm font-medium group-hover:text-foreground/80 transition-colors line-clamp-2">
										{previousEntry.data.title}
									</span>
								</a>
							)}
							{nextEntry && (
								<a href={`/changelog/${nextEntry.id}`} class="group p-4 rounded-xl border border-border hover:bg-card/50 transition-colors md:text-right md:col-start-2">
									<div class="text-xs text-muted-foreground mb-2 flex items-center gap-1 md:justify-end">
										Newer
										<ChevronRight class="w-3 h-3" />
									</div>
									<span class="text-sm font-medium group-hover:text-foreground/80 transition-colors line-clamp-2">
										{nextEntry.data.title}
									</span>
								</a>
							)}
						</div>
					</nav>
				)}
			</div>
		</div>
	</section>

	<div class="pb-16"></div>
</Layout>

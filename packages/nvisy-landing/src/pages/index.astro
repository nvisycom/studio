---
import Layout from "@/layouts/Layout.astro";
import {
	Hero,
	Review,
	Features,
	Testimonials,
	CTA,
	SocialProof,
	FAQ,
} from "@/components";
import Connect from "@/components/sections/Connect.astro";
import Industries from "@/components/sections/Industries.astro";
import Blogposts from "@/components/sections/Blogposts.astro";

// SEO and metadata
const pageTitle = "Home";
const pageDescription =
	"Transform documents into structured, actionable data with AI. Extract insights, ensure compliance, and automate document workflows at scale.";
const pageKeywords =
	"document processing, AI data extraction, document intelligence, data automation, compliance, document workflow";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
>
	<main class="overflow-hidden">
		<!-- Hero Section - Immediate Impact -->
		<Hero
			title="Turn Documents Into Useful Data"
			description="Extract, structure, and transform information from any document with AI-powered precision. From data extraction to compliance-ready processing, automate your document workflows at scale."
			buttons={[
				{
					text: "Try for Free",
					href: "/pricing",
					variant: "primary"
				},
				{
					text: "Request a Demo",
					href: "/contact",
					variant: "secondary"
				}
			]}
		/>

		<!-- Social Proof - Clients -->
		<SocialProof
			title="Trusted by Industry Leaders"
			subtitle="Join hundreds of companies transforming their document workflows"
		/>

		<!-- Review Section - How It Works with Screenshots -->
		<Review
			description="Four simple steps from upload to structured, actionable data. See our intuitive dashboard in action."
		/>

		<!-- Features Section - Core Value Props -->
		<Features
			category="general"
			featured={true}
			title="Enterprise-Grade Document Intelligence"
			description="Everything you need to extract value from documents at scale. Advanced AI meets strict compliance requirements."
		/>

		<!-- Industries Section - Real-World Applications -->
		<Industries
			title="Built for Every Industry"
			description="From legal firms to healthcare providers, organizations worldwide rely on Nvisy to unlock value from their documents while ensuring compliance."
		/>

		<!-- Testimonials Section -->
		<Testimonials
			title="Loved by Teams Worldwide"
			description="Join hundreds of companies that trust Nvisy to transform their document workflows."
		/>

		<!-- Connect Section - Integrations & Webhooks -->
		<Connect
			title="Connect Your Workflow"
			description="Seamlessly integrate Nvisy into your existing infrastructure with powerful APIs and webhooks."
		/>

		<!-- Latest Blog Posts Section -->
		<Blogposts
			title="Latest from Our Blog"
			description="Stay updated with insights, tutorials, and product announcements from our team"
		/>

		<!-- FAQ Section - Answer Objections -->
		<FAQ
			title="Common Questions"
			description="Everything you need to know about transforming your documents with Nvisy"
			category="general"
			featured={true}
		/>

		<!-- Final CTA - Strong Close -->
		<CTA
			title="Ready to Unlock Your Document Data?"
			description="Join 500+ companies already using Nvisy. Start with 100 free pages, no credit card required."
			background="gradient"
			buttons={[
				{
					text: "Start Free Trial",
					href: "/pricing",
					variant: "primary"
				},
				{
					text: "Talk to Sales",
					href: "/contact",
					variant: "secondary"
				}
			]}
		/>
	</main>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import HomeHero from "@/components/sections/HomeHero.astro";
import Capabilities from "@/components/sections/Capabilities.astro";
import Changelog from "@/components/sections/Changelog.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import SocialProof from "@/components/sections/SocialProof.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import Security from "@/components/sections/Security.astro";
import CTA from "@/components/sections/CTA.astro";
import Integrations from "@/components/sections/Integrations.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";

const pageTitle = "Home";
const pageDescription =
	"Automatically detect and redact sensitive data across documents, images, and audio. Enterprise-grade PII/PHI protection.";
const pageKeywords =
	"data redaction, PII redaction, PHI redaction, privacy compliance, GDPR, HIPAA, CCPA";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
	hideFooterBorder
>
	<main>
		<HomeHero
			title="Redaction infrastructure"
			titleHighlight="for sensitive data"
			description="Built for teams that can't afford to leak a single field."
		/>

		<SocialProof title="Trusted by teams handling sensitive data" />

		<Capabilities />

		<HowItWorks
			title="How it works"
			description="From upload to redacted output in four simple steps."
		/>

		<Testimonials
			title="What our customers say"
			description="See how teams are automating their data redaction workflows."
			limit={6}
		/>

		<SectionDivider variant="gradient" class="my-8" />

		<Integrations
			title="Integrates with your stack"
			description="Connect Nvisy with the tools you already use."
		/>

		<Changelog />

		<CTA
			title="Ready to protect your data?"
			description="Start with free credits. No credit card required."
			primaryCta={{ text: "Open App", href: "https://app.nvisy.com" }}
			secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
		/>

		<Security />
	</main>
</Layout>

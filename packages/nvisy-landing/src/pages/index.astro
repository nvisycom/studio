---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Stats from "@/components/sections/Stats.astro";
import Features from "@/components/sections/Features.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import SocialProof from "@/components/sections/SocialProof.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import Security from "@/components/sections/Security.astro";
import CTA from "@/components/sections/CTA.astro";
import Integrations from "@/components/sections/Integrations.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";
import { getCollection } from "astro:content";

// Get latest changelog entry
const changelogEntries = (await getCollection("changelog")).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const latestChangelog = changelogEntries[0];

const pageTitle = "Home";
const pageDescription =
	"Automatically detect and redact sensitive data across documents, images, and audio. Enterprise-grade PII/PHI protection.";
const pageKeywords =
	"data redaction, PII redaction, PHI redaction, privacy compliance, GDPR, HIPAA, CCPA";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
	hideFooterBorder
>
	<main>
		<Hero
			badge="Now in public beta"
			title="Automated data"
			titleHighlight="redaction"
			description="Detect and remove sensitive data from documents, images, and audio. AI-powered PII and PHI redaction for privacy compliance."
			primaryCta={{ text: "Start Free", href: "https://app.nvisy.com/auth/signup" }}
			secondaryCta={latestChangelog ? { text: `New: ${latestChangelog.data.title}`, href: `/changelog/${latestChangelog.slug}` } : undefined}
		/>

		<SocialProof
			title="Trusted by industry leaders"
			subtitle="Join hundreds of companies protecting their sensitive data"
			variant="grid"
		/>

		<Stats />

		<Features
			title="Built for compliance"
			description="Everything you need to protect sensitive data at enterprise scale."
		/>

		<HowItWorks
			title="How it works"
			description="From upload to redacted output in four simple steps."
		/>

		<Testimonials
			title="What our customers say"
			description="See how teams are automating their data redaction workflows."
			limit={6}
		/>

		<SectionDivider variant="gradient" class="my-8" />

		<Integrations
			title="Integrates with your stack"
			description="Connect Nvisy with the tools you already use."
		/>

		<CTA
			title="Ready to protect your data?"
			description="Start with free credits. No credit card required."
			primaryCta={{ text: "Open App", href: "https://app.nvisy.com" }}
			secondaryCta={{ text: "View Documentation", href: "https://docs.nvisy.com" }}
		/>

		<Security />
	</main>
</Layout>

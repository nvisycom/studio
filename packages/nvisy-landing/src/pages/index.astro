---
import Layout from "@/layouts/Layout.astro";
import { Hero, Features, Testimonials, CTA } from "@/components";
import Industries from "@/components/sections/Industries.astro";
import Stats from "@/components/sections/Stats.astro";
import Security from "@/components/sections/Security.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";

// SEO and metadata
const pageTitle = "Home";
const pageDescription =
	"Transform documents into structured, actionable data with AI. Extract insights, ensure compliance, and automate document workflows at scale.";
const pageKeywords =
	"document processing, AI data extraction, document intelligence, data automation, compliance, document workflow";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
>
	<main>
		<!-- Hero Section -->
		<Hero
			title="Turn Documents Into Useful Data"
			description="Transform any document into structured, actionable data with AI-powered precision. Extract insights and automate workflows at scale."
			background="gradient"
			buttons={[
				{
					text: "Start Free",
					href: "https://app.nvisy.com/auth/signup",
					variant: "primary",
				},
				{
					text: "View Documentation",
					href: "https://docs.nvisy.com",
					variant: "secondary",
				},
			]}
		/>

		<!-- Stats Section -->
		<Stats
			stats={[
				{ value: "99.5%", label: "Accuracy Rate" },
				{ value: "10x", label: "Faster Processing" },
				{ value: "500+", label: "Companies Trust Us" },
				{ value: "1M+", label: "Documents Processed" },
			]}
			padding="md"
		/>

		<!-- How It Works Section -->
		<HowItWorks />

		<!-- Features Section - Core Value Props -->
		<Features
			category="general"
			featured={true}
			title="Enterprise-Grade Document Intelligence"
			description="Everything you need to extract value from documents at scale. Advanced AI meets strict compliance requirements."
		/>

		<!-- Industries Section - Real-World Applications -->
		<Industries
			title="Built for Every Industry"
			description="From legal firms to healthcare providers, organizations worldwide rely on Nvisy to unlock value from their documents while ensuring compliance."
		/>

		<!-- Testimonials Section -->
		<Testimonials
			title="Loved by Teams Worldwide"
			description="Join hundreds of companies that trust Nvisy to transform their document workflows."
		/>

		<!-- Final CTA -->
		<CTA
			title="Ready to Get Started?"
			description="Join 500+ companies already using Nvisy. Start with 100 free pages, no credit card required."
			background="gradient"
			buttons={[
				{
					text: "Start Free",
					href: "https://app.nvisy.com/auth/signup",
					variant: "primary",
				},
				{
					text: "View Pricing",
					href: "/pricing",
					variant: "secondary",
				},
			]}
		/>

		<!-- Security & Compliance -->
		<Security />
	</main>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Stats from "@/components/sections/Stats.astro";
import Features from "@/components/sections/Features.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import Industries from "@/components/sections/Industries.astro";
import SocialProof from "@/components/sections/SocialProof.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import Security from "@/components/sections/Security.astro";
import CTA from "@/components/sections/CTA.astro";
import Integrations from "@/components/sections/Integrations.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";
import { getCollection } from "astro:content";

// Get latest changelog entry
const changelogEntries = (await getCollection("changelog")).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const latestChangelog = changelogEntries[0];

const pageTitle = "Home";
const pageDescription =
	"Transform documents into structured, actionable data with AI. Extract insights, ensure compliance, and automate document workflows at scale.";
const pageKeywords =
	"document processing, AI data extraction, document intelligence, data automation, compliance, document workflow";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
	hideFooterBorder
>
	<main>
		<Hero
			badge="Now in public beta"
			title="Document intelligence"
			titleHighlight="for modern teams"
			description="Transform any document into structured, actionable data. AI-powered extraction that just works."
			primaryCta={{ text: "Start Free", href: "https://app.nvisy.com/auth/signup" }}
			secondaryCta={latestChangelog ? { text: `New: ${latestChangelog.data.title}`, href: `/changelog/${latestChangelog.slug}` } : undefined}
		/>

		<SocialProof
			title="Trusted by industry leaders"
			subtitle="Join hundreds of companies protecting their sensitive data"
			variant="grid"
		/>

		<Stats />

		<Features
			title="Built for scale"
			description="Everything you need to process documents at enterprise scale."
		/>

		<HowItWorks
			title="How it works"
			description="From document to data in three simple steps."
		/>

		<SectionDivider variant="gradient" class="my-8" />

		<Industries
			title="Built for every industry"
			description="From legal firms to healthcare providers, organizations worldwide rely on Nvisy."
		/>

		<Testimonials
			title="What our customers say"
			description="See how teams are transforming their document workflows."
			limit={6}
		/>

		<SectionDivider variant="gradient" class="my-8" />

		<Integrations
			title="Integrates with your stack"
			description="Connect Nvisy with the tools you already use."
		/>

		<CTA
			title="Ready to get started?"
			description="Start with 100 free pages. No credit card required."
			primaryCta={{ text: "Open App", href: "https://app.nvisy.com" }}
			secondaryCta={{ text: "Download", href: "/products/studio" }}
		/>

		<Security />
	</main>
</Layout>

---
export interface Props {
	event: string;
	interactive?: boolean;
}

const { event: eventName, interactive: isInteractive = true } = Astro.props;
---

<script is:inline define:vars={{ eventName, isInteractive }}>
// @ts-nocheck - define:vars injects variables at runtime
import { track } from "@plausible-analytics/tracker";
track(eventName, { interactive: isInteractive });
</script>

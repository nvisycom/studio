---
import { Image } from "astro:assets";
import logo from "@/assets/brand/nvisy.png";

export interface Props {
	/** Whether the logo should be a clickable link to home page */
	asLink?: boolean;
	/** Size variant of the logo */
	size?: "sm" | "md" | "lg";
	/** Custom company name override */
	companyName?: string;
	/** Custom CSS classes */
	class?: string;
}

const {
	asLink = false,
	size = "md",
	companyName = "Nvisy",
	class: className = "",
} = Astro.props;

const sizeClasses = {
	sm: "w-8 h-8",
	md: "w-12 h-12",
	lg: "w-16 h-16",
};

const logoClass = `${sizeClasses[size]} ${className}`;
---
{asLink ? (
	<a href="/" class="inline-block" aria-label={`${companyName} homepage`}>
		<Image
			src={logo}
			alt={companyName}
			class={logoClass}
		/>
	</a>
) : (
	<Image
		src={logo}
		alt={companyName}
		class={logoClass}
	/>
)}

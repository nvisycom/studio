---
import { Check, X, ArrowRight } from "lucide-vue-next";

const plans = [
	{ id: "free", name: "Free", buttonText: "Get Started" },
	{ id: "starter", name: "Starter", buttonText: "Start Free Trial" },
	{
		id: "business",
		name: "Business",
		popular: true,
		buttonText: "Start Free Trial",
	},
	{ id: "enterprise", name: "Enterprise", buttonText: "Contact Sales" },
];

const categories = [
	{
		name: null,
		features: [
			{
				values: ["$0 / month", "$49 / month", "$199 / month", "Custom pricing"],
			},
			{
				values: [
					"500 credits / month",
					"5,000 credits / month",
					"25,000 credits / month",
					"Unlimited credits",
				],
			},
			{
				values: [
					"Unlimited members",
					"Unlimited members",
					"Unlimited members",
					"Unlimited members",
				],
			},
		],
	},
	{
		name: "Redaction Capabilities",
		features: [
			{
				values: [
					"PII & PHI detection",
					"PII & PHI detection",
					"PII & PHI detection",
					"PII & PHI detection",
				],
			},
			{
				values: [
					"50+ entity types",
					"50+ entity types",
					"50+ entity types",
					"50+ entity types",
				],
			},
			{ label: "Custom redaction rules", values: [false, false, true, true] },
			{ label: "Batch processing", values: [false, true, true, true] },
		],
	},
	{
		name: "Supported Formats",
		features: [
			{
				values: ["PDF & DOCX", "PDF & DOCX", "PDF & DOCX", "PDF & DOCX"],
			},
			{
				values: [
					"Images (PNG, JPG, TIFF)",
					"Images (PNG, JPG, TIFF)",
					"Images (PNG, JPG, TIFF)",
					"Images (PNG, JPG, TIFF)",
				],
			},
			{ label: "Audio (MP3, WAV)", values: [false, true, true, true] },
			{ label: "Video (MP4)", values: [false, true, true, true] },
			{ label: "Data (CSV, JSON, XLSX)", values: [false, true, true, true] },
		],
	},
	{
		name: "Compliance & Audit",
		features: [
			{
				values: [
					"GDPR compliant",
					"GDPR compliant",
					"GDPR compliant",
					"GDPR compliant",
				],
			},
			{ label: "Audit logs", values: [false, false, true, true] },
			{ label: "Compliance reports", values: [false, false, true, true] },
			{ label: "HIPAA & CCPA", values: [false, false, true, true] },
		],
	},
	{
		name: "Integrations",
		features: [
			{
				values: [
					"REST API & SDKs",
					"REST API & SDKs",
					"REST API & SDKs",
					"REST API & SDKs",
				],
			},
			{ label: "Webhooks & Integrations", values: [false, false, true, true] },
			{ label: "Custom integrations", values: [false, false, false, true] },
		],
	},
	{
		name: "Security",
		features: [
			{
				values: [
					"TLS encryption",
					"TLS encryption",
					"TLS encryption",
					"TLS encryption",
				],
			},
			{ label: "SSO/SAML", values: [false, false, true, true] },
			{ label: "Self-hosted deployment", values: [false, false, false, true] },
			{ label: "Custom SLA", values: [false, false, false, true] },
		],
	},
	{
		name: "Support",
		features: [
			{
				values: [
					"Community support",
					"Email support",
					"Priority support",
					"Priority support",
				],
			},
			{
				label: "Dedicated account manager",
				values: [false, false, false, true],
			},
		],
	},
];

const businessIndex = plans.findIndex((p) => p.popular);
---

<section class="py-20 md:py-24">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto relative">
      <!-- Business column border - single continuous element -->
      <div
        class="hidden lg:block absolute top-0 bottom-0 border-2 border-foreground/20 rounded-2xl shadow-xl pointer-events-none"
        style={`left: calc(${businessIndex} * 100% / ${plans.length}); width: calc(100% / ${plans.length}); z-index: 1;`}
      />

      <!-- Plan names header -->
      <div class="flex flex-col lg:flex-row">
        {plans.map((plan) => (
          <div class="flex-1 p-5">
            <span class="text-2xl font-normal">
              {plan.name}
            </span>
          </div>
        ))}
      </div>

      <!-- Categories -->
      {categories.map((category, catIdx) => (
        <>
          <!-- Category Label (if exists) -->
          {category.name && (
            <div class="flex flex-col lg:flex-row mt-10">
              {plans.map((_plan, planIdx) => (
                <div class="flex-1 pb-3 px-5">
                  {planIdx === 0 && (
                    <span class="text-sm font-semibold uppercase tracking-wider text-foreground/50">
                      {category.name}
                    </span>
                  )}
                </div>
              ))}
            </div>
          )}

          <!-- Features rows -->
          {category.features.map((feature, featureIdx) => (
            <div class="flex flex-col lg:flex-row">
              {plans.map((_plan, planIdx) => {
                const value = feature.values[planIdx];
                const isAvailable = value !== false;
                const displayText = typeof value === 'string' ? value : ('label' in feature ? feature.label : '');

                return (
                  <div
                    class:list={[
                      "flex-1 px-5 py-2",
                      catIdx === 0 && featureIdx === 0 && "pt-4",
                    ]}
                  >
                    <div class="flex items-center gap-2.5">
                      {isAvailable ? (
                        <Check class="w-4 h-4 text-emerald-500 flex-shrink-0" />
                      ) : (
                        <X class="w-4 h-4 text-foreground/30 flex-shrink-0" />
                      )}
                      <span class:list={[
                        "text-sm",
                        isAvailable ? "text-foreground/70" : "text-foreground/30"
                      ]}>
                        {displayText}
                      </span>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </>
      ))}

      <!-- CTA Buttons row -->
      <div class="flex flex-col lg:flex-row mt-10">
        {plans.map((plan) => (
          <div class="flex-1 px-5 pb-5">
            <button
              class:list={[
                "w-full font-medium rounded-xl transition-all duration-200 flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98]",
                plan.popular
                  ? "bg-foreground text-background hover:bg-foreground/90 shadow-sm py-3 px-6"
                  : "bg-accent hover:bg-accent/80 text-foreground py-2.5 px-5",
              ]}
            >
              {plan.buttonText}
              <ArrowRight class="w-4 h-4" />
            </button>
            {plan.popular ? (
              <a href="/contact" class="block text-center mt-4 text-base leading-6 text-foreground/70 hover:text-foreground transition-colors">
                or contact sales
              </a>
            ) : (
              <div class="mt-4 h-6"></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

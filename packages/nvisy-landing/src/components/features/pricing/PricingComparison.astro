---
import { Check, X, ArrowRight } from "lucide-vue-next";
import { plans } from "./pricing-data";
import { buttonClasses } from "./shared";

// Derive pricing/credits from plan data to avoid duplication
const priceValues = plans.map((p) =>
	p.priceUnit === "custom"
		? "Custom pricing"
		: p.priceUnit === "free"
			? "$0 / month"
			: `$${p.price} / month`,
);

const creditValues = plans.map((p) => {
	const creditFeature = p.features.find((f) => f.includes("credits"));
	return creditFeature ?? "Unlimited credits";
});

const categories = [
	{
		name: null,
		features: [{ values: priceValues }, { values: creditValues }],
	},
	{
		name: "Redaction Capabilities",
		features: [
			{ label: "Custom redaction policy", values: [true, true, true, true] },
			{ label: "User-provided context", values: [true, true, true, true] },
			{ label: "Batch processing", values: [false, true, true, true] },
		],
	},
	{
		name: "Supported Formats",
		features: [
			{
				values: ["PDF & DOCX", "PDF & DOCX", "PDF & DOCX", "PDF & DOCX"],
			},
			{
				values: [
					"Images (PNG, JPG)",
					"Images (PNG, JPG)",
					"Images (PNG, JPG)",
					"Images (PNG, JPG)",
				],
			},
			{ label: "Audio (MP3, WAV)", values: [false, true, true, true] },
			{ label: "Data (CSV, JSON, XLSX)", values: [false, true, true, true] },
		],
	},
	{
		name: "Compliance & Audit",
		features: [
			{ label: "Audit logs", values: [true, true, true, true] },
			{ label: "Compliance reports", values: [false, true, true, true] },
			{ label: "HIPAA & CCPA", values: [false, false, true, true] },
		],
	},
	{
		name: "Integrations",
		features: [
			{ label: "Webhooks & Integrations", values: [false, true, true, true] },
			{ label: "Custom integrations", values: [false, false, false, true] },
		],
	},
	{
		name: "Security",
		features: [
			{ label: "SSO/SAML", values: [false, false, true, true] },
			{ label: "Self-hosted deployment", values: [false, false, false, true] },
			{ label: "Custom SLA", values: [false, false, false, true] },
		],
	},
	{
		name: "Support",
		features: [
			{
				values: [
					"Community support",
					"Email support",
					"Priority support",
					"Priority support",
				],
			},
			{
				label: "Dedicated account manager",
				values: [false, false, false, true],
			},
		],
	},
];

const businessIndex = plans.findIndex((p) => p.popular);
---

<section class="py-20 md:py-24">
  <div class="container mx-auto px-4">
    <!-- Desktop: full comparison grid -->
    <div class="hidden lg:block max-w-6xl mx-auto relative">
      <!-- Business column highlight -->
      <div
        class="absolute top-0 bottom-0 border-2 border-foreground/20 rounded-2xl shadow-xl pointer-events-none"
        style={`left: calc(${businessIndex} * 100% / ${plans.length}); width: calc(100% / ${plans.length}); z-index: 1;`}
      />

      <!-- Plan names header -->
      <div class="flex">
        {plans.map((plan) => (
          <div class="flex-1 p-5">
            <span class="text-2xl font-normal">{plan.name}</span>
          </div>
        ))}
      </div>

      <!-- Categories -->
      {categories.map((category, catIdx) => (
        <>
          {category.name && (
            <div class="flex mt-10">
              {plans.map((_plan, planIdx) => (
                <div class="flex-1 pb-3 px-5">
                  {planIdx === 0 && (
                    <span class="text-sm font-semibold uppercase tracking-wider text-foreground/50">
                      {category.name}
                    </span>
                  )}
                </div>
              ))}
            </div>
          )}

          {category.features.map((feature, featureIdx) => (
            <div class="flex">
              {plans.map((_plan, planIdx) => {
                const value = feature.values[planIdx];
                const isAvailable = value !== false;
                const displayText = typeof value === "string" ? value : ("label" in feature ? feature.label : "");

                return (
                  <div
                    class:list={[
                      "flex-1 px-5 py-2",
                      catIdx === 0 && featureIdx === 0 && "pt-4",
                    ]}
                  >
                    <div class="flex items-center gap-2.5">
                      {isAvailable ? (
                        <Check class="w-4 h-4 text-emerald-500 flex-shrink-0" />
                      ) : (
                        <X class="w-4 h-4 text-foreground/30 flex-shrink-0" />
                      )}
                      <span class:list={[
                        "text-sm",
                        isAvailable ? "text-foreground/70" : "text-foreground/30",
                      ]}>
                        {displayText}
                      </span>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </>
      ))}

      <!-- CTA Buttons row -->
      <div class="flex mt-10">
        {plans.map((plan) => (
          <div class="flex-1 px-5 pb-5">
            <a
              href={plan.buttonHref}
              class:list={buttonClasses(plan.popular)}
            >
              {plan.buttonText}
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Tablet/Mobile: per-plan feature cards (2x2 on md, 1-column on small) -->
    <div class="lg:hidden max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      {plans.map((plan) => {
        const planIdx = plans.indexOf(plan);
        return (
          <div
            class:list={[
              "rounded-2xl p-6",
              plan.popular
                ? "bg-card border-2 border-foreground/20 shadow-xl"
                : "bg-card/50 border border-border",
            ]}
          >
            <h3 class="text-xl font-semibold mb-1">{plan.name}</h3>
            <p class="text-sm text-foreground/60 mb-4">{plan.description}</p>

            {categories.map((category) => (
              <>
                {category.name && (
                  <p class="text-xs font-semibold uppercase tracking-wider text-foreground/50 mt-5 mb-2">
                    {category.name}
                  </p>
                )}
                {category.features.map((feature) => {
                  const value = feature.values[planIdx];
                  const isAvailable = value !== false;
                  const displayText = typeof value === "string" ? value : ("label" in feature ? feature.label : "");

                  return (
                    <div class="flex items-center gap-2.5 py-1">
                      {isAvailable ? (
                        <Check class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" />
                      ) : (
                        <X class="w-3.5 h-3.5 text-foreground/30 flex-shrink-0" />
                      )}
                      <span class:list={[
                        "text-sm",
                        isAvailable ? "text-foreground/70" : "text-foreground/30",
                      ]}>
                        {displayText}
                      </span>
                    </div>
                  );
                })}
              </>
            ))}

            <a
              href={plan.buttonHref}
              class:list={buttonClasses(plan.popular)}
            >
              {plan.buttonText}
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>

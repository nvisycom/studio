---
import { Check } from "lucide-vue-next";
import { plans } from "./pricing-data";

// Cards: Free(0), Starter(1), Business(2, popular), Enterprise(3)
// Mobile 1-col: [Free|Starter|Business|Enterprise] stacked
// Tablet 2x2:  [Free, Starter] / [Business, Enterprise]
// Desktop 4-col: [Free, Starter, Business, Enterprise] in a row
// Business (popular) always has its own rounded-2xl border, so adjacent
// non-popular cards remove their touching border and don't round that edge.

function cardClasses(index: number, popular: boolean): string[] {
	if (popular) {
		return [
			"border-2 border-foreground/20 rounded-2xl lg:-my-4 z-10 shadow-lg",
		];
	}

	const cls = ["border border-border"];

	// --- Mobile (1-col) ---
	// 0=Free: round top
	// 3=Enterprise: round bottom
	// 1=Starter: no rounding (between Free and Business)
	if (index === 0) cls.push("rounded-t-2xl");
	if (index === 3) cls.push("rounded-b-2xl");
	if (index > 0) cls.push("-mt-px");

	// --- Tablet (2x2) ---
	// 0=Free: TL only. 1=Starter: TR only. 3=Enterprise: BR only.
	// Business(2) is popular, handled above.
	// Reset mobile rounding, apply 2x2 corners.
	if (index === 0) {
		cls.push("md:rounded-none md:rounded-tl-2xl");
	} else if (index === 1) {
		cls.push("md:rounded-none md:rounded-tr-2xl md:-ml-px md:mt-0");
	} else if (index === 3) {
		// Enterprise sits at row2-col2, Business(popular) is row2-col1
		cls.push("md:rounded-none md:rounded-br-2xl md:mt-0");
	}

	// --- Desktop (4-col) ---
	// [Free, Starter, |Business|, Enterprise]
	// Free: round left. Enterprise: round right.
	// Starter: no rounding, remove right border (touches Business).
	// Enterprise: no rounding on left (touches Business), round right.
	if (index === 0) {
		cls.push("lg:rounded-none lg:rounded-l-2xl lg:mt-0");
	} else if (index === 1) {
		cls.push("lg:rounded-none lg:-ml-px lg:border-r-0 lg:mt-0");
	} else if (index === 3) {
		cls.push("lg:rounded-none lg:rounded-r-2xl lg:border-l-0 lg:mt-0");
	}

	return cls;
}
---

<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto items-stretch">
    {plans.map((plan, index) => (
      <div
        class:list={[
          "relative flex flex-col px-6 py-8 lg:px-8",
          ...cardClasses(index, !!plan.popular),
        ]}
      >
        <!-- Plan name -->
        <h3 class="text-2xl font-semibold tracking-tight mb-3">{plan.name}</h3>

        <!-- Price -->
        <div class="mb-4">
          {plan.price === "custom" ? (
            <span class="text-3xl font-semibold tracking-tight">Contact us</span>
          ) : (
            <>
              <span class="text-3xl font-semibold tracking-tight">${plan.price}</span>
              {plan.price > 0 && (
                <span class="text-sm text-foreground/50 ml-1">/month</span>
              )}
            </>
          )}
        </div>

        <p class="text-sm text-foreground/50 mb-6">{plan.description}</p>

        <!-- Features checklist -->
        <ul class="flex flex-col gap-2.5 flex-grow mb-8">
          {plan.features.map((feature) => (
            <li class="flex items-start gap-2.5">
              <Check class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0 mt-0.5" />
              <span class="text-sm text-foreground/70">{feature}</span>
            </li>
          ))}
        </ul>

        <!-- CTA Button at bottom -->
        <div class="mt-auto">
          <a
            href={plan.buttonHref}
            class:list={[
              "w-full text-sm font-medium rounded-lg py-2.5 px-4 text-center transition-colors block",
              plan.popular
                ? "bg-foreground text-background hover:bg-foreground/90"
                : "bg-foreground/10 text-foreground hover:bg-foreground/15",
            ]}
          >
            {plan.buttonText}
          </a>
        </div>
      </div>
    ))}
  </div>
</div>

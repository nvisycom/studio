---
import type { CollectionEntry } from "astro:content";
import { ChevronRight, Clock, File } from "@lucide/vue";

interface Props {
	entry: CollectionEntry<"legal-docs">;
}

const { entry } = Astro.props;

const formatDate = (date: Date): string => {
	return new Date(date).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	});
};
---

<a
  href={`/legal/${entry.id}`}
  class="group block rounded-xl border border-border bg-card p-8 transition-colors hover:border-foreground/20 hover:bg-muted/40"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-grow">
      <h3 class="text-base font-medium tracking-tight">
        {entry.data.title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-foreground/55">
        {
          entry.data.description ||
            `Legal document covering ${entry.data.title.toLowerCase()} requirements and guidelines.`
        }
      </p>

      <div
        class="mt-5 flex items-center gap-3 font-mono text-xs text-foreground/40"
      >
        <span class="flex items-center gap-1.5">
          <File class="h-3 w-3" />
          v{entry.data.version}
        </span>
        <span class="h-1 w-1 rounded-full bg-foreground/20"></span>
        <span class="flex items-center gap-1.5">
          <Clock class="h-3 w-3" />
          Updated {formatDate(entry.data.updatedAt)}
        </span>
      </div>
    </div>
    <ChevronRight
      class="h-5 w-5 shrink-0 text-foreground/40 transition-transform group-hover:translate-x-0.5 group-hover:text-foreground"
    />
  </div>
</a>

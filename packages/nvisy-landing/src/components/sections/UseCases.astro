---
import { getEntry } from "astro:content";

export interface Props {
	title?: string;
	description?: string;
	category: string;
}

const {
	title = "Use Cases",
	description = "See how organizations use our platform to protect sensitive information.",
	category,
} = Astro.props;

// Fetch use cases from content collection
const categoryUseCases = await getEntry("use-cases", category);
const useCases = categoryUseCases?.data || [];
---

<section class="container mx-auto px-4 py-20">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-light text-neutral-900 dark:text-white mb-6">
        {title}
      </h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {useCases.map((useCase) => (
        <div class="bg-white dark:bg-black rounded-xl border border-neutral-200 dark:border-neutral-700 p-6 flex flex-col">
          <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">{useCase.title}</h3>
          <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4 flex-grow">
            {useCase.description}
          </p>
          <div class="text-xs text-neutral-500 bg-neutral-50 dark:bg-neutral-900 rounded-lg p-3 mt-auto">
            {useCase.audience}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import {
	Layers,
	Shield,
	ScanSearch,
	ShieldCheck,
	Brush,
	BarChart3,
	type LucideIcon,
} from "@lucide/vue";

interface Feature {
	icon: LucideIcon;
	title: string;
	description: string;
}

export interface Props {
	title?: string;
	description?: string;
	features?: Feature[];
}

const {
	title = "Built for compliance",
	description = "Everything you need to protect sensitive data at enterprise scale.",
	features: propFeatures,
} = Astro.props;

const defaultFeatures: Feature[] = [
	{
		icon: Layers,
		title: "Multimodal redaction",
		description:
			"Redact PII and PHI across PDFs, DOCX, images, CSV, JSON, and audio.",
	},
	{
		icon: Shield,
		title: "Enterprise security",
		description:
			"Bank-grade encryption, SOC 2 compliance, and zero data retention.",
	},
	{
		icon: ScanSearch,
		title: "AI-powered detection",
		description:
			"Detect 50+ entity types: names, SSNs, addresses, medical, financial.",
	},
	{
		icon: ShieldCheck,
		title: "Privacy compliance",
		description:
			"GDPR, HIPAA, CCPA, and SOC 2 compliant, with full audit trails.",
	},
	{
		icon: Brush,
		title: "Flexible masking",
		description:
			"Blackout, mask, tokenize, or replace data with synthetic values.",
	},
	{
		icon: BarChart3,
		title: "Redaction analytics",
		description: "Track redaction metrics, entity distributions, and coverage.",
	},
];

const features = propFeatures || defaultFeatures;
---

<section class="border-b border-border bg-background">
	<div class="container mx-auto px-5 py-20 md:py-28">
		<!-- Header -->
		<div class="max-w-2xl">
			<h2
				class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em] text-balance"
			>
				{title}
			</h2>
			<p class="mt-4 text-base text-foreground/60 leading-relaxed">
				{description}
			</p>
		</div>

		<!-- Feature grid -->
		<div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-3">
			{
				features.map((feature) => {
					const Icon = feature.icon;
					return (
						<div class="group bg-background p-6 transition-colors hover:bg-muted/40 md:p-8">
							<div class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-foreground/80">
								<Icon class="h-[18px] w-[18px]" />
							</div>
							<h3 class="mt-5 text-base font-medium tracking-tight">
								{feature.title}
							</h3>
							<p class="mt-2 text-sm text-foreground/55 leading-relaxed">
								{feature.description}
							</p>
						</div>
					);
				})
			}
		</div>
	</div>
</section>

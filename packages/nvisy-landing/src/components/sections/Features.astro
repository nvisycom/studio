---
import {
	Layers,
	Shield,
	ScanSearch,
	ShieldCheck,
	Brush,
	BarChart3,
	type LucideIcon,
} from "lucide-vue-next";

interface Feature {
	icon: LucideIcon;
	title: string;
	description: string;
	span?: "wide";
}

export interface Props {
	title?: string;
	description?: string;
	features?: Feature[];
	category?: string;
	featured?: boolean;
}

const {
	title = "Built for compliance",
	description = "Everything you need to protect sensitive data at enterprise scale.",
	features: propFeatures,
} = Astro.props;

const defaultFeatures: Feature[] = [
	{
		icon: Layers,
		title: "Multimodal Redaction",
		description:
			"Redact PII and PHI across PDFs, DOCX, images, CSV, JSON, and audio.",
	},
	{
		icon: Shield,
		title: "Enterprise Security",
		description:
			"Bank-grade encryption, SOC 2 compliance, and zero data retention for redacted files.",
		span: "wide",
	},
	{
		icon: ScanSearch,
		title: "AI-Powered Detection",
		description:
			"Detect 50+ entity types: names, SSNs, addresses, medical records, financial data.",
	},
	{
		icon: ShieldCheck,
		title: "Privacy Compliance",
		description:
			"GDPR, HIPAA, CCPA, and SOC 2 compliant. Full audit trails for every redaction.",
	},
	{
		icon: Brush,
		title: "Flexible Masking",
		description:
			"Blackout, mask, tokenize, or replace sensitive data with synthetic values.",
	},
	{
		icon: BarChart3,
		title: "Redaction Analytics",
		description:
			"Track redaction metrics, entity distributions, and compliance coverage across your files.",
		span: "wide",
	},
];

const features = propFeatures || defaultFeatures;
---

<section class="relative py-24 md:py-32 overflow-hidden">
	<!-- Background -->
	<div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/30 to-transparent" />

	<div class="container relative z-10 mx-auto px-4">
		<!-- Header -->
		<div class="max-w-2xl mx-auto text-center mb-16">
			<h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
				{title}
			</h2>
			<p class="text-lg text-muted-foreground">
				{description}
			</p>
		</div>

		<!-- Bento Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
			{features.map((feature, index) => {
				const Icon = feature.icon;
				const spanClass = feature.span === "wide" ? "md:col-span-2" : "";
				return (
					<div
						class={`scroll-reveal group relative p-6 md:p-8 rounded-2xl border border-border bg-card/50 backdrop-blur-sm hover:border-border/60 transition-all duration-300 ${spanClass}`}
						style={`--reveal-delay: ${index * 100}ms;`}
						data-reveal
					>
						<!-- Gradient background on hover -->
						<div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-sky-100/80 to-pink-100/80 dark:from-sky-900/30 dark:to-pink-900/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

						<!-- Content -->
						<div class="relative z-10">
							<div class="w-10 h-10 rounded-xl bg-foreground/5 flex items-center justify-center mb-4 group-hover:bg-foreground/10 transition-colors duration-300">
								<Icon class="w-5 h-5 text-foreground" />
							</div>
							<h3 class="text-lg font-semibold mb-2 tracking-tight">
								{feature.title}
							</h3>
							<p class="text-sm text-muted-foreground leading-relaxed">
								{feature.description}
							</p>
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>

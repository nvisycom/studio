---
import { Button } from "@/components/ui/button";
import { ArrowRight } from "@lucide/vue";

export interface Props {
	title?: string;
	description?: string;
	primaryCta?: { text: string; href: string };
	secondaryCta?: { text: string; href: string };
	background?: "gradient" | "solid";
	buttons?: Array<{ text: string; href: string; variant?: string }>;
}

const {
	title = "Ready to get started?",
	description = "Join thousands of companies already using our platform.",
	primaryCta = {
		text: "Get Started",
		href: "https://app.nvisy.com/auth/signup",
	},
	secondaryCta,
} = Astro.props;
---

<section class="relative py-24 md:py-32 overflow-hidden bg-background">
	<!-- Subtle grid pattern -->
	<div class="absolute inset-0 bg-[linear-gradient(to_right,oklch(0.5_0_0/0.02)_1px,transparent_1px),linear-gradient(to_bottom,oklch(0.5_0_0/0.02)_1px,transparent_1px)] bg-[size:64px_64px]" />

	<div class="container relative z-10 mx-auto px-4">
		<div class="scroll-reveal max-w-2xl mx-auto text-center" data-reveal>
			<h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
				{title}
			</h2>
			<p class="text-lg text-muted-foreground mb-8 max-w-xl mx-auto">
				{description}
			</p>
			<div class="flex flex-col min-[480px]:flex-row items-center justify-center gap-3 px-4">
				<Button as="a" href={primaryCta.href} variant="glow" size="lg" class="group">
					{primaryCta.text}
					<ArrowRight class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
				</Button>
				{secondaryCta && (
					<Button as="a" href={secondaryCta.href} variant="outline" size="lg">
						{secondaryCta.text}
					</Button>
				)}
			</div>
		</div>
	</div>
</section>

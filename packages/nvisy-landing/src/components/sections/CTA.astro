---
import { ArrowRight } from "@lucide/vue";

export interface Props {
	title?: string;
	description?: string;
	primaryCta?: { text: string; href: string };
	secondaryCta?: { text: string; href: string };
}

const {
	title = "Ready to get started?",
	description = "Join thousands of companies already using our platform.",
	primaryCta = {
		text: "Get Started",
		href: "https://app.nvisy.com/auth/signup",
	},
	secondaryCta,
} = Astro.props;
---

<section class="border-b border-border bg-background">
	<div class="container mx-auto px-5 py-24 text-center md:py-36">
		<h2
			class="mx-auto max-w-[16ch] font-display text-6xl md:text-7xl font-medium tracking-[-0.035em] leading-[1.02] text-balance"
		>
			{title}
		</h2>
		<p
			class="mx-auto mt-5 max-w-lg text-base md:text-lg font-light text-foreground/55 leading-relaxed text-pretty"
		>
			{description}
		</p>

		<div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a
				href={primaryCta.href}
				class="group inline-flex h-11 items-center justify-center gap-2 rounded-[10px] bg-foreground px-5 text-sm font-medium text-background transition-opacity hover:opacity-90"
			>
				{primaryCta.text}
				<ArrowRight
					class="h-4 w-4 transition-transform group-hover:translate-x-[3px]"
				/>
			</a>
			{
				secondaryCta && (
					<a
						href={secondaryCta.href}
						class="inline-flex h-11 items-center justify-center rounded-[10px] border border-border bg-muted/50 px-5 text-sm font-medium text-foreground transition-colors hover:border-foreground/20 hover:bg-muted"
					>
						{secondaryCta.text}
					</a>
				)
			}
		</div>
	</div>
</section>

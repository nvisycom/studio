---
export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "How it works",
	description = "From upload to redacted output in four simple steps.",
} = Astro.props;

const steps = [
	{
		title: "Upload",
		description: "Upload any file: PDFs, images, audio, CSV, or JSON.",
	},
	{
		title: "Detect",
		description: "AI scans for PII, PHI, financial data, and 50+ entity types.",
	},
	{
		title: "Review",
		description: "Review detected entities, adjust rules, and confirm.",
	},
	{
		title: "Redact",
		description: "Download redacted files or integrate via API.",
	},
];
---

<section class="border-b border-border bg-background">
	<div class="container mx-auto px-5 py-20 md:py-28">
		<!-- Header -->
		<div class="max-w-2xl">
			<h2
				class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em] text-balance"
			>
				{title}
			</h2>
			<p class="mt-4 text-base text-foreground/60 leading-relaxed">
				{description}
			</p>
		</div>

		<!-- Steps -->
		<div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step, i) => (
					<div class="border-t border-border pt-5">
						<div class="font-mono text-sm text-foreground/40">
							{String(i + 1).padStart(2, "0")}
						</div>
						<h3 class="mt-4 text-base font-medium tracking-tight">
							{step.title}
						</h3>
						<p class="mt-2 text-sm text-foreground/55 leading-relaxed">
							{step.description}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>

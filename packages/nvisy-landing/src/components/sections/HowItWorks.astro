---
import HowItWorksStepper from "./HowItWorksStepper.vue";
import { AspectRatio } from "@/components/ui/aspect-ratio";
---

<section class="py-16 md:py-28 bg-white dark:bg-black">
	<div class="container mx-auto px-4">
		<div class="max-w-3xl mx-auto text-center mb-16">
			<h2 class="text-3xl md:text-4xl lg:text-5xl font-normal text-black dark:text-white mb-4">
				How It Works
			</h2>
			<p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 font-medium">
				Four simple steps from document to structured data
			</p>
		</div>

		<!-- Stepper -->
		<div class="max-w-5xl mx-auto">
			<HowItWorksStepper client:load />
		</div>

		<!-- Screenshot -->
		<div class="max-w-5xl mx-auto mt-16">
			<div class="rounded-2xl overflow-hidden border border-neutral-200/50 dark:border-neutral-800/50 shadow-2xl bg-white/80 dark:bg-neutral-900/80 backdrop-blur-sm">
				<AspectRatio ratio={16 / 9}>
					<img
						src="/images/dashboard-screenshot.png"
						alt="Nvisy Dashboard - Document Processing Interface"
						class="w-full h-full object-cover"
						loading="eager"
					/>
				</AspectRatio>
			</div>
		</div>
	</div>
</section>

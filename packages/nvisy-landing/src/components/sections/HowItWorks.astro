---
import HowItWorksStepper from "./HowItWorksStepper.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "How It Works",
	description = "Four simple steps from document to structured data",
} = Astro.props;
---

<section class="relative py-24 md:py-32 overflow-hidden">
	<!-- Background -->
	<div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/20 to-transparent" />

	<div class="container relative z-10 mx-auto px-4">
		<div class="scroll-reveal max-w-2xl mx-auto text-center mb-16" data-reveal>
			<h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
				{title}
			</h2>
			<p class="text-lg text-muted-foreground">
				{description}
			</p>
		</div>

		<div class="scroll-reveal max-w-5xl mx-auto" style="--reveal-delay: 150ms;" data-reveal>
			<HowItWorksStepper client:visible />
		</div>
	</div>
</section>

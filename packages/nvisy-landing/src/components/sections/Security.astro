---
const compliances = [
	{ name: "GDPR", status: "completed" },
	{ name: "CCPA", status: "completed" },
	{ name: "SOC II", status: "in-progress" },
	{ name: "HIPAA", status: "in-progress" },
];
---

<section class="py-8 md:py-12 bg-white dark:bg-black">
  <div class="container mx-auto max-w-4xl px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {compliances.map((compliance) => (
        <div class="text-center">
          <div class="flex items-center justify-center gap-2 mb-1">
            <span class="text-sm font-semibold text-black dark:text-white">{compliance.name}</span>
            <div class={`w-2.5 h-2.5 rounded-full ${compliance.status === 'completed' ? 'bg-green-500' : 'bg-orange-500'}`}></div>
          </div>
          {compliance.status === 'in-progress' && (
            <div class="text-xs text-neutral-400">In Progress</div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

---
import { Shield } from "lucide-vue-next";

const compliances = [
	{ name: "GDPR", status: "completed" },
	{ name: "SOC II", status: "in-progress" },
	{ name: "HIPAA", status: "in-progress" },
];
---

<section class="py-12 bg-background">
  <div class="container mx-auto max-w-5xl px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3 text-muted-foreground">
        <Shield className="w-5 h-5" />
        <span class="text-sm font-medium">Enterprise-grade security & compliance</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6">
        {compliances.map((compliance) => (
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-accent/50 border border-border">
            {compliance.status === 'completed' ? (
              <span class="relative flex h-2 w-2">
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
            ) : (
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
              </span>
            )}
            <span class="text-sm font-medium">{compliance.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

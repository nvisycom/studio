---
import { ArrowUpRight, Star } from "@lucide/vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Built on open source",
	description = "Our core services and tools are open source. Contribute, audit our approach, and build with confidence.",
} = Astro.props;

// Nvisy organization repositories
const nvisyRepos = [
	{
		name: "nvisycom/server",
		description:
			"Self-hosted backend with REST and WebSocket APIs for data redaction and privacy compliance.",
		url: "https://github.com/nvisycom/server",
		language: "Rust",
		stars: 3,
	},
	{
		name: "nvisycom/runtime",
		description:
			"Self-hosted redaction engine for automated PII/PHI detection and removal across multimodal data.",
		url: "https://github.com/nvisycom/runtime",
		language: "Rust",
		stars: 3,
	},
	{
		name: "nvisycom/inference",
		description:
			"Model inference service powering entity detection across documents, images, and audio.",
		url: "https://github.com/nvisycom/inference",
		language: "Python",
		stars: 3,
	},
	{
		name: "nvisycom/studio",
		description:
			"Cross-platform desktop app with a secure, native interface for redaction workflows.",
		url: "#",
		language: "TypeScript",
		comingSoon: true,
	},
	{
		name: "nvisycom/docs",
		description:
			"Guides, API references, and everything you need to build with Nvisy.",
		url: "https://github.com/nvisycom/docs",
		language: "MDX",
		stars: 3,
	},
];
---

<section class="border-b border-border bg-background">
	<div class="container mx-auto px-5 py-20 md:py-28">
		<!-- Header -->
		<div class="flex items-end justify-between gap-8">
			<div class="max-w-xl">
				<h2
					class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]"
				>
					{title}
				</h2>
				<p class="mt-4 text-base text-foreground/60 leading-relaxed">
					{description}
				</p>
			</div>
			<a
				href="https://github.com/nvisycom"
				target="_blank"
				rel="noopener noreferrer"
				class="group hidden shrink-0 items-center gap-1.5 text-sm font-medium text-foreground/60 transition-colors hover:text-foreground sm:inline-flex"
			>
				View on GitHub
				<ArrowUpRight
					class="h-3.5 w-3.5 transition-transform group-hover:translate-x-[2px] group-hover:-translate-y-[2px]"
				/>
			</a>
		</div>

		<!-- Repositories grid -->
		<div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				nvisyRepos.map((repo) => {
					const Tag = repo.comingSoon ? "div" : "a";
					return (
						<Tag
							href={repo.comingSoon ? undefined : repo.url}
							target={repo.comingSoon ? undefined : "_blank"}
							rel={repo.comingSoon ? undefined : "noopener noreferrer"}
							class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-colors hover:border-foreground/20 hover:bg-muted/40"
						>
							<div class="flex items-start justify-between gap-3">
								<h3 class="font-mono text-sm text-foreground">{repo.name}</h3>
								{!repo.comingSoon && (
									<ArrowUpRight class="h-4 w-4 shrink-0 text-foreground/40 transition-colors group-hover:text-foreground" />
								)}
							</div>
							<p class="mt-2 flex-1 text-[13px] leading-relaxed text-foreground/55">
								{repo.description}
							</p>
							<div class="mt-5 flex items-center justify-between">
								<span class="rounded-md border border-border px-2 py-0.5 font-mono text-[11px] text-foreground/60">
									{repo.language}
								</span>
								{repo.comingSoon ? (
									<span class="font-mono text-[11px] uppercase tracking-wider text-foreground/40">
										Soon
									</span>
								) : (
									<span class="flex items-center gap-1 text-foreground/40">
										<Star class="h-3.5 w-3.5" />
										<span class="font-mono text-[11px]">{repo.stars}</span>
									</span>
								)}
							</div>
						</Tag>
					);
				})
			}
		</div>

	</div>
</section>

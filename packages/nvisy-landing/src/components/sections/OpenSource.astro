---
import { ExternalLink, Star } from "lucide-vue-next";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Open Source",
	description = "Our core services and tools are open source. Contribute, validate our approach, and build with confidence.",
} = Astro.props;

// Nvisy organization repositories
const nvisyRepos = [
	{
		name: "nvisycom/server",
		description: "Document processing server - core extraction engine",
		url: "#",
		language: "Rust",
		comingSoon: true,
	},
	{
		name: "nvisycom/runtime",
		description: "Secure OCR runtime with extraction capabilities",
		url: "#",
		language: "Rust",
		comingSoon: true,
	},
	{
		name: "nvisycom/studio",
		description: "Cross-platform desktop application for document processing",
		url: "https://github.com/nvisycom/studio",
		language: "TypeScript",
		stars: 54,
	},
	{
		name: "nvisycom/sdk-ts",
		description: "TypeScript SDK for seamless integration",
		url: "https://github.com/nvisycom/sdk-ts",
		language: "TypeScript",
		stars: 42,
	},
	{
		name: "nvisycom/sdk-py",
		description: "Python SDK for easy document processing",
		url: "https://github.com/nvisycom/sdk-py",
		language: "Python",
		stars: 38,
	},
	{
		name: "nvisycom/docs",
		description: "Documentation and guides",
		url: "https://github.com/nvisycom/docs",
		language: "MDX",
		stars: 23,
	},
];

const languageColors: Record<string, string> = {
	Rust: "bg-orange-500/10 text-orange-600 dark:text-orange-400",
	TypeScript: "bg-blue-500/10 text-blue-600 dark:text-blue-400",
	Python: "bg-yellow-500/10 text-yellow-600 dark:text-yellow-400",
	MDX: "bg-violet-500/10 text-violet-600 dark:text-violet-400",
};
---

<section class="py-24 md:py-32">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="scroll-reveal text-center mb-16" data-reveal>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <!-- Repositories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {nvisyRepos.map((repo, index) => (
        repo.comingSoon ? (
          <div
            class="scroll-reveal group relative p-6 rounded-2xl border border-border bg-card/30 backdrop-blur-sm flex flex-col opacity-60"
            style={`--reveal-delay: ${index * 75}ms;`}
            data-reveal
          >
            <div class="flex-1 mb-4">
              <h3 class="text-base font-medium mb-2">
                {repo.name}
              </h3>
              <p class="text-sm text-muted-foreground">
                {repo.description}
              </p>
            </div>
            <div class="flex items-center justify-between">
              <span class={`text-xs px-2 py-1 rounded-md font-medium ${languageColors[repo.language] || 'bg-muted text-muted-foreground'}`}>
                {repo.language}
              </span>
              <span class="text-xs text-muted-foreground font-medium">
                Coming Soon
              </span>
            </div>
          </div>
        ) : (
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="scroll-reveal group relative p-6 rounded-2xl border border-border bg-card/50 backdrop-blur-sm hover:bg-card/80 transition-all duration-300 flex flex-col"
            style={`--reveal-delay: ${index * 75}ms;`}
            data-reveal
          >
            <!-- Subtle gradient on hover -->
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

            <div class="relative flex-1 mb-4">
              <div class="flex items-start justify-between mb-2">
                <h3 class="text-base font-medium">
                  {repo.name}
                </h3>
                <ExternalLink className="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors flex-shrink-0" />
              </div>
              <p class="text-sm text-muted-foreground">
                {repo.description}
              </p>
            </div>
            <div class="relative flex items-center justify-between">
              <span class={`text-xs px-2 py-1 rounded-md font-medium ${languageColors[repo.language] || 'bg-muted text-muted-foreground'}`}>
                {repo.language}
              </span>
              <div class="flex items-center gap-1 text-muted-foreground">
                <Star className="w-3.5 h-3.5" />
                <span class="text-xs font-medium">{repo.stars}</span>
              </div>
            </div>
          </a>
        )
      ))}
    </div>
  </div>
</section>

---
import ConnectCards from "@/components/features/connect/ConnectCards.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Connect your workflow",
	description = "Seamlessly integrate Nvisy into your existing infrastructure with powerful APIs and webhooks.",
} = Astro.props;
---

<section class="relative py-24 md:py-32 overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/10 to-transparent" />

  <div class="container relative z-10 mx-auto max-w-6xl px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <ConnectCards client:visible />
  </div>
</section>

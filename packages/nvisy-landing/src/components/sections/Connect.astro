---
import ConnectCards from "@/components/features/connect/ConnectCards.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Connect Your Workflow",
	description = "Seamlessly integrate Nvisy into your existing infrastructure with powerful APIs and webhooks.",
} = Astro.props;
---

<section class="py-12 md:py-20 bg-white dark:bg-black">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-light text-neutral-900 dark:text-white mb-4 md:mb-6">
        {title}
      </h2>
      <p class="text-base md:text-lg lg:text-xl font-light text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto leading-relaxed">
        {description}
      </p>
    </div>

    <ConnectCards client:visible />
  </div>
</section>

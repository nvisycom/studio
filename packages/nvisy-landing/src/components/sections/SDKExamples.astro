---
import { getCollection, render } from "astro:content";
import SDKShowcase from "./SDKShowcase.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Simple, powerful SDKs",
	description = "Integrate data redaction in minutes with our easy-to-use SDKs. Built for developers, by developers.",
} = Astro.props;

// Fetch SDK content and render Content components
const sdkEntries = await getCollection("sdk-examples");
const sortedSdks = sdkEntries.sort((a, b) => a.data.order - b.data.order);

// Render each SDK entry to get Content component
const sdksData = await Promise.all(
	sortedSdks.map(async (entry) => {
		const { Content } = await render(entry);
		return {
			name: entry.data.name,
			language: entry.data.language,
			githubUrl: entry.data.githubUrl,
			Content,
			order: entry.data.order,
		};
	}),
);
---

<section class="border-b border-border bg-background">
  <div class="container mx-auto px-5 py-20 md:py-28">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]">
        {title}
      </h2>
      <p class="mt-4 text-base text-foreground/60 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Render Content components with dual theme support -->
    {sdksData.map((sdk) => (
      <div style="display: none;" data-sdk-content={sdk.name}>
        <sdk.Content />
      </div>
    ))}

    <!-- Vue component for interactivity -->
    <SDKShowcase
      class="mt-12"
      sdks={sdksData.map((sdk) => ({
        name: sdk.name,
        language: sdk.language,
        githubUrl: sdk.githubUrl,
        order: sdk.order,
      }))}
      client:load
    />
  </div>
</section>

<script>
  // Extract rendered content HTML and pass to Vue component
  function initSDKShowcase() {
    const showcaseContainer = document.querySelector('[data-sdk-showcase]');
    if (!showcaseContainer) return;

    const codeData: Record<string, string> = {};

    // Extract rendered content for each SDK
    document.querySelectorAll('[data-sdk-content]').forEach((el) => {
      const sdkName = el.getAttribute('data-sdk-content');
      if (sdkName) {
        codeData[sdkName] = el.innerHTML;
      }
    });

    // Pass to Vue component
    showcaseContainer.setAttribute('data-code-html', JSON.stringify(codeData));
    showcaseContainer.dispatchEvent(new CustomEvent('code-ready', {
      detail: codeData
    }));
  }

  document.addEventListener('astro:page-load', initSDKShowcase);
  initSDKShowcase();
</script>

---
export interface Props {
	title?: string;
}

const { title = "Trusted by teams handling sensitive data" } = Astro.props;

// Placeholder client wordmarks — swap for real logos when available.
const clients = [
	"Acme Corp",
	"Globex",
	"Initech",
	"Umbrella",
	"Stark Ind.",
	"Wayne Ent.",
];
---

<section class="border-b border-border bg-background">
	<a href="/customers" class="group block">
		<div class="container mx-auto px-5 py-12 md:py-16">
			<p
				class="text-center font-mono text-xs uppercase tracking-wider text-muted-foreground/70 transition-colors group-hover:text-muted-foreground"
			>
				{title}
			</p>

			<div
				class="mx-auto mt-8 flex max-w-5xl flex-wrap items-center justify-center gap-y-6 sm:flex-nowrap sm:justify-between"
			>
				{
					clients.map((client) => (
						<span class="text-base font-medium text-foreground/35 transition-colors group-hover:text-foreground/55 md:text-lg">
							{client}
						</span>
					))
				}
			</div>
		</div>
	</a>
</section>


---
import { getCollection, getEntry } from "astro:content";
import FAQAccordion from "./FAQAccordion.vue";

export interface FAQItem {
	question: string;
	answer: string;
}

export interface Props {
	title?: string;
	description?: string;
	faqs?: FAQItem[];
	category?: string;
	featured?: boolean;
}

const {
	title = "Frequently asked questions",
	description = "Everything you need to know about our platform and services.",
	category,
	featured,
	faqs: propFaqs,
} = Astro.props;

// Fetch FAQs from content if no faqs prop is provided
let faqs: FAQItem[] = propFaqs || [];

if (!propFaqs) {
	if (category) {
		// Fetch specific category JSON file
		const categoryFaqs = await getEntry("faqs", category);
		if (categoryFaqs) {
			let faqList = categoryFaqs.data;

			// Filter by featured if specified
			if (featured !== undefined) {
				faqList = faqList.filter((faq) => faq.featured === featured);
			}

			faqs = faqList
				.sort((a, b) => a.order - b.order)
				.map((faq) => ({
					question: faq.question,
					answer: faq.answer,
				}));
		}
	} else {
		// Fetch all FAQ categories and combine them
		const allFaqEntries = await getCollection("faqs");
		let allFaqsList = allFaqEntries.flatMap((entry) => entry.data);

		// Filter by featured if specified
		if (featured !== undefined) {
			allFaqsList = allFaqsList.filter((faq) => faq.featured === featured);
		}

		faqs = allFaqsList
			.sort((a, b) => a.order - b.order)
			.map((faq) => ({
				question: faq.question,
				answer: faq.answer,
			}));
	}
}
---

<section class="py-24 md:py-32">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <div class="max-w-3xl mx-auto">
      <FAQAccordion client:load faqs={faqs} />
    </div>
  </div>
</section>

---
interface Stat {
	value: string;
	label: string;
}

export interface Props {
	stats?: Stat[];
}

const { stats } = Astro.props;

const defaultStats: Stat[] = [
	{ value: "99.5%", label: "Redaction Accuracy" },
	{ value: "<100ms", label: "Latency" },
	{ value: "10M+", label: "Files Redacted" },
	{ value: "500+", label: "Companies" },
];

const statsData = stats || defaultStats;
---

<section class="py-16 md:py-20">
	<div class="container mx-auto px-4">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 max-w-4xl mx-auto">
			{statsData.map((stat, index) => (
				<div
					class="scroll-reveal text-center"
					style={`--reveal-delay: ${index * 100}ms;`}
					data-reveal
				>
					<div class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-1">
						{stat.value}
					</div>
					<div class="text-sm text-muted-foreground">
						{stat.label}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

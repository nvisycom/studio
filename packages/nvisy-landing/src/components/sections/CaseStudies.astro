---
import { ArrowRight, Building2, Clock } from "lucide-vue-next";
import { getCollection } from "astro:content";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Customer success stories",
	description = "See how leading organizations use Nvisy to protect sensitive information and streamline compliance.",
} = Astro.props;

// Fetch blog posts with "Case Study" category
const caseStudies = (await getCollection("blog-posts"))
	.filter((post) => post.data.category === "Case Study")
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 3);
---

<section class="py-24 md:py-32">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    {caseStudies.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {caseStudies.map((study) => (
          <a
            href={`/blog/${study.id}`}
            class="group relative p-6 rounded-2xl border border-border bg-card/50 backdrop-blur-sm hover:bg-card/80 transition-all duration-300 flex flex-col"
          >
            <!-- Subtle gradient on hover -->
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

            <div class="relative flex-1">
              {/* Category badge */}
              {study.data.category && (
                <span class="inline-block text-xs font-medium px-2 py-1 rounded-md bg-foreground text-background mb-4">
                  {study.data.category}
                </span>
              )}

              {/* Title */}
              <h3 class="text-base font-medium mb-3 line-clamp-2">
                {study.data.title}
              </h3>

              {/* Excerpt */}
              <p class="text-sm text-muted-foreground leading-relaxed mb-4 line-clamp-3 flex-grow">
                {study.data.excerpt || study.data.description}
              </p>
            </div>

            {/* Footer */}
            <div class="relative flex items-center justify-between pt-4 border-t border-border mt-auto">
              <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <Clock class="w-3.5 h-3.5" />
                <span>
                  {new Date(study.data.publishedAt).toLocaleDateString('en-US', {
                    month: 'short',
                    year: 'numeric'
                  })}
                </span>
              </div>
              <div class="flex items-center gap-1 text-sm text-muted-foreground group-hover:text-foreground transition-colors">
                Read
                <ArrowRight class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="w-16 h-16 bg-muted rounded-2xl flex items-center justify-center mx-auto mb-4">
          <Building2 class="w-8 h-8 text-muted-foreground" />
        </div>
        <p class="text-muted-foreground">
          Case studies coming soon. Check back for customer success stories.
        </p>
      </div>
    )}

    {caseStudies.length > 0 && (
      <div class="text-center mt-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium hover:text-muted-foreground transition-colors"
        >
          View all stories
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    )}
  </div>
</section>

---
export interface Props {
	title?: string;
	titleHighlight?: string;
	description?: string;
	pill?: string;
	pillHref?: string;
}

const {
	title = "Redaction infrastructure",
	titleHighlight = "for sensitive data",
	description = "Built for teams that can't afford to leak a single field.",
	pill = "Public beta · MCP Server is live →",
	pillHref = "https://docs.nvisy.com",
} = Astro.props;
---

<section class="hero-grid relative overflow-hidden bg-background">
	<div class="container relative z-10 mx-auto px-5 pt-14 pb-12 md:pt-28 md:pb-20">
		<!-- Headline -->
		<h1
			class="max-w-[80%] font-display font-medium tracking-[-0.03em] leading-[1.02] text-balance text-foreground text-[clamp(2.5rem,6vw,5.25rem)]"
		>
			<span>{title}</span><br />
			<span>{titleHighlight}</span>
		</h1>

		<!-- Sub-paragraph (left) + pill (right) -->
		<div
			class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
		>
			<p
				class="ml-1 max-w-[520px] font-display font-light text-pretty text-foreground/50 text-[clamp(1rem,0.85vw,1.125rem)] leading-relaxed"
			>
				{description}
			</p>

			{
				pill && (
					<a
						href={pillHref}
						class="inline-flex h-[33px] shrink-0 items-center gap-[10px] self-start rounded-full border border-border bg-muted/50 pl-3 pr-[14px] font-mono text-[0.8125rem] tracking-[0.02em] text-muted-foreground transition-colors hover:text-foreground sm:self-auto"
					>
						<span class="relative flex h-2 w-2">
							<span
								class="absolute inline-flex h-full w-full rounded-full"
								style="box-shadow: 0 0 0 3px rgba(46,204,113,0.18);"
							/>
							<span class="inline-flex h-2 w-2 rounded-full bg-[#2ecc71]" />
						</span>
						<span>{pill}</span>
					</a>
				)
			}
		</div>

		<!-- Product screenshot placeholder -->
		<div class="mt-14 md:mt-20">
			<div
				class="relative aspect-[16/9] w-full overflow-hidden rounded-xl border border-border bg-muted/30 shadow-sm"
			>
				<slot name="demo">
					<div
						class="flex h-full w-full items-center justify-center font-mono text-xs uppercase tracking-wider text-muted-foreground/50"
					>
						Product preview
					</div>
				</slot>
			</div>
		</div>
	</div>
</section>

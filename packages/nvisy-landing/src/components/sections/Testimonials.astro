---
import { getCollection, getEntry } from "astro:content";
import type { TestimonialItem } from "@/content.config";

export interface Props {
	title?: string;
	description?: string;
	category?: string;
	featured?: boolean;
	limit?: number;
}

const {
	title = "Trusted by industry leaders",
	description = "See what teams say about automating their data redaction workflows.",
	category,
	featured = true,
	limit,
} = Astro.props;

async function getTestimonials(category?: string): Promise<TestimonialItem[]> {
	if (category) {
		const categoryTestimonials = await getEntry("testimonials", category);
		return categoryTestimonials?.data || [];
	} else {
		const allTestimonials = await getCollection("testimonials");
		return allTestimonials.flatMap((entry) => entry.data);
	}
}

let allTestimonials: TestimonialItem[] = (await getTestimonials(category))
	.filter((testimonial) => testimonial.featured === featured)
	.sort((lhs, rhs) => lhs.order - rhs.order);

if (limit) {
	allTestimonials = allTestimonials.slice(0, limit);
}

const minTestimonials = 3;

const initials = (name: string) =>
	name
		.split(" ")
		.map((n) => n.charAt(0))
		.join("");
---

{
	allTestimonials.length >= minTestimonials && (
		<section class="border-b border-border bg-background">
			<div class="container mx-auto px-5 py-20 md:py-28">
				<div class="max-w-xl">
					<h2 class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]">
						{title}
					</h2>
					<p class="mt-4 text-base text-foreground/60 leading-relaxed">
						{description}
					</p>
				</div>

				<div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{allTestimonials.map((testimonial) => (
						<figure class="flex flex-col rounded-xl border border-border bg-card p-6">
							<blockquote class="flex-1 text-sm leading-relaxed text-foreground/70">
								“{testimonial.quote}”
							</blockquote>
							<figcaption class="mt-6 flex items-center gap-3 border-t border-border/60 pt-5">
								<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-muted font-mono text-xs font-medium text-foreground/70">
									{initials(testimonial.author)}
								</div>
								<div class="min-w-0">
									<div class="truncate text-sm font-medium tracking-tight">
										{testimonial.author}
									</div>
									<div class="truncate text-[13px] text-foreground/50">
										{testimonial.title}, {testimonial.company}
									</div>
								</div>
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>
	)
}

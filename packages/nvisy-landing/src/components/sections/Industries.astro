---
import { getEntry } from "astro:content";
import IndustriesTabs from "./IndustriesTabs.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Built for every industry",
	description = "From legal firms to healthcare providers, organizations rely on Nvisy to protect sensitive data and meet privacy compliance.",
} = Astro.props;

// Load use cases from content collections
const financialData = await getEntry("use-cases", "financial");
const governmentData = await getEntry("use-cases", "government");
const healthcareData = await getEntry("use-cases", "healthcare");
const insuranceData = await getEntry("use-cases", "insurance");

const industries = [
	{
		id: "financial",
		name: "Financial",
		icon: "building-2",
		useCases: financialData?.data || [],
	},
	{
		id: "government",
		name: "Government",
		icon: "landmark",
		useCases: governmentData?.data || [],
	},
	{
		id: "healthcare",
		name: "Healthcare",
		icon: "heart-pulse",
		useCases: healthcareData?.data || [],
	},
	{
		id: "insurance",
		name: "Insurance",
		icon: "shield-check",
		useCases: insuranceData?.data || [],
	},
];
---

<section class="border-b border-border bg-background" aria-labelledby="use-cases-title">
	<div class="container mx-auto px-5 pt-16 pb-20 md:pt-24 md:pb-28">
		<!-- Section Header: heading left, description right (50/50) -->
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:items-start md:gap-12">
			<h2 id="use-cases-title" class="font-display text-4xl md:text-5xl font-medium tracking-[-0.03em]">
				{title}
			</h2>
			{description && (
				<p class="text-lg md:text-xl font-light text-foreground/55 leading-relaxed text-pretty">
					{description}
				</p>
			)}
		</div>

		<!-- Tabbed Use Cases -->
		<div class="mt-12">
			<IndustriesTabs client:visible industries={industries} />
		</div>
	</div>
</section>

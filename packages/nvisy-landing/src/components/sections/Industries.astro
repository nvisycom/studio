---
import { getEntry } from "astro:content";
import IndustriesTabs from "./IndustriesTabs.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Built for Every Industry",
	description = "From legal firms to healthcare providers, organizations worldwide rely on Nvisy to protect sensitive data and meet privacy compliance requirements.",
} = Astro.props;

// Load use cases from content collections
const financialData = await getEntry("use-cases", "financial");
const governmentData = await getEntry("use-cases", "government");
const healthcareData = await getEntry("use-cases", "healthcare");
const insuranceData = await getEntry("use-cases", "insurance");

const industries = [
	{
		id: "financial",
		name: "Financial",
		icon: "building-2",
		useCases: financialData?.data || [],
	},
	{
		id: "government",
		name: "Government",
		icon: "landmark",
		useCases: governmentData?.data || [],
	},
	{
		id: "healthcare",
		name: "Healthcare",
		icon: "heart-pulse",
		useCases: healthcareData?.data || [],
	},
	{
		id: "insurance",
		name: "Insurance",
		icon: "shield-check",
		useCases: insuranceData?.data || [],
	},
];
---

<section class="relative py-24 md:py-32 overflow-hidden" aria-labelledby="use-cases-title">
	<!-- Background effects -->
	<div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/10 to-transparent" />

	<div class="container relative z-10 mx-auto max-w-6xl px-4">
		<!-- Section Header -->
		<div class="scroll-reveal text-center mb-16" data-reveal>
			<h2 id="use-cases-title" class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
				{title}
			</h2>
			{description && (
				<p class="text-lg text-muted-foreground max-w-2xl mx-auto">
					{description}
				</p>
			)}
		</div>

		<!-- Tabbed Use Cases -->
		<IndustriesTabs client:visible industries={industries} />
	</div>
</section>

---
import { getEntry } from "astro:content";
import IndustriesTabs from "./IndustriesTabs.vue";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Built for Every Industry",
	description = "From legal firms to healthcare providers, organizations worldwide rely on Nvisy to unlock value from their documents while ensuring compliance.",
} = Astro.props;

// Load use cases from content collections
const financialData = await getEntry("use-cases", "financial");
const governmentData = await getEntry("use-cases", "government");
const healthcareData = await getEntry("use-cases", "healthcare");
const insuranceData = await getEntry("use-cases", "insurance");

const industries = [
	{
		id: "financial",
		name: "Financial",
		icon: "building-2",
		useCases: financialData?.data || [],
	},
	{
		id: "government",
		name: "Government",
		icon: "landmark",
		useCases: governmentData?.data || [],
	},
	{
		id: "healthcare",
		name: "Healthcare",
		icon: "heart-pulse",
		useCases: healthcareData?.data || [],
	},
	{
		id: "insurance",
		name: "Insurance",
		icon: "shield-check",
		useCases: insuranceData?.data || [],
	},
];
---

<section class="py-16 md:py-28 px-4 bg-white dark:bg-black" aria-labelledby="use-cases-title">
	<div class="container mx-auto max-w-5xl">
		<!-- Header -->
		<header class="text-center mb-12 md:mb-16">
			<h2 id="use-cases-title" class="text-3xl md:text-4xl lg:text-5xl font-light text-neutral-900 dark:text-white mb-3 md:mb-4">
				{title}
			</h2>
			{description && (
				<p class="text-base md:text-lg text-neutral-700 dark:text-neutral-300 font-medium max-w-3xl mx-auto leading-relaxed px-4">
					{description}
				</p>
			)}
		</header>

		<!-- Tabbed Use Cases -->
		<IndustriesTabs client:load industries={industries} />
	</div>
</section>

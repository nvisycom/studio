---
import { ArrowRight } from "lucide-vue-next";
import AnthropicIcon from "@/assets/integration/anthropic.svg?raw";
import DiscordIcon from "@/assets/integration/discord.svg?raw";
import DropboxIcon from "@/assets/integration/dropbox.svg?raw";
import GoogleDriveIcon from "@/assets/integration/google-drive.svg?raw";
import MakeIcon from "@/assets/integration/make.svg?raw";
import OneDriveIcon from "@/assets/integration/microsoft-onedrive.svg?raw";
import TeamsIcon from "@/assets/integration/microsoft-teams.svg?raw";
import MinioIcon from "@/assets/integration/minio.svg?raw";
import N8nIcon from "@/assets/integration/n8n.svg?raw";
import NotionIcon from "@/assets/integration/notion.svg?raw";
import OpenAIIcon from "@/assets/integration/openai.svg?raw";
import SlackIcon from "@/assets/integration/slack.svg?raw";
import ZapierIcon from "@/assets/integration/zapier.svg?raw";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Integrates with your stack",
	description = "Connect Nvisy with the tools you already use. More integrations coming soon.",
} = Astro.props;

const integrations = [
	{ name: "Slack", icon: SlackIcon, category: "communication" },
	{ name: "Microsoft Teams", icon: TeamsIcon, category: "communication" },
	{ name: "Discord", icon: DiscordIcon, category: "communication" },
	{ name: "Notion", icon: NotionIcon, category: "productivity" },
	{ name: "Google Drive", icon: GoogleDriveIcon, category: "storage" },
	{ name: "Dropbox", icon: DropboxIcon, category: "storage" },
	{ name: "OneDrive", icon: OneDriveIcon, category: "storage" },
	{ name: "MinIO", icon: MinioIcon, category: "storage" },
	{ name: "Zapier", icon: ZapierIcon, category: "automation" },
	{ name: "Make", icon: MakeIcon, category: "automation" },
	{ name: "n8n", icon: N8nIcon, category: "automation" },
	{ name: "OpenAI", icon: OpenAIIcon, category: "ai" },
	{ name: "Anthropic", icon: AnthropicIcon, category: "ai" },
];
---

<section class="py-24 md:py-32">
  <div class="container mx-auto px-4">
    <div class="scroll-reveal text-center mb-16" data-reveal>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <!-- Integration icons with hover effect linking to integrations page -->
    <a href="/integrations" class="block relative group cursor-pointer max-w-4xl mx-auto">
      <!-- Integration icons grid -->
      <div class="transition-all duration-300 group-hover:blur-sm group-hover:opacity-30">
        <div class="relative overflow-hidden">
          <!-- Gradient overlays -->
          <div class="absolute left-0 top-0 bottom-0 w-16 md:w-24 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none"></div>
          <div class="absolute right-0 top-0 bottom-0 w-16 md:w-24 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none"></div>

          <!-- Scrolling track -->
          <div class="integrations-marquee">
            <div class="integrations-track">
              {integrations.map((integration) => (
                <div
                  class="flex-shrink-0 w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-muted/50 dark:bg-foreground/10 border border-border flex items-center justify-center"
                  title={integration.name}
                >
                  <div class="w-8 h-8 md:w-10 md:h-10 text-foreground dark:text-foreground [&>svg]:w-full [&>svg]:h-full" set:html={integration.icon} />
                </div>
              ))}
            </div>
            <div class="integrations-track" aria-hidden="true">
              {integrations.map((integration) => (
                <div
                  class="flex-shrink-0 w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-muted/50 dark:bg-foreground/10 border border-border flex items-center justify-center"
                  title={integration.name}
                >
                  <div class="w-8 h-8 md:w-10 md:h-10 text-foreground dark:text-foreground [&>svg]:w-full [&>svg]:h-full" set:html={integration.icon} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Hover overlay with CTA -->
      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
        <div class="flex items-center gap-2 px-6 py-3 rounded-xl bg-foreground text-background font-medium text-sm shadow-lg transform scale-95 group-hover:scale-100 transition-transform duration-300">
          View all integrations
          <ArrowRight className="w-4 h-4" />
        </div>
      </div>
    </a>
  </div>
</section>

<style>
  .integrations-marquee {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .integrations-track {
    display: flex;
    gap: 1rem;
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% - 1rem));
    }
  }
</style>

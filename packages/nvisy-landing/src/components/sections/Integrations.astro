---
import { ArrowRight } from "@lucide/vue";
import AnthropicIcon from "@/assets/integration/anthropic.svg?raw";
import DiscordIcon from "@/assets/integration/discord.svg?raw";
import DropboxIcon from "@/assets/integration/dropbox.svg?raw";
import GoogleDriveIcon from "@/assets/integration/google-drive.svg?raw";
import MakeIcon from "@/assets/integration/make.svg?raw";
import OneDriveIcon from "@/assets/integration/microsoft-onedrive.svg?raw";
import TeamsIcon from "@/assets/integration/microsoft-teams.svg?raw";
import MinioIcon from "@/assets/integration/minio.svg?raw";
import N8nIcon from "@/assets/integration/n8n.svg?raw";
import NotionIcon from "@/assets/integration/notion.svg?raw";
import OpenAIIcon from "@/assets/integration/openai.svg?raw";
import SlackIcon from "@/assets/integration/slack.svg?raw";
import ZapierIcon from "@/assets/integration/zapier.svg?raw";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Integrates with your stack",
	description = "Connect Nvisy with the tools you already use.",
} = Astro.props;

const integrations = [
	{ name: "Slack", icon: SlackIcon },
	{ name: "Microsoft Teams", icon: TeamsIcon },
	{ name: "Discord", icon: DiscordIcon },
	{ name: "Notion", icon: NotionIcon },
	{ name: "Google Drive", icon: GoogleDriveIcon },
	{ name: "Dropbox", icon: DropboxIcon },
	{ name: "OneDrive", icon: OneDriveIcon },
	{ name: "MinIO", icon: MinioIcon },
	{ name: "Zapier", icon: ZapierIcon },
	{ name: "Make", icon: MakeIcon },
	{ name: "n8n", icon: N8nIcon },
	{ name: "OpenAI", icon: OpenAIIcon },
	{ name: "Anthropic", icon: AnthropicIcon },
];
---

<section class="border-b border-border bg-background">
	<div class="container mx-auto px-5 py-20 md:py-28">
		<!-- Header -->
		<div class="flex items-end justify-between gap-8">
			<div class="max-w-xl">
				<h2
					class="font-display text-3xl md:text-4xl font-medium tracking-[-0.02em]"
				>
					{title}
				</h2>
				<p class="mt-4 text-base text-foreground/60 leading-relaxed">
					{description}
				</p>
			</div>
			<a
				href="/integrations"
				class="group hidden shrink-0 items-center gap-1.5 text-sm font-medium text-foreground/60 transition-colors hover:text-foreground sm:inline-flex"
			>
				View all
				<ArrowRight
					class="h-3.5 w-3.5 transition-transform group-hover:translate-x-[3px]"
				/>
			</a>
		</div>

		<!-- Logo grid (hairline cells) -->
		<div
			class="mt-12 grid grid-cols-3 gap-2.5 sm:grid-cols-4 lg:grid-cols-7"
		>
			{
				integrations.map((integration) => (
					<div
						class="flex aspect-square items-center justify-center rounded-xl border border-border bg-card transition-colors hover:border-foreground/20 hover:bg-muted/40"
						title={integration.name}
					>
						<div
							class="h-8 w-8 text-foreground/80 [&>svg]:h-full [&>svg]:w-full"
							set:html={integration.icon}
						/>
					</div>
				))
			}
			<!-- trailing 'more' cell -->
			<a
				href="/integrations"
				class="flex aspect-square items-center justify-center rounded-xl border border-border bg-card font-mono text-xs text-foreground/40 transition-colors hover:border-foreground/20 hover:bg-muted/40 hover:text-foreground"
			>
				+ more
			</a>
		</div>
	</div>
</section>

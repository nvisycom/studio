---
import type { ButtonProps } from "@/components/types";
import { getButtonClasses } from "@/utils/buttonStyles";
import {
	getBackgroundClass,
	type BackgroundVariant,
} from "@/utils/backgroundStyles";
import { Play, ArrowRight, ExternalLink } from "lucide-vue-next";
import GradientShader from "@/components/effects/GradientShader.vue";

export interface Props {
	title?: string;
	subtitle?: string;
	description?: string;
	buttons?: ButtonProps[];
	centered?: boolean;
	background?: BackgroundVariant;
	maxWidth?: "sm" | "md" | "lg" | "xl" | "full";
	titleHighlight?: string;
	heroImage?: string;
	heroImageAlt?: string;
}

const {
	title = "Enterprise Document",
	subtitle = "",
	description = "Turn unstructured documents into structured data with AI-powered precision. Extract, transform, and automate your document workflows at scale.",
	centered = true,
	background = "solid",
	maxWidth = "xl",
	titleHighlight,
	heroImage,
	heroImageAlt = "Hero image",
	buttons = [
		{
			text: "Start Free Trial",
			href: "https://app.nvisy.com/auth/signup",
			variant: "primary",
		},
		{
			text: "View Documentation",
			href: "https://docs.nvisy.com",
			variant: "secondary",
			external: true,
		},
	],
} = Astro.props;

// Helper function to split title and highlight text
const getTitleParts = () => {
	if (!titleHighlight || !title.includes(titleHighlight)) {
		return { beforeHighlight: title, highlight: "", afterHighlight: "" };
	}
	const parts = title.split(titleHighlight);
	return {
		beforeHighlight: parts[0],
		highlight: titleHighlight,
		afterHighlight: parts[1] || "",
	};
};

const titleParts = getTitleParts();

const maxWidthClasses = {
	sm: "max-w-2xl",
	md: "max-w-4xl",
	lg: "max-w-5xl",
	xl: "max-w-6xl",
	full: "max-w-none",
};

const isGradient = background === "gradient";
---

<section class={`
	${isGradient ? '' : getBackgroundClass(background)}
	min-h-[20vh]
	${isGradient ? 'relative overflow-hidden' : 'py-12 md:py-16 px-4 flex items-center'}
`}>
	{isGradient && <GradientShader client:load maskSelector="#hero-screenshot" />}

	<div class={`container mx-auto px-4 w-full relative z-10 ${isGradient ? 'py-12 md:py-16' : ''}`}>
			<div class={`grid ${heroImage ? 'lg:grid-cols-2 gap-12 items-center' : 'grid-cols-1'}`}>
				<div class={`
					${centered ? `mx-auto text-center` : ""}
					${maxWidthClasses[maxWidth]}
				`}>
					<slot name="pre-title" />

					{title && (
						<h1 class="text-4xl md:text-5xl lg:text-6xl font-normal leading-tight mb-4 md:mb-6 text-black dark:text-white">
							{title}
							{subtitle && (
								<span class="block mt-2 text-2xl md:text-3xl lg:text-4xl font-normal leading-tight text-neutral-800 dark:text-neutral-200">
									{subtitle}
								</span>
							)}
						</h1>
					)}

					<slot name="title" />

					{description && (
						<p class={`
							text-lg md:text-xl mb-6 md:mb-8 leading-relaxed text-neutral-700 dark:text-neutral-300 font-normal
							${centered ? "max-w-3xl mx-auto" : "max-w-3xl"}
						`}>
							{description}
						</p>
					)}

					<slot name="description" />
				</div>

				{heroImage && (
					<div class={centered ? "flex justify-center" : ""}>
						<div class="relative">
							<img
								src={heroImage}
								alt={heroImageAlt}
								class="w-full h-auto rounded-lg shadow-2xl"
								loading="eager"
							/>
							<slot name="hero-image-overlay" />
						</div>
					</div>
				)}
			</div>

			<!-- Media slot - full width, outside the constrained grid -->
			<slot name="media" />

			<!-- Buttons section -->
			<div class={`
				${centered ? `mx-auto text-center` : ""}
				${maxWidthClasses[maxWidth]}
			`}>
				{(buttons.length > 0 || Astro.slots.has('buttons')) && (
					<div class={`
						flex flex-col sm:flex-row gap-4 mb-8 md:mb-12
						${centered ? "justify-center" : "justify-start"}
					`}>
						{buttons.map((button) => {
							return button.href ? (
								<a
									href={button.href}
									class={getButtonClasses(button.variant || "primary")}
									aria-label={button.text}
									{...(button.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
								>
									{button.icon && (
										<span class="flex-shrink-0">
											{button.icon === "play" && <Play class="w-5 h-5" />}
											{button.icon === "arrow" && <ArrowRight class="w-5 h-5" />}
											{button.icon === "external" && <ExternalLink class="w-5 h-5" />}
										</span>
									)}
									{button.text}
								</a>
							) : (
								<button
									class={getButtonClasses(button.variant || "primary")}
									onclick={button.onClick}
									aria-label={button.text}
								>
									{button.icon && (
										<span class="flex-shrink-0">
											{button.icon === "play" && <Play class="w-5 h-5" />}
											{button.icon === "arrow" && <ArrowRight class="w-5 h-5" />}
											{button.icon === "external" && <ExternalLink class="w-5 h-5" />}
										</span>
									)}
									{button.text}
								</button>
							);
						})}

						<slot name="buttons" />
					</div>
				)}

				<slot name="stats" />
				<slot name="content" />
			</div>

			<slot name="footer" />
	</div>
</section>

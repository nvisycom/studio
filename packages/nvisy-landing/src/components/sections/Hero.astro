---
import { Button } from "@/components/ui/button";
import { ArrowRight } from "lucide-vue-next";

export interface Props {
	badge?: string;
	title?: string;
	titleHighlight?: string;
	titleInline?: boolean;
	description?: string;
	primaryCta?: { text: string; href: string } | undefined;
	secondaryCta?: { text: string; href: string } | undefined;
	centered?: boolean;
	compact?: boolean;
}

const {
	badge,
	title = "Document intelligence",
	titleHighlight,
	titleInline = false,
	description = "Transform any document into structured, actionable data.",
	primaryCta = {
		text: "Get Started",
		href: "https://app.nvisy.com/auth/signup",
	},
	secondaryCta,
	centered = true,
	compact = false,
} = Astro.props;
---

<section class:list={["relative flex items-center justify-center overflow-hidden bg-background", compact ? "min-h-[40vh] md:min-h-[50vh]" : "min-h-[60vh] md:min-h-[85vh]"]}>
	<!-- Base gradient background -->
	<div class="absolute inset-0 bg-gradient-radial [mask-image:linear-gradient(to_bottom,black_50%,transparent_100%)]" />

	<!-- Animated gradient mesh orbs -->
	<div class="absolute inset-0 overflow-hidden">
		<!-- Primary orb - purple/violet -->
		<div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[600px] animate-orb-float">
			<div class="w-full h-full bg-gradient-to-b from-violet-500/15 via-fuchsia-500/10 to-transparent dark:from-violet-500/40 dark:via-fuchsia-500/20 dark:to-transparent rounded-full animate-pulse-glow" />
		</div>

		<!-- Secondary orb - blue/cyan (left) -->
		<div class="absolute top-[5%] left-[10%] w-[500px] h-[400px] animate-orb-float-reverse">
			<div class="w-full h-full bg-gradient-to-br from-blue-500/10 via-cyan-500/5 to-transparent dark:from-blue-500/25 dark:via-cyan-500/15 dark:to-transparent rounded-full animate-pulse-glow" style="animation-delay: -2s;" />
		</div>

		<!-- Tertiary orb - pink/rose (right) -->
		<div class="absolute top-[15%] right-[5%] w-[450px] h-[350px] animate-orb-float" style="animation-delay: -5s;">
			<div class="w-full h-full bg-gradient-to-bl from-pink-500/8 via-rose-500/5 to-transparent dark:from-pink-500/20 dark:via-rose-500/10 dark:to-transparent rounded-full animate-pulse-glow" style="animation-delay: -3s;" />
		</div>
	</div>

	<!-- Subtle grid pattern with fade -->
	<div class="absolute inset-0 bg-[linear-gradient(to_right,oklch(0.5_0_0/0.03)_1px,transparent_1px),linear-gradient(to_bottom,oklch(0.5_0_0/0.03)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:linear-gradient(to_bottom,black_50%,transparent_100%)]" />

	<div class="container relative z-10 mx-auto px-4 py-12 md:py-16">
		<div class={`max-w-4xl ${centered ? 'mx-auto text-center' : ''}`}>
			<!-- Badge -->
			{badge && (
				<div class="inline-flex items-center gap-2 px-4 py-1.5 mb-5 text-sm font-medium rounded-full border border-border bg-background/50 backdrop-blur-sm animate-fade-in" style="animation-delay: 0ms; opacity: 0;">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
					</span>
					{badge}
				</div>
			)}

			<!-- Pre-title slot -->
			<slot name="pre-title" />

			<!-- Title -->
			<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.1] mb-6 animate-fade-in-up" style="animation-delay: 100ms; opacity: 0;">
				{title}
				{titleHighlight && (
					<span class={`${titleInline ? 'inline' : 'block mt-2'} text-gradient-vibrant`}>
						{titleInline ? ` ${titleHighlight}` : titleHighlight}
					</span>
				)}
			</h1>

			<!-- Title slot -->
			<slot name="title" />

			<!-- Description -->
			{description && (
				<p class={`text-lg md:text-xl text-muted-foreground max-w-2xl mb-10 leading-relaxed animate-fade-in-up ${centered ? 'mx-auto' : ''}`} style="animation-delay: 200ms; opacity: 0;">
					{description}
				</p>
			)}

			<!-- Description slot -->
			<slot name="description" />

			<!-- CTAs -->
			<div class={`flex flex-col sm:flex-row items-center gap-4 animate-fade-in-up ${centered ? 'justify-center' : ''}`} style="animation-delay: 300ms; opacity: 0;">
				{primaryCta && (
					<Button as="a" href={primaryCta.href} size="lg" variant="glow">
						{primaryCta.text}
						<ArrowRight class="w-4 h-4" />
					</Button>
				)}
				{secondaryCta && (
					<Button as="a" href={secondaryCta.href} size="lg" variant="outline">
						{secondaryCta.text}
					</Button>
				)}
				<slot name="buttons" />
			</div>

			<!-- Content slot -->
			<slot name="content" />
		</div>

		<!-- Demo slot -->
		<slot name="demo" />
	</div>

</section>

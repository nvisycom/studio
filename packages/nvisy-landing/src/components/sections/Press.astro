---
interface PressItem {
	name: string;
	logo?: string;
	url?: string;
}

interface Props {
	items?: PressItem[];
	title?: string;
	description?: string;
}

const { items = [], title, description } = Astro.props;

// Default items if none provided
const defaultItems: PressItem[] = [
	{ name: "TechCrunch", url: "#" },
	{ name: "ProductHunt", url: "#" },
	{ name: "Hacker News", url: "#" },
	{ name: "The Verge", url: "#" },
];

const displayItems = items.length > 0 ? items : defaultItems;
---

<section class="py-12 md:py-16 bg-white dark:bg-black">
  <div class="container mx-auto px-4 max-w-4xl">
    {(title || description) && (
      <div class="text-center mb-10">
        {title && (
          <h2 class="text-2xl md:text-3xl font-light text-neutral-900 dark:text-white mb-3">
            {title}
          </h2>
        )}
        {description && (
          <p class="text-neutral-600 dark:text-neutral-400 max-w-xl mx-auto">
            {description}
          </p>
        )}
      </div>
    )}

    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
      {displayItems.map((item) => (
        item.url ? (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-400 dark:text-neutral-500 hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors"
          >
            {item.logo ? (
              <img
                src={item.logo}
                alt={item.name}
                class="h-8 w-auto opacity-50 hover:opacity-100 transition-opacity"
              />
            ) : (
              <span class="text-xl md:text-2xl font-semibold">{item.name}</span>
            )}
          </a>
        ) : (
          <span class="text-neutral-400 dark:text-neutral-500 text-xl md:text-2xl font-semibold">
            {item.logo ? (
              <img
                src={item.logo}
                alt={item.name}
                class="h-8 w-auto opacity-50"
              />
            ) : (
              item.name
            )}
          </span>
        )
      ))}
    </div>
  </div>
</section>

---
import { ExternalLink } from "lucide-vue-next";

export interface FooterLink {
	name: string;
	href: string;
	isExternal?: boolean;
}

export interface FooterSection {
	title: string;
	links: FooterLink[];
}

interface Props {
	footerSections: FooterSection[];
}

const { footerSections } = Astro.props;
---

{footerSections.map((section) => (
  <div>
    <h3 class="text-xs font-medium text-muted-foreground mb-4 uppercase tracking-wider">
      {section.title}
    </h3>
    <ul class="space-y-3">
      {section.links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noopener noreferrer" : undefined}
            class="text-sm text-foreground/80 hover:text-foreground transition-colors inline-flex items-center gap-1.5"
          >
            {link.name}
            {link.isExternal && <ExternalLink class="w-3 h-3" />}
          </a>
        </li>
      ))}
    </ul>
  </div>
))}

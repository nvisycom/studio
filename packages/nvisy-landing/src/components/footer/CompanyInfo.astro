---
import { COMPANY_NAME } from "@nvisy/config";
import Logo from "@/components/Logo.astro";
import OpenStatus from "./OpenStatus.vue";
import GithubIcon from "@/assets/icons/github.svg";
import BlueskyIcon from "@/assets/icons/bluesky.svg";
import LinkedinIcon from "@/assets/icons/linkedin.svg";
import DiscordIcon from "@/assets/icons/discord.svg";
import MailIcon from "@/assets/icons/mail.svg";

export interface Props {
	companyName?: string;
}

const { companyName = COMPANY_NAME } = Astro.props;

const socialLinks = [
	{
		name: "Email",
		href: "mailto:hello@nvisy.com",
		Icon: MailIcon,
	},
	{
		name: "GitHub",
		href: "https://github.com/nvisycom",
		Icon: GithubIcon,
	},
	{
		name: "Discord",
		href: "https://discord.gg/kunumbtCSB",
		Icon: DiscordIcon,
	},
	{
		name: "Bluesky",
		href: "https://bsky.app/profile/nvisy.com",
		Icon: BlueskyIcon,
	},
	{
		name: "LinkedIn",
		href: "https://www.linkedin.com/company/nvisy/",
		Icon: LinkedinIcon,
	},
];
---

<div class="col-span-1 lg:col-span-2">
  <div class="mb-4">
    <Logo size="md" asLink={true} companyName={companyName} />
  </div>
  <p class="text-sm text-muted-foreground max-w-xs leading-relaxed">
    Automated data redaction for documents, images, and audio. Detect and remove sensitive information at scale.
  </p>
  <div class="flex gap-1 mt-6">
    {socialLinks.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-foreground transition-colors p-2 hover:bg-accent rounded-lg"
        aria-label={`Follow us on ${social.name}`}
      >
        <social.Icon class="h-4 w-4" />
      </a>
    ))}
  </div>

  <div class="mt-6">
    <OpenStatus client:idle slug="nvisy" />
  </div>
</div>

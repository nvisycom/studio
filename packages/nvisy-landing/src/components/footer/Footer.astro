---
import TopSection from "./TopSection.astro";
import CompanyInfo from "./CompanyInfo.astro";
import BottomSection from "./BottomSection.astro";
import { COMPANY_NAME } from "@nvisy/config";
import { footerSections } from "./nav-data";

export interface Props {
	copyrightYear?: number;
	companyName?: string;
	copyrightPrefix?: string;
	copyrightSuffix?: string;
	hideBorder?: boolean;
}

const {
	copyrightYear = new Date().getFullYear(),
	companyName = COMPANY_NAME,
	copyrightPrefix = "Copyright",
	copyrightSuffix = "",
	hideBorder = false,
} = Astro.props;
---

<footer class:list={["bg-[var(--footer-bg)]", { "border-t border-border": !hideBorder }]}>
  <div class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-6 gap-12">
      <CompanyInfo companyName={companyName} />
      <div class="grid grid-cols-2 md:grid-cols-4 lg:contents gap-8">
        <TopSection footerSections={footerSections} />
      </div>
    </div>
    <BottomSection
      copyrightYear={copyrightYear}
      companyName={companyName}
      copyrightPrefix={copyrightPrefix}
      copyrightSuffix={copyrightSuffix}
    />
  </div>
</footer>

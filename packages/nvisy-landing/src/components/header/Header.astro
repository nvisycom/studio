---
import Logo from "../Logo.astro";
import DesktopNavigation from "./DesktopNavigation.vue";
import MobileNavigation from "./MobileNavigation.vue";
---

<header
  class="sticky top-0 z-50 w-full bg-white/95 dark:bg-black/95 backdrop-blur-md supports-[backdrop-filter]:bg-white/90 dark:supports-[backdrop-filter]:bg-black/90"
>
  <div class="container mx-auto px-4 md:px-8 lg:px-12">
    <div class="flex h-16 items-center justify-between gap-8">
      <!-- Logo Section -->
      <Logo asLink={true} size="md" />

      <!-- Desktop Navigation Section -->
      <DesktopNavigation client:load />

      <!-- Auth Button Section -->
      <div class="flex items-center space-x-3">
        <a
          href="https://app.nvisy.com/auth/login"
          class="hidden sm:inline-flex relative text-neutral-700 dark:text-neutral-200 hover:text-black dark:hover:text-white font-medium text-base transition-all duration-300"
        >
          Log In
        </a>
        <a
          href="https://app.nvisy.com/auth/signup"
          class="inline-flex items-center justify-center bg-black dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-200 text-white dark:text-black font-medium px-4 py-2 text-base transition-all duration-300 rounded-md no-underline hover:shadow-lg hover:scale-105"
        >
          Sign Up
        </a>

        <!-- Mobile Navigation Component -->
        <MobileNavigation client:load />
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Menu (Full Width) -->
  <MobileNavigation menuOnly={true} client:load />
</header>

---
import Logo from "../Logo.astro";
import DesktopNavigation from "./DesktopNavigation.vue";
import MobileNavigation from "./MobileNavigation.vue";
import AuthButtons from "./AuthButtons.vue";
---

<header
  class="header-glass sticky top-0 z-50 w-full transform-gpu border-b border-border/60"
>
  <div class="container relative mx-auto px-4 md:px-8 lg:px-12">
    <div class="flex h-16 items-center justify-between gap-8">
      <Logo asLink={true} size="sm" />

      <div class="flex items-center gap-1">
        <DesktopNavigation client:load />

        <div class="mx-2 hidden h-5 w-px bg-foreground/20 lg:block"></div>

        <AuthButtons client:load />

        <MobileNavigation client:load />
      </div>
    </div>
  </div>

  <MobileNavigation menuOnly={true} client:load />
</header>

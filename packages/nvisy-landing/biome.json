{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["**", "!.astro", "!dist"]
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"includes": ["src/**", "!.astro", "!dist"],
		"rules": {
			"suspicious": {
				"noUnknownAtRules": "off",
				"noExplicitAny": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedImports": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"css": {
		"parser": { "tailwindDirectives": true },
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noVueDuplicateKeys": "off"
					}
				}
			}
		}
	]
}

---
import {
	BUILD_VERSION,
	DEFAULT_DESCRIPTION,
	DEFAULT_TITLE,
} from "@nvisy/config";

import { Footer } from "@/components/footer";
import { Header } from "@/components/header";
import MinLayout from "@/layouts/MinLayout.astro";
import Cookies from "@/components/Cookies.vue";

export interface Props {
	title?: string | undefined;
	description?: string | undefined;
	version?: string | undefined;
	withDefaultTitle?: boolean | undefined;
	image?: string | undefined;
	article?: boolean | undefined;
	publishedTime?: string | undefined;
	modifiedTime?: string | undefined;
	author?: string | undefined;
	keywords?: string | undefined;
	hideHeader?: boolean | undefined;
	hideFooter?: boolean | undefined;
}

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	version = BUILD_VERSION,
	withDefaultTitle = false,
	image,
	article,
	publishedTime,
	modifiedTime,
	author,
	keywords,
	hideHeader = false,
	hideFooter = false,
} = Astro.props;
---
<MinLayout
	title={title}
	description={description}
	version={version}
	withDefaultTitle={withDefaultTitle}
	image={image}
	article={article}
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	author={author}
	keywords={keywords}
>
	<!-- Page Content -->
	<div slot="content" class="flex flex-col min-h-screen">
		<!-- Header -->
		{!hideHeader && (
			<header role="banner" class="flex-shrink-0">
				<Header client:load />
			</header>
		)}

		<!-- Main Content -->
		<main
			id="main-content"
			role="main"
			class="flex-1 w-full"
			tabindex="-1"
		>
			<slot/>
		</main>

		<!-- Footer -->
		{!hideFooter && (
			<footer role="contentinfo" class="flex-shrink-0">
				<Footer />
			</footer>
		)}

		<!-- Cookie Popup -->
		<Cookies />
	</div>
</MinLayout>

---
import { Hero, CTA, FAQ, Testimonials} from "@/sections";
import { PricingCards, BillingToggle } from "@/sections/pricing";
import { Layout } from "@/layouts";
---

<Layout title="Pricing" description="Choose the perfect plan for your needs. Simple, transparent pricing with no hidden fees.">
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Simple, Transparent Pricing"
      description="Choose the perfect plan for your needs. Start free and scale as you grow, with no hidden fees or surprise charges."
      background="gradient"
      fontSize="xl"
      padding="lg"
      buttons={[]}
      >
        <BillingToggle client:load slot="content" />
      </Hero>

    <!-- Pricing Cards -->
    <PricingCards client:load />

    <!-- Testimonials Section -->
    <Testimonials
      title="Trusted by teams worldwide"
      description="See what our customers say about transforming their document redaction workflows."
      backgroundColor="gray"
    />

    <FAQ
      title="Frequently asked questions"
      description="Everything you need to know about our pricing and plans."
      maxWidth="3xl"
      category="pricing"
    />

    <CTA
      title="Ready to get started?"
      description="Join thousands of companies already using our platform to build better products faster."
      background="solid"
      buttons={[
        {
          text: "Start Free Trial",
          variant: "primary"
        },
        {
          text: "Book a Demo",
          variant: "secondary",
          icon: "mail"
        }
      ]}
    />
  </div>
  </div>
</Layout>

---
import {Layout} from "@/layouts";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { CTA, Hero } from "@/sections";
import { Github, Mail } from "lucide-vue-next";

let completedItems: CollectionEntry<"roadmap">[] = [];
let inProgressItems: CollectionEntry<"roadmap">[] = [];
let plannedItems: CollectionEntry<"roadmap">[] = [];

try {
	const roadmapEntries = await getCollection("roadmap");
	completedItems = [...roadmapEntries].filter(({ id }) => {
		return id === "completed";
	});
	inProgressItems = [...roadmapEntries].filter(({ id }) => {
		return id === "in-progress";
	});
	plannedItems = [...roadmapEntries].filter(({ id }) => {
		return id === "planned";
	});
} catch (error: unknown) {
	console.error("Error fetching roadmap collection:", error);
}

const completed = completedItems[0]?.data || [];
const inProgress = inProgressItems[0]?.data || [];
const planned = plannedItems[0]?.data || [];
---

<Layout
  title="Roadmap"
  description="See what we're building at Nvisy. Our product roadmap shows completed milestones, current work, and future plans for developer productivity tools."
>
  <div class="bg-white dark:bg-black min-h-screen">
    <!-- Hero Section -->
    <Hero
      title="Product Roadmap"
      description="See what we're building to help developers be more productive. Our roadmap shows completed features, current work, and exciting plans ahead."
      background="gradient"
      fontSize="xl"
      padding="lg"
      buttons={[]}
    />


    <!-- Roadmap Timeline -->
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-6xl mx-auto">

        <!-- Completed Features -->
        <div class="mb-16">
          <div class="flex items-center mb-8">
            <div class="w-4 h-4 bg-gray-900 dark:bg-white rounded-full mr-3"></div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
              Completed
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {completed.map((item) => (
              <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-6 hover:border-gray-400 dark:hover:border-neutral-500 transition-all duration-300 hover:shadow-lg">
                <div class="flex items-start justify-between mb-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{item.title}</h3>
                  <div class="w-2 h-2 bg-gray-900 dark:bg-white rounded-full mt-2"></div>
                </div>
                <p class="text-gray-600 dark:text-neutral-400 text-sm mb-4">
                  {item.description}
                </p>
                <div class="flex items-center justify-between">
                  <div class="text-xs text-gray-600 dark:text-neutral-400 font-medium">
                    {item.quarter}
                  </div>
                  {item.githubIssue && (
                    <a
                      href={item.githubIssue}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-xs text-gray-500 dark:text-neutral-500 hover:text-gray-700 dark:hover:text-neutral-300 transition-colors"
                    >
                        <span class="mr-2">
                            <Github class="h-5 w-5" />
                        </span>
                      Issue
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Current Work -->
        <div class="mb-16">
          <div class="flex items-center mb-8">
            <div class="w-4 h-4 bg-gray-900 dark:bg-white rounded-full mr-3 animate-pulse"></div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                In Progress
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {inProgress.map((item) => (
              <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-6 hover:border-gray-400 dark:hover:border-neutral-500 transition-all duration-300 hover:shadow-lg">
                <div class="flex items-start justify-between mb-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{item.title}</h3>
                  <div class="w-2 h-2 bg-gray-900 dark:bg-white rounded-full mt-2"></div>
                </div>
                <p class="text-gray-600 dark:text-neutral-400 text-sm mb-4">
                  {item.description}
                </p>
                <div class="flex items-center justify-between mb-2">
                  <div class="text-xs text-gray-600 dark:text-neutral-400 font-medium">
                    {item.quarter}
                  </div>
                  {item.githubIssue && (
                    <a
                      href={item.githubIssue}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-xs text-gray-500 dark:text-neutral-500 hover:text-gray-700 dark:hover:text-neutral-300 transition-colors"
                    >
                        <span class="mr-2">
                            <Github class="h-5 w-5" />
                        </span>
                        Issue
                    </a>
                  )}
                </div>
                {item.progress && (
                  <div class="w-full bg-gray-200 dark:bg-neutral-700 rounded-full h-1">
                    <div class="bg-gray-900 dark:bg-white h-1 rounded-full" style={`width: ${item.progress}%`}></div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Future Plans -->
        <div class="mb-16">
          <div class="flex items-center mb-8">
            <div class="w-4 h-4 bg-gray-600 dark:bg-neutral-400 rounded-full mr-3"></div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                Planned
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {planned.map((item) => (
              <div class="bg-white dark:bg-black rounded-xl border border-gray-200 dark:border-neutral-700 p-6 hover:border-gray-400 dark:hover:border-neutral-500 transition-all duration-300 hover:shadow-lg">
                <div class="flex items-start justify-between mb-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{item.title}</h3>
                  <div class="w-2 h-2 bg-gray-600 dark:bg-neutral-400 rounded-full mt-2"></div>
                </div>
                <p class="text-gray-600 dark:text-neutral-400 text-sm mb-4">
                  {item.description}
                </p>
                <div class="flex items-center justify-between">
                  <div class="text-xs text-gray-600 dark:text-neutral-400 font-medium">
                    {item.quarter}
                  </div>
                  {item.githubIssue && (
                    <a
                      href={item.githubIssue}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-xs text-gray-500 dark:text-neutral-500 hover:text-gray-700 dark:hover:text-neutral-300 transition-colors"
                    >
                        <span class="mr-2">
                            <Github class="h-5 w-5" />
                        </span>
                      Issue
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Community & Feedback -->
        <CTA
          title="Help Shape Our Roadmap"
          description="Your feedback drives our development priorities. Let us know what features matter most to you and your team."
          background="none"
          padding="md"
          buttons={[
            {
              text: "Share Feedback",
              href: "https://github.com/nvisy/feedback/discussions",
              variant: "primary",
              icon: "github"
            },
            {
              text: "Request Feature",
              href: "/contact",
              variant: "secondary"
            }
          ]}
        />
      </div>
    </div>
  </div>
</Layout>

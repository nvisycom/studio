---
export interface Props {
	title?: string;
	industries?: Array<{
		name: string;
		description: string;
		icon: string;
		category: string;
		stats?: string;
	}>;
}

const {
	title = "Trusted by industry leaders",
	industries = [
		{
			name: "ENTERPRISE",
			description:
				"Fortune 500 companies trust us with their most sensitive data",
			icon: "🏢",
			category: "enterprise",
			stats: "500+ companies",
		},
		{
			name: "LEGAL FIRM",
			description: "Law firms rely on us for confidential document processing",
			icon: "⚖️",
			category: "legal",
			stats: "200+ firms",
		},
		{
			name: "FINANCE",
			description: "Banks and financial institutions secure their data with us",
			icon: "💼",
			category: "finance",
			stats: "150+ institutions",
		},
		{
			name: "HEALTHCARE",
			description:
				"Healthcare providers protect patient data using our solutions",
			icon: "🏥",
			category: "healthcare",
			stats: "300+ providers",
		},
	],
} = Astro.props;
---

<section class="py-16 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-black">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center mb-12">
      <p class="text-gray-500 dark:text-gray-400 text-sm mb-2">{title}</p>
      <div class="w-24 h-0.5 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="trust-filters">
      <button
        class="trust-filter active group relative p-6 bg-black dark:bg-white rounded-2xl border border-gray-200 dark:border-gray-700 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 cursor-pointer text-left"
        data-category="all"
      >
        <!-- Icon -->
        <div class="text-3xl mb-4 transform group-hover:scale-110 transition-transform duration-300">
          🌟
        </div>

        <!-- Title -->
        <h3 class="font-bold text-white dark:text-gray-900 text-sm mb-2 transition-colors">
          ALL INDUSTRIES
        </h3>

        <!-- Stats -->
        <p class="text-xs text-gray-300 dark:text-gray-600 font-medium mb-3">
          1000+ clients
        </p>

        <!-- Arrow -->
        <div class="flex justify-end">
          <svg
            class="w-4 h-4 text-gray-300 dark:text-gray-600 transform group-hover:translate-x-1 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </button>

      {industries.map((industry) => (
        <div class="group relative">
          <button
            class="trust-filter block w-full p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 cursor-pointer text-left"
            data-category={industry.category}
          >
            <!-- Icon -->
            <div class="text-3xl mb-4 transform group-hover:scale-110 transition-transform duration-300">
              {industry.icon}
            </div>

            <!-- Title -->
            <h3 class="font-bold text-gray-900 dark:text-white text-sm mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {industry.name}
            </h3>

            <!-- Stats -->
            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium mb-3">
              {industry.stats}
            </p>

            <!-- Arrow -->
            <div class="flex justify-end">
              <svg
                class="w-4 h-4 text-gray-400 group-hover:text-blue-500 transform group-hover:translate-x-1 transition-all duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </button>

          <!-- Hover Tooltip -->
          <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-4 py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-sm rounded-lg shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-10 w-64 text-center">
            <p class="font-medium mb-1">{industry.name}</p>
            <p class="text-xs text-gray-300 dark:text-gray-600">{industry.description}</p>
            <!-- Tooltip arrow -->
            <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-gray-100"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Content Area for Filtered Results -->
    <div class="mt-12" id="filtered-content">
      <!-- Default content shown when "All" is selected -->
      <div class="text-center industry-content" data-industry="all">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Serving All Industries</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">Enterprise Solutions</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Scalable document redaction for large organizations with complex compliance requirements.</p>
          </div>
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">Industry Compliance</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Meeting regulatory standards across healthcare, finance, legal, and enterprise sectors.</p>
          </div>
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">Security First</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Advanced encryption and security protocols to protect your most sensitive information.</p>
          </div>
        </div>
      </div>

      <!-- Enterprise content -->
      <div class="text-center industry-content hidden" data-industry="enterprise">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Enterprise Solutions</h3>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
          Fortune 500 companies trust our AI-powered redaction technology to handle their most sensitive documents at scale.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">🏢 Scale & Performance</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Process millions of documents with 99.9% uptime and enterprise-grade infrastructure.</p>
          </div>
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">🔧 Custom Integration</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Seamlessly integrate with your existing workflows and enterprise systems.</p>
          </div>
        </div>
      </div>

      <!-- Legal content -->
      <div class="text-center industry-content hidden" data-industry="legal">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Legal Firm Solutions</h3>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
          Law firms rely on our precision redaction to protect attorney-client privilege and sensitive case information.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">⚖️ Legal Compliance</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Meet all legal discovery and privilege requirements with automated precision.</p>
          </div>
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">📋 Case Management</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Streamline document review processes and reduce manual redaction time by 90%.</p>
          </div>
        </div>
      </div>

      <!-- Finance content -->
      <div class="text-center industry-content hidden" data-industry="finance">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Financial Services</h3>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
          Banks and financial institutions protect customer data and maintain regulatory compliance with our solutions.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">💼 Regulatory Compliance</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">SOX, PCI DSS, and banking regulations compliance with automated redaction workflows.</p>
          </div>
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">🛡️ Data Protection</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Protect PII, account numbers, and sensitive financial data across all documents.</p>
          </div>
        </div>
      </div>

      <!-- Healthcare content -->
      <div class="text-center industry-content hidden" data-industry="healthcare">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Healthcare Solutions</h3>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
          Healthcare providers trust us to protect patient privacy and maintain HIPAA compliance across all medical records.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">🏥 HIPAA Compliance</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Automatically identify and redact PHI to maintain patient privacy and regulatory compliance.</p>
          </div>
          <div class="p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-left">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-3">📊 Medical Records</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400">Process medical charts, lab results, and clinical notes while preserving data integrity.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Additional Trust Indicators -->
    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
      <div class="flex flex-col md:flex-row items-center justify-center gap-8 text-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-semibold text-gray-900 dark:text-white text-lg">SOC 2 Compliant</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Enterprise security standards</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-semibold text-gray-900 dark:text-white text-lg">GDPR Ready</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Privacy by design</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-semibold text-gray-900 dark:text-white text-lg">99.9% Uptime</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Reliable service guarantee</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const trustFilters = document.querySelectorAll('.trust-filter');
    const industryContent = document.querySelectorAll('.industry-content');

    let selectedIndustry = 'all';

    // Industry filtering
    trustFilters.forEach(filter => {
      filter.addEventListener('click', function() {
        const element = filter as HTMLElement;
        selectedIndustry = element.dataset.category || 'all';

        // Update active state
        trustFilters.forEach(f => {
          const filterElement = f as HTMLElement;
          filterElement.classList.remove('active', 'bg-black', 'dark:bg-white');
          filterElement.classList.add('bg-white', 'dark:bg-gray-800');

          const title = filterElement.querySelector('h3');
          if (title) {
            title.classList.remove('text-white', 'dark:text-gray-900');
            title.classList.add('text-gray-900', 'dark:text-white');
          }

          const stats = filterElement.querySelector('p');
          if (stats) {
            stats.classList.remove('text-gray-300', 'dark:text-gray-600');
            stats.classList.add('text-gray-500', 'dark:text-gray-400');
          }

          const arrow = filterElement.querySelector('svg');
          if (arrow) {
            arrow.classList.remove('text-gray-300', 'dark:text-gray-600');
            arrow.classList.add('text-gray-400');
          }
        });

        // Set active state for clicked filter
        element.classList.add('active', 'bg-black', 'dark:bg-white');
        element.classList.remove('bg-white', 'dark:bg-gray-800');

        const activeTitle = element.querySelector('h3');
        if (activeTitle) {
          activeTitle.classList.add('text-white', 'dark:text-gray-900');
          activeTitle.classList.remove('text-gray-900', 'dark:text-white');
        }

        const activeStats = element.querySelector('p');
        if (activeStats) {
          activeStats.classList.add('text-gray-300', 'dark:text-gray-600');
          activeStats.classList.remove('text-gray-500', 'dark:text-gray-400');
        }

        const activeArrow = element.querySelector('svg');
        if (activeArrow) {
          activeArrow.classList.add('text-gray-300', 'dark:text-gray-600');
          activeArrow.classList.remove('text-gray-400');
        }

        filterContent();
      });
    });

    function filterContent() {
      industryContent.forEach(content => {
        const contentElement = content as HTMLElement;
        const contentIndustry = contentElement.dataset.industry;

        if (contentIndustry === selectedIndustry) {
          contentElement.style.opacity = '0';
          setTimeout(() => {
            contentElement.classList.remove('hidden');
            contentElement.style.opacity = '1';
          }, 150);
        } else {
          contentElement.style.opacity = '0';
          setTimeout(() => {
            contentElement.classList.add('hidden');
          }, 150);
        }
      });
    }
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

---
import type { CollectionEntry } from "astro:content";
import { ChevronRight, Clock, File } from "lucide-vue-next";

interface Props {
	entry: CollectionEntry<"legal">;
}

const { entry } = Astro.props;

const formatDate = (date: Date): string => {
	return new Date(date).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	});
};
---

<a
  href={`/legal/${entry.slug}`}
  class="group bg-white dark:bg-black border border-gray-200 dark:border-neutral-800 rounded-xl p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 block"
>
  <div class="flex items-start justify-between mb-4">
    <div class="flex-grow">
      <div class="flex items-center gap-2 mb-3">
        <h3
          class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-gray-700 dark:group-hover:text-neutral-300 transition-colors"
        >
          {entry.data.title}
        </h3>
      </div>
      <p
        class="text-gray-600 dark:text-neutral-300 text-sm leading-relaxed mb-4"
      >
        {
          entry.data.description ||
            `Legal document covering ${entry.data.title.toLowerCase()} requirements and guidelines.`
        }
      </p>

      <div
        class="flex items-center gap-4 text-xs text-gray-500 dark:text-neutral-400"
      >
        <div class="flex items-center gap-1">
          <File class="w-3 h-3" />
          Version {entry.data.version}
        </div>
        <div class="flex items-center gap-1">
          <Clock class="w-3 h-3" />
          Updated {formatDate(entry.data.updatedAt)}
        </div>
      </div>
    </div>
    <div class="ml-4 flex-shrink-0">
      <ChevronRight
        class="w-5 h-5 text-gray-400 dark:text-neutral-500 group-hover:text-gray-600 dark:group-hover:text-neutral-300 transition-colors"
      />
    </div>
  </div>
</a>

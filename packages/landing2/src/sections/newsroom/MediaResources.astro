---
import { Download } from "lucide-vue-next";

// Media resources data - this could be passed as props in a real implementation
const mediaResources = [
	{
		name: "Company Logo Package",
		description: "High-resolution logos in various formats (PNG, SVG, EPS)",
		type: "logos",
		size: "2.4 MB",
	},
	{
		name: "Brand Guidelines",
		description: "Complete brand style guide and usage instructions",
		type: "document",
		size: "3.8 MB",
	},
];
---

<div class="max-w-4xl mx-auto">
  <div class="text-center mb-12">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      Media Resources
    </h2>
    <p class="text-gray-600 dark:text-neutral-300 max-w-2xl mx-auto">
      Download high-quality media assets, company information, and brand resources for your coverage.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {mediaResources.map(resource => (
      <div class="bg-white dark:bg-black border border-gray-200 dark:border-neutral-700 rounded-lg p-6 hover:shadow-lg hover:border-gray-300 dark:hover:border-neutral-600 transition-all duration-300">
        <div class="flex items-start justify-between">
          <div class="flex-1 min-w-0 pr-4">
            <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2">
              {resource.name}
            </h3>
            <p class="text-sm text-gray-600 dark:text-neutral-300 mb-3 leading-relaxed">
              {resource.description}
            </p>
            <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-neutral-400">
              <span class="capitalize bg-gray-100 dark:bg-neutral-800 px-2 py-1 rounded-full">
                {resource.type}
              </span>
              <span>{resource.size}</span>
            </div>
          </div>
          <button
            class="flex items-center justify-center w-12 h-12 bg-gray-100 dark:bg-neutral-800 hover:bg-gray-200 dark:hover:bg-neutral-700 rounded-lg transition-colors flex-shrink-0"
            aria-label={`Download ${resource.name}`}
          >
            <Download class="w-5 h-5 text-gray-600 dark:text-neutral-300" client:load />
          </button>
        </div>
      </div>
    ))}
  </div>


</div>
